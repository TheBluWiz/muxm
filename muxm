readonly VALID_PROFILES="archive hdr10-hq atv-directplay-hq atv-directplay-animation streaming-hevc av1-hq streaming-av1 animation universal youtube-upload"

# _valid_profiles_display — return the profile list comma-separated for user-facing messages.
_valid_profiles_display(){ echo "${VALID_PROFILES// /, }"; }

# _is_valid_profile — return 0 if $1 is a recognised profile name, 1 otherwise.
# Also accepts deprecated aliases: 'dv-archival' (maps to 'archive'), 'streaming' (maps to 'streaming-hevc').
_is_valid_profile(){ [[ " $VALID_PROFILES " == *" $1 "* ]] || [[ "$1" == "dv-archival" ]] || [[ "$1" == "streaming" ]]; }

# L4: single source of truth for deprecated profile aliases.
# All normalisation call sites must go through _normalize_profile instead of
# maintaining their own warn+rename blocks.
declare -A PROFILE_ALIASES=( [dv-archival]=archive [streaming]=streaming-hevc )

# _normalize_profile — resolve a deprecated alias to its canonical name.
# Emits a deprecation warning when a mapping is applied. Modifies the named variable in-place.
# Args: $1 — name of the variable holding the profile string (nameref)
_normalize_profile(){
  local -n _np_profile=$1
  local _np_canon
  _np_canon="${PROFILE_ALIASES[$_np_profile]:-}"
  if [[ -n "$_np_canon" ]]; then
    warn "Profile '$_np_profile' is deprecated. Use '--profile $_np_canon' instead."
    _np_profile="$_np_canon"
  fi
}

