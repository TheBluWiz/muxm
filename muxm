declare -i REPORT_JSON=0

# ===== Section 5: Basic helpers ===============================================================
# ---- Logging helpers ----
# All output goes to stderr to keep stdout clean for piping.
# say()  — plain informational message (no prefix)
# note() — informational with ℹ️  prefix
# warn() — warning with ⚠️  prefix
# die()  — fatal error with ❌ prefix; exits with code (default 1)
#           Usage: die "message" or die <code> "message"
# _log_buffer_mirror — append terminal-message text to the pre-§17 _LOG_BUFFER so it survives
# into the logfile once that exists (Section 17 flush). Called by note/warn/die ONLY while the
# tee is not yet live (_LOG_READY=0); once live, the tee captures stderr into the log directly,
# so mirroring would double-write. No-op under DEBUG (the buffer is never flushed there).
# Args: $1 = emoji/prefix to match the terminal form; $2.. = message lines.
_log_buffer_mirror() {
  local _pfx="$1"; shift
  local _l
  for _l in "$@"; do _LOG_BUFFER+="${_pfx}${_l}"$'\n'; done
  return 0
}

# _to_log PREFIX LINE… — record message lines in the LOG only (never the terminal), so --quiet can
# suppress terminal narration WITHOUT ever stripping it from the persistent log (Phases 1–2).
# Pre-§17 → the flush buffer; post-§17 → $LOGFILE directly (un-timestamped, to match tee'd lines).
_to_log() {
  local _pfx="$1"; shift
  if (( ${_LOG_READY:-0} )); then
    if [[ -n "${LOGFILE:-}" && -w "${LOGFILE:-}" ]]; then
      local _l; for _l in "$@"; do printf '%s%s\n' "$_pfx" "$_l" >> "$LOGFILE" || true; done
    fi
  else
    _log_buffer_mirror "$_pfx" "$@"
  fi
  return 0
}

# say/note — informational narration. VERBOSITY gates the TERMINAL only (0=quiet suppresses these,
# routing them to the log via _to_log so the log stays complete). Emoji prefixes obey USE_COLOR via
# ${_PFX_-default} (set -u-safe even before the prefix globals resolve). All helpers return 0 — they
# are bare statements under `set -e`, so a nonzero tail would abort the run at the call site.
say()  {
  if (( _VERBOSITY_N >= 1 )); then
    printf "%s\n" "$@" >&2
    (( ${_LOG_READY:-0} )) || _log_buffer_mirror "" "$@"
  else
    _to_log "" "$@"
  fi
  return 0
}
note() {
  if (( _VERBOSITY_N >= 1 )); then
    printf "${_PFX_NOTE-ℹ️  }%s\n" "$@" >&2
    (( ${_LOG_READY:-0} )) || _log_buffer_mirror "${_PFX_NOTE-ℹ️  }" "$@"
  else
    _to_log "${_PFX_NOTE-ℹ️  }" "$@"
  fi
  return 0
}
# warn — never suppressed (shows even under --quiet); always terminal + log.
warn() {
  printf "${_PFX_WARN-⚠️  }%s\n" "$@" >&2
  (( ${_LOG_READY:-0} )) || _log_buffer_mirror "${_PFX_WARN-⚠️  }" "$@"
  return 0
}

# log() — log-only detail.
#   • Post-§17 (_LOG_READY=1): append to $LOGFILE with a cheap [+Ns] prefix (no per-line date fork).
#   • Pre-§17: buffer for the §17 flush.
#   • --verbose (VERBOSITY≥2): ALSO echo the line to the raw terminal FD (bypassing the tee, so it
#     is not double-written to the logfile) — this is how verbose surfaces the otherwise-log-only
#     narration. DEBUG no longer needs a special case here: post-decouple it has a real logfile.
log() {
  local _l
  if (( ${_LOG_READY:-0} )); then
    if [[ -n "${LOGFILE:-}" && -w "${LOGFILE:-}" ]]; then
      for _l in "$@"; do printf '[+%ss] %s\n' "$SECONDS" "$_l" >> "$LOGFILE" || true; done
    fi
  else
    for _l in "$@"; do _LOG_BUFFER+="[+${SECONDS}s] $_l"$'\n'; done
  fi
  if (( _VERBOSITY_N >= 2 )); then
    for _l in "$@"; do printf '%s\n' "$_l" >&"${TERM_FD:-2}"; done
  fi
  return 0
}

# is_valid_verbosity / _resolve_verbosity — VERBOSITY is the human enum (quiet|normal|verbose, also
# accepts 0|1|2 for convenience); the helpers gate on the numeric _VERBOSITY_N. _resolve_verbosity
# maps the current VERBOSITY to _VERBOSITY_N and normalises the string. Defined here (before the §6
# validation and §12 parser call sites) so it is always available when called.
is_valid_verbosity() { case "$1" in quiet|normal|verbose|0|1|2) return 0 ;; *) return 1 ;; esac; }
_resolve_verbosity() {
  case "${VERBOSITY:-normal}" in
    quiet|0)   VERBOSITY="quiet";   _VERBOSITY_N=0 ;;
    normal|1)  VERBOSITY="normal";  _VERBOSITY_N=1 ;;
    verbose|2) VERBOSITY="verbose"; _VERBOSITY_N=2 ;;
    *) die 11 "Invalid VERBOSITY=\"$VERBOSITY\" (expected quiet, normal, or verbose)" ;;
  esac
  return 0
}

# ---- Terminal FD for interactive UI (spinner / progress bar) ----
# Saved in Section 17 before the exec > >(tee …) redirect.
# Falls back to stderr if not yet initialised.
TERM_FD=""
# shellcheck disable=SC2059  # Callers pass printf format + args intentionally
_term_print() { printf -- "$@" >&"${TERM_FD:-2}"; }

# ---- Spinner — indeterminate progress indicator ----
# spinner PID "Message"
# Display an animated spinner on the terminal while a background process runs.
# Args: $1 — PID to poll, $2 — status message to display
# NOTE: spinner NEVER calls wait — it only polls with kill -0.
#       The caller MUST call wait "$pid" afterward to collect exit status.
# Globals: TERM_FD (read)
spinner() {
  local pid=$1 msg=$2 i=0
  local -a sym=( '|' '/' '—' $'\\' )
  local -i show=1
  local _poll=0.2
  # Non-interactive (piped / CI / test harness): there is no animation to display, so poll far
  # more frequently. On small inputs an ffmpeg pass often finishes in <0.1s, where the 0.2s poll
  # added ~0.2s of pure wait *per pass* — the single biggest contributor to test-suite wall time.
  # The visible interactive spinner keeps its smooth 0.2s cadence. Contract is unchanged: this
  # still only polls `kill -0` and never calls `wait` (callers own the wait + exit status).
  [[ -t ${TERM_FD:-2} ]] || { show=0; _poll=0.02; }
  while kill -0 "$pid" 2>/dev/null; do
    (( show )) && _term_print '\r  %s  [ %s ]' "$msg" "${sym[i]}" || true
    i=$(( (i+1) % 4 ))
    sleep "$_poll"
  done
  (( show )) && _term_print '\r  %s  [ done ]\n' "$msg" || true
}

# _make_progress_pipe — Create a named pipe (FIFO) for ffmpeg -progress output.
# Args: $1 — path for the FIFO
# Returns: 0 if FIFO created successfully, 1 on failure (with warning logged).
# On failure, callers should fall back to spinner-only mode (no -progress flag).
_make_progress_pipe() {
  local pipe_path="$1"
  if mkfifo "$pipe_path" 2>/dev/null; then
    return 0
  fi
  warn "Could not create progress pipe ($pipe_path) — progress display unavailable."
  return 1
}

# _repeat_char — print a character n times using pure bash (no seq dependency).
# Portable alternative to `printf '%0.s' $(seq 1 n)`.
# Args: $1 — character to repeat, $2 — count (0 or negative prints nothing)
_repeat_char() { local char="$1" n="${2:-0}" i; for (( i=0; i<n; i++ )); do printf '%s' "$char"; done; }

# ---- Progress bar — percentage-based for ffmpeg encodes ----
# Reads ffmpeg -progress output from a named pipe and renders a terminal bar.
# Args: $1 = ffmpeg PID, $2 = progress pipe path, $3 = total duration (seconds),
#       $4 = label
# Returns: the exit status of the ffmpeg process.
#
# IMPORTANT: This function calls `wait "$pid"` internally. The caller should NOT
# call wait again. The wait at the end of this function is the authoritative
# collection of the ffmpeg exit status — it fires after the progress pipe is
# fully drained or the process has exited.
ffmpeg_progress_bar() {
  local pid=$1 pipe=$2 total_secs=$3 label=$4
  local pct=0 bar="" elapsed_us=0

  # If we can't show a progress bar (no terminal or unknown duration),
  # we MUST still drain the named pipe — otherwise ffmpeg blocks forever
  # trying to open the FIFO for writing with no reader on the other end.
  if [[ ! -t ${TERM_FD:-2} ]] || (( total_secs <= 0 )); then
    cat "$pipe" >/dev/null 2>&1 &
    local drain_pid=$!
    spinner "$pid" "$label"
    wait "$pid" 2>/dev/null
    local rc=$?
    # Clean up the FIFO drain process (may already be gone if pipe hit EOF)
    kill "$drain_pid" 2>/dev/null || true
    wait "$drain_pid" 2>/dev/null || true
    return $rc
  fi

  local -i cols=40
  # Suppress the ERR trap for the read loop: a SIGINT-interrupted read returns exit 1,
  # which would fire on_error spuriously ("command failed") before the INT trap runs.
  # The original handler is restored after the loop only to leave the global trap state
  # as we found it — NOT so a failing `wait "$pid"` below can fire it: ffmpeg_progress_bar
  # always runs via _ffmpeg_run_with_ui, which every caller invokes under `if ! …`. That
  # `!` disables errexit/ERR for the whole call chain (bash skips both in an if-condition),
  # so a real ffmpeg failure surfaces through this function's return status — checked by
  # the `if !` caller — not through the ERR trap.
  trap '' ERR
  while IFS='=' read -r key val 2>/dev/null; do
    case "$key" in
      out_time_us|out_time_ms)
        # L5: handle both progress fields. Older ffmpeg emits only out_time_ms; modern builds emit
        # both. NOTE: ffmpeg's out_time_ms is a long-standing misnomer — it carries MICROSECONDS, the
        # same value as out_time_us (verified: both print e.g. 3000000 for a 3s clip), so both route
        # to the identical microseconds math below. (The review's "*1000" suggestion assumed true
        # milliseconds and would run the bar 1000× fast; it is intentionally not applied.)
        elapsed_us="${val:-0}"
        # Guard against non-numeric values
        [[ "$elapsed_us" =~ ^-?[0-9]+$ ]] || continue
        (( elapsed_us < 0 )) && elapsed_us=0
        pct=$(( elapsed_us * 100 / (total_secs * 1000000) ))
        (( pct > 100 )) && pct=100
        local filled empty
        filled=$(( pct * cols / 100 ))
        empty=$(( cols - filled ))
        bar="$(_repeat_char '█' "$filled")"
        bar+="$(_repeat_char '░' "$empty")"
        _term_print '\r  %s  [%s] %3d%%' "$label" "$bar" "$pct"
        ;;
      progress)
        # ffmpeg writes "progress=end" when done
        [[ "$val" == "end" ]] && break
        ;;
    esac
  done < "$pipe"
  trap 'on_error $LINENO "$BASH_COMMAND" "$?"' ERR

  # Ensure the bar reaches 100% visually
  bar="$(_repeat_char '█' "$cols")"
  _term_print '\r  %s  [%s] 100%%\n' "$label" "$bar"

  wait "$pid" 2>/dev/null
  return $?
}

# _ffmpeg_run_with_ui — launch ffmpeg with a progress bar when possible, else spinner.
# Args: $1 = nameref to command array (args after "ffmpeg", without -progress flag),
#       $2 = label string, $3 = error file path, $4 = total duration in seconds.
# Returns: ffmpeg exit status. Caller is responsible for die/warn on failure.
_ffmpeg_run_with_ui() {
  local -n _ffui_cmd=$1
  local _ffui_label="$2"
  local _ffui_err="$3"
  local _ffui_secs="${4:-0}"
  local _ffui_cwd="${5:-}"     # optional: run ffmpeg from this directory (used by the
                               # forced-sub burn-in, whose -vf references burn.srt
                               # relatively so no user path needs filtergraph escaping).
  local _ffui_pipe="$WORKDIR/_ffui.$$.pipe"
  local _ffui_t0=$SECONDS      # for log-only per-op timing (D8: where did the run hang?)

  # When a cwd is requested, launch ffmpeg inside a subshell that cd's first. `exec`
  # replaces the subshell with ffmpeg, so $! is ffmpeg's own PID (not the subshell's) —
  # keeping _ACTIVE_FFMPEG_PID accurate so on_exit can SIGKILL it on Ctrl+C. Every path
  # passed to ffmpeg is absolute, so the cwd change only affects the relative burn.srt.
  if _make_progress_pipe "$_ffui_pipe"; then
    if [[ -n "$_ffui_cwd" ]]; then
      ( cd "$_ffui_cwd" && exec ffmpeg "${_ffui_cmd[@]}" -progress "$_ffui_pipe" 2>"$_ffui_err" ) &
    else
      ffmpeg "${_ffui_cmd[@]}" -progress "$_ffui_pipe" 2>"$_ffui_err" &
    fi
    local _ffui_pid=$!
    _ACTIVE_FFMPEG_PID=$_ffui_pid
    ffmpeg_progress_bar "$_ffui_pid" "$_ffui_pipe" "$_ffui_secs" "$_ffui_label"
    local _ffui_rc=$?
    _ACTIVE_FFMPEG_PID=""
    rm -f "$_ffui_pipe" 2>/dev/null || true
    log "ffmpeg op \"$_ffui_label\" finished in $(( SECONDS - _ffui_t0 ))s (exit $_ffui_rc)"
    return $_ffui_rc
  else
    if [[ -n "$_ffui_cwd" ]]; then
      ( cd "$_ffui_cwd" && exec ffmpeg "${_ffui_cmd[@]}" 2>"$_ffui_err" ) &
    else
      ffmpeg "${_ffui_cmd[@]}" 2>"$_ffui_err" &
    fi
    local _ffui_pid=$!
    _ACTIVE_FFMPEG_PID=$_ffui_pid
    spinner "$_ffui_pid" "$_ffui_label"
    wait "$_ffui_pid" 2>/dev/null
    local _ffui_rc=$?
    _ACTIVE_FFMPEG_PID=""
    log "ffmpeg op \"$_ffui_label\" finished in $(( SECONDS - _ffui_t0 ))s (exit $_ffui_rc)"
    return $_ffui_rc
  fi
}

# _await_tracked_pid PID MSG — CR-10: the shared tail for the ~20 "backgrounded child → register
# _ACTIVE_FFMPEG_PID → spinner → wait → clear PID" sites. Enforces the SIGINT-safety contract in ONE
# place: register the pid BEFORE wait (so on_exit can SIGKILL the child on Ctrl-C) and clear it AFTER
# (so a stale pid can't be killed later). Returns the child's exit code, so callers keep their exact
# rc handling: `local rc=0; _await_tracked_pid "$pid" "msg" || rc=$?` then die/warn/fallback on rc.
# NOTE: this is a plain function (no subshell), so the `wait` here still reaps a child started by the
# CALLER's shell. The fire-and-forget OCR sites intentionally do NOT use this (they `wait … || true`
# and read output files, not rc) — routing them through an rc-returning helper would trip set -e.
_await_tracked_pid(){
  local _atp_pid="$1" _atp_msg="$2" _atp_rc=0
  _ACTIVE_FFMPEG_PID="$_atp_pid"   # register BEFORE wait (SIGINT-safety contract)
  spinner "$_atp_pid" "$_atp_msg"
  wait "$_atp_pid" 2>/dev/null || _atp_rc=$?
  _ACTIVE_FFMPEG_PID=""            # clear AFTER wait
  return "$_atp_rc"
}

# _get_source_duration_secs — extract source video duration in whole seconds.
#
# Three-tier lookup (each tier falls through on null, "N/A", or non-numeric):
#   1. streams[].duration           — standard per-stream field (MP4, TS)
#   2. format.duration              — container-level (requires -show_format in cache)
#   3. streams[].tags.DURATION      — Matroska/MKV tag, format "HH:MM:SS.nnnnnnnnn"
#
# Tier 3 is the most reliable for MKV sources: Matroska stores per-track duration
# in stream tags even when the standard duration field and Segment Duration are absent.
#
# Result is cached in _CACHED_SRC_DURATION_SECS after the first call — subsequent
# calls return instantly without jq forks. Source duration doesn't change mid-run.
#
# Globals: METADATA_CACHE (read), _CACHED_SRC_DURATION_SECS (read/write)
_get_source_duration_secs() {
  # Return cached result if available
  if [[ -n "$_CACHED_SRC_DURATION_SECS" ]]; then
    echo "$_CACHED_SRC_DURATION_SECS"
    return
  fi

  local dur="" result=0

  # Tier 1: standard stream-level duration (common in MP4, rare in MKV)
  dur="$(_jq_cache -r \
    '[.streams[] | select(.codec_type=="video")] | .[0].duration // empty' | head -n1)"
  if [[ "$dur" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    log "Duration source: stream duration = ${dur}s"
    result="$(LC_NUMERIC=C printf '%.0f' "$dur")"
  fi

  # Tier 2: container/format-level duration (most containers)
  if [[ "$result" == "0" ]]; then
    dur="$(_jq_cache -r \
      '.format.duration // empty' | head -n1)"
    if [[ "$dur" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      log "Duration source: format duration = ${dur}s"
      result="$(LC_NUMERIC=C printf '%.0f' "$dur")"
    fi
  fi

  # Tier 3: Matroska tags — DURATION as "HH:MM:SS.nnnnnnnnn"
  if [[ "$result" == "0" ]]; then
    local tag_dur
    tag_dur="$(_jq_cache -r \
      '[.streams[] | select(.codec_type=="video")] | .[0].tags.DURATION // empty' | head -n1)"
    if [[ "$tag_dur" =~ ^([0-9]+):([0-9]+):([0-9]+)(\.[0-9]+)?$ ]]; then
      local h="${BASH_REMATCH[1]}" m="${BASH_REMATCH[2]}" s="${BASH_REMATCH[3]}"
      result=$(( 10#$h * 3600 + 10#$m * 60 + 10#$s ))
      log "Duration source: Matroska tag DURATION = ${tag_dur} → ${result}s"
    fi
  fi

  [[ "$result" == "0" ]] && \
    log "Duration: unable to determine from stream, format, or Matroska tags — progress bar unavailable"

  _CACHED_SRC_DURATION_SECS="$result"
  echo "$result"
}

# Lowercase a string. For non-hot-path use where readability is preferred.
# Hot paths (per-stream loops in Sections 27–28) use ${var,,} directly to avoid fork overhead.
_lower(){ printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]'; }

# _jq_cache — Run jq against the cached METADATA_CACHE JSON.
# Absorbs stderr (jq errors) so callers don't need to redirect individually.
# All jq flags (-r, -e, etc.) and the filter expression are passed through.
# Usage: _jq_cache -r '.format.duration // empty'
#        _jq_cache -e '[.streams[] | …] | length > 0'
# Globals: METADATA_CACHE (read)
# Debug mode (DEBUG=1): logs filter, exit code, result, and any jq stderr to help
# diagnose probe failures. Uses a reusable temp file in WORKDIR to avoid per-call
# mktemp overhead; acceptable in debug mode where performance is not the priority.
_jq_cache() {
  if [[ "${DEBUG:-0}" != "1" ]]; then
    printf '%s\n' "$METADATA_CACHE" | jq "$@" 2>/dev/null
    return
  fi
  # Debug mode: capture stderr and log inputs/outputs for probe-failure diagnosis
  local _jq_out _jq_rc _jq_err
  local _jq_err_file="${WORKDIR:-/tmp}/jq_debug_err.tmp"
  _jq_out="$(printf '%s\n' "$METADATA_CACHE" | jq "$@" 2>"$_jq_err_file")"
  _jq_rc=$?
  _jq_err="$(<"$_jq_err_file" 2>/dev/null)"
  log "[jq_cache] filter: $*"
  log "[jq_cache] rc=${_jq_rc}  result=${_jq_out:0:300}"
  [[ -n "$_jq_err" ]] && log "[jq_cache] jq stderr: ${_jq_err:0:300}"
  printf '%s\n' "$_jq_out"
  return $_jq_rc
}

# Error handling strategy:
#   die()      — Called explicitly for expected failures (bad input, missing tool,
#                validation error). Sets FAILED/EXIT_CODE/FAIL_MSG and exits
#                immediately; the EXIT trap (on_exit) handles cleanup.
#   on_error() — ERR trap, fires on any unexpected non-zero exit under set -eEuo pipefail.
#                Sets the same globals but does NOT call exit; the shell exits
#                automatically after the ERR trap returns (due to set -e), which
#                then triggers on_exit for cleanup.
#   on_exit()  — EXIT trap that always runs. Reads FAILED/EXIT_CODE/FAIL_MSG to
#                decide whether to commit the output or clean up after failure.
die()  {
  local code=1
  if [[ $# -gt 1 && "$1" =~ ^[0-9]+$ ]]; then code="$1"; shift; fi
  # FAIL_MSG carries no "Fatal:" prefix (D7): the "❌ ERROR:" / "❌ Build FAILED" prefixes
  # already convey severity, and on_exit must not echo the cause a second time (see _ERROR_PRINTED).
  FAILED=1; EXIT_CODE="$code"; FAIL_MSG="$*"
  printf "${_PFX_ERR-❌ ERROR: }%s\n" "$FAIL_MSG" >&2
  [[ "${_LOG_READY:-0}" == "1" ]] || _log_buffer_mirror "${_PFX_ERR-❌ ERROR: }" "$FAIL_MSG"
  _ERROR_PRINTED=1   # the cause is now on screen; on_exit keeps its summary terse
  exit "$code"
}

on_error(){
  local lineno="$1" cmd="$2" status="$3"
  FAILED=1
  EXIT_CODE="$status"
  FAIL_MSG="Command failed at line $lineno: $cmd (exit $status)"
  printf "${_PFX_ERR-❌ ERROR: }%s\n" "$FAIL_MSG" >&2
  _ERROR_PRINTED=1   # cause printed here; on_exit will not echo it again (D7)
  # Note: This trap does not call exit directly. Under set -e, the shell
  # exits after the ERR trap returns, which triggers the EXIT trap (on_exit)
  # where FAILED/EXIT_CODE/FAIL_MSG are used for cleanup and reporting.
}

mark_done(){
  COMPLETED_STEPS+=("$1")
  # Log-only per-step timing (D8): elapsed since the previous completed step (or the §17
  # baseline) so the log shows where time went / where it hung. Cheap ($SECONDS, no fork).
  log "step \"$1\" done in $(( SECONDS - ${_STEP_T0:-0} ))s"
  _STEP_T0=$SECONDS
}

need(){
  command -v "$1" >/dev/null 2>&1 || die 10 "Missing required tool: $1"
}

# Cross-platform tool detection pattern used throughout this section:
# Several tools ship under different names or have different flag syntax on macOS
# (typically via Homebrew) vs Linux. The general approach is:
#   1. Try the macOS/Homebrew variant first (e.g., MP4Box, stat -f, sed -i '')
#   2. Fall back to the GNU/Linux variant (e.g., mp4box, stat -c, sed -i)
#   3. Fall back to POSIX-portable alternatives (e.g., wc -c instead of stat)
# Functions that implement this pattern: _detect_mp4box, realpath_fallback,
# filesize_pretty, write_checksum, _sed_inplace (Section 9).
#
# Audit notes (verified 2026-04-11):
#   - stat:      handled via BSD (-f%z) / GNU (-c%s) / gstat / wc fallback chain
#   - sed -i:    handled via _sed_inplace (BSD requires '', GNU does not)
#   - sed (pipe):non-inplace sed uses only POSIX s-commands; no -E flag or
#                GNU extensions — portable on both BSD/macOS and GNU/Linux
#   - date:      all calls use POSIX-compatible format strings (+%Y%m%d, etc.)
#   - mktemp:    template-argument form used (POSIX-compatible on BSD and GNU)
#   - grep:      only -i, -E, -o, -q, -v, -x, -F flags used (all POSIX-compatible)
#                RF10: -m is NON-POSIX and was redundant with -q, so it was removed; the grep
#                flag allow-list above is enforced by the unit suite (_test_unit_rf10_grep_flags).
#   - readlink:  not used; path resolution handled via realpath_fallback
#   - seq:       eliminated; replaced with _repeat_char (pure bash, fully portable)

# Detect mp4box binary (name varies: MP4Box on macOS Homebrew, mp4box on Linux).
# Sets global MP4BOX_CMD to the found binary name, or empty string if not found.
# Returns: 0 if found, 1 if not found
_detect_mp4box(){
  if command -v MP4Box >/dev/null 2>&1; then
    MP4BOX_CMD="MP4Box"
  elif command -v mp4box >/dev/null 2>&1; then
    MP4BOX_CMD="mp4box"
  else
    MP4BOX_CMD=""
    return 1
  fi
  return 0
}

# Improved realpath that handles non-existent files on all platforms.
# L9 note (left as-is, functionally inert): the BSD/no-realpath fallback below resolves the
# *directory* to canonical via `cd … && pwd` but does NOT canonicalize symlinks or `..` in the
# basename the way GNU `realpath -m` does for the whole path. Both call sites (SRC_ABS, OUT_ABS)
# operate on an existing file whose directory is cd-resolved, so the difference never surfaces;
# noted only so a future caller passing a symlinked/`..`-bearing basename knows the limitation.
realpath_fallback(){
  local p="$1"
  
  # Try GNU realpath with -m (allows missing files). Skip on macOS/BSD ($OSTYPE=darwin*), whose
  # realpath has no -m: the call always fails there, so probing it every time is pure overhead —
  # it just falls through to the portable resolver below. (Phase 5; perf only.)
  if [[ "$OSTYPE" != darwin* ]] && command -v realpath >/dev/null 2>&1; then
    if realpath -m "$p" 2>/dev/null; then
      return 0
    fi
  fi
  
  # Fallback for macOS/BSD and systems without realpath
  local dir base
  dir="$(dirname -- "$p")"
  base="$(basename -- "$p")"
  
  if [[ -d "$dir" ]]; then
    echo "$(cd "$dir" 2>/dev/null && pwd)/$base"
  elif [[ "$p" =~ ^/ ]]; then
    # Already absolute
    echo "$p"
  else
    # Make absolute from current directory
    echo "$PWD/$p"
  fi
}

# Improved filesize_pretty - outputs human-readable file size string to stdout.
# Composable: callers format/route the output (e.g., say "Size: $(filesize_pretty f)")
filesize_pretty(){
  local file="$1" bytes=""
  [[ -f "$file" ]] || { echo "unknown (file not found)"; return 1; }

  # Get raw byte count (try multiple methods for portability)
  if stat -f "%z" "$file" >/dev/null 2>&1; then
    bytes="$(stat -f "%z" "$file")"            # macOS / BSD
  elif stat -c "%s" "$file" >/dev/null 2>&1; then
    bytes="$(stat -c "%s" "$file")"            # GNU / Linux
  elif command -v gstat >/dev/null 2>&1; then
    bytes="$(gstat -c "%s" "$file")"           # Homebrew GNU stat
  elif command -v wc >/dev/null 2>&1; then
    bytes="$(wc -c < "$file" | tr -d ' ')"     # POSIX fallback
  fi

  if [[ -z "$bytes" || ! "$bytes" =~ ^[0-9]+$ ]]; then
    echo "unknown size"
    return 0
  fi

  # Human-readable formatting
  if (( bytes >= BYTES_PER_GIB )); then
    LC_NUMERIC=C printf '%.2f GB (%s bytes)\n' "$(echo "scale=2; $bytes/$BYTES_PER_GIB" | bc)" "$bytes"
  elif (( bytes >= BYTES_PER_MIB )); then
    LC_NUMERIC=C printf '%.1f MB (%s bytes)\n' "$(echo "scale=1; $bytes/$BYTES_PER_MIB" | bc)" "$bytes"
  elif (( bytes >= 1024 )); then
    LC_NUMERIC=C printf '%.0f KB\n' "$(echo "scale=0; $bytes/1024" | bc)"
  else
    printf '%s bytes\n' "$bytes"
  fi
}

write_checksum(){
  local file_path="$1"
  local -a cmd=()
  local ext spinner_msg

  case "${CHECKSUM_ALGO:-sha256}" in
    blake2b)
      if command -v b2sum >/dev/null 2>&1; then
        cmd=(b2sum); ext="b2"; spinner_msg="Computing BLAKE2b checksum"
      else
        warn "b2sum not found; cannot write BLAKE2b checksum"; return 0
      fi
      ;;
    auto)
      if command -v b2sum >/dev/null 2>&1; then
        cmd=(b2sum); ext="b2"; spinner_msg="Computing BLAKE2b checksum"
      elif command -v sha256sum >/dev/null 2>&1; then
        cmd=(sha256sum); ext="sha256"; spinner_msg="Computing SHA-256 checksum"
      elif command -v shasum >/dev/null 2>&1; then
        cmd=(shasum -a 256); ext="sha256"; spinner_msg="Computing SHA-256 checksum"
      else
        warn "Checksum tool not found"; return 0
      fi
      ;;
    sha256|*)
      if command -v sha256sum >/dev/null 2>&1; then
        cmd=(sha256sum)
      elif command -v shasum >/dev/null 2>&1; then
        cmd=(shasum -a 256)
      else
        warn "Checksum tool not found"; return 0
      fi
      ext="sha256"; spinner_msg="Computing SHA-256 checksum"
      ;;
  esac

  note "Writing checksum → ${file_path}.${ext}"
  "${cmd[@]}" "$file_path" > "${file_path}.${ext}" &
  local _cksum_pid=$!
  spinner "$_cksum_pid" "$spinner_msg"
  local _cksum_rc=0
  wait "$_cksum_pid" 2>/dev/null || _cksum_rc=$?
  if (( _cksum_rc != 0 )); then
    warn "Checksum computation failed (exit ${_cksum_rc}); removing partial file."
    rm -f "${file_path}.${ext}"
    return 1
  fi
}

# Validate that a media file exists, is non-empty, and is parseable by ffprobe.
# Two-step approach:
#   Step 1 — file must exist and have non-zero size (catches disk-full / write failure)
#   Step 2 — ffprobe must confirm a valid video stream is present (catches corrupt mux)
# Args: $1 — file path, $2 — context label for error message
# Dies on failure.
_validate_media_file(){
  local file="$1" label="${2:-output}"
  # Step 1: file exists and has non-zero size
  if [[ ! -s "$file" ]]; then
    _check_disk_full "$file"
    die 41 "$label produced empty file"
  fi
  # Step 2: ffprobe confirms a video stream is present (not just that the file is parseable)
  local _vcodec
  _vcodec="$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=codec_name -of csv=p=0 "$file" 2>/dev/null)" \
    || die 41 "$label produced unreadable file (ffprobe failed)"
  [[ -n "$_vcodec" ]] || die 41 "$label produced file with no video stream (ffprobe found: none)"
  log "[validate] $label: OK — video codec=${_vcodec}, size=$(filesize_pretty "$file")"
}

# _check_disk_full — inspect an ffmpeg error log (or a file path on a volume)
# for ENOSPC ("No space left on device") and emit a specific warning if found.
# Call this before die() when an ffmpeg command or file operation fails, so the
# user gets an actionable message instead of a generic "encode failed".
# Args: $1 — error log file path (or any file on the relevant volume)
# Globals: WORKDIR (read, for volume fallback)
_check_disk_full() {
  local errfile="${1:-}"
  # Check error log text first (most reliable — ffmpeg prints the OS error)
  if [[ -f "$errfile" ]] && grep -q "No space left on device" "$errfile" 2>/dev/null; then
    warn "Disk full: 'No space left on device' detected — free space on the output volume and retry."
    return 0
  fi
  # Fallback: check available space on the workdir volume directly
  local avail_kb=""
  local check_dir="${WORKDIR:-${OUT_DIR:-.}}"
  avail_kb="$(df -Pk "$check_dir" 2>/dev/null | awk 'NR==2{print $4}')"
  if [[ -n "$avail_kb" ]] && (( avail_kb < 1024 )); then
    warn "Disk full: less than 1 MB free on temp volume ($check_dir) — free space and retry."
  fi
}

# Check if ffmpeg supports a given muxer (e.g., "vobsub" — missing on macOS Homebrew).
# Args: $1 — muxer name
# Returns: 0 if supported, 1 otherwise
ffmpeg_has_muxer(){
  local mux="$1"
  # Muxer name is the 2nd field; $1 is the D./.E capability-flag column.
  # (Matching $1 made this always return false, so the vobsub PGS fast-path
  # below was never taken and a spurious "lacks vobsub muxer" warning fired.)
  ffmpeg -hide_banner -muxers 2>/dev/null | awk -v m="$mux" '$2==m{f=1} END{exit !f}'
}

# Validate ffmpeg/ffprobe log level values.
# Used by config-file validation (Section 6) and CLI parsing (Section 12).
is_valid_loglevel(){
  case "$1" in
    quiet|panic|fatal|error|warning|info|verbose|debug|trace) return 0;;
    *) return 1;;
  esac
}
# M-DRY-c: human-readable valid-loglevel list for "Valid values: …" die messages, hand-kept in
# sync with is_valid_loglevel's case above (a unit drift-guard asserts every entry here passes
# is_valid_loglevel and that the counts match). Single source for the four error messages.
readonly _VALID_LOGLEVEL_STR="quiet, panic, fatal, error, warning, info, verbose, debug, trace"

# Validate HW_ACCEL values (used by .muxmrc validation + CLI parsing).
# Accepted: none | auto | videotoolbox | nvenc
is_valid_hw_accel(){
  case "$1" in
    none|auto|videotoolbox|nvenc) return 0;;
    *) return 1;;
  esac
}

# is_apple_silicon — true on arm64 Darwin (M-series and beyond).
is_apple_silicon(){
  [[ "$(uname -s 2>/dev/null)" == "Darwin" ]] && [[ "$(uname -m 2>/dev/null)" == "arm64" ]]
}

# ffmpeg_has_encoder — returns 0 if ffmpeg reports the named encoder.
# Args: $1 — encoder name as listed by `ffmpeg -encoders` (e.g. hevc_videotoolbox).
# Safe to call before tool validation: if ffmpeg is absent, the cache is empty and grep returns 1.
# The encoder list is invariant for the life of the process, so it is fetched once and memoized —
# previously each call (HW detection, AV1 gating) re-spawned `ffmpeg -encoders` (large output).
_FFMPEG_ENCODERS_CACHE=""
_FFMPEG_ENCODERS_CACHED=0
ffmpeg_has_encoder(){
  local name="$1"
  [[ -n "$name" ]] || return 1
  if (( ! _FFMPEG_ENCODERS_CACHED )); then
    _FFMPEG_ENCODERS_CACHE="$(ffmpeg -hide_banner -encoders 2>/dev/null | awk '{print $2}')"
    _FFMPEG_ENCODERS_CACHED=1
  fi
  grep -qx "$name" <<<"$_FFMPEG_ENCODERS_CACHE"
}

# _preflight_sw_video_encoder — when the run will use the software x26x encoder (VIDEO_CODEC is
# libx265/libx264 and no hardware backend resolved), verify ffmpeg actually has it and die 10 with
# an install hint — the same fail-fast treatment the AV1 and hardware encoders already get above.
# Without this, a stripped ffmpeg build lacking libx265 proceeds all the way to the encode and
# fails mid-stream at die 40 instead of cleanly at preflight (M5). No-op for AV1/hardware paths.
# Reads: VIDEO_CODEC, HW_ACCEL_RESOLVED.
_preflight_sw_video_encoder() {
  [[ "$VIDEO_CODEC" == "libx265" || "$VIDEO_CODEC" == "libx264" ]] || return 0
  [[ "${HW_ACCEL_RESOLVED:-none}" == "none" ]] || return 0   # HW path uses hevc_videotoolbox/etc.
  ffmpeg_has_encoder "$VIDEO_CODEC" && return 0
  die 10 "${VIDEO_CODEC} encoder not available in this ffmpeg build. Install a complete ffmpeg (e.g., brew install ffmpeg-full, or run muxm --install-dependencies)."
}

# _ffmpeg_bin_is_complete — true if the given ffmpeg binary has every capability muxm's full
# feature set needs: libass (subtitle burn-in) + libsvtav1 + libaom-av1 (both AV1 encoders,
# including --video-codec libaom-av1). The single definition of "complete" used by both the
# installer (_ensure_ffmpeg_full) and the runtime preference (_prefer_complete_ffmpeg).
# Args: $1 — ffmpeg binary (name on PATH or absolute path).
_ffmpeg_bin_is_complete(){
  local _b="$1" _enc
  "$_b" -version 2>/dev/null | grep -q -- "--enable-libass" || return 1
  _enc="$("$_b" -hide_banner -encoders 2>/dev/null | awk '{print $2}')"
  printf '%s\n' "$_enc" | grep -qx 'libsvtav1'  || return 1
  printf '%s\n' "$_enc" | grep -qx 'libaom-av1' || return 1
  return 0
}

# _prefer_complete_ffmpeg — when the ffmpeg on PATH lacks libass/AV1, make muxm use a complete
# build. `brew install ffmpeg-full` (what --install-dependencies installs) is keg-only, so Homebrew
# does NOT symlink it onto PATH; this prepends its keg bin so every ffmpeg/ffprobe call muxm makes
# uses it. Cost is near-zero on the common paths: it returns before any -encoders probe unless an
# ffmpeg-full keg exists AND the active ffmpeg is neither that keg nor otherwise complete. A
# complete custom ffmpeg already on PATH is left untouched. Emits a normal-verbosity note when it
# switches, so `which ffmpeg` and the ffmpeg muxm actually runs never silently diverge (the F5
# "says == does" guarantee). Called once, at the top of tool validation (Section 14).
_prefer_complete_ffmpeg(){
  local _kb _kegbin=""
  # Locate an ffmpeg-full keg bin via known opt paths (avoids a slow `brew --prefix` at startup).
  for _kb in "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/ffmpeg-full/bin" \
             /opt/homebrew/opt/ffmpeg-full/bin \
             /usr/local/opt/ffmpeg-full/bin \
             /home/linuxbrew/.linuxbrew/opt/ffmpeg-full/bin; do
    if [[ -x "$_kb/ffmpeg" ]]; then _kegbin="$_kb"; break; fi
  done
  [[ -n "$_kegbin" ]] || return 0
  # Fast path: the keg is already the active ffmpeg (string match — skips the -encoders probe on
  # the common case, so this stays cheap across the whole test suite / repeated invocations).
  [[ "$(command -v ffmpeg 2>/dev/null)" == "$_kegbin/ffmpeg" ]] && return 0
  # A complete custom ffmpeg on PATH is authoritative — leave it (capability check, not path).
  if command -v ffmpeg >/dev/null 2>&1 && _ffmpeg_bin_is_complete ffmpeg; then return 0; fi
  # Prefer the keg only if it is genuinely complete (never switch to a broken keg).
  _ffmpeg_bin_is_complete "$_kegbin/ffmpeg" || return 0
  export PATH="$_kegbin:$PATH"
  note "Using ffmpeg-full for libass/AV1 support: $_kegbin (keg-only — not on your default PATH)."
}

# detect_hw_accel — populate HW_ACCEL_AVAILABLE from ffmpeg's encoder list
# and resolve HW_ACCEL="auto" to a concrete backend when possible.
#
# Non-fatal probe: when HW_ACCEL is set to an explicit backend that is not
# available, HW_ACCEL_RESOLVED is left as "none" and the strict check in
# Section 14 dies with a precise error. This mirrors the AV1 encoder pattern
# (Section 14 strict check at the point of use), so --print-effective-config
# can still run even when ffmpeg is missing or lacks the requested backend.
#
# Phase 1 scope: detection + resolution only. No encoder dispatch change.
# Phase 2 adds VideoToolbox parameter builders; Phase 3 adds NVENC.
#
# Sets:
#   HW_ACCEL_AVAILABLE[]  — subset of {videotoolbox, nvenc}
#   HW_ACCEL_RESOLVED     — concrete backend name, or "none"
# Reads:
#   HW_ACCEL              — user/config/CLI-selected backend
detect_hw_accel(){
  HW_ACCEL_AVAILABLE=()

  # VideoToolbox is Apple Silicon only in practice; probe on Darwin hosts.
  if is_apple_silicon && ffmpeg_has_encoder hevc_videotoolbox; then
    HW_ACCEL_AVAILABLE+=("videotoolbox")
  fi
  # NVENC availability is detected purely by encoder presence (cross-platform).
  if ffmpeg_has_encoder hevc_nvenc; then
    HW_ACCEL_AVAILABLE+=("nvenc")
  fi

  case "$HW_ACCEL" in
    none)
      HW_ACCEL_RESOLVED="none"
      ;;
    auto)
      # Prefer platform-native backend first (videotoolbox on macOS, then nvenc).
      if [[ " ${HW_ACCEL_AVAILABLE[*]} " == *" videotoolbox "* ]]; then
        HW_ACCEL_RESOLVED="videotoolbox"
      elif [[ " ${HW_ACCEL_AVAILABLE[*]} " == *" nvenc "* ]]; then
        HW_ACCEL_RESOLVED="nvenc"
      else
        HW_ACCEL_RESOLVED="none"
        note "Hardware acceleration 'auto' requested but no supported encoder is available — falling back to software."
      fi
      ;;
    videotoolbox|nvenc)
      # Non-fatal: if explicit backend is missing, leave HW_ACCEL_RESOLVED="none".
      # Section 14 runs a strict check and dies with a precise error message.
      if [[ " ${HW_ACCEL_AVAILABLE[*]} " == *" $HW_ACCEL "* ]]; then
        HW_ACCEL_RESOLVED="$HW_ACCEL"
      else
        HW_ACCEL_RESOLVED="none"
      fi
      ;;
    *)
      die 11 "Invalid HW_ACCEL=\"$HW_ACCEL\" (internal). Valid values: none, auto, videotoolbox, nvenc"
      ;;
  esac
}

# _normalize_codec_lang — lowercase codec and lang in-place; default lang to
# TAG_LANGUAGE_DEFAULT when empty. Uses namerefs so callers can pass any variable names.
# Args: $1 — name of codec variable, $2 — name of lang variable
# Globals: TAG_LANGUAGE_DEFAULT (read)
_normalize_codec_lang() {
  local -n _ncl_c=$1 _ncl_l=$2
  _ncl_c="${_ncl_c,,}"
  _ncl_l="${_ncl_l,,}"
  if [[ -z "$_ncl_l" ]]; then _ncl_l="$TAG_LANGUAGE_DEFAULT"; fi
}

# _log_dropped_tracks — emit each entry in a dropped-reasons array to the log file.
# Args: $1 — label string (e.g. "multi-track"), $2 — name of dropped_reasons array (nameref)
_log_dropped_tracks() {
  local _ldt_label="$1"
  local -n _ldt_reasons=$2
  if (( ${#_ldt_reasons[@]} > 0 )); then
    local _ldt_r
    for _ldt_r in "${_ldt_reasons[@]}"; do
      log "  [$_ldt_label] Dropped $_ldt_r"
    done
  fi
}

# _source_label — human-readable label for a subtitle source entry.
# Embedded streams produce "#N"; external files produce their basename.
# Args: $1 — source string ("embedded:N" or "ext:/abs/path")
_source_label() {
  local _sl_src="$1"
  if [[ "$_sl_src" == embedded:* ]]; then
    echo "#${_sl_src#embedded:}"
  else
    basename -- "${_sl_src#ext:}"
  fi
}

# _check_filter_ideality — call a keep-list builder and set ideal=0 if any tracks
# are dropped. Used by check_skip_if_ideal to avoid duplicated counting logic.
# Args: $1 — stream type label (e.g. "audio"), $2 — builder fn name,
#        $3 — count fn name, $4 — nameref to ideal variable, $5 — nameref to reason variable
_check_filter_ideality() {
  local _cfi_label="$1" _cfi_builder="$2" _cfi_counter="$3"
  local -n _cfi_ideal=$4 _cfi_reason=$5
  local _cfi_keep
  _cfi_keep="$("$_cfi_builder")"
  local -a _cfi_keep_arr
  read -r -a _cfi_keep_arr <<< "$_cfi_keep"
  local _cfi_n_keep="${#_cfi_keep_arr[@]}"
  local _cfi_n_total
  _cfi_n_total="$("$_cfi_counter")"
  if [[ "$_cfi_n_keep" != "$_cfi_n_total" ]]; then
    _cfi_ideal=0
    _cfi_reason="$_cfi_label filter would drop $(( _cfi_n_total - _cfi_n_keep )) of $_cfi_n_total tracks"
  fi
}

# ===== Section 6: Config chain: Defaults → /etc → ~ → project =================================
# Config files are sourced as shell scripts — they can execute arbitrary code.
# Security note: The project-level ./.muxmrc is sourced from $PWD intentionally.
# A malicious .muxmrc placed in a directory the user cd's into could execute
# arbitrary commands. This is the same trust model as .envrc (direnv), Makefile,
# etc. — standard for developer tooling. See README.md (Config Chain section)
# and docs/config_profile.md for profile behavior details.
# Source a config file if it exists and is readable. Tracks loaded files for diagnostics.
# Args: $1 — file path
# Globals: MUXM_CONFIG_LOADED (modified)
_muxm_try_source(){
  local f="$1"
  [[ -r "$f" ]] || return 0
  # shellcheck disable=SC1090
  . "$f"
  MUXM_CONFIG_LOADED+=("$f")
}
