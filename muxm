# Dispatcher
apply_profile() {
  [[ -z "${PROFILE_NAME:-}" ]] && return 0
  # Resolve deprecated aliases before dispatch (L4: single normalisation path).
  _normalize_profile PROFILE_NAME
  case "$PROFILE_NAME" in
    archive)                     apply_profile_archive ;;
    hdr10-hq)                    apply_profile_hdr10_hq ;;
    atv-directplay-hq)           apply_profile_atv_directplay_hq ;;
    atv-directplay-animation)    apply_profile_atv_directplay_animation ;;
    streaming-hevc)              apply_profile_streaming_hevc ;;
    av1-hq)                      apply_profile_av1_hq ;;
    streaming-av1)               apply_profile_streaming_av1 ;;
    animation)                   apply_profile_animation ;;
    universal)                   apply_profile_universal ;;
    youtube-upload)              apply_profile_youtube_upload ;;
    *)
      die 11 "Unknown profile: $PROFILE_NAME
   Valid profiles: $(_valid_profiles_display)"
      ;;
  esac
  note "Applied profile: $PROFILE_NAME (source: ${_PROFILE_SOURCE:-unknown})"
}

# _create_config_prescan — Pre-scan CLI args for --create-config/--force-create-config before full parsing.
#
# Scans "$@" for the config-generation flags, then calls _create_config and
# exits. Must run after profile apply functions are defined so the config
# generator can invoke them. Halts all other operations if the flag is found.
#
# Args: "$@" — the raw CLI arguments passed to main.
# Returns: exits 0 after writing config; returns normally (no-op) if flag absent.
# Globals: PROFILE_NAME (read)
_create_config_prescan() {
  local _cc_force=0 _cc_scope="" _cc_profile="" _cc_found=0 _cc_i=0
  local -a _cc_args=("$@")
  while (( _cc_i < ${#_cc_args[@]} )); do
    case "${_cc_args[$_cc_i]}" in
      --)
        # End-of-options: a --create-config after -- is a positional, not the flag.
        break
        ;;
      --create-config|--force-create-config)
        _cc_found=1
        [[ "${_cc_args[$_cc_i]}" == "--force-create-config" ]] && _cc_force=1
        # Next arg must be scope
        if (( _cc_i + 1 >= ${#_cc_args[@]} )); then
          die 11 "${_cc_args[$_cc_i]} requires a scope: system, user, or project
   Usage: muxm ${_cc_args[$_cc_i]} <system|user|project> [profile]"
        fi
        _cc_scope="${_cc_args[$((_cc_i + 1))]}"
        # Optional: profile as third arg (only if it doesn't start with -)
        if (( _cc_i + 2 < ${#_cc_args[@]} )) && [[ "${_cc_args[$((_cc_i + 2))]}" != -* ]]; then
          _cc_profile="${_cc_args[$((_cc_i + 2))]}"
        fi
        break
        ;;
    esac
    _cc_i=$((_cc_i + 1))
  done
  if (( _cc_found )); then
    # Collect any remaining args after scope+profile as config override flags
    local _cc_override_start
    if [[ -n "$_cc_profile" ]]; then
      _cc_override_start=$(( _cc_i + 3 ))
    else
      _cc_override_start=$(( _cc_i + 2 ))
    fi
    local -a _cc_override_args=()
    local _cc_oi=$(( _cc_override_start ))
    while (( _cc_oi < ${#_cc_args[@]} )); do
      _cc_override_args+=("${_cc_args[$_cc_oi]}")
      _cc_oi=$(( _cc_oi + 1 ))
    done
    _create_config "$_cc_scope" "$_cc_profile" "$_cc_force" ${_cc_override_args[@]+"${_cc_override_args[@]}"}
    # _create_config always exits; this line is unreachable
  fi
}
_create_config_prescan "$@"

apply_profile

# _probe_profile_ext PROFILE — return the OUTPUT_EXT that apply_profile_PROFILE sets.
# `local OUTPUT_EXT="mp4"` only gives a clean default to read back — apply_profile_* also mutates
# many OTHER globals (CRF_VALUE, VIDEO_CODEC, …). The real isolation is the command-substitution
# SUBSHELL at the call site ("$(_probe_profile_ext …)"); callers must invoke it that way. (Phase 5)
_probe_profile_ext() {
  local OUTPUT_EXT="mp4"
  "apply_profile_${1//-/_}" 2>/dev/null || true
  echo "${OUTPUT_EXT}"
}

# _run_multi_profiles — multi-profile dispatch.
# Called when _MULTI_PROFILE_MODE=1 (--profile a,b,c detected in prescan).
# Re-invokes the script once per profile as a subprocess, deriving a per-profile
# output path automatically. Each subprocess gets its own fresh variable state.
#
# Args: none (reads _MULTI_PROFILES, _ORIG_FILTERED_ARGS, SRC_ABS, POSITIONALS)
# Exits: 0 if all profiles succeed; 1 if any failed.
_run_multi_profiles() {
  local -i _total=${#_MULTI_PROFILES[@]}
  local -a _results=()
  local -i _fail_count=0
  local _src_stem="${SRC_ABS%.*}"
  local _src_ext="${SRC_ABS##*.}"

  # Determine output stem base (full path prefix used for per-profile file names).
  # If the user supplied an explicit output filename as the second positional arg,
  # extract its stem and directory; otherwise fall back to the source stem.
  local _out_stem_full
  local -i _user_provided=0
  if [[ ${#POSITIONALS[@]} -ge 2 && -n "${POSITIONALS[1]}" ]]; then
    local _user_out="${POSITIONALS[1]}"
    local _user_dir _user_base _user_stem
    _user_dir="$(dirname "$_user_out")"
    _user_base="$(basename "$_user_out")"
    _user_stem="${_user_base%.*}"
    local _user_ext="${_user_base##*.}"
    # Normalise and keep only recognised container extensions
    _user_ext="${_user_ext,,}"
    [[ "$_user_ext" =~ ^(mp4|m4v|mov|mkv)$ ]] || _user_ext=""
    _out_stem_full="${_user_dir}/${_user_stem}"
    _user_provided=1
  else
    _out_stem_full="$_src_stem"
  fi

  # Build child flag args: _ORIG_FILTERED_ARGS with the source/output positionals
  # removed by VALUE, not by position. The CLI parser does NOT require positionals to be
  # trailing — `muxm <src> --crf 20 --profile a,b` puts the source first — so slicing off
  # the last ${#POSITIONALS[@]} elements would strip flag values instead, corrupting the
  # child invocation ("Too many arguments" / a flag left without its value). Each child is
  # re-invoked with the source (and per-profile output) re-appended after the injected
  # --profile/--output-ext below, so _child_flags must contain ONLY flags.
  local -a _child_flags=()
  local -a _pos_pending=("${POSITIONALS[@]}")   # multiset of positional values to drop
  local _ofa _ppi _dropped
  local -i _skip_next=0
  for _ofa in "${_ORIG_FILTERED_ARGS[@]}"; do
    # RF5: strip the user's --output-ext (and its value) here — the per-profile --output-ext is
    # injected at the child invocation below, and it comes BEFORE _child_flags, so a retained user
    # value would re-override it in the child parser (last --output-ext wins) and mislabel the
    # container (file named .archive.mkv but actually MP4). The user's intent is instead honored by
    # making OUTPUT_EXT the per-profile ext for EVERY profile (see _OUTPUT_EXT_EXPLICIT below).
    # (muxm's parser has no --flag=value form, so the space-separated pair is the only case.)
    if (( _skip_next )); then _skip_next=0; continue; fi
    if [[ "$_ofa" == "--output-ext" ]]; then _skip_next=1; continue; fi
    _dropped=0
    for _ppi in "${!_pos_pending[@]}"; do
      if [[ "$_ofa" == "${_pos_pending[$_ppi]}" ]]; then
        unset '_pos_pending[$_ppi]'   # remove one occurrence per positional
        _dropped=1
        break
      fi
    done
    (( _dropped )) || _child_flags+=("$_ofa")
  done

  # Pre-compute per-profile extensions and output paths (needed for warning + invocation).
  local -a _prof_exts=()
  local -a _child_outs=()
  local _mp _prof_ext
  for _mp in "${_MULTI_PROFILES[@]}"; do
    if (( _OUTPUT_EXT_EXPLICIT )); then
      # RF5: an explicit CLI --output-ext applies to EVERY profile, so the per-profile filename
      # and the child's actual container always agree. This mirrors single-profile behavior, where
      # an explicit --output-ext overrides the profile's natural container. (In multi-profile mode
      # _resolve_output_and_sub_policy is skipped, so OUTPUT_EXT here is exactly the user's CLI
      # value — not the output-filename inference, which the per-child resolution handles.)
      _prof_ext="$OUTPUT_EXT"
    else
      _prof_ext="$(_probe_profile_ext "$_mp")"
      # Passthrough profiles (atv-directplay-hq, atv-directplay-animation) set OUTPUT_EXT=""
      # — fall back to the user extension (if an explicit output filename with a recognised
      # container extension was given) or the source extension. (archive now forces MKV, so
      # it returns a concrete ext here and never takes this fallback.)
      if [[ -z "$_prof_ext" ]]; then
        if (( _user_provided )) && [[ -n "${_user_ext:-}" ]]; then
          _prof_ext="$_user_ext"
        else
          _prof_ext="$_src_ext"
        fi
      fi
    fi
    _prof_ext="${_prof_ext,,}"
    _prof_exts+=("$_prof_ext")
    _child_outs+=("${_out_stem_full}.${_mp}.${_prof_ext}")
  done

  # If the user supplied an explicit output filename, warn that it will be split
  # into per-profile files before the first encode starts.
  if (( _user_provided )); then
    warn "Multi-profile mode: output will be split into per-profile files:"
    local _co
    for _co in "${_child_outs[@]}"; do
      printf "     %s\n" "$_co" >&2
    done
  fi

  local -i _idx=0
  for _mp in "${_MULTI_PROFILES[@]}"; do
    _idx=$((_idx + 1))

    # Header per profile pass
    printf "━━━ Profile %d/%d: %s ━━━\n" "$_idx" "$_total" "$_mp" >&2

    _prof_ext="${_prof_exts[$((_idx-1))]}"
    local _child_out="${_child_outs[$((_idx-1))]}"

    # Re-invoke muxm for this profile
    local -i _child_rc=0
    "$0" --profile "$_mp" --output-ext "$_prof_ext" \
      ${_child_flags[@]+"${_child_flags[@]}"} "$SRC_ABS" "$_child_out" || _child_rc=$?

    if (( _child_rc == 0 )); then
      _results+=("${_mp}:PASS")
    else
      _results+=("${_mp}:FAIL:${_child_rc}")
      _fail_count=$((_fail_count + 1))
      warn "Profile '${_mp}' failed (exit ${_child_rc}) — continuing with remaining profiles."
    fi
  done

  # Per-profile summary
  printf "\n" >&2
  say "Multi-profile summary:"
  for _r in "${_results[@]}"; do
    local _rp="${_r%%:*}" _rs="${_r#*:}"
    if [[ "$_rs" == "PASS" ]]; then
      say "  ✅ ${_rp}: PASS"
    else
      say "  ❌ ${_rp}: FAIL (exit ${_rs#*:})"
    fi
  done

  return $(( _fail_count > 0 ? 1 : 0 ))
}

# ===== Section 12: CLI parsing =================================================================
if [[ -n "$OUTPUT_EXT" ]]; then
  USAGE_SHORT="Usage: ${CLI_NAME} [options] <source> [target.${OUTPUT_EXT}]"
else
  USAGE_SHORT="Usage: ${CLI_NAME} [options] <source> [target.{src-ext}]"
fi
print_usage(){
  cat <<EOF
${APP_NAME} v${VERSION} — ${CLI_NAME}

$USAGE_SHORT

Profiles (--profile NAME):
  archive                    Remux-first archival. DV + HDR10, multi-track. MKV (lossless).
  hdr10-hq                   Strip DV, keep HDR10. CRF 17, lossless audio. MKV.
  atv-directplay-hq          Apple TV Direct Play. DV-aware, E-AC-3. Passthrough container.
  atv-directplay-animation   ATV Direct Play, animation quality. CRF 16, E-AC-3, ASS subs. Passthrough container.
  streaming-hevc             HEVC CRF 20 for Plex/Jellyfin. HDR10, E-AC-3. MP4.
  av1-hq                     AV1 CRF 28/24 (res-aware), lossless audio. HDR10, MKV.
  streaming-av1              AV1 CRF 30/28 (res-aware), Opus audio. Optimized for AV1-capable platforms. MP4.
  animation                  Anime/cartoon. CRF 16, lossless audio, ASS subs. MKV.
  universal                  H.264 SDR, AAC stereo. Lean, play anywhere. MP4.
  youtube-upload             H.264 high-profile CRF 16. Best-scored audio (surround allowed), soft forced subs. MP4.

Common options:
  -h, --help                  Show this help
  -V, --version               Show version
  --profile NAME[,NAME...]    Apply a format profile (overrides config defaults). Comma-
                              separate names to run each as a full separate pass; cost
                              scales linearly with the number of profiles (no shared decode).
  --crf N                     Video quality (default: ${CRF_VALUE})
  -p, --preset NAME           x265 preset (default: ${PRESET_VALUE})
  --hw-accel BACKEND          Hardware acceleration: none | auto | videotoolbox | nvenc
                              (macOS Apple VideoToolbox only; on Linux, software fallback)
                              (default: ${HW_ACCEL}; also accepted in .muxmrc as HW_ACCEL="...")
  --hw-accel-quality N        Override VT/NVENC quality knob (0-100, default: profile-calibrated)
  --no-hw-accel-allow-sw      Disallow VT's internal software fallback (default: allowed)
  --dry-run                   Plan steps without encoding
  --workdir DIR               Stage temp intermediates under DIR (e.g. a roomier volume)
  --setup                     Install dependencies, man page, and completions
  --create-config {system|user|project} [PROFILE]
                              Generate a .muxmrc config file

See muxm(1) for the full option reference, profiles, and examples.
  First run: muxm --setup
  Then:      man muxm

Quick start:
