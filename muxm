MAX_COPY_BITRATE=""
# Tone-map HDR→SDR (universal profile)
declare -i TONEMAP_HDR_TO_SDR=0
TONEMAP_FILTER='zscale=t=linear:npl=100,format=gbrpf32le,zscale=p=bt709,tonemap=tonemap=hable:desat=0,zscale=t=bt709:m=bt709:r=tv,format=yuv420p'
# Force all audio to a specific codec (e.g., "aac" for universal; "" = auto)
AUDIO_FORCE_CODEC=""
AUDIO_FORCE_BITRATE=""    # Override the bitrate for any transcoded non-lossless audio output (D3)
# Allow lossless audio codecs (TrueHD, DTS-HD MA, FLAC) to pass through untouched
declare -i AUDIO_LOSSLESS_PASSTHROUGH=0
