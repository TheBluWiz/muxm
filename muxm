}

print_version(){ echo "${APP_NAME} v${VERSION} (${CLI_NAME})"; }

is_valid_preset(){
  case "$1" in
    ultrafast|superfast|veryfast|faster|fast|medium|slow|slower|veryslow|placebo) return 0;;
    *) return 1;;
  esac
}

# L10: die clearly when a value-taking flag receives another flag as its value.
# Empty-string values are allowed (some flags use "" as "no filter").
_require_val(){
  # Args: $1 = flag name, $2 = remaining arg count ($# at the call site), $3 = value.
  # Passing $# lets us detect a value-flag used as the FINAL token (no value follows):
  # the old 2-arg form read a missing $2 afterward and crashed with "$2: unbound
  # variable" under `set -u`. argc>=2 means the flag itself plus a value are present.
  local _flag="$1" _argc="${2:-0}" _val="${3:-}"
  (( _argc >= 2 )) || die 11 "$_flag requires a value"
  [[ "$_val" == -* ]] && die 11 "$_flag requires a value, not a flag (got: $_val)"
  return 0
}

# Parse-time validators for the numeric/rate value flags (L3). These reject obvious garbage at
# parse time — the same robustness the CLI already gives CRF — instead of letting it slip through
# to a mid-encode ffmpeg failure (die 40). Framing is validation-consistency, not security: the
# user owns their own command line. A sourced .muxmrc bypasses these (it assigns the globals
# directly), so the matching globals are re-validated after config load in Section 15.
# Args: $1 = flag name (for the message), $2 = the value.
_validate_level_arg(){ [[ "$2" =~ $_RE_LEVEL ]]   || die 11 "Invalid $1 '$2': expected a numeric H.265/H.264 level like 5.1 or 4.0."; }
_validate_rate_arg(){  [[ "$2" =~ $_RE_BITRATE ]] || die 11 "Invalid $1 '$2': expected a bitrate like 20000k, 5M, or a plain integer (bits/s)."; }
# L4: reject an unknown --audio-force-codec encoder at parse time (die 11) instead of letting an
# encoder muxm can't name an intermediate for surface as a cryptic late die 43 after track scanning.
# SYNC: this allow-list must stay in step with the real (non-fallback) arms of _audio_codec_ext —
# every accepted encoder must resolve to a valid intermediate extension there. `alac` is deliberately
# NOT accepted: it is lossless-copyable but has no _audio_codec_ext arm, so forcing a transcode to it
# would still die 43 — failing fast here is strictly better. (Profile- or .muxmrc-supplied values
# bypass this CLI arm, matching the existing _validate_rate_arg/_validate_level_arg scope.)
_validate_force_codec_arg(){
  case "$2" in
    libopus|libmp3lame|libvorbis|aac|libfdk_aac|aac_at|ac3|eac3|flac) return 0 ;;
    *) die 11 "Invalid $1 '$2': unknown audio encoder. Valid: libopus, libmp3lame, libvorbis, aac, libfdk_aac, aac_at, ac3, eac3, flac." ;;
  esac
}

POSITIONALS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) print_usage; exit 0 ;;
    -V|--version) print_version; exit 0 ;;

    --print-effective-config) PRINT_EFFCONF=1; shift ;;

    -k|--keep-temp) KEEP_TEMP=1; shift ;;
    -K|--keep-temp-always) KEEP_TEMP_ALWAYS=1; shift ;;
    --keep-log) KEEP_LOG=1; shift ;;
    --quiet)   VERBOSITY="quiet";   _VERBOSITY_N=0; shift ;;
    --verbose) VERBOSITY="verbose"; _VERBOSITY_N=2; shift ;;
    --no-color) USE_COLOR=0; _PFX_NOTE=""; _PFX_WARN="Warning: "; _PFX_ERR="ERROR: "; _PFX_FAIL=""; shift ;;

    --dry-run) DRY_RUN=1; shift ;;
    --checksum) CHECKSUM=1; shift ;;
    --no-checksum) CHECKSUM=0; shift ;;
    --checksum-algo) _require_val "$1" "$#" "${2:-}"; CHECKSUM_ALGO="$2"; CHECKSUM=1; shift 2 ;;
    --disk-check) DISK_CHECK=1; shift ;;
    --no-disk-check) DISK_CHECK=0; shift ;;

    --ffmpeg-loglevel)
      _require_val "$1" "$#" "${2:-}"; FFMPEG_LOGLEVEL="$2"
      is_valid_loglevel "$FFMPEG_LOGLEVEL" || die 11 "Invalid --ffmpeg-loglevel: \"$FFMPEG_LOGLEVEL\". Valid values: ${_VALID_LOGLEVEL_STR}"
      shift 2 ;;
    --no-hide-banner) FFMPEG_HIDE_BANNER=0; shift ;;
    --no-overwrite) FFMPEG_OVERWRITE=0; shift ;;
    --ffprobe-loglevel)
      _require_val "$1" "$#" "${2:-}"; FFPROBE_LOGLEVEL="$2"
      is_valid_loglevel "$FFPROBE_LOGLEVEL" || die 11 "Invalid --ffprobe-loglevel: \"$FFPROBE_LOGLEVEL\". Valid values: ${_VALID_LOGLEVEL_STR}"
      shift 2 ;;
    --threads)
      _require_val "$1" "$#" "${2:-}"
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || die 11 "Invalid --threads: \"$2\". Must be a positive integer (number of CPU threads/cores; e.g. 4)."
      THREADS="$2"; _CLI_THREADS_EXPLICIT=1; shift 2 ;;
    --workdir) _require_val "$1" "$#" "${2:-}"; WORKDIR_BASE="$2"; shift 2 ;;

    --crf)
      _require_val "$1" "$#" "${2:-}"; _crf_in="$2"
      if [[ ! "$_crf_in" =~ ^[0-9]+$ ]] || (( 10#$_crf_in > 51 )); then
        die 11 "Invalid --crf: integer 0–51 expected (got: ${_crf_in})"
      fi
      CRF_VALUE="$_crf_in"; _CLI_CRF_EXPLICIT=1; shift 2 ;;
    -p|--preset)
      _require_val "$1" "$#" "${2:-}"; PRESET_VALUE="$2"; _CLI_PRESET_EXPLICIT=1
      is_valid_preset "$PRESET_VALUE" || die 11 "Invalid preset: $PRESET_VALUE. Valid presets: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow, placebo."
      shift 2
      ;;
    --x265-params) _require_val "$1" "$#" "${2:-}"; X265_PARAMS_BASE="$2"; _CLI_X265_PARAMS_EXPLICIT=1; shift 2 ;;
    --x264-params) _require_val "$1" "$#" "${2:-}"; X264_PARAMS_BASE="$2"; _CLI_X264_PARAMS_EXPLICIT=1; shift 2 ;;
    --av1-params)  _require_val "$1" "$#" "${2:-}"; SVT_AV1_PARAMS_BASE="$2"; _CLI_AV1_PARAMS_EXPLICIT=1; shift 2 ;;
    --av1-maxrate) _require_val "$1" "$#" "${2:-}"; _validate_rate_arg "$1" "$2"; AV1_MAXRATE="$2"; shift 2 ;;
    --av1-bufsize) _require_val "$1" "$#" "${2:-}"; _validate_rate_arg "$1" "$2"; AV1_BUFSIZE="$2"; shift 2 ;;
    -l|--level)    _require_val "$1" "$#" "${2:-}"; _validate_level_arg "$1" "$2"; LEVEL_VALUE="$2"; _CLI_LEVEL_EXPLICIT=1; shift 2 ;;
    --conservative-vbv) CONSERVATIVE_VBV=1; shift ;;
    --no-conservative-vbv) CONSERVATIVE_VBV=0; shift ;;
    --dv) DISABLE_DV=0; shift ;;
    --no-dv) DISABLE_DV=1; shift ;;
    --allow-dv-fallback) ALLOW_DV_FALLBACK=1; shift ;;
    --no-allow-dv-fallback) ALLOW_DV_FALLBACK=0; shift ;;
    --dv-convert-p81) DV_CONVERT_TO_P81_IF_FAIL=1; shift ;;
    --no-dv-convert-p81) DV_CONVERT_TO_P81_IF_FAIL=0; shift ;;
    --video-codec)
      _require_val "$1" "$#" "${2:-}"; VIDEO_CODEC="$2"
      case "$VIDEO_CODEC" in
        libx265|libx264|libsvt-av1|libaom-av1) ;;
        *) die 11 "Invalid --video-codec: must be libx265, libx264, libsvt-av1, or libaom-av1 (got: $VIDEO_CODEC)" ;;
      esac
      shift 2
      ;;
    --hw-accel)
      _require_val "$1" "$#" "${2:-}"; HW_ACCEL="$2"; _CLI_HW_ACCEL_EXPLICIT=1
      is_valid_hw_accel "$HW_ACCEL" || die 11 "Invalid --hw-accel: \"$HW_ACCEL\". Valid values: none, auto, videotoolbox, nvenc"
      shift 2
      ;;
    --hw-accel-quality)
      _require_val "$1" "$#" "${2:-}"; HW_ACCEL_QUALITY="$2"; _CLI_HW_ACCEL_QUALITY_EXPLICIT=1
      # Accept integer 0–100 (VT/NVENC quality scales both fit this range).
      if [[ ! "$HW_ACCEL_QUALITY" =~ ^[0-9]+$ ]] || (( HW_ACCEL_QUALITY < 0 )) || (( HW_ACCEL_QUALITY > 100 )); then
        die 11 "Invalid --hw-accel-quality: \"$HW_ACCEL_QUALITY\". Must be an integer between 0 and 100."
      fi
      shift 2
      ;;
    --hw-accel-allow-sw)    HW_ACCEL_ALLOW_SW=1; shift ;;
    --no-hw-accel-allow-sw) HW_ACCEL_ALLOW_SW=0; shift ;;
    --video-copy-if-compliant) VIDEO_COPY_IF_COMPLIANT=1; shift ;;
    --no-video-copy-if-compliant) VIDEO_COPY_IF_COMPLIANT=0; shift ;;
    --tonemap) TONEMAP_HDR_TO_SDR=1; shift ;;
    --no-tonemap) TONEMAP_HDR_TO_SDR=0; shift ;;
    --sdr-force-10bit) SDR_FORCE_10BIT=1; shift ;;
    --no-sdr-force-10bit) SDR_FORCE_10BIT=0; shift ;;
    --max-copy-bitrate) _require_val "$1" "$#" "${2:-}"; MAX_COPY_BITRATE="$2"; shift 2 ;;

    --audio-track)        _require_val "$1" "$#" "${2:-}"; AUDIO_TRACK_OVERRIDE="$2"; shift 2 ;;
    --audio-lang-pref)    _require_val "$1" "$#" "${2:-}"; AUDIO_LANG_PREF="$2"; shift 2 ;;
    --stereo-bitrate)     _require_val "$1" "$#" "${2:-}"; _validate_rate_arg "$1" "$2"; STEREO_BITRATE="$2"; shift 2 ;;
    --prefer-stereo) AUDIO_PREFER_STEREO=1; _CLI_AUDIO_PREFER_STEREO_EXPLICIT=1; shift ;;
    --no-prefer-stereo) AUDIO_PREFER_STEREO=0; _CLI_AUDIO_PREFER_STEREO_EXPLICIT=1; shift ;;
    --stereo-fallback) ADD_STEREO_IF_MULTICH=1; _CLI_ADD_STEREO_IF_MULTICH_EXPLICIT=1; shift ;;
    --no-stereo-fallback) ADD_STEREO_IF_MULTICH=0; _CLI_ADD_STEREO_IF_MULTICH_EXPLICIT=1; shift ;;
    --audio-force-codec)   _require_val "$1" "$#" "${2:-}"; _validate_force_codec_arg "$1" "$2"; AUDIO_FORCE_CODEC="$2"; shift 2 ;;
    --audio-force-bitrate) _require_val "$1" "$#" "${2:-}"; AUDIO_FORCE_BITRATE="$2"; shift 2 ;;
    --audio-lossless-passthrough) AUDIO_LOSSLESS_PASSTHROUGH=1; shift ;;
    --no-audio-lossless-passthrough) AUDIO_LOSSLESS_PASSTHROUGH=0; shift ;;
    --audio-titles) INCLUDE_AUDIO_TITLES=1; shift ;;
    --no-audio-titles) INCLUDE_AUDIO_TITLES=0; shift ;;

    --no-subtitles) SUB_INCLUDE_FORCED=0; SUB_INCLUDE_FULL=0; SUB_INCLUDE_SDH=0; shift ;;
    --sub-lang-pref) _require_val "$1" "$#" "${2:-}"; SUB_LANG_PREF="$2"; shift 2 ;;
    --no-sub-sdh) SUB_INCLUDE_SDH=0; shift ;;
    --ocr-lang)  _require_val "$1" "$#" "${2:-}"; SUB_OCR_LANG="$2"; shift 2 ;;
    --no-ocr) SUB_ENABLE_OCR=0; shift ;;
    --ocr-tool)  _require_val "$1" "$#" "${2:-}"; SUB_OCR_TOOL="$2"; shift 2 ;;
    --sub-burn-forced) SUB_BURN_FORCED=1; shift ;;
    --no-sub-burn-forced) SUB_BURN_FORCED=0; shift ;;
    --sub-export-external) SUB_EXPORT_EXTERNAL=1; shift ;;
    --no-sub-export-external) SUB_EXPORT_EXTERNAL=0; shift ;;
    --sub-preserve-format) SUB_PRESERVE_TEXT_FORMAT=1; _CLI_SUB_PRESERVE_TEXT_FORMAT_EXPLICIT=1; shift ;;
    --no-sub-preserve-format) SUB_PRESERVE_TEXT_FORMAT=0; _CLI_SUB_PRESERVE_TEXT_FORMAT_EXPLICIT=1; shift ;;
    --sub-preserve-bitmap)    SUB_PRESERVE_BITMAP=1; _CLI_SUB_PRESERVE_BITMAP_EXPLICIT=1; shift ;;
    --no-sub-preserve-bitmap) SUB_PRESERVE_BITMAP=0; _CLI_SUB_PRESERVE_BITMAP_EXPLICIT=1; shift ;;

    --no-ext-subs)  EXT_SUB_ENABLED=0; shift ;;
    --ext-subs)     EXT_SUB_ENABLED=1; shift ;;
    --sub-sole-ext-fallback)    SUB_SOLE_EXT_FALLBACK=1; shift ;;
    --no-sub-sole-ext-fallback) SUB_SOLE_EXT_FALLBACK=0; shift ;;
    --ext-subs-dir)
      _require_val "$1" "$#" "${2:-}"; EXT_SUB_DIR="$2"
      [[ ! -d "$EXT_SUB_DIR" ]] && die 11 "--ext-subs-dir: directory not found: $EXT_SUB_DIR"
      shift 2 ;;

    --skip-audio) SKIP_AUDIO=1; shift ;;
    --skip-subs)  SKIP_SUBS=1;  shift ;;

    --output-ext) _require_val "$1" "$#" "${2:-}"; OUTPUT_EXT="$2"; _OUTPUT_EXT_EXPLICIT=1; shift 2 ;;
    --keep-chapters) KEEP_CHAPTERS=1; shift ;;
    --no-keep-chapters) KEEP_CHAPTERS=0; shift ;;
    --strip-metadata) STRIP_METADATA=1; shift ;;
    --no-strip-metadata) STRIP_METADATA=0; shift ;;
    --profile-comment) PROFILE_COMMENT=1; shift ;;
    --no-profile-comment) PROFILE_COMMENT=0; shift ;;
    --skip-if-ideal) SKIP_IF_IDEAL=1; shift ;;
    --no-skip-if-ideal) SKIP_IF_IDEAL=0; shift ;;
    --report-json) REPORT_JSON=1; shift ;;
    --no-report-json) REPORT_JSON=0; shift ;;

    --replace-source)
      if [[ ! -t 0 ]]; then
        die 11 "--replace-source requires an interactive terminal (stdin is not a TTY). Use --force-replace-source for non-interactive/scripted usage."
      fi
      REPLACE_SOURCE=1; shift ;;
    --force-replace-source) FORCE_REPLACE_SOURCE=1; shift ;;

    # L10/cleanup: no `--profile)` arm here — the pre-scan strips every `--profile <val>` before
    # this parser runs, and a post-`--` `--profile` is folded into POSITIONALS by the `--)` arm
    # below, so the token can never reach this case. (The old arm's `shift 2` would also over-shift
    # a lone trailing `--profile`.) A stray `--profile` now correctly hits the unknown-option guard.

    --) shift; POSITIONALS+=("$@"); break ;;  # M1: fold remaining args back in (the `--` end-of-options idiom, e.g. `muxm -- -dashname.mkv`); the arity check below still guards
    -*) die 11 "Unknown option: $1. $USAGE_SHORT" ;;
    *) POSITIONALS+=("$1"); shift ;;
  esac
done

# Resolve the final verbosity now that config (§6) and the CLI (above) have both been applied —
# CLI wins because the parser overwrote any .muxmrc VERBOSITY. Maps the enum to _VERBOSITY_N for
# the rest of the run (covers the config-only case, where no --quiet/--verbose flag ran).
_resolve_verbosity

# Validate CHECKSUM_ALGO
case "${CHECKSUM_ALGO:-sha256}" in
  sha256|blake2b|auto) ;;
  *) die 11 "Invalid CHECKSUM_ALGO: \"$CHECKSUM_ALGO\". Valid values: sha256, blake2b, auto" ;;
esac

# ===== Section 13: Profile + flag conflict warnings ==========================================
# These are warnings, not errors — the user's explicit CLI flags always win.
# Conflicts are only checked when a profile is active.

_warn_conflict() {
  local profile="$1" flag="$2" reason="$3"
  warn "Profile '$profile' + $flag: $reason"
}

# L5: shared helpers for near-verbatim Section 13 patterns.

# Warn when SUB_MULTI_TRACK clashes with flags that force single-track behaviour.
_warn_multitrack_sub_conflicts(){
  local _p="$1"
  (( SUB_MULTI_TRACK )) || return 0
  (( SUB_BURN_FORCED )) && \
    _warn_conflict "$_p" "--sub-burn-forced" \
      "Multi-track subtitle mode copies all subs from source. --sub-burn-forced forces single-track."
  (( SUB_EXPORT_EXTERNAL )) && \
    _warn_conflict "$_p" "--sub-export-external" \
      "Multi-track subtitle mode embeds all subs via stream-copy. External export is ignored."
  return 0
}

# CR-14: --sub-export-external + MKV advisory. Idempotent (one-shot via _EXPORT_MKV_ADVISORY_SHOWN)
# so it can be safely called from BOTH the Section-13 conflict block (where it catches an explicit
# --output-ext mkv / mkv-setting profile, the only state known pre-resolution — and the only state
# available in `--print-effective-config` with no source) AND the tail of
# _resolve_output_and_sub_policy (which catches passthrough profiles whose OUTPUT_EXT resolves to
# mkv only there). Whichever runs first fires once; the second call is a no-op. No double-warning.
_warn_export_external_mkv(){
  (( _EXPORT_MKV_ADVISORY_SHOWN )) && return 0
  if (( SUB_EXPORT_EXTERNAL )) && [[ "$OUTPUT_EXT" == "mkv" ]]; then
    warn "[Subs] --sub-export-external with MKV: Matroska already carries multiple subtitle tracks natively, so external SRT export is unnecessary — proceeding as requested."
    _EXPORT_MKV_ADVISORY_SHOWN=1
  fi
  return 0
}

# Warn when OUTPUT_EXT matches an unusual/unsupported container for a profile.
# Args: profile ext msg
_warn_container_unusual(){
  local _p="$1" _ext="$2" _msg="$3"
  [[ "$OUTPUT_EXT" != "$_ext" ]] && return 0
  _warn_conflict "$_p" "--output-ext $_ext" "$_msg"
  return 0
}

# Warn when libx264 is selected under a profile that relies on HDR metadata.
# Args: profile msg
_warn_h264_hdr(){
  [[ "$VIDEO_CODEC" == "libx264" ]] && _warn_conflict "$1" "--video-codec libx264" "$2"
  return 0
}

# Deferred warning (C6): H.264 cannot carry Dolby Vision. The libx264 path silently drops
# the source RPU — the DV RPU-injection gate excludes libx264 (only libx265/hevc_videotoolbox
# produce a raw HEVC ES suitable for dovi_tool). AV1 + DV already warns and auto-disables DV
# upstream; this surfaces the previously-silent H.264 case. Must be called POST-PROBE (IS_DV
# set), and is gated on !DISABLE_DV so a deliberate --no-dv stays quiet. VIDEO_CODEC=="libx264"
# also covers h264_videotoolbox, which likewise cannot carry DV. Globals: VIDEO_CODEC, IS_DV,
# DISABLE_DV.
_warn_h264_drops_dv() {
  if [[ "$VIDEO_CODEC" == "libx264" ]] && (( IS_DV )) && (( ! DISABLE_DV )); then
    warn "H.264 cannot carry Dolby Vision; the source's DV metadata will be dropped. Use --video-codec libx265 to preserve Dolby Vision, or --no-dv to silence this warning."
  fi
  return 0
}

# WI-1b: warn when an explicitly-typed CLI flag is silently ignored by the resolved
# backend/codec. Every check is gated on a _CLI_*_EXPLICIT tracker (or, for AV1 rate
# control, on a non-empty value that no profile sets), so a value supplied by a profile or
# config never warns. Must be called AFTER detect_hw_accel so HW_ACCEL_RESOLVED and
# VIDEO_CODEC are known, and before print_effective_config so the warnings are visible
# (and unit-testable) there.
# Phrasing note (C1–C4): VideoToolbox can fall back to its software path per-frame
# (allow_sw), in which case the software knobs *would* apply — hence "When the VideoToolbox
# backend is used". The config-time emission is correct for the overwhelmingly common case.
_warn_ignored_knobs() {
  local _vt=0;    [[ "$HW_ACCEL_RESOLVED" == "videotoolbox" ]] && _vt=1
  local _is_x26x=0; [[ "$VIDEO_CODEC" == "libx265" || "$VIDEO_CODEC" == "libx264" ]] && _is_x26x=1
  local _is_av1=0;  _is_av1_codec "$VIDEO_CODEC" && _is_av1=1

  # C1–C4: VideoToolbox ignores the x265/x264 software encode knobs.
  if (( _vt && _is_x26x )); then
    (( _CLI_CRF_EXPLICIT )) && \
      warn "When the VideoToolbox backend is used it controls quality via -q:v; --crf $CRF_VALUE is ignored. Use --hw-accel-quality to set VideoToolbox quality."
    (( _CLI_PRESET_EXPLICIT )) && \
      warn "When the VideoToolbox backend is used it does not accept x265/x264 presets; --preset $PRESET_VALUE is ignored."
    if [[ "$VIDEO_CODEC" == "libx265" ]] && (( _CLI_X265_PARAMS_EXPLICIT )); then
      warn "When the VideoToolbox backend is used it does not accept --x265-params; the parameter string is ignored."
    fi
    if [[ "$VIDEO_CODEC" == "libx264" ]] && (( _CLI_X264_PARAMS_EXPLICIT )); then
      warn "When the VideoToolbox backend is used it honors only profile=high from --x264-params; other keys are ignored."
    fi
  fi

  # C5: --hw-accel-quality only affects hardware encoders.
  if (( _CLI_HW_ACCEL_QUALITY_EXPLICIT )) \
     && [[ "$HW_ACCEL_RESOLVED" != "videotoolbox" && "$HW_ACCEL_RESOLVED" != "nvenc" ]]; then
    warn "--hw-accel-quality has no effect without a hardware backend (current backend: ${HW_ACCEL_RESOLVED:-none})."
  fi

  # C10: --threads caps the software encoder's thread pool (pools= for libx265,
  # lp= for libsvtav1). A VideoToolbox encode is fixed-function hardware with no
  # software pool to size, so the flag does nothing there. (AV1 + videotoolbox
  # falls back to software libsvtav1, where --threads *does* apply — so this only
  # fires for the HEVC/H.264 codecs that actually route to a VT encoder.)
  if (( _CLI_THREADS_EXPLICIT && _vt && _is_x26x )); then
    warn "--threads has no effect on a VideoToolbox hardware encode (fixed-function; no software thread pool to cap)."
  fi

  # C7: --av1-params / --av1-maxrate / --av1-bufsize apply only to AV1 encodes.
  if (( ! _is_av1 )); then
    if (( _CLI_AV1_PARAMS_EXPLICIT )) || [[ -n "$AV1_MAXRATE" || -n "$AV1_BUFSIZE" ]]; then
      warn "--av1-params/--av1-maxrate/--av1-bufsize apply only to AV1 encodes; ignored for $VIDEO_CODEC."
    fi
  fi

  # C8: --x265-params / --x264-params apply only to their own codec.
  if (( _CLI_X265_PARAMS_EXPLICIT )) && [[ "$VIDEO_CODEC" != "libx265" ]]; then
    warn "--x265-params applies only to the libx265 encoder; ignored for $VIDEO_CODEC."
  fi
  if (( _CLI_X264_PARAMS_EXPLICIT )) && [[ "$VIDEO_CODEC" != "libx264" ]]; then
    warn "--x264-params applies only to the libx264 encoder; ignored for $VIDEO_CODEC."
  fi

  # C9: --level has no effect on AV1 encodes.
  if (( _CLI_LEVEL_EXPLICIT )) && (( _is_av1 )); then
    warn "--level has no effect on AV1 encodes."
  fi
  return 0
}

if [[ -n "${PROFILE_NAME:-}" ]]; then
  case "$PROFILE_NAME" in

    archive)
      # DV archival without DV is pointless
      (( DISABLE_DV )) && \
        _warn_conflict "$PROFILE_NAME" "--no-dv" \
          "DV archival without Dolby Vision is pointless. Output will be a plain remux."

      # archive is copy-only; an explicit --crf on the CLI implies the user expects a
      # re-encode. Gate on _CLI_CRF_EXPLICIT (was the CRF actually typed on the CLI?), not
      # on the profile source / CRF≠18 — a CRF set via .muxmrc, or an explicit --crf 18,
      # was previously mis-handled (config CRF warned; explicit --crf 18 stayed silent).
      if (( _CLI_CRF_EXPLICIT )); then
        _warn_conflict "$PROFILE_NAME" "--crf $CRF_VALUE" \
          "archive is designed for copy-only (no re-encode). CRF is ignored when VIDEO_COPY_IF_COMPLIANT succeeds."
      fi

      # Stripping metadata defeats archival purpose
      (( STRIP_METADATA )) && \
        _warn_conflict "$PROFILE_NAME" "--strip-metadata" \
          "Stripping metadata conflicts with archival goals. Metadata will be stripped as requested."

      # Stripping chapters defeats archival purpose
      (( ! KEEP_CHAPTERS )) && \
        _warn_conflict "$PROFILE_NAME" "--no-keep-chapters" \
          "Stripping chapters conflicts with archival goals. Chapters will be stripped as requested."

      # Burning subs defeats archival purpose (irreversible)
      (( SUB_BURN_FORCED )) && \
        _warn_conflict "$PROFILE_NAME" "--sub-burn-forced" \
          "Burning subtitles is irreversible and conflicts with archival goals."

      # Multi-track audio conflicts: flags that force single-track behavior
      if (( AUDIO_MULTI_TRACK )); then
        [[ -n "${AUDIO_TRACK_OVERRIDE:-}" ]] && \
          _warn_conflict "$PROFILE_NAME" "--audio-track $AUDIO_TRACK_OVERRIDE" \
            "Multi-track mode keeps all matching tracks. --audio-track forces single-track selection."

        [[ -n "${AUDIO_FORCE_CODEC:-}" ]] && \
          _warn_conflict "$PROFILE_NAME" "--audio-force-codec $AUDIO_FORCE_CODEC" \
            "Multi-track archival copies all audio. --audio-force-codec implies transcoding, which forces single-track."

        (( ADD_STEREO_IF_MULTICH )) && \
          _warn_conflict "$PROFILE_NAME" "--stereo-fallback" \
            "Multi-track archival preserves all source tracks. Stereo fallback is redundant."
      fi

      # Multi-track subtitle conflicts: flags that force single-track behavior
      _warn_multitrack_sub_conflicts "$PROFILE_NAME"
      ;;

    hdr10-hq)
      # hdr10-hq sets DISABLE_DV=1 by default; if someone re-enabled it, warn
      (( ! DISABLE_DV )) && \
        _warn_conflict "$PROFILE_NAME" "(DV enabled)" \
          "hdr10-hq expects DV to be stripped. DV layers may cause unexpected behavior."

      # Tone-mapping makes no sense for HDR output
      (( TONEMAP_HDR_TO_SDR )) && \
        _warn_conflict "$PROFILE_NAME" "--tonemap" \
          "Tone-mapping HDR to SDR conflicts with HDR10 output. Output will be SDR."

      # H.264 codec is wrong for HDR10
      _warn_h264_hdr "$PROFILE_NAME" "H.264 cannot carry HDR10 metadata. Use libx265 for HDR10 output."
      ;;

    atv-directplay-hq)
      # Note: SUB_PRESERVE_TEXT_FORMAT for MKV output is set post-resolution (Section 15).
      # There is no conflict check here for it because OUTPUT_EXT is not yet resolved at this point.

      # No MKV warning: MKV Direct Plays on Apple TV via Plex/Infuse (the native TV.app
      # requires MP4, but that is not a footgun worth a conflict warning). See WI-5.
      # MOV is unusual but works
      _warn_container_unusual "$PROFILE_NAME" "mov" \
        "MOV may work on Apple TV but mp4 is recommended for broadest Direct Play."
      # Tone-mapping defeats HDR purpose
      (( TONEMAP_HDR_TO_SDR )) && \
        _warn_conflict "$PROFILE_NAME" "--tonemap" \
          "Tone-mapping to SDR removes HDR. Apple TV supports HDR natively."
      # H.264 loses HDR + DV
      _warn_h264_hdr "$PROFILE_NAME" "H.264 cannot carry HDR10/DV. Apple TV supports HEVC; use libx265."
      # Lossless audio won’t Direct Play on ATV
      (( AUDIO_LOSSLESS_PASSTHROUGH )) && \
        _warn_conflict "$PROFILE_NAME" "--audio-lossless-passthrough" \
          "TrueHD/DTS-HD MA won’t Direct Play on Apple TV. E-AC-3 is recommended."
      ;;

    atv-directplay-animation)
      # No MKV warning: MKV Direct Plays on Apple TV via Plex/Infuse (passthrough may also
      # produce MKV — that is intentional and supported). See WI-5.
      # MOV is unusual
      _warn_container_unusual "$PROFILE_NAME" "mov" \
        "MOV may work on Apple TV but mp4 is recommended for broadest Direct Play."
      # Tone-mapping defeats HDR purpose
      (( TONEMAP_HDR_TO_SDR )) && \
        _warn_conflict "$PROFILE_NAME" "--tonemap" \
          "Tone-mapping to SDR removes HDR. Apple TV supports HDR natively."
      # H.264 loses HDR + DV
      _warn_h264_hdr "$PROFILE_NAME" "H.264 cannot carry HDR10/DV. Apple TV supports HEVC; use libx265."

      # Lossless audio won’t Direct Play on ATV
      (( AUDIO_LOSSLESS_PASSTHROUGH )) && \
        _warn_conflict "$PROFILE_NAME" "--audio-lossless-passthrough" \
          "TrueHD/DTS-HD MA won’t Direct Play on Apple TV. E-AC-3 is recommended."

      # Disabling format preservation converts ASS to plain-text SRT
      (( ! SUB_PRESERVE_TEXT_FORMAT )) && \
        _warn_conflict "$PROFILE_NAME" "--no-sub-preserve-format" \
          "ASS/SSA subtitles will be converted to SRT, losing positioning and styling."

      # Multi-track subtitle conflicts
      _warn_multitrack_sub_conflicts "$PROFILE_NAME"
      ;;

    streaming-hevc)
      # Container choices unusual for streaming targets
      _warn_container_unusual "$PROFILE_NAME" "mkv" \
        "MKV is unusual for streaming targets. MP4 recommended for broadest client support."
      _warn_container_unusual "$PROFILE_NAME" "mov" \
        "MOV is unusual for streaming targets. MP4 recommended for broadest client support."
      # Lossless audio increases file size significantly
      (( AUDIO_LOSSLESS_PASSTHROUGH )) && \
        _warn_conflict "$PROFILE_NAME" "--audio-lossless-passthrough" \
          "Lossless audio increases file size significantly. E-AC-3/AAC recommended for streaming."
      # H.264 cannot carry HDR10
      _warn_h264_hdr "$PROFILE_NAME" "H.264 cannot carry HDR10 metadata. HEVC recommended for streaming."
      ;;

    av1-hq)
      # C10: av1-hq has no dedicated conflict arm. MP4/MOV have limited AV1+HDR10 support;
      # the profile forces MKV.
      _warn_container_unusual "$PROFILE_NAME" "mp4" \
        "MP4 has limited AV1+HDR10 support. av1-hq uses MKV to preserve HDR10."
      _warn_container_unusual "$PROFILE_NAME" "mov" \
        "MOV has limited AV1+HDR10 support. av1-hq uses MKV to preserve HDR10."
      # Switching off AV1 defeats the entire purpose of an AV1 archival profile.
      if ! _is_av1_codec "$VIDEO_CODEC"; then
        _warn_conflict "$PROFILE_NAME" "--video-codec $VIDEO_CODEC" \
          "av1-hq is an AV1 archival profile; selecting $VIDEO_CODEC overrides its whole purpose."
      fi
      # Transcoding lossless audio loses quality unnecessarily — MKV carries it natively.
      (( ! AUDIO_LOSSLESS_PASSTHROUGH )) && \
        _warn_conflict "$PROFILE_NAME" "--no-audio-lossless-passthrough" \
          "Transcoding lossless audio loses quality. av1-hq archives lossless natively in MKV."
      # Tone-mapping defeats the HDR10 archival intent.
      (( TONEMAP_HDR_TO_SDR )) && \
        _warn_conflict "$PROFILE_NAME" "--tonemap" \
          "Tone-mapping to SDR removes HDR10. av1-hq preserves HDR10 for archival."
      ;;

    streaming-av1)
      # C10: streaming-av1 has no dedicated conflict arm. Switching off AV1 defeats the profile.
      if ! _is_av1_codec "$VIDEO_CODEC"; then
        _warn_conflict "$PROFILE_NAME" "--video-codec $VIDEO_CODEC" \
          "streaming-av1 targets AV1-capable platforms; selecting $VIDEO_CODEC overrides the profile."
      fi
      # MKV is unusual for streaming targets (the profile uses MP4).
      _warn_container_unusual "$PROFILE_NAME" "mkv" \
        "MKV is unusual for streaming targets. streaming-av1 uses MP4 for broadest client support."
      # Tone-mapping defeats HDR streaming intent.
      (( TONEMAP_HDR_TO_SDR )) && \
        _warn_conflict "$PROFILE_NAME" "--tonemap" \
          "Tone-mapping to SDR removes HDR. streaming-av1 preserves HDR."
      ;;

    animation)
      # Container choices that drop subtitle fidelity
      _warn_container_unusual "$PROFILE_NAME" "mp4" \
        "MP4 cannot carry styled ASS/SSA or PGS bitmap subtitles. MKV recommended for animation."
      _warn_container_unusual "$PROFILE_NAME" "mov" \
        "MOV cannot carry styled ASS/SSA or PGS bitmap subtitles. MKV recommended for animation."
      # Burning subs destroys ASS styling
      (( SUB_BURN_FORCED )) && \
        _warn_conflict "$PROFILE_NAME" "--sub-burn-forced" \
          "Burning subs destroys ASS styling (typesetting, signs, karaoke). Soft subs recommended."
      # Multi-track subtitle conflicts: flags that force single-track behavior
      _warn_multitrack_sub_conflicts "$PROFILE_NAME"

      # Disabling format preservation converts ASS to plain-text SRT
      (( ! SUB_PRESERVE_TEXT_FORMAT )) && \
        _warn_conflict "$PROFILE_NAME" "--no-sub-preserve-format" \
          "ASS/SSA subtitles will be converted to SRT, losing positioning and styling."
      # H.264 8-bit causes banding in animation
      _warn_h264_hdr "$PROFILE_NAME" "H.264 8-bit causes visible banding in animation gradients. HEVC 10-bit recommended."
      # Transcoding lossless audio loses quality unnecessarily
      (( ! AUDIO_LOSSLESS_PASSTHROUGH )) && \
        _warn_conflict "$PROFILE_NAME" "--no-audio-lossless-passthrough" \
          "Transcoding lossless audio loses quality. MKV supports lossless natively."
      ;;

    universal)
      # Container choices unusual for max-compatibility targets
      _warn_container_unusual "$PROFILE_NAME" "mkv" \
        "MKV is unusual for max compatibility. MP4 recommended for widest device support."
      _warn_container_unusual "$PROFILE_NAME" "mov" \
        "MOV is unusual for max compatibility. MP4 recommended for widest device support."
      # Lossless passthrough defeats compatibility
      (( AUDIO_LOSSLESS_PASSTHROUGH )) && \
        _warn_conflict "$PROFILE_NAME" "--audio-lossless-passthrough" \
          "Lossless audio (TrueHD/DTS-HD MA) is not widely supported. AAC is recommended."
      # HEVC may not play everywhere
      [[ "$VIDEO_CODEC" == "libx265" ]] && \
        _warn_conflict "$PROFILE_NAME" "--video-codec libx265" \
          "HEVC is less widely supported than H.264 for universal playback."
      # Keeping DV enabled makes no sense for SDR universal output
      (( ! DISABLE_DV )) && \
        _warn_conflict "$PROFILE_NAME" "(DV enabled)" \
          "Dolby Vision in an SDR/H.264 universal output is contradictory. DV will be stripped."
      ;;

    youtube-upload)
      # MKV won't ingest well on YouTube
      _warn_container_unusual "$PROFILE_NAME" "mkv" \
        "YouTube requires MP4. MKV output may be rejected or not process correctly."
      # Lossless audio won't survive YouTube's transcode pipeline
      (( AUDIO_LOSSLESS_PASSTHROUGH )) && \
        _warn_conflict "$PROFILE_NAME" "--audio-lossless-passthrough" \
          "YouTube transcodes all audio. Lossless passthrough is unnecessary overhead; use AAC."
      ;;

  esac

  # Cross-profile: warn on any flag combination that is inherently contradictory
  if (( TONEMAP_HDR_TO_SDR )) && [[ "$VIDEO_CODEC" == "libx265" ]]; then
    warn "Tone-mapping to SDR with HEVC output: SDR content in HEVC is valid but unusual. Consider libx264 for max compatibility."
  fi

  if (( VIDEO_COPY_IF_COMPLIANT )) && (( TONEMAP_HDR_TO_SDR )); then
    warn "Copy-if-compliant + tone-mapping: the source video copy will be skipped whenever tone-mapping is needed (tone-mapping requires a re-encode)."
  fi

  if (( SUB_BURN_FORCED )) && (( ! SUB_INCLUDE_FORCED )); then
    warn "[Subs] Forced-subtitle burn-in is enabled, but forced subtitles are excluded — there is nothing to burn."
  fi
  # CR-14: fires here for an explicit --output-ext mkv / mkv-setting profile (the only state known
  # pre-resolution, and the only state available under --print-effective-config with no source).
  # Passthrough profiles whose OUTPUT_EXT resolves to mkv only later are caught by the twin call at
  # the tail of _resolve_output_and_sub_policy; the one-shot guard makes whichever runs first win.
  _warn_export_external_mkv
fi

# Global safeguard: AV1 + DV is not supported — DV RPU injection requires HEVC.
# Auto-disable DV when an AV1 codec is selected.
if _is_av1_codec "$VIDEO_CODEC"; then
  if (( ! DISABLE_DV )); then
    warn "AV1 codec does not support Dolby Vision RPU injection — disabling DV (--no-dv)."
    DISABLE_DV=1
  fi
fi

# Global safeguard: H.264 cannot carry HDR metadata. If the user has selected
# libx264 without tone-mapping, HDR sources will produce washed-out output.
# This warning fires regardless of whether a profile is active.
if [[ "$VIDEO_CODEC" == "libx264" ]] && (( ! TONEMAP_HDR_TO_SDR )); then
  # We can't probe the source yet (no file parsed), so we note the risk.
  # The video pipeline will re-check once source HDR status is known.
  _H264_HDR_WARN_PENDING=1
else
  _H264_HDR_WARN_PENDING=0
fi

# Probe hardware-encoder availability and resolve HW_ACCEL=auto.
# Non-fatal: an explicit but missing backend leaves HW_ACCEL_RESOLVED="none"
# so --print-effective-config can still run; Section 14 dies with a precise
# error when the encode actually needs the backend.
detect_hw_accel

# Emit profile-level HW_ACCEL compatibility warnings now that the backend is
# resolved. These mirror the --no-dv/--tonemap style conflict warnings above
# and surface the fallback reason before print_effective_config exits.
if [[ -n "${PROFILE_NAME:-}" ]] && [[ "$HW_ACCEL_RESOLVED" != "none" ]]; then
  case "$PROFILE_NAME" in
    archive)
      _warn_conflict "$PROFILE_NAME" "--hw-accel $HW_ACCEL" \
        "archive is copy-only; hardware acceleration only applies when re-encoding. Ignored unless VIDEO_COPY_IF_COMPLIANT fails."
      ;;
    av1-hq|streaming-av1)
      if [[ "$HW_ACCEL_RESOLVED" == "videotoolbox" ]]; then
        _warn_conflict "$PROFILE_NAME" "--hw-accel videotoolbox" \
          "VideoToolbox has no AV1 encoder on Apple Silicon. Falling back to libsvt-av1 (software)."
      elif [[ "$HW_ACCEL_RESOLVED" == "nvenc" ]] && ! ffmpeg_has_encoder av1_nvenc; then
        _warn_conflict "$PROFILE_NAME" "--hw-accel nvenc" \
          "NVENC AV1 encoding needs an RTX 40-series (Ada Lovelace) GPU or newer; using software (libsvt-av1) instead."
      fi
      ;;
  esac
fi

# WI-1b: surface explicitly-typed CLI flags that the resolved backend/codec silently
# ignores (C1–C5, C7–C9). Runs after detect_hw_accel (HW_ACCEL_RESOLVED known) and before
# print_effective_config so the warnings appear there. Gated on _CLI_*_EXPLICIT.
_warn_ignored_knobs


# True (rc 0) iff $1 is one of the Apple TV Direct-Play profiles. These share the same Direct-Play
# contract (single-layer DV P8.1, copy-if-compliant, ≤50 Mbps) and must be gated together
# everywhere; a single literal `== atv-directplay-hq` silently excludes the animation sibling (CR-2).
# Route Direct-Play-intent checks through here so a future Direct-Play profile inherits the gate by
# being added in one place. MUST be defined BEFORE _resolve_output_and_sub_policy (its first caller),
# which runs at top level on the print-effective-config path well before Section 26 — defining it in
# Section 26 made it "command not found" there, silently skipping the ATV MKV subtitle adjustment.
_is_atv_directplay_profile() {
  [[ "$1" == "atv-directplay-hq" || "$1" == "atv-directplay-animation" ]]
}

# _resolve_output_and_sub_policy — resolve the final output container and the ATV subtitle
# policy from the source/output filenames and the active profile. Extracted from Section 15
# so --print-effective-config (Section 13) can resolve the same way and report the RESOLVED
# config (D4) instead of pre-resolution globals. Called exactly once per run (the diagnostic
# path exits before Section 15; the normal path skips the diagnostic block), but each sub-block
# is self-gating so a repeat call would be a no-op.
# Reads/writes globals: OUTPUT_EXT, _OUTPUT_EXT_EXPLICIT, SUB_PRESERVE_TEXT_FORMAT,
# SUB_PRESERVE_BITMAP. Requires SRC_ABS set (and reads OUT, PROFILE_NAME, _CLI_SUB_PRESERVE_*).
_resolve_output_and_sub_policy(){
  # ---- Infer output container from explicit output filename ----
  # If the user provided an explicit output filename with a recognized extension, infer
  # OUTPUT_EXT from it (as if --output-ext was passed). This prevents a mismatch where
  # passthrough would derive the container from the source, but the output file has a
  # different extension (e.g., muxm --profile archive movie.mkv output.mp4).
  # --output-ext flag wins if already set.
  if [[ -n "${OUT:-}" ]] && (( ! _OUTPUT_EXT_EXPLICIT )); then
    local _out_inferred_ext; _out_inferred_ext="$(_lower "${OUT##*.}")"
    case "$_out_inferred_ext" in
      mp4|m4v|mov|mkv)
        OUTPUT_EXT="$_out_inferred_ext"
        _OUTPUT_EXT_EXPLICIT=1
        log "[output] Inferred output container .$_out_inferred_ext from explicit output filename"
        ;;
    esac
  fi

  # ---- Container passthrough resolution ----
  # If OUTPUT_EXT is empty (set by a profile or left at default), derive the container from the
  # source file extension. This implements "passthrough" mode: mkv→mkv, mp4→mp4, etc.
  # --output-ext on the CLI always wins (_OUTPUT_EXT_EXPLICIT=1 skips this block).
  if [[ -z "$OUTPUT_EXT" ]] && (( ! _OUTPUT_EXT_EXPLICIT )); then
    local _src_passthrough_ext; _src_passthrough_ext="$(_lower "${SRC_ABS##*.}")"
    case "$_src_passthrough_ext" in
      mp4|m4v|mov|mkv)
        OUTPUT_EXT="$_src_passthrough_ext"
        log "[container-passthrough] Source .$_src_passthrough_ext → output .$OUTPUT_EXT"
        ;;
      *)
        OUTPUT_EXT="mkv"
        note "[container-passthrough] Source container .$_src_passthrough_ext is not supported for output — defaulting to .mkv"
        ;;
    esac
  fi

  # ---- atv-directplay-hq / atv-directplay-animation: MKV-output subtitle adjustment ----
  # When either ATV profile produces MKV output (via passthrough or explicit --output-ext mkv),
  # enable native ASS/SSA format and PGS bitmap preservation — UNLESS the user explicitly asked
  # otherwise on the CLI (D1: gate on _CLI_SUB_PRESERVE_*_EXPLICIT so --no-… is not clobbered).
  if _is_atv_directplay_profile "${PROFILE_NAME:-}" && [[ "$OUTPUT_EXT" == "mkv" ]]; then
    if (( ! _CLI_SUB_PRESERVE_TEXT_FORMAT_EXPLICIT )); then
      SUB_PRESERVE_TEXT_FORMAT=1
      log "[${PROFILE_NAME}] MKV output: enabling native ASS/SSA format preservation."
    fi
    if (( ! _CLI_SUB_PRESERVE_BITMAP_EXPLICIT )); then
      SUB_PRESERVE_BITMAP=1
      log "[${PROFILE_NAME}] MKV output: enabling PGS bitmap preservation (stream-copy)."
    fi
  fi

  # CR-14: now that OUTPUT_EXT is fully resolved, fire the export-external+MKV advisory for the
  # passthrough case the Section-13 conflict block could not see (OUTPUT_EXT was "" there). One-shot
  # guarded, so if the conflict block already warned (explicit mkv) this is a no-op — no double-warn.
  _warn_export_external_mkv
}

# Display the resolved configuration from all sources (config files + profile + CLI).
# Called when --print-effective-config is passed. Exits after printing.
print_effective_config(){
  cat <<EOF
Effective config (post config-files + profile + CLI):

