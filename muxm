  # Resolution-aware CRF (applied after probe by _apply_av1_resolution_crf):
  #   - base CRF 28 (VMAF 97.91 at 1080p SDR — the SDR transparency point),
  #   - dropped to AV1_HQ_HDR_CRF (24, VMAF 92.54 at 4K HDR) for >=4K or HDR sources.
  # CRF 20 (VMAF 93.48 at 4K HDR, parity with HEVC CRF 18) is reachable via --crf 20.
  # See docs/AV1_CALIBRATION.md for methodology.
  DISABLE_DV=1
  ALLOW_DV_FALLBACK=0
  DV_CONVERT_TO_P81_IF_FAIL=0
  OUTPUT_EXT="mkv"
  VIDEO_CODEC="libsvt-av1"
  VIDEO_COPY_IF_COMPLIANT=0
  CRF_VALUE=28
  PRESET_VALUE=6
  SVT_AV1_PARAMS_BASE='film-grain=0:enable-overlays=1:scd=1'
  HDR_TARGET_PIXFMT="yuv420p10le"
  FORCE_CHROMA_420=1
  AUDIO_LOSSLESS_PASSTHROUGH=1
  ADD_STEREO_IF_MULTICH=0
  STEREO_BITRATE="256k"
  SUB_INCLUDE_FORCED=1
  SUB_INCLUDE_FULL=1
  SUB_INCLUDE_SDH=1
  SUB_BURN_FORCED=0
  KEEP_CHAPTERS=1
  STRIP_METADATA=0
  CHECKSUM=1
