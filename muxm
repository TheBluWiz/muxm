  _CLI_LEVEL_EXPLICIT           = $_CLI_LEVEL_EXPLICIT
  _CLI_HW_ACCEL_EXPLICIT        = $_CLI_HW_ACCEL_EXPLICIT
  _CLI_HW_ACCEL_QUALITY_EXPLICIT = $_CLI_HW_ACCEL_QUALITY_EXPLICIT
  _OUTPUT_EXT_EXPLICIT          = $_OUTPUT_EXT_EXPLICIT
  _CLI_SUB_PRESERVE_TEXT_FORMAT_EXPLICIT = $_CLI_SUB_PRESERVE_TEXT_FORMAT_EXPLICIT
  _CLI_SUB_PRESERVE_BITMAP_EXPLICIT = $_CLI_SUB_PRESERVE_BITMAP_EXPLICIT
