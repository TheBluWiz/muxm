declare -i DISK_CHECK=1          # Set to 0 via --no-disk-check to suppress preflight estimation

# av1-hq CRF for 4K/HDR sources (resolution-aware). The profile bases at CRF 28 (the 1080p
# SDR transparency point) and drops to this value for >=4K or HDR content. 24 is the
# documented calibrated default (VMAF 92.54 at 4K HDR); set to 20 for measured HEVC-CRF-18
# parity (larger files). An explicit --crf always overrides this. One-line owner choice.
declare -i AV1_HQ_HDR_CRF=24

# ---- ffmpeg/ffprobe UX
declare -i FFMPEG_HIDE_BANNER=1
FFMPEG_LOGLEVEL="error"
declare -i FFMPEG_OVERWRITE=1
FFPROBE_LOGLEVEL="error"

# ---- Source replacement (in-place overwrite)
declare -i REPLACE_SOURCE=0
declare -i FORCE_REPLACE_SOURCE=0

# ---- Quick-test toggles
declare -i SKIP_AUDIO=0
declare -i SKIP_SUBS=0

# ---- Overrides
AUDIO_TRACK_OVERRIDE=""

# ---- Multi-track audio (archive profile)
