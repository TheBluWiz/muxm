# _create_config_emit_multi — emit a minimal config for a comma-separated multi-profile value.
# Outputs only the header, PROFILE_NAME (uncommented), and any CLI overrides.
_create_config_emit_multi() {
  local profile="$1"

  cat <<'HEADER'
# muxm project config — generated by --create-config
# Multi-profile: each encode runs both profiles sequentially.
# Only explicit overrides are listed; profiles handle all other settings.
# CLI flags always override these values.
HEADER
  printf '# Generated: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
  printf '\n'
  printf 'PROFILE_NAME="%s"\n' "$profile"

  if (( ${#_CC_OVERRIDES[@]} > 0 )); then
    printf '\n'
    local _ovr_var
    # RF1 (HIGH-1): ALWAYS emit the escaped, double-quoted form for every override — drop the
    # old numeric/string branch entirely. The string branch did `printf '%s="%s"'` with NO
    # escaping, so a crafted value (e.g. --x265-params '$(touch /tmp/pwn)') emitted a line that
    # executed on every later `. .muxmrc` source. VAR="20" sources identically to VAR=20, so the
    # unconditional quoted form is safe for numeric values too. Same _cc_shell_escape as _V, so
    # the two emitters can no longer drift (which is what re-opened M1 on this path).
    for _ovr_var in "${!_CC_OVERRIDES[@]}"; do
      printf '%s="%s"\n' "$_ovr_var" "$(_cc_shell_escape "${_CC_OVERRIDES[$_ovr_var]}")"   # RF1
    done
  fi
}

# M5: fetch the value following a value-taking --create-config override flag, dying cleanly (11)
# instead of crashing under `set -u` when it is missing (e.g. a trailing `--crf` with no value).
# Mirrors the main parser's _require_val. Sets _cc_val as a SIDE EFFECT (not via stdout: a `die`
# inside `$(...)` would only exit the subshell, not abort) and must be called bare from
# _create_config, whose _cc_oi / _cc_flag / _cc_override_argv locals it reads via dynamic scope.
_cc_need_val() {
  (( _cc_oi + 1 < ${#_cc_override_argv[@]} )) \
    || die 11 "Config override '$_cc_flag' requires a value."
  _cc_val="${_cc_override_argv[$((_cc_oi+1))]}"
}

_create_config() {
  local scope="$1"
  local profile="${2:-atv-directplay-hq}"
  local force="${3:-0}"
  shift 3
  local -a _cc_override_argv=("$@")

  # Parse config override flags into global associative array _CC_OVERRIDES.
  declare -gA _CC_OVERRIDES=()
  local _cc_flag _cc_val _cc_oi=0
  while (( _cc_oi < ${#_cc_override_argv[@]} )); do
    _cc_flag="${_cc_override_argv[$_cc_oi]}"
    case "$_cc_flag" in
      --crf)                        _cc_need_val;_CC_OVERRIDES[CRF_VALUE]="$_cc_val";                (( _cc_oi += 2 )) ;;
      --preset)                     _cc_need_val;_CC_OVERRIDES[PRESET_VALUE]="$_cc_val";             (( _cc_oi += 2 )) ;;
