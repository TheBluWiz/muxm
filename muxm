apply_profile_streaming_av1() {
  # AV1 streaming profile. Opus audio, MP4 container, CRF 30 (_apply_av1_resolution_crf
  # drops it to 28 for >=4K or HDR sources — resolution-aware A1; an explicit --crf still wins).
  # Optimized for platforms that accept AV1 (YouTube, Netflix ingest).
  # VMAF 97.70 at 1080p SDR, 90.65 at 4K HDR.
  DISABLE_DV=1
  ALLOW_DV_FALLBACK=0
  DV_CONVERT_TO_P81_IF_FAIL=0
