# ---- Terminal verbosity & color (Phase 6; Phase 7 made VERBOSITY a .muxmrc knob) ----
# VERBOSITY gates what muxm's OWN narration prints to the TERMINAL — the LOG always stays complete
# (quiet routes suppressed lines to the log only). It is the human-facing enum quiet|normal|verbose
# (the tracked .muxmrc knob, default normal); the hot-path helpers gate on the derived numeric
# _VERBOSITY_N (0=quiet, 1=normal, 2=verbose) so a string can't sneak into an (( )). The CLI pre-scan
# below touches only _VERBOSITY_N, never VERBOSITY, so the _MUXM_PRE_CONFIG snapshot (§6) still
# captures the script default — a generated config emits the default, not the invoking CLI choice.
VERBOSITY="normal"
declare -i _VERBOSITY_N=1
# USE_COLOR=0 strips muxm's emoji prefixes (no ANSI is emitted) for CI/plain logs. Honour the
# NO_COLOR convention (https://no-color.org); --no-color also sets it. _PFX_* are referenced by
# say/note/warn/die via ${_PFX_-default} so they are set -u-safe even before this resolves.
declare -i USE_COLOR=1
[[ -n "${NO_COLOR:-}" ]] && USE_COLOR=0
_PFX_NOTE="ℹ️  "; _PFX_WARN="⚠️  "; _PFX_ERR="❌ ERROR: "; _PFX_FAIL="❌ "
if (( ! USE_COLOR )); then _PFX_NOTE=""; _PFX_WARN="Warning: "; _PFX_ERR="ERROR: "; _PFX_FAIL=""; fi
# Early pre-scan: resolve verbosity/color from the CLI NOW, before config-load/profile narration
# (§6/§11) fires — otherwise --quiet/--no-color couldn't suppress those pre-parse messages because
# the main arg loop (§12) hasn't run yet. The main loop still handles these flags (drift guard).
for _va in "$@"; do
  case "$_va" in
    --quiet)    _VERBOSITY_N=0 ;;
    --verbose)  _VERBOSITY_N=2 ;;
    --no-color) USE_COLOR=0; _PFX_NOTE=""; _PFX_WARN="Warning: "; _PFX_ERR="ERROR: "; _PFX_FAIL="" ;;
  esac
done
unset _va

