  PRESET_VALUE=6
  SVT_AV1_PARAMS_BASE='film-grain=0:enable-overlays=1:scd=1'
  HDR_TARGET_PIXFMT="yuv420p10le"
  FORCE_CHROMA_420=1
  AUDIO_LOSSLESS_PASSTHROUGH=0
  AUDIO_FORCE_CODEC="libopus"
  # Multichannel bitrate controlled via AUDIO_FORCE_BITRATE
  AUDIO_FORCE_BITRATE="256k"
  ADD_STEREO_IF_MULTICH=0
  STEREO_BITRATE="192k"
  SUB_INCLUDE_FORCED=1
  SUB_INCLUDE_FULL=1
  SUB_INCLUDE_SDH=0
  SUB_BURN_FORCED=0
  KEEP_CHAPTERS=1
  STRIP_METADATA=0
}

# _apply_av1_resolution_crf — resolution/HDR-aware CRF for the AV1 profiles.
# Must run after the source is probed (PROFILE_DESC reflects the HDR/HLG decision). For
# >=4K (width >= 3840 or height >= 2160) or HDR/HLG sources, drops the profile's base SDR
# CRF to its 4K/HDR target; otherwise the base (≤1080p-SDR) CRF is kept. An explicit --crf
# always wins (gated by _CLI_CRF_EXPLICIT). Calibration: docs/AV1_CALIBRATION.md.
#   streaming-av1: base 30 (≤1080p SDR) → 28 (>=4K or HDR)
#   av1-hq:        base 28 (≤1080p SDR) → AV1_HQ_HDR_CRF (24) (>=4K or HDR)
_apply_av1_resolution_crf() {
  (( _CLI_CRF_EXPLICIT )) && return 0
  local _target
  case "${PROFILE_NAME:-}" in
    streaming-av1) _target=28 ;;
    av1-hq)        _target="$AV1_HQ_HDR_CRF" ;;
    *)             return 0 ;;
  esac

  local _w _h _is4k=0 _hdr=0
  _w="$(_probe_field width)"; _h="$(_probe_field height)"
  [[ "$_w" =~ ^[0-9]+$ ]] && (( _w >= 3840 )) && _is4k=1
  [[ "$_h" =~ ^[0-9]+$ ]] && (( _h >= 2160 )) && _is4k=1
  [[ "$PROFILE_DESC" == "HDR10" || "$PROFILE_DESC" == "HLG" ]] && _hdr=1

  if (( _is4k || _hdr )); then
    CRF_VALUE="$_target"
    note "${PROFILE_NAME}: ${_w:-?}×${_h:-?} ${PROFILE_DESC} source → CRF ${_target} (4K/HDR quality; the ≤1080p-SDR default is higher)"
    report_add "av1_crf_resolution_aware" "CRF ${_target} (${_w:-?}×${_h:-?}, ${PROFILE_DESC})"
  fi
}

apply_profile_animation() {
  # Goal: Banding-free, artifact-free animation. Preserve flat gradients and hard edges.
  DISABLE_DV=1
  ALLOW_DV_FALLBACK=0
  DV_CONVERT_TO_P81_IF_FAIL=0
  # Container: mkv (ASS/SSA subtitle support, lossless audio)
  OUTPUT_EXT="mkv"
  # Video: HEVC, quality-first, animation-tuned x265 params
  VIDEO_CODEC="libx265"
  VIDEO_COPY_IF_COMPLIANT=0
  CRF_VALUE=16
  PRESET_VALUE="slower"
  X265_PARAMS_BASE='profile=main10:repeat-headers=1:aq-mode=3:aq-strength=0.8:psy-rd=1.0:psy-rdoq=0.5:rc-lookahead=60:deblock=-1,-1:bframes=8'
  HDR_TARGET_PIXFMT="yuv420p10le"
  FORCE_CHROMA_420=1
  SDR_USE_10BIT_IF_SRC_10BIT=1
  SDR_FORCE_10BIT=1
  # Audio: lossless passthrough (FLAC-first for anime releases)
  AUDIO_LOSSLESS_PASSTHROUGH=1
  ADD_STEREO_IF_MULTICH=0
  STEREO_BITRATE="192k"
  AUDIO_CODEC_PREFERENCE="flac,truehd,eac3,ac3,aac,alac,other"
  # Subs: multi-track, keep all, never burn (preserve ASS styling + PGS bitmaps)
  SUB_MULTI_TRACK=1
  SUB_INCLUDE_FORCED=1
  SUB_INCLUDE_FULL=1
  SUB_INCLUDE_SDH=1
  SUB_MAX_TRACKS=6
  SUB_BURN_FORCED=0
  SUB_EXPORT_EXTERNAL=0
  SUB_PRESERVE_TEXT_FORMAT=1
  # Chapters/metadata: keep (OP/ED chapter markers)
  KEEP_CHAPTERS=1
  STRIP_METADATA=0
}

apply_profile_youtube_upload() {
  # Goal: H.264 high-profile for YouTube ingestion. Master quality, AAC stereo, soft/export subs.
  DISABLE_DV=1
  ALLOW_DV_FALLBACK=0
  DV_CONVERT_TO_P81_IF_FAIL=0
  # Container: mp4 (required by YouTube)
  OUTPUT_EXT="mp4"
  # Video: H.264 high-profile, quality-first
  VIDEO_CODEC="libx264"
  VIDEO_COPY_IF_COMPLIANT=0
  SKIP_IF_IDEAL=0
  CRF_VALUE=16
  PRESET_VALUE="slow"
  FORCE_CHROMA_420=1
  X264_PARAMS_BASE='profile=high:rc-lookahead=60:aq-mode=2:aq-strength=1.0'
  # HDR: preserve pixel format, no DV, no tone-map (let YouTube handle it)
  TONEMAP_HDR_TO_SDR=0
  HDR_TARGET_PIXFMT="yuv420p10le"
  # Audio: keep the best-scored track; YouTube re-encodes server-side
  STEREO_BITRATE="256k"
  AUDIO_LOSSLESS_PASSTHROUGH=0
  ADD_STEREO_IF_MULTICH=0
  # Subs: soft forced, export full as external SRT
  SUB_INCLUDE_FORCED=1
  SUB_INCLUDE_FULL=1
  SUB_INCLUDE_SDH=0
  SUB_BURN_FORCED=0
  SUB_EXPORT_EXTERNAL=1
  # Chapters/metadata: strip fluff, keep chapters
  STRIP_METADATA=1
  KEEP_CHAPTERS=1
}

# _profile_comment — return the profile tagline for container comment metadata.
# Returns empty string for unrecognised/absent profiles (no comment written).
_profile_comment() {
  case "${PROFILE_NAME:-}" in
    archive)                    echo "Preserved in digital amber." ;;
    hdr10-hq)                   echo "All the nits, none of the drama." ;;
    atv-directplay-hq)          echo "Shaped to please the most demanding rectangle in your living room." ;;
    atv-directplay-animation)   echo "Studio Ghibli didn't suffer for mov_text." ;;
    streaming-hevc)             echo "Lean, mean, streaming machine." ;;   # RF12: dropped unreachable 'streaming' alias arm (apply_profile normalizes PROFILE_NAME first)
    av1-hq)                     echo "Fewer bits, same nits." ;;
    streaming-av1)              echo "Stream smarter, not larger." ;;
    animation)                  echo "psy-rd turned down, sakuga turned up." ;;
    universal)                  echo "Lowest common denominator, highest common decency." ;;
    youtube-upload)             echo "Your master, YouTube's problem." ;;
