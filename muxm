declare -i AUDIO_MULTI_TRACK=0
# Filter: exclude commentary/descriptive audio tracks (multi-track mode only)
declare -i AUDIO_KEEP_COMMENTARY=1

# ---- Profile-introduced variables (safe defaults preserve current behavior)
