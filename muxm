  SUB_OCR_LANG              = $SUB_OCR_LANG
  SUB_PRESERVE_TEXT_FORMAT  = $SUB_PRESERVE_TEXT_FORMAT
  SUB_PRESERVE_BITMAP       = $SUB_PRESERVE_BITMAP
