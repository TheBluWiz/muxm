# ---- Hardware acceleration
# HW_ACCEL selects the backend used by the video encoder dispatch layer.
#   none         — force pure-software encoders (libx265/libx264/libsvt-av1)
#   auto         — detect and pick the best available backend on this host
#   videotoolbox — Apple Silicon VideoToolbox (HEVC/H.264; no AV1 HW encode)
#   nvenc        — NVIDIA NVENC (HEVC/H.264; AV1 on Ada Lovelace/RTX 40+)
# Phase 2 adds the VideoToolbox dispatch arm; Phase 3 adds NVENC.
HW_ACCEL="none"
# Reserved foundation for the VideoToolbox (v1.5.0) / NVENC (v1.6.0) backends: records
# whether the user typed --hw-accel explicitly, for the future "explicit backend beats
# profile/config default" precedence decision (mirrors _CLI_CRF_EXPLICIT). Set at parse,
# not yet read — see docs/HW_ACCEL.md.
declare -i _CLI_HW_ACCEL_EXPLICIT=0
declare -a HW_ACCEL_AVAILABLE=()   # populated by detect_hw_accel()
HW_ACCEL_RESOLVED=""               # concrete backend after auto→explicit resolution
HW_ACCEL_FALLBACK_REASON=""        # set when an incompatibility forces software fallback

# ---- VideoToolbox quality map
# hevc_videotoolbox / h264_videotoolbox use `-q:v N` (0-100, higher=better) as
# their quality knob instead of x265/x264's CRF. VT_QUALITY_MAP stores the
# calibrated quality value per profile — the fixed point where VT's VMAF
# matches (within tolerance) the profile's software CRF baseline.
#
# Empirically calibrated q:v values — see docs/VIDEOTOOLBOX_CALIBRATION.md.
# Method: VMAF sweep vs each profile's SW baseline; pass = |Δ VMAF| ≤ 0.5.
# Calibrating clip: Clip B (4K HDR10) for HDR profiles; Clip A (1080p SDR)
# for SDR/upload profiles; Clip C (1080p SDR animation: Arcane S01E01) for
# animation profiles. Sweeps run 2026-06-10/11.
# The default (65) applies when --profile is not set or the profile is absent.
#
# youtube-upload: q:v 75 is SDR-calibrated (Clip A). The 4K HDR cross-check
# calibrated at q:v 80, but that path (H.264 + HDR + no tone-map) produces
# 8-bit output with PQ metadata — an accepted limitation. See OQ#3 in
# docs/VIDEOTOOLBOX_CALIBRATION.md §5.
#
# animation / atv-directplay-animation: q:v 65 calibrated on Clip C. Live-action
# calibration (Clip B) gave q:v 70, but animation content (sharp edges,
# flat gradients) shifts the operating point. VT ignores x265 profile params,
# so both profiles produce identical HW VMAF; values reflect animation content.
declare -A VT_QUALITY_MAP=(
  [hdr10-hq]=70
  [atv-directplay-hq]=70
  [atv-directplay-animation]=65
  [streaming-hevc]=65
  [animation]=65
  [universal]=70
  [youtube-upload]=75
)
declare -i VT_QUALITY_DEFAULT=65

