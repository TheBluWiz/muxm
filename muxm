EOF
  exit 0
}

# D4: when --print-effective-config is requested, resolve the output container + ATV subtitle
# policy FIRST (mirroring Section 15) so the diagnostic reports what the encode will actually do
# — not pre-resolution globals (which mis-reported OUTPUT_EXT and masked the D1 SUB_PRESERVE_*
# clobber). Resolution needs a source path to derive passthrough/inferred containers; with no
# source we leave OUTPUT_EXT empty and print_effective_config shows "<pending: needs source>".
# Multi-profile mode prints per child downstream, so skip resolution there (each child resolves
# its own container). Stays before Section 14 so the diagnostic still runs without ffmpeg/jq/bc.
if (( PRINT_EFFCONF )); then
  if (( ! _MULTI_PROFILE_MODE )); then
    SRC="${POSITIONALS[0]:-}"
    OUT="${POSITIONALS[1]:-}"
    if [[ -n "$SRC" ]]; then
      SRC_ABS="$(realpath_fallback "$SRC")"
      _resolve_output_and_sub_policy
    fi
  fi
  print_effective_config
fi

# ===== Section 14: Tool validation ============================================================
# F5: if a complete ffmpeg (libass + AV1) is installed as the keg-only `ffmpeg-full` but the one
# on PATH is incomplete, prefer the keg so all features work (it emits a note when it switches).
_prefer_complete_ffmpeg
need ffmpeg
need ffprobe
need jq
need bc
if (( ! DISABLE_DV )); then
  if command -v dovi_tool >/dev/null 2>&1; then
    _HAS_DOVI_TOOL=1
  else
    warn "dovi_tool not found — Dolby Vision handling will be disabled."
    DISABLE_DV=1
  fi
else
  # DV explicitly disabled, dovi_tool not needed
  :
fi

# mp4box (GPAC) is used to mux raw HEVC ES into MP4 with proper dvcC/dvvC box
# signaling. ffmpeg cannot synthesize dvcC from raw ES input — mp4box parses
# RPU NAL units natively and writes correct DV container metadata.
# Binary name varies by platform: MP4Box (macOS homebrew) vs mp4box (Linux).
if (( ! DISABLE_DV )); then
  if ! _detect_mp4box; then
    warn "mp4box (GPAC) not found — DV container signaling (dvcC box) may fail."
    warn "  Install: brew install gpac (macOS) or apt install gpac (Linux)"
  fi
fi

# Check AV1 encoder availability when libsvt-av1 or libaom-av1 is requested.
# Non-fatal probe: warn if not available now; die when actually selected at runtime.
if _is_av1_codec "$VIDEO_CODEC"; then
  if [[ "$VIDEO_CODEC" == "libsvt-av1" ]] && ! ffmpeg_has_encoder libsvtav1; then
    die 10 "libsvtav1 encoder not available in this ffmpeg build. Install a complete ffmpeg (e.g., brew install ffmpeg-full, or run muxm --install-dependencies)."
  fi
  if [[ "$VIDEO_CODEC" == "libaom-av1" ]] && ! ffmpeg_has_encoder libaom-av1; then
    die 10 "libaom-av1 encoder not available in this ffmpeg build. Install a complete ffmpeg (e.g., brew install ffmpeg-full, or run muxm --install-dependencies)."
  fi
fi

# Same fail-fast preflight for the software x26x encoders (M5) — runs after detect_hw_accel so
# HW_ACCEL_RESOLVED is known (the HW path uses hevc_videotoolbox/hevc_nvenc, not libx265/libx264).
_preflight_sw_video_encoder

# Strict check for explicit hardware acceleration requests. detect_hw_accel
# ran earlier (Section 13b) as a non-fatal probe so --print-effective-config
# could still run; here we enforce that an explicit --hw-accel or HW_ACCEL
# from config actually resolved to the requested backend.
case "$HW_ACCEL" in
  videotoolbox|nvenc)
    if [[ "$HW_ACCEL_RESOLVED" != "$HW_ACCEL" ]]; then
      if [[ "$HW_ACCEL" == "videotoolbox" ]] && ! is_apple_silicon && ffmpeg_has_encoder "hevc_videotoolbox"; then
        die 10 "Hardware acceleration '--hw-accel videotoolbox' requires Apple Silicon (arm64 Darwin). hevc_videotoolbox is present in this ffmpeg build but VideoToolbox is only accessible on Apple Silicon hosts. Use --hw-accel none or --hw-accel auto."
      else
        die 10 "Hardware acceleration '--hw-accel $HW_ACCEL' requested, but no matching encoder (hevc_${HW_ACCEL}) is available in this ffmpeg build. Install an ffmpeg build with ${HW_ACCEL} support, or use --hw-accel none/auto."
      fi
    fi
    ;;
esac

if (( SUB_ENABLE_OCR )); then
  # Security: reject OCR tool names containing shell metacharacters to prevent
  # injection via --ocr-tool or a malicious .muxmrc. Allows alphanumerics,
  # dots, hyphens, underscores, and forward slashes (for paths).
  if [[ "$SUB_OCR_TOOL" =~ [^a-zA-Z0-9_./-] ]]; then
    warn "[Subs] The configured OCR tool '${SUB_OCR_TOOL}' contains disallowed characters — OCR disabled for safety."
    SUB_ENABLE_OCR=0
  elif ! command -v "$SUB_OCR_TOOL" >/dev/null 2>&1; then
    warn "[Subs] OCR is enabled but '${SUB_OCR_TOOL}' is not in PATH — PGS OCR will be skipped."
    SUB_ENABLE_OCR=0
  fi
fi

# ===== Section 15: Input validation & security checks =========================================
SRC="${POSITIONALS[0]:-}"
OUT="${POSITIONALS[1]:-}"
(( ${#POSITIONALS[@]} > 2 )) && die 11 "Too many arguments — unexpected: ${POSITIONALS[*]:2}. $USAGE_SHORT"
[[ -z "$SRC" ]] && { print_usage; exit 0; }

# Validate output extension (security: prevent command injection)
case "$OUTPUT_EXT" in
  mp4|m4v|mov|mkv|"") ;;  # "" = container passthrough, resolved below once source is known
  *) die 11 "Invalid OUTPUT_EXT: must be mp4, m4v, mov, or mkv (got: $OUTPUT_EXT)" ;;
esac

# Re-validate CRF_VALUE after config load: a sourced config can assign directly to the
# declare -i variable, bypassing the CLI parser guard (C1).
if [[ ! "$CRF_VALUE" =~ ^[0-9]+$ ]] || (( CRF_VALUE > 51 )); then
  die 11 "Invalid CRF_VALUE from config: integer 0–51 expected (got: ${CRF_VALUE})"
fi

# Re-validate the level/rate value flags after config load, mirroring the CRF re-check (L3): a
# sourced .muxmrc assigns these directly, bypassing the parse-time guards above. LEVEL_VALUE,
# AV1_MAXRATE, and AV1_BUFSIZE are optional (blank = let the encoder decide), so gate on -n;
# STEREO_BITRATE always has a value (default 192k).
[[ -n "$LEVEL_VALUE"  && ! "$LEVEL_VALUE"  =~ $_RE_LEVEL ]]   && die 11 "Invalid LEVEL_VALUE from config: expected a numeric level like 5.1 (got: ${LEVEL_VALUE})"
[[ -n "$AV1_MAXRATE"  && ! "$AV1_MAXRATE"  =~ $_RE_BITRATE ]] && die 11 "Invalid AV1_MAXRATE from config: expected a bitrate like 20000k (got: ${AV1_MAXRATE})"
[[ -n "$AV1_BUFSIZE"  && ! "$AV1_BUFSIZE"  =~ $_RE_BITRATE ]] && die 11 "Invalid AV1_BUFSIZE from config: expected a bitrate like 40000k (got: ${AV1_BUFSIZE})"
[[ ! "$STEREO_BITRATE" =~ $_RE_BITRATE ]]                    && die 11 "Invalid STEREO_BITRATE from config: expected a bitrate like 192k (got: ${STEREO_BITRATE})"

# Resolve and validate source file
SRC_ABS="$(realpath_fallback "$SRC")"
[[ -f "$SRC_ABS" ]] || die 11 "Source file not found: $SRC_ABS — check the path (and quoting) and try again."
[[ -s "$SRC_ABS" ]] || die 11 "Source file is empty: $SRC_ABS — zero bytes on disk (incomplete download or failed export?)."
[[ -r "$SRC_ABS" ]] || die 11 "Source file not readable: $SRC_ABS — check the file's read permissions."

# Validate filename doesn't contain control characters (security)
# This catches newlines, tabs, null bytes, and other chars that could cause
# field-splitting issues in the printf '%s\n' patterns used throughout.
if [[ "$SRC_ABS" =~ [[:cntrl:]] ]]; then
  die 11 "Source filename contains control characters - potential security risk. Rename the file to remove control characters."
fi

# ---- Multi-profile dispatch ------------------------------------------------------------------
# Must run after SRC_ABS is validated so we have a clean absolute source path,
# but before WORKDIR/TMP_OUT creation (those belong to single-profile children only).
# Each child sub-invocation runs independently with its own workdir and pipeline.
if (( _MULTI_PROFILE_MODE )); then
  _run_multi_profiles
  # on_exit EXIT trap fires after this exit; WORKDIR/TMP_OUT are empty → no-op cleanup.
  exit $?
fi
# ---- End multi-profile dispatch --------------------------------------------------------------

# ---- Resolve output container + ATV subtitle policy -----------------------------------------
# Output-filename inference, container passthrough, and the ATV MKV subtitle adjustment all live
# in _resolve_output_and_sub_policy (Section 13) so --print-effective-config can resolve the same
# way and report the post-resolution config (D4). Only runs in single-profile mode (multi-profile
# dispatched and exited above); SRC_ABS is validated, OUT is set.
_resolve_output_and_sub_policy
# ---- End output container + subtitle policy resolution --------------------------------------

# Determine output path
if [[ -z "${OUT:-}" ]]; then
  base="${SRC_ABS%.*}"
  OUT="${base}.${OUTPUT_EXT}"
fi

# Resolve output directory and validate
OUT_DIR="$(dirname -- "$OUT")"
OUT_DIR="$(if cd -- "$OUT_DIR" 2>/dev/null; then pwd; else echo "$OUT_DIR"; fi)"
[[ -d "$OUT_DIR" ]] || die 11 "Output directory does not exist: $OUT_DIR"
[[ -w "$OUT_DIR" ]] || die 11 "Output directory not writable: $OUT_DIR"

OUT_BASENAME="$(basename -- "$OUT")"
OUT_ABS="${OUT_DIR}/${OUT_BASENAME}"
OUT="$OUT_ABS"

# Validate output doesn't contain control characters (security)
if [[ "$OUT_ABS" =~ [[:cntrl:]] ]]; then
  die 11 "Output filename contains control characters - potential security risk. Rename the file to remove control characters."
fi

# Prevent overwriting source file (security/safety)
# --replace-source / --force-replace-source: allow source replacement
# Otherwise: auto-version the output filename to avoid collision
declare -i _REPLACING_SOURCE=0
if [[ "$SRC_ABS" -ef "$OUT_ABS" ]]; then
  if (( FORCE_REPLACE_SOURCE )); then
    _REPLACING_SOURCE=1
    note "Source will be replaced (--force-replace-source): $SRC_ABS"
  elif (( REPLACE_SOURCE )); then
    printf '⚠️  Are you sure you want the original file replaced? (y/n) '
    read -r _confirm || _confirm=""  # M6: REPLACE_SOURCE via .muxmrc bypasses the --replace-source TTY guard; treat a non-interactive EOF as a decline (clean die 11 below) instead of an ERR-trap crash
    if [[ "$_confirm" == [Yy]* ]]; then
      _REPLACING_SOURCE=1
      note "Source will be replaced (confirmed): $SRC_ABS"
    else
      die 11 "Aborted — source replacement declined by user."
    fi
  else
    # Auto-version: filename(1).ext, filename(2).ext, ...
    _ver_base="${OUT_ABS%.*}"
    _ver_ext="${OUT_ABS##*.}"
    _ver=1
    OUT_ABS="${_ver_base}(${_ver}).${_ver_ext}"
    while [[ -e "$OUT_ABS" ]]; do
      (( _ver++ ))
      OUT_ABS="${_ver_base}(${_ver}).${_ver_ext}"
    done
    OUT_BASENAME="$(basename -- "$OUT_ABS")"
    OUT="$OUT_ABS"
    note "Source collision — output renamed to: $OUT_BASENAME"
  fi
fi

# --no-overwrite: refuse if final output already exists
if (( ! FFMPEG_OVERWRITE )) && [[ -f "$OUT_ABS" ]]; then
  die 11 "Output file already exists (--no-overwrite): $OUT_ABS — remove --no-overwrite to overwrite, or choose a different output path."
fi

# Temp output file name (L1): mktemp creates a 0600 file, then we delete it and re-add the
# extension so the muxer writes to a name with the right suffix. NOTE on the TOCTOU window — the
# mktemp name is NOT a secret: an attacker with write access to OUT_DIR can read it from a
# directory listing and, in the gap between the rm below and ffmpeg's open, plant a symlink at
# that path that ffmpeg's -y then writes through. So the real precondition is a shared/world-
# writable OUT_DIR (an attacker with write access there already controls the output location);
# the random name only thwarts blind pre-creation, not an attacker who observes the listing.
# Honest severity is Low (it needs a hostile OUT_DIR). mktemp --suffix would avoid the rm→reuse
# but is not portable to BSD/macOS. CR-8: the same observe-then-symlink class — and the same Low
# severity and hostile-OUT_DIR precondition — covers ALL the predictable post-run artifacts written
# into OUT_DIR with a deterministic name via `>` / `cp -f` / `mkdir -p` (which follow a pre-planted
# symlink): write_checksum's ${OUT}.${algo}, write_json_report's ${OUT%.ext}.report.json, _persist_log's
# ${OUT%.ext}.muxm.log (--keep-log), and _persist_failure_bundle's ${OUT%.ext}.muxm-debug/ dir.
# All share this accepted trade-off; none is separately hardened (write-to-WORKDIR-then-mv was
# considered and deferred — it buys nothing an attacker who already controls OUT_DIR can't defeat).
TMP_OUT="$(mktemp "$OUT_DIR/.muxm.output.XXXXXXXX")" || die 11 "Cannot create temp output file"
rm -f "$TMP_OUT"  # Remove the file, we just wanted the name
TMP_OUT="${TMP_OUT}.${OUTPUT_EXT}"

# Durable landing paths for the run log / failure diagnostics, resolved once now
# that OUT/OUTPUT_EXT are final. Same naming convention as write_json_report
# (${OUT%.ext}.report.json) so all post-run artifacts sit beside the output on the
# OUT_DIR volume — already validated to exist and be writable just above. on_exit
# copies into these (only after the tee is drained, before WORKDIR is removed).
#   --keep-log (clean success): copy the log → LOG_PERSIST_PATH
#   any failure (always):       copy a small bundle → DEBUG_BUNDLE_DIR/
LOG_PERSIST_PATH="${OUT%."${OUTPUT_EXT}"}.muxm.log"
DEBUG_BUNDLE_DIR="${OUT%."${OUTPUT_EXT}"}.muxm-debug"

# Determine mux format
MUX_FORMAT="mp4"
case "$OUTPUT_EXT" in
  mp4|m4v) MUX_FORMAT="mp4" ;;
  mov)     MUX_FORMAT="mov" ;;
  mkv)     MUX_FORMAT="matroska" ;;
esac

# ===== Section 16: Build ffmpeg/ffprobe flags =================================================
# Assemble the base flag arrays used for every ffmpeg and ffprobe invocation.
# These arrays are prepended to command-specific flags throughout the pipeline,
# ensuring consistent loglevel, banner suppression, overwrite policy, and probe
# settings (analyzeduration/probesize) across all subprocess calls.
FFMPEG_FLAGS=()
FFPROBE_FLAGS=()

(( FFMPEG_HIDE_BANNER )) && FFMPEG_FLAGS+=(-hide_banner)
FFMPEG_FLAGS+=(-loglevel "$FFMPEG_LOGLEVEL")
(( FFMPEG_OVERWRITE )) && FFMPEG_FLAGS+=(-y)

FFPROBE_FLAGS=(-v "$FFPROBE_LOGLEVEL")

PROBE_OPTS=(-analyzeduration 100M -probesize 100M)
FFMPEG_FLAGS+=("${PROBE_OPTS[@]}")
FFPROBE_FLAGS+=("${PROBE_OPTS[@]}")

# ===== Section 17: Workdir & logging ==========================================================
# Workdir holds all multi-GB intermediates. By default it lives next to the output
# (OUT_DIR); --workdir DIR relocates it to a roomier volume so intermediates don't
# fill the output disk. The final output temp (TMP_OUT) always stays in OUT_DIR so
# the closing rename to the final path is atomic (same volume).
WORKDIR_PARENT="$OUT_DIR"
if [[ -n "$WORKDIR_BASE" ]]; then
  [[ -d "$WORKDIR_BASE" ]] || die 11 "--workdir directory does not exist: $WORKDIR_BASE"
  [[ -w "$WORKDIR_BASE" ]] || die 11 "--workdir directory is not writable: $WORKDIR_BASE"
  WORKDIR_PARENT="$WORKDIR_BASE"
fi
WORKDIR="$(
  mktemp -d "${WORKDIR_PARENT}/.muxm.tmp.XXXXXXXX"
)" || die 11 "Cannot create working directory under: $WORKDIR_PARENT"
[[ -n "$WORKDIR_BASE" ]] && note "Workdir relocated to: $WORKDIR (intermediates kept off the output volume)"
LOGFILE="$WORKDIR/muxm.$(date +%Y%m%d-%H%M%S).log"

# RF12: arm the EXIT trap NOW — immediately after the workdir exists — instead of later (before the
# output-lock acquisition). This closes the sub-second window in which a SIGINT/SIGTERM between
# workdir creation and the old arm point would leak the (possibly multi-GB) workdir. on_exit is safe
# to run with the still-partial state here: _drain_tee no-ops while TEE_PID/TERM_FD are empty (the tee
# is set up just below), the lock release is gated on _OUT_LOCK_HELD (not yet set), and TMP_OUT/OUT
# are ${VAR:-}-guarded, so a signal now performs a clean workdir-only teardown.
trap 'on_exit' EXIT

# ---- Begin logging to file ----
# Redirect stdout and stderr through tee to capture all output in the log file
# while still displaying it on the terminal.
#
# FD 3 is preserved as a "raw terminal" descriptor BEFORE the redirect. This
# allows spinner/progress-bar code to write \r-based updates directly to the
# terminal without polluting the log file with ANSI cursor movements.
#
# Lifecycle: FD 3 is opened here and closed in on_exit() (Section 18) during
# cleanup, completing the descriptor lifecycle.
#
# After this section:
#   stdout/stderr → tee → log file + terminal
#   FD 3          → raw terminal (bypasses tee)
# The tee block now runs UNCONDITIONALLY — including under DEBUG=1 (Phase 6 decouple). Previously
# DEBUG skipped it entirely so `set -x` xtrace wouldn't flood the logfile through the tee, which
# left the one mode you most want a persistent log producing none. Instead we keep the tee and
# siphon xtrace to the raw terminal FD (see BASH_XTRACEFD below), so the logfile stays clean.
: > "$LOGFILE" 2>/dev/null || true
# Flush the pre-§17 narrative captured in _LOG_BUFFER (config/profile/conflict/ignored-knob/
# validation messages) into the freshly-created logfile, so the log tells the WHOLE story —
# the "why", not just the post-banner pipeline. One-shot direct append; then drop the buffer.
if [[ -n "$_LOG_BUFFER" ]]; then
  printf '%s' "$_LOG_BUFFER" >> "$LOGFILE" 2>/dev/null || true
  _LOG_BUFFER=""
fi
_STEP_T0=$SECONDS   # baseline for per-step timing (mark_done)
# Preserve a raw terminal FD for spinner / progress-bar output.
# After the exec redirect, stdout and stderr both go through tee → log + terminal.
# FD 3 bypasses tee so \r-based progress UI doesn't pollute the log file.
exec 3>&2
TERM_FD=3
# DEBUG decouple (Phase 6, option a): point `set -x` xtrace at the raw terminal (FD 3) so the trace
# stays on screen as before, but does NOT flow through the tee into the logfile. Must be set before
# the tee redirect below; on_exit runs `set +x` before closing FD 3 so no traced command writes to
# a closing descriptor.
[[ "${DEBUG:-0}" == "1" ]] && BASH_XTRACEFD=3
# Hold the tee on an explicit descriptor (fd 4) so _drain_tee can close it deterministically.
# With the bare `exec > >(tee …)` form, the shell keeps an unnamed write-end to the process
# substitution open until it exits, so at drain time tee never sees EOF and `wait $TEE_PID`
# blocks until the watchdog kills it (~5s of dead wait on every run). Owning the write-end on
# a named fd lets us close it explicitly → tee gets EOF immediately → wait returns at once.
# Fixed fd number (not the {var}> form) for bash 3.2 portability.
exec 4> >(tee -a "$LOGFILE"); TEE_PID=$!
exec 1>&4 2>&4
_LOG_READY=1   # tee is live: note/warn/say now reach the log via the tee; log() appends directly
note "Logging to $(realpath_fallback "$LOGFILE")"
# Self-describing log: dump the resolved effective config (log-only, captured via $() so it
# never reaches the terminal) so "why did it do X" is answerable from the file alone.
# NOTE: as of Phase 2 print_effective_config runs on EVERY normal run (not just under
# --print-effective-config), so it is on the hot path — every variable it references must stay
# ${x:-}-guarded (set -u-safe), or an unguarded addition would crash every run, not just the
# diagnostic flag. Keep it side-effect-free.
log "$(print_effective_config)"

# ===== Section 18: Traps ======================================================================
trap 'on_error $LINENO "$BASH_COMMAND" "$?"' ERR
trap 'FAILED=1; EXIT_CODE=130; FAIL_MSG="Interrupted by user (SIGINT)"; _term_print "\n"; exit 130' INT
trap 'FAILED=1; EXIT_CODE=143; FAIL_MSG="Terminated (SIGTERM)"; exit 143' TERM

_print_completed_steps(){
  [[ ${#COMPLETED_STEPS[@]} -gt 0 ]] || return 0
  echo "---- Completed steps ----"
  for s in "${COMPLETED_STEPS[@]}"; do echo "  • $s"; done
}

# _cleanup_workdir — Remove WORKDIR after a run, with safety guard.
# Args: $1 = 1 to also honour KEEP_TEMP (failure path), 0 for success path.
# Globals read: WORKDIR, DEBUG, KEEP_TEMP, KEEP_TEMP_ALWAYS
_cleanup_workdir() {
  local keep_on_failure="${1:-0}"
  if [[ -n "$WORKDIR" && -d "$WORKDIR" && "${DEBUG:-0}" != "1" && $KEEP_TEMP_ALWAYS -eq 0 ]]; then
    if (( keep_on_failure && KEEP_TEMP )); then
      note "Keeping failure artifacts at: $WORKDIR"
      return
    fi
    if (( ! keep_on_failure )); then
      (( KEEP_TEMP )) && note "--keep-temp preserves workdir on failure only; use -K/--keep-temp-always to keep on success."
    fi
    # Safety: only remove if path matches expected .muxm.tmp. pattern
    if [[ "$WORKDIR" == *"/.muxm.tmp."* ]]; then
      rm -rf "$WORKDIR"
    else
      warn "Refusing to remove unexpected workdir path: $WORKDIR"
    fi
  else
    if (( keep_on_failure )); then
      note "Keeping failure artifacts at: $WORKDIR"
    else
      note "Keeping workdir: $WORKDIR"
    fi
  fi
}

# _reclaim — Delete a large, provably-dead intermediate mid-run to cap peak disk
# usage. Runs regardless of -k/-K: those flags preserve the workdir and the small
# logs/.err/RPU files needed for post-mortem, but the multi-GB video intermediates
# are never useful for debugging and are the disk hogs. No-op in dry-run, and only
# ever removes paths inside WORKDIR.
# Args: $1 = file path; $2 = short reason (logged)
# Globals: WORKDIR, DRY_RUN
_reclaim() {
  local f="${1:-}" reason="${2:-}"
  (( DRY_RUN )) && return 0
  [[ -n "$f" && -e "$f" ]] || return 0
  # CR-12: require a non-empty WORKDIR before the prefix guard. If WORKDIR were ever empty the
  # `"$WORKDIR"/*` pattern degenerates to `/*`, matching any absolute path and defeating the
  # containment check. Not reachable today (WORKDIR is set before any _reclaim), but mirrors the
  # `-n "$WORKDIR"` precondition in _cleanup_workdir — defense-in-depth for a deletion path.
  [[ -n "$WORKDIR" ]] || { warn "Refusing to reclaim: WORKDIR is unset"; return 0; }
  case "$f" in
    "$WORKDIR"/*) ;;
    *) warn "Refusing to reclaim path outside workdir: $f"; return 0 ;;
  esac
  local sz_mb
  sz_mb="$(du -m "$f" 2>/dev/null | awk 'NR==1{print $1}')" || true
  rm -f "$f" 2>/dev/null || true
  [[ -n "$sz_mb" ]] && note "Reclaimed ${sz_mb} MB intermediate: $(basename "$f")${reason:+ ($reason)}"
  return 0
}

# _ensure_src_es — Demux the source video to a raw HEVC Annex B elementary stream
# at $V_SRC_ES, on demand. Idempotent: returns 0 immediately if already present.
# Only needed as the FILE fallback for DV RPU extraction when the piped extraction
# (ffmpeg → dovi_tool) fails; demuxing it eagerly wrote a full source-sized copy
# that was usually never read (peak-disk waste).
# Returns: 0 on success (file present & non-empty), 1 on failure.
# Globals: V_SRC_ES, SRC_ABS, WORKDIR, FFMPEG_FLAGS
_ensure_src_es() {
  [[ -s "$V_SRC_ES" ]] && return 0
  ffmpeg "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:v:0 -c copy -bsf:v hevc_mp4toannexb -f hevc "$V_SRC_ES" 2>"$WORKDIR/demux.err" &
  local _es_pid=$!
  if ! _await_tracked_pid "$_es_pid" "Demuxing video elementary stream (on demand)"; then
    local codec; codec="$(_probe_field codec_name)"
    warn "Could not demux raw HEVC ES (source codec: ${codec:-unknown})."
    warn "  DV RPU extraction requires an HEVC source stream. Use --no-dv to skip DV processing."
    warn "  See: $WORKDIR/demux.err for details."
    : > "$V_SRC_ES" 2>/dev/null || true
    return 1
  fi
  return 0
}

# on_exit — EXIT trap handler. Performs all end-of-run cleanup and reporting.
#
# Success path: atomically moves temp output to final path, writes checksum,
#   prints completed steps, cleans up workdir (unless --keep-temp-always).
# Failure path: prints failure message + completed steps, cleans up temp output,
#   preserves workdir for debugging (if --keep-temp or --keep-temp-always).
# Dry-run path: removes temp placeholder, reports completion.
#
# Globals read: FAILED, DRY_RUN, TMP_OUT, OUT, CHECKSUM, WORKDIR, DEBUG,
#               KEEP_TEMP, KEEP_TEMP_ALWAYS, EXIT_CODE, FAIL_MSG, TERM_FD

# _drain_tee — restore stdout/stderr to the terminal, drain the tee logger, and close FD 3.
# Identical work on the success and failure on_exit paths (A3 — DRY). Runs in the main shell
# (on_exit is the EXIT trap, not a subshell; a function call doesn't subshell), so the `exec`
# FD restore affects the right shell.
#
# POST-CONDITION (relied on by on_exit's persistence step): after this returns, fd 1 and
# fd 2 point at the real terminal (the saved TERM_FD), NOT at /dev/null — so on_exit can
# still print "Log saved …" / "Diagnostics …" / a copy-failure warning after the drain.
# Earlier this used `exec 4>&- 2>/dev/null` / `exec 3>&- 2>/dev/null`; an `exec` redirect is
# PERMANENT, so those silently left fd 2 pointing at /dev/null and swallowed any post-drain
# message. The closes never actually fail here (closing an open or already-closed fd both
# succeed), so error suppression is done with `|| true` (set -e-safe) instead — never with a
# `2>…` on an `exec`, which would clobber fd 2 again. Do not reintroduce one.
_drain_tee() {
  exec 1>&"${TERM_FD:-2}" 2>&"${TERM_FD:-2}" || true
  if [[ -n "${TEE_PID:-}" ]]; then
    # Close our write-end (fd 4, opened in Section 17) so tee sees EOF and exits promptly;
    # `wait $TEE_PID` then returns at once instead of blocking on a never-arriving EOF.
    exec 4>&- || true
    # Safety backstop in case some stray child still holds the pipe: a watchdog that holds NO
    # pipe fds of its own (it redirects 1/2 to /dev/null and closes 3/4, so neither it nor an
    # orphaned sleep can keep tee's input — or the caller's captured stdout — open) and is
    # SIGKILL'd the instant the wait returns, so it never adds latency. SIGKILL (not TERM)
    # because on_exit set `trap '' TERM`, which a forked subshell inherits — a plain kill would
    # be ignored and `wait` would then block for the full sleep. With the fd-close above this
    # backstop essentially never fires.
    ( trap '' ERR; exec 1>/dev/null 2>&1 3>&- 4>&-; sleep 2; kill "$TEE_PID" 2>/dev/null || true ) &
    local _tee_wd=$!
    wait "$TEE_PID" 2>/dev/null || true
    kill -KILL "$_tee_wd" 2>/dev/null || true
    wait "$_tee_wd" 2>/dev/null || true
  fi
  [[ -n "${TERM_FD:-}" ]] && { exec 3>&- || true; }
  return 0   # never let a false [[ … ]] above make the drain itself look like a failure (set -e)
}

# _persist_log — Copy the run log to its durable path beside the output (--keep-log,
# clean-success path). Pure copy; the caller (on_exit) owns all user messaging.
# MUST run AFTER _drain_tee (so $LOGFILE is fully flushed and closed) and BEFORE
# _cleanup_workdir (so the source still exists). Returns 0 on success or when there
# is genuinely nothing to copy (e.g. DEBUG=1 created no log); returns 1 only when a
# real log exists but the copy fails — the caller then keeps WORKDIR so it survives.
# Globals read: LOGFILE, LOG_PERSIST_PATH
_persist_log() {
  [[ -n "${LOGFILE:-}" && -f "$LOGFILE" && -n "${LOG_PERSIST_PATH:-}" ]] || return 0
  cp -f "$LOGFILE" "$LOG_PERSIST_PATH" 2>/dev/null || return 1
  return 0
}

# _persist_failure_bundle — On any failure, copy a small, self-contained diagnostics
# bundle beside the output (always, regardless of --keep-log): the run log PLUS every
# *.err / *.log in WORKDIR. Those are the ffmpeg / dovi_tool / MP4Box / OCR stderr and
# tool logs — i.e. the actual root-cause text the run log only *points at* (the log says
# "See: …/encode.err"; without the .err the pointer dangles once WORKDIR is removed).
# ALL of them are copied, not just the stage named in the failure message, because a
# late-stage failure (e.g. the final mux) is frequently rooted in an earlier stage's
# stderr. The multi-GB binary intermediates (*.hevc/.mkv/.mp4/.es/.aac/.bin, extracted
# subs) are deliberately excluded: never useful for triage, and already reclaimed
# mid-run by _reclaim. Everything copied is KB-scale.
# Pure copy; the caller (on_exit) owns messaging. Returns 0 if the bundle was written,
# 1 if a copy/mkdir failed (the failure may itself be "output volume full") — the caller
# then keeps WORKDIR so the real diagnostics survive somewhere.
# Globals read: LOGFILE, WORKDIR, DEBUG_BUNDLE_DIR
_persist_failure_bundle() {
  [[ -n "${DEBUG_BUNDLE_DIR:-}" ]] || return 0
  local rc=0 _f
  mkdir -p "$DEBUG_BUNDLE_DIR" 2>/dev/null || return 1
  # The run log itself (also matched by the *.log glob below, but copy it explicitly so
  # it is always present even if its naming convention changes).
  [[ -n "${LOGFILE:-}" && -f "$LOGFILE" ]] && { cp -f "$LOGFILE" "$DEBUG_BUNDLE_DIR/" 2>/dev/null || rc=1; }
  if [[ -n "${WORKDIR:-}" && -d "$WORKDIR" ]]; then
    # nullglob is not set, so an unmatched glob stays literal — the -f guard skips it.
    for _f in "$WORKDIR"/*.err "$WORKDIR"/*.log; do
      [[ -f "$_f" ]] || continue
      cp -f "$_f" "$DEBUG_BUNDLE_DIR/" 2>/dev/null || rc=1
    done
  fi
  return $rc
}

on_exit() {
  # M2: disarm ERR alongside INT/TERM/EXIT. This does NOT by itself keep cleanup running — `trap ''
  # ERR` only suppresses the on_error handler; `set -e` still exits on a failing command regardless.
  # What actually prevents the leak is GUARDING the failure-prone final steps below (the `if ! mv`
  # and `write_checksum || warn`) so a failed mv/checksum never trips set -e and aborts on_exit
  # mid-way (which would skip the drain/log-persist/workdir cleanup and leak the multi-GB workdir).
  # Disarming ERR here is the complementary half: it stops on_error from printing a spurious
  # "Command failed at line…" diagnostic during cleanup. Both together = clean, complete teardown.
  trap '' INT TERM ERR EXIT  # prevent re-entrancy + suppress the spurious ERR diagnostic during cleanup
  set +x 2>/dev/null || true   # stop DEBUG xtrace before the FD teardown closes BASH_XTRACEFD (FD 3)
  # Clean up subtitle burn-in temp file (lives inside WORKDIR; explicit removal before workdir cleanup)
  [[ -n "${_BURN_SRT_FILTER:-}" && -f "$_BURN_SRT_FILTER" ]] && rm -f "$_BURN_SRT_FILTER"

  # M4: release our output lock if (and only if) we acquired it. Gated on _OUT_LOCK_HELD so the
  # multi-profile parent (exits before acquiring) and a refused concurrent run never remove the
  # lock that another live run owns. Runs on every exit path, including SIGINT/SIGTERM.
  if (( ${_OUT_LOCK_HELD:-0} )) && [[ -n "${OUT:-}" ]]; then
    rm -rf "${OUT}.lock" 2>/dev/null || true
  fi

  local have_result=0 _persist_ok=1

  if (( DRY_RUN )); then
    have_result=1
  elif [[ -n "${TMP_OUT:-}" && -s "$TMP_OUT" ]]; then
    have_result=1
  elif [[ -n "${OUT:-}" && -s "$OUT" ]]; then
    have_result=1
  fi

  # Note: fd 3 (TERM_FD) is intentionally kept open here so the drain can restore
  # stdout/stderr to it before waiting on the tee process (H6).

  if (( FAILED == 0 && have_result == 1 )); then
    if (( DRY_RUN )); then
      [[ -f "$TMP_OUT" ]] && rm -f "$TMP_OUT"
      note "DRY-RUN complete — no real files were created."
    else
      # M2: surface a failed final mv/checksum cleanly (the ERR trap is disarmed above, so these no
      # longer abort cleanup) — warn and skip the success banner rather than claiming success.
      local _mv_ok=1
      if [[ -f "$TMP_OUT" ]] && ! mv -f "$TMP_OUT" "$OUT"; then
        _mv_ok=0
        warn "Could not move the finished output into place: $OUT (output volume full or unwritable?)."
      fi
      if (( _mv_ok )); then
        # macOS/APFS sets the UF_HIDDEN (user hidden) flag on dot-prefixed files
        # at the filesystem level. Our temp file (.muxm.output.XXXXXXXX) inherits
        # this flag, and `mv` preserves it even after renaming to a non-dot name.
        # This causes Finder to treat the final output as hidden. Clear it here.
        # No-op on Linux (chflags doesn't exist) and harmless if already clear.
        chflags nohidden "$OUT" 2>/dev/null || true
        (( _REPLACING_SOURCE )) && note "Original source file has been replaced."
        (( CHECKSUM )) && { write_checksum "$OUT" || warn "Could not write the checksum file for $OUT."; }
        note "Build SUCCEEDED."
      fi
    fi

    _print_completed_steps
    # Drain the tee FIRST so $LOGFILE is fully flushed + closed before we copy it; THEN
    # persist (only under --keep-log); THEN remove the workdir. A failed copy (e.g. the
    # output volume is full) must not destroy the only surviving log, so gate cleanup on
    # the copy succeeding. (Persistence runs post-drain, so its notes are terminal-only.)
    _drain_tee
    if (( KEEP_LOG )); then
      if _persist_log; then
        [[ -f "$LOG_PERSIST_PATH" ]] && note "Log saved: $LOG_PERSIST_PATH"
      else
        _persist_ok=0
        warn "Could not write log to $LOG_PERSIST_PATH — preserving workdir: $WORKDIR"
      fi
    fi
    (( _persist_ok )) && _cleanup_workdir 0
    exit 0
  else
    # Failure summary (D7): the detailed cause is printed ONCE — by die()/on_error() at the
    # failure site (_ERROR_PRINTED=1) — so this line stays terse and just folds in the exit code
    # and the durable diagnostics location. Only when no cause was printed (SIGINT/SIGTERM, or no
    # output produced) do we surface the reason here. Printed BEFORE the tee drains so it is
    # captured in the copied log — the bundle then self-documents where it lives. The bundle is
    # kept on every failure, regardless of --keep-log.
    if (( ${_ERROR_PRINTED:-0} )); then
      printf "%sBuild FAILED (exit %s). Diagnostics: %s/\n" "${_PFX_FAIL-❌ }" "${EXIT_CODE:-1}" "$DEBUG_BUNDLE_DIR"
    else
      [[ -z "$FAIL_MSG" ]] && FAIL_MSG="No output produced (likely an earlier parse/runtime error)."
      printf "%sBuild FAILED (exit %s): %s — Diagnostics: %s/\n" "${_PFX_FAIL-❌ }" "${EXIT_CODE:-1}" "$FAIL_MSG" "$DEBUG_BUNDLE_DIR"
    fi

    _print_completed_steps

    # Clean up temp output file on failure
    [[ -f "$TMP_OUT" ]] && rm -f "$TMP_OUT"

    # SIGKILL any still-running ffmpeg before draining so it releases the tee pipe's
    # write end; otherwise wait "$TEE_PID" blocks until ffmpeg exits on its own.
    if [[ -n "${_ACTIVE_FFMPEG_PID:-}" ]]; then
      kill -KILL "$_ACTIVE_FFMPEG_PID" 2>/dev/null || true
      wait "$_ACTIVE_FFMPEG_PID" 2>/dev/null || true
      _ACTIVE_FFMPEG_PID=""
    fi

    # Drain the tee FIRST (log fully flushed + closed), THEN copy the bundle out, THEN
    # remove the workdir. The copy may fail if the failure is itself "disk full on the
    # output volume" — if so, keep the workdir so the real diagnostics survive there.
    _drain_tee
    if _persist_failure_bundle; then
      _cleanup_workdir 1
    else
      warn "Could not write diagnostics to $DEBUG_BUNDLE_DIR — preserving workdir: $WORKDIR"
    fi
    exit "${EXIT_CODE:-1}"
  fi
}

# _acquire_out_lock — refuse to start when another LIVE muxm run already targets this $OUT, and
# reclaim a lock orphaned by a dead one (on_exit cannot run on SIGKILL). The lock is a directory
# (${OUT}.lock) created atomically by mkdir — portable across macOS and Linux, where flock(1)
# (util-linux) is unavailable. A pid file inside names the owner for the liveness check (mirrors
# run_parallel.sh's stale-dir sweep). Released in on_exit, gated on _OUT_LOCK_HELD. (M4)
_acquire_out_lock() {
  local lock="${OUT}.lock" owner tries=0 empty_tries=0
  while ! mkdir "$lock" 2>/dev/null; do
    owner=""; [[ -r "$lock/pid" ]] && read -r owner < "$lock/pid" 2>/dev/null
    if [[ "$owner" =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
      die 11 "Another muxm run (PID $owner) is already writing to this output: $OUT — wait for it to finish, choose a different output path, or remove the stale lock with: rm -rf '$lock'"
    fi
    # L2: an empty/unreadable pid file may simply mean the holder just won the mkdir race but has
    # not yet written its pid (the write happens immediately AFTER mkdir succeeds — see below). Do
    # not treat that sub-millisecond window as a stale lock to reclaim: give the holder a brief moment
    # to populate the pid and re-check, and only fall through to reclaim if it stays empty. A present
    # but non-numeric pid, or a numeric pid whose process is gone, is genuinely stale and reclaimed now.
    if [[ -z "$owner" ]] && (( ++empty_tries <= 3 )); then
      sleep 0.05
      continue
    fi
    # Owner dead or unidentifiable → stale lock. Reclaim and retry, bounded so a genuinely-stuck
    # path (e.g. a permission error) can't spin forever.
    (( ++tries > 3 )) && die 11 "Could not acquire the output lock '$lock' — remove it manually: rm -rf '$lock'"
    rm -rf "$lock" 2>/dev/null || true
  done
  printf '%s\n' "$$" > "$lock/pid" 2>/dev/null || true
  _OUT_LOCK_HELD=1
}

# M4: the EXIT trap is already armed (just after workdir creation, RF12) so the lock is guaranteed to
# be released, and the print-config / multi-profile early exits are already behind us — take an
# advisory lock on $OUT so two concurrent runs can't clobber each other's output, report, or log.
# Dry runs write nothing — skip.
(( DRY_RUN )) || _acquire_out_lock

# ===== Section 19: Disk space preflight =======================================================
# Estimates required disk space before starting an encode and aborts early if
# the destination volume is likely too small. Estimation uses CRF-to-ratio
# lookup tables (_crf_ratio) and preset multipliers (_preset_multiplier) to
# derive an expected output bitrate from the source, with a 25% safety margin.
# Both the output volume and the temp workdir volume are checked (they may differ
# when WORKDIR is on a separate filesystem). Disable with DISK_CHECK=0.

# _crf_ratio CODEC CRF — echo output/source bitrate ratio ×1000
# Used by disk_free_warn to estimate encoded video size from source bitrate.
_crf_ratio() {
  local codec="$1"
  local -i crf="${2:-18}"
  case "$codec" in
    libx265)
      case "$crf" in
        14) echo 720 ;; 15) echo 600 ;; 16) echo 480 ;; 17) echo 400 ;;
        18) echo 330 ;; 19) echo 270 ;; 20) echo 220 ;; 21) echo 180 ;;
        22) echo 160 ;; 23) echo 130 ;; 24) echo 100 ;; 25) echo 85  ;;
        26) echo 72  ;; 27) echo 58  ;; 28) echo 50  ;;
        *) (( crf < 14 )) && echo 850 || echo 35 ;;
      esac ;;
    libx264)
      case "$crf" in
        14) echo 1100 ;; 15) echo 920 ;; 16) echo 780 ;; 17) echo 650 ;;
        18) echo 550  ;; 19) echo 460 ;; 20) echo 390 ;; 21) echo 330 ;;
        22) echo 270  ;; 23) echo 230 ;; 24) echo 200 ;; 25) echo 160 ;;
        26) echo 140  ;; 27) echo 110 ;; 28) echo 100 ;;
        *) (( crf < 14 )) && echo 1300 || echo 70 ;;
      esac ;;
    libsvt-av1|libaom-av1)
      # Measured output/source bitrate ratios from AV1_CALIBRATION.md §6 (the prior
      # values under-estimated AV1 output size by 28–80%, causing the preflight to
      # under-warn). Out-of-range fallbacks bumped to stay monotonic with the table.
      case "$crf" in
        20)echo 320;;22)echo 260;;24)echo 211;;26)echo 189;;28)echo 178;;30)echo 166;;
        32)echo 153;;34)echo 130;;36)echo 108;;38)echo 88;;40)echo 70;;
        *)(( crf<20 ))&&echo 360||echo 55;;
      esac ;;
    *) echo 330 ;;  # fallback: x265 CRF 18 equivalent
  esac
}

# _preset_multiplier PRESET — echo encode-size multiplier ×1000 relative to medium
# Faster presets typically produce larger files at the same CRF.
_preset_multiplier() {
  case "${1:-medium}" in
    ultrafast) echo 2000 ;;
    superfast) echo 1400 ;;
    veryfast)  echo 1000 ;;
    faster)    echo 1050 ;;
    fast)      echo 1050 ;;
    medium)    echo 1000 ;;
    slow)      echo 1000 ;;
    slower)    echo 1000 ;;
    veryslow)  echo 950  ;;
    *)         echo 1000 ;;
  esac
}

# _av1_preset_multiplier PRESET — AV1 uses numeric presets (0=slowest/best, 13=fastest/worst)
# Lower numeric preset = more compression = smaller file at same CRF.
_av1_preset_multiplier() {
  case "${1:-6}" in
    0|1)       echo 900  ;;
    2|3|4)     echo 950  ;;
    5|6|7)     echo 1000 ;;
    8|9|10)    echo 1050 ;;
    11|12|13)  echo 1200 ;;
    *)         echo 1000 ;;
  esac
}

# _gb — format a byte count as "X.X" for GiB display (integer fallback).
_gb() { LC_NUMERIC=C printf '%.1f' "$(echo "scale=2; ${1:-0} / $BYTES_PER_GIB" | bc 2>/dev/null)" 2>/dev/null || echo "$(( ${1:-0} / BYTES_PER_GIB ))"; }

# disk_free_warn — smart disk space preflight
# Estimates output size from source bitrate + CRF/preset tables, then warns
# if estimated required space exceeds available space on the output (or temp) volume.
# When bitrate metadata is absent (common for MKV inputs), it falls back to the
# source file size: an effective bitrate is synthesized from size×8/dur so the same
# CRF-ratio/preset math runs, and copy/remux estimates are floored at the source size.
# This is hybrid by design — the per-copy size estimate is bitrate/size-derived, while
# peak_factor (1× copy / 2× non-DV / 3× DV) is the separate copy-count axis.
# Must be called AFTER cache_stream_metadata() so METADATA_CACHE is populated.
# Set DISK_CHECK=0 (--no-disk-check) to skip entirely.
disk_free_warn() {
  (( DISK_CHECK )) || return 0

  # ---- Duration (integer seconds, via three-tier cached lookup) ----
  local -i dur
  dur="$(_get_source_duration_secs)"
  (( dur <= 0 )) && dur=1

  # ---- Source file size (single stat; the bitrate-free fallback below) ----
  # MKV inputs frequently carry no per-stream (or container) bit_rate, which used to
  # collapse est_video_bytes to 0 and let the guard silently under-warn. The actual
  # file size is always available and is a sound conservative proxy.
  local -i src_size=0
  local _src_sz
  _src_sz="$(stat -f%z "$SRC_ABS" 2>/dev/null || stat -c%s "$SRC_ABS" 2>/dev/null || echo 0)"
  [[ "$_src_sz" =~ ^[0-9]+$ ]] && src_size="$_src_sz"

  # ---- Video estimate ----
  local -i est_video_bytes=0
  local vbr_raw
  vbr_raw="$(_jq_cache -r \
    '[.streams[] | select(.codec_type=="video")] | .[0].bit_rate // empty' | head -n1 || true)"
  local -i vbr=0
  if [[ "$vbr_raw" =~ ^[0-9]+$ ]]; then
    vbr="$vbr_raw"
  else
    # Fall back to container bit_rate (includes audio — still a useful upper bound)
    local fbr_raw
    fbr_raw="$(_jq_cache -r '.format.bit_rate // empty' | head -n1 || true)"
    [[ "$fbr_raw" =~ ^[0-9]+$ ]] && vbr="$fbr_raw"
  fi

  # Bitrate metadata absent but file size known: synthesize an effective bitrate
  # from the source size so the existing CRF-ratio/preset math still runs (copy mode
  # → ≈ source size; re-encode → ratio applied to the source-derived rate). src_size
  # includes audio + container, so this slightly overestimates the video portion —
  # the safe (conservative) direction for a disk guard.
  if (( vbr == 0 && src_size > 0 )); then
    vbr=$(( src_size * 8 / dur ))
  fi

  if (( vbr > 0 )); then
    if (( VIDEO_COPY_IF_COMPLIANT )); then
      # Copy mode: output ≈ source size (no CRF reduction).
      # NOTE (known marginal edge): this assumes the source is actually compliant and gets
      # stream-copied. If it is NOT compliant, muxm re-encodes instead, and a very low-CRF
      # (≤~14, near-lossless) re-encode of an already-large source can exceed this copy-sized
      # reservation — so the guard may under-warn in that narrow case. Acceptable: such profiles
      # target near-lossless preservation, where the operator is expected to provision headroom.
      est_video_bytes=$(( (vbr / 8) * dur ))
    else
      local -i ratio preset_mult
      ratio="$(_crf_ratio "$VIDEO_CODEC" "$CRF_VALUE")"
      case "$VIDEO_CODEC" in
        libsvt-av1|libaom-av1) preset_mult="$(_av1_preset_multiplier "$PRESET_VALUE")" ;;
        *)                     preset_mult="$(_preset_multiplier "$PRESET_VALUE")" ;;
      esac
      # shellcheck disable=SC2017 # Early division order is intentional: prevents signed-64-bit overflow on long 4K sources (H5).
      est_video_bytes=$(( vbr / 8 * dur / 1000 * ratio / 1000 * preset_mult ))
      # Floor a degenerate (collapsed-to-zero) re-encode estimate against a
      # source-derived estimate, so a stale/odd bit_rate tag can't defeat the guard.
      # Only fires when the bitrate math underflows to 0; legitimately small
      # (heavy-compression) estimates are left untouched to avoid over-blocking.
      if (( est_video_bytes == 0 && src_size > 0 )); then
        est_video_bytes=$(( src_size * ratio * preset_mult / 1000 / 1000 ))
      fi
    fi
  fi

  # ---- Audio estimate ----
  # Multi-track mode: estimate all streams; single-track mode: first stream only (approximation).
  local -i est_audio_bytes=0
  local -i n_audio
  n_audio="$(_audio_stream_count)"
  if (( n_audio > 0 )); then
    local -i max_tracks=$n_audio
    (( AUDIO_MULTI_TRACK )) || max_tracks=1
    local -i i
    for (( i=0; i<max_tracks; i++ )); do
      local a_info a_codec a_channels _a_lang a_bitrate _a_title
      a_info="$(_audio_stream_info "$i")"
      _split_tab "$a_info" a_codec a_channels _a_lang a_bitrate _a_title _ _ _  # C2: non-collapsing (RF3: sink trailing disposition fields)

      local -i ch=0
      [[ "$a_channels" =~ ^[0-9]+$ ]] && ch="$a_channels"

      # Passthrough if codec is already a compatible format and no forced transcode
      local -i is_passthrough=0
      if [[ -z "${AUDIO_FORCE_CODEC:-}" ]]; then
        case "${a_codec:-}" in
          eac3|ac3|aac|dts|truehd|mlp|flac) is_passthrough=1 ;;
        esac
      fi

      if (( is_passthrough )); then
        if [[ "$a_bitrate" =~ ^[0-9]+$ ]] && (( a_bitrate > 0 )); then
          est_audio_bytes=$(( est_audio_bytes + (a_bitrate / 8) * dur ))
        elif (( ch > 0 )); then
          # Estimate from channel count: ~96 kbps per channel
          est_audio_bytes=$(( est_audio_bytes + ch * 96000 * dur / 8 ))
        fi
      else
        # Transcoding to EAC-3: 64 kbps per channel (conservative)
        local -i ach=$(( ch > 0 ? ch : 6 ))
        est_audio_bytes=$(( est_audio_bytes + ach * 64000 * dur / 8 ))
      fi
    done
  fi

  # ---- Estimates (25% safety margin, 5 MB subtitle overhead) ----
  local -i sub_overhead=$(( 5 * 1024 * 1024 ))
  # Output file (lands in OUT_DIR):
  local -i est_output=$(( (est_video_bytes + est_audio_bytes + sub_overhead) * 125 / 100 ))

  # Peak working set (intermediates live in WORKDIR). The DV re-encode pipeline
  # holds up to ~3 full-size video copies at its busiest point (base+injected+mixed)
  # even with eager mid-run reclaim; non-DV re-encode ~2; stream-copy ~1. The
  # transient raw-ES demux fallback is reclaimed immediately and not sized here.
  local -i peak_factor=1
  if (( ! VIDEO_COPY_IF_COMPLIANT )); then
    peak_factor=2
    if (( ! DISABLE_DV )); then
      if _source_has_dv_metadata \
         || [[ "$METADATA_CACHE" == *dovi* || "$METADATA_CACHE" == *dolby_vision* \
               || "$METADATA_CACHE" == *dvhe* || "$METADATA_CACHE" == *dvh1* ]]; then
        peak_factor=3
      fi
    fi
  fi
  local -i est_peak=$(( (est_video_bytes * peak_factor + est_audio_bytes + sub_overhead) * 125 / 100 ))

  # Copy/remux output can't be much smaller than the source — floor both estimates at
  # the source size (with the same 25% margin) when known. Uses max(), not a sum, so it
  # never double-counts audio; it just prevents a missing/low bit_rate from
  # under-reserving for a near-1:1 remux.
  if (( VIDEO_COPY_IF_COMPLIANT && src_size > 0 )); then
    local -i src_floor=$(( src_size * 125 / 100 ))
    (( est_output > src_floor )) || est_output=$src_floor
    (( est_peak   > src_floor )) || est_peak=$src_floor
  fi

  # Floor: require at least DISK_FREE_WARN_GB free — but only for re-encodes
  # (peak_factor > 1), which stage multi-GB scratch. A pure stream-copy/remux
  # (peak_factor == 1) needs no scratch, so it is gated by its own (small)
  # estimate alone and isn't blocked on a near-full disk by the floor.
  local -i floor_bytes=0
  (( peak_factor > 1 )) && floor_bytes=$(( DISK_FREE_WARN_GB * 1024 * 1024 * 1024 ))
  local -i need_workdir=$(( est_peak   > floor_bytes ? est_peak   : floor_bytes ))
  local -i need_output=$((  est_output > floor_bytes ? est_output : floor_bytes ))

  log "Disk preflight: video_bytes=${est_video_bytes} audio_bytes=${est_audio_bytes} src_size=${src_size} peak_factor=${peak_factor}" \
      "est_output=${est_output} est_peak=${est_peak} need_workdir=${need_workdir} need_output=${need_output} (~$(_gb "$need_workdir")GB peak)"

  # ---- Enforce per-volume (hard stop; override with --no-disk-check) ----
  # WORKDIR holds the large intermediates; OUT_DIR holds the final file. Check
  # each, skipping the duplicate check when both resolve to the same volume.
  local wd_dev od_dev
  wd_dev="$(df -Pk "$WORKDIR" 2>/dev/null | awk 'NR==2{print $1}')"
  od_dev="$(df -Pk "$OUT_DIR"  2>/dev/null | awk 'NR==2{print $1}')"

  local wd_avail_kb
  wd_avail_kb="$(df -Pk "$WORKDIR" 2>/dev/null | awk 'NR==2{print $4}')"
  if [[ -n "$wd_avail_kb" ]] && (( wd_avail_kb * 1024 < need_workdir )); then
    die 11 "Not enough disk space for working files: ~$(_gb "$need_workdir")GB needed but only ~$(_gb "$(( wd_avail_kb * 1024 ))")GB free on the workdir volume ($WORKDIR).
   muxm stages large video intermediates here (peak ≈ ${peak_factor}× the encoded video). Free space,
   use --workdir DIR to stage on a roomier volume, or pass --no-disk-check to override this guard."
  fi

  if [[ -n "$od_dev" && "$od_dev" != "$wd_dev" ]]; then
    local od_avail_kb
    od_avail_kb="$(df -Pk "$OUT_DIR" 2>/dev/null | awk 'NR==2{print $4}')"
    if [[ -n "$od_avail_kb" ]] && (( od_avail_kb * 1024 < need_output )); then
      die 11 "Not enough disk space for the output file: ~$(_gb "$need_output")GB needed but only ~$(_gb "$(( od_avail_kb * 1024 ))")GB free on the output volume ($OUT_DIR).
   Free space, choose an output path on a roomier volume, or pass --no-disk-check to override this guard."
    fi
  fi

  # D15: confirm the preflight passed (a note → suppressed by --quiet, shown otherwise). The
  # workdir volume holds the multi-GB intermediates, so its free space is the meaningful figure.
  # L (Phase 5): if df produced nothing (unavailable / unusual mount), say so explicitly instead
  # of failing open silently — the user should know the free-space guard did not actually run.
  if [[ -n "${wd_avail_kb:-}" ]]; then
    note "Disk OK — ~$(_gb "$(( wd_avail_kb * 1024 ))")GB free on the working volume."
  else
    note "Disk preflight skipped: df unavailable — proceeding without a free-space check."
  fi
  return 0
}

# ===== Section 20: Metadata caching & ffprobe helpers =========================================
# Cache all stream metadata in one call for performance
cache_stream_metadata() {
  log "→ Caching stream metadata..."
  local _probe_err_file="$WORKDIR/probe_meta.err"
  METADATA_CACHE="$(ffprobe "${FFPROBE_FLAGS[@]}" -show_format -show_streams -of json "$SRC_ABS" 2>"$_probe_err_file")" || {
    local _probe_err
    _probe_err="$(head -5 "$_probe_err_file" 2>/dev/null)"
    die 12 "ffprobe failed to read source file: ${_probe_err:-file may be corrupt or inaccessible}. Try: ffprobe -v error \"$SRC_ABS\""
  }
  # Validate JSON integrity before downstream helpers rely on it
  _jq_cache empty || {
    die 12 "ffprobe returned invalid JSON — file may be corrupt or ffprobe version incompatible. Try: ffprobe -v error -show_format -of json \"$SRC_ABS\""
  }
  if [[ "${DEBUG:-0}" == "1" ]]; then
    log "[cache_stream_metadata] JSON size: ${#METADATA_CACHE} bytes"
    log "[cache_stream_metadata] streams: $(_jq_cache -r '[.streams[].codec_type] | join(", ")' 2>/dev/null)"
  fi
}

# ===== Section 21: Report helpers & skip-if-ideal =============================================

# _json_escape — Echo a string with every JSON-string-illegal byte escaped, so the result is
# safe to embed between double quotes in RFC-8259 JSON. Order matters: backslash first, then the
# double quote, then the common control characters as their short forms (\n \r \t), then EVERY
# remaining ASCII control byte (< 0x20) as \uXXXX. That last pass is what makes a crafted path or
# track title (a `"` in a filename, a BEL/0x07 in a tag) unable to break the report's key/line
# structure or emit a control byte that violates the JSON grammar (M1). NUL (0x00) can't occur —
# a bash string cannot hold it.
_json_escape() {
  local s="${1//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  if [[ "$s" == *[[:cntrl:]]* ]]; then
    local i ch esc
    for (( i=1; i<32; i++ )); do
      (( i == 9 || i == 10 || i == 13 )) && continue   # already emitted as \t \n \r above
      printf -v ch '\\%03o' "$i"; printf -v ch '%b' "$ch"   # the literal control byte for value i
      printf -v esc '\\u%04x' "$i"
      s="${s//"$ch"/$esc}"
    done
  fi
  printf '%s' "$s"
}

# Add an entry to the JSON report accumulator. Both key and value are escaped via _json_escape
# so any byte is JSON-safe.
report_add() {
  REPORT_ENTRIES+=("\"$(_json_escape "$1")\": \"$(_json_escape "$2")\"")
}

# Write JSON report alongside output
write_json_report() {
  (( REPORT_JSON )) || return 0
  local report_path="${OUT%."${OUTPUT_EXT}"}.report.json"
  if {
    printf '{\n'
    printf '  "tool": "%s",\n' "$(_json_escape "$APP_NAME v$VERSION")"
    printf '  "profile": "%s",\n' "$(_json_escape "${PROFILE_NAME:-<none>}")"
    printf '  "source": "%s",\n' "$(_json_escape "$SRC_ABS")"
    printf '  "output": "%s",\n' "$(_json_escape "$OUT")"
    if (( ${#REPORT_ENTRIES[@]} > 0 )); then
      printf '  "timestamp": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      local i last=$(( ${#REPORT_ENTRIES[@]} - 1 ))
      for (( i=0; i<${#REPORT_ENTRIES[@]}; i++ )); do
        if (( i < last )); then
          printf '  %s,\n' "${REPORT_ENTRIES[$i]}"
        else
          printf '  %s\n' "${REPORT_ENTRIES[$i]}"
        fi
      done
    else
      printf '  "timestamp": "%s"\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fi
    printf '}\n'
  } > "$report_path" 2>/dev/null; then
    note "JSON report written → $report_path"   # L (Phase 5): only claim "written" on success
  else
    warn "Failed to write JSON report to $report_path"
  fi
}

# Check if source already matches profile requirements (skip-if-ideal)
# Delegates video-stream compliance to _video_is_copy_compliant (DRY), then
# adds container and audio checks that only the skip-if-ideal path needs.
check_skip_if_ideal() {
  (( SKIP_IF_IDEAL )) || return 1  # return 1 = don't skip

  local ideal=1 reason=""

  # ---- Video compliance (reuse the copy-compliant check) ----
  # _video_is_copy_compliant checks: codec, pixel format, tone-map, DV profile, bitrate.
  # On rejection it sets _COPY_REJECT_REASON with a specific diagnostic.
  # VIDEO_COPY_IF_COMPLIANT=0 means the profile requires re-encoding; skip-if-ideal cannot apply.
  if (( ! VIDEO_COPY_IF_COMPLIANT )); then
    ideal=0
    reason="VIDEO_COPY_IF_COMPLIANT=0 (profile requires re-encode)"
  elif ! _video_is_copy_compliant; then
    ideal=0
    reason="${_COPY_REJECT_REASON:-video stream not copy-compliant}"
  fi

  # ---- Container check (skip-if-ideal only) ----
  if (( ideal )); then
    local src_ext
    src_ext="$(_lower "${SRC_ABS##*.}")"
    case "$OUTPUT_EXT" in
      mp4|m4v)
        if [[ "$src_ext" != "mp4" && "$src_ext" != "m4v" ]]; then
          ideal=0; reason="container is .$src_ext (need .mp4/.m4v)"
        fi
        ;;
      mkv)
        if [[ "$src_ext" != "mkv" ]]; then
          ideal=0; reason="container is .$src_ext (need .mkv)"
        fi
        ;;
      mov)
        # C1: without this arm a non-.mov source requested as .mov fell through with
        # ideal=1 and was hardlinked into a .mov name — a Matroska/MP4 byte stream in a
        # mislabeled container. Require an actual .mov source to skip into a .mov output.
        if [[ "$src_ext" != "mov" ]]; then
          ideal=0; reason="container is .$src_ext (need .mov)"
        fi
        ;;
      *)
        # C1: defensive default — any future/unknown OUTPUT_EXT must never silently
        # false-skip into a mislabeled container. Force a remux instead.
        ideal=0; reason="container .$OUTPUT_EXT has no skip-if-ideal rule"
        ;;
    esac
  fi

  # ---- Audio compliance (skip-if-ideal only) ----
  if (( ideal )) && (( AUDIO_MULTI_TRACK )); then
    # Multi-track: source is ideal only if every audio track survives the filter.
    # If any track would be dropped (commentary, wrong language), we need to remux.
    _check_filter_ideality "audio" "_build_audio_keep_list" "_audio_stream_count" ideal reason
  elif (( ideal )) && (( ! AUDIO_LOSSLESS_PASSTHROUGH )); then
    local n_audio a_codec
    n_audio="$(_audio_stream_count)"
    if (( n_audio > 0 )); then
      a_codec="$(_audio_codec 0)"
      if [[ -n "${AUDIO_FORCE_CODEC:-}" && "$a_codec" != "$(_encoder_to_codec "$AUDIO_FORCE_CODEC")" ]]; then
        ideal=0; reason="audio codec is $a_codec (need $(_encoder_to_codec "$AUDIO_FORCE_CODEC"))"
      elif ! audio_is_direct_play_copyable "$a_codec"; then
        ideal=0; reason="audio codec $a_codec not Direct Play compatible"
      fi
    fi
  elif (( ideal )) && (( AUDIO_LOSSLESS_PASSTHROUGH )); then
    # L1: single-track WITH lossless passthrough. The two arms above both skip this case, so
    # `ideal` would otherwise rest on video+container alone. But the single-track keep-list loop
    # below filters audio through _sii_audio_is_container_safe and SILENTLY excludes a
    # container-unsafe codec (e.g. FLAC/DTS-HD MA in an .mp4 — the MP4/MOV whitelist is
    # aac|ac3|eac3|alac), shipping a video-only remux with only a log line. Force the normal
    # pipeline instead, which transcodes/handles the lossless track rather than dropping it.
    local _sii_lp_n _sii_lp_codec
    _sii_lp_n="$(_audio_stream_count)"
    if (( _sii_lp_n > 0 )); then
      _sii_lp_codec="$(_audio_codec 0)"
      if ! _sii_audio_is_container_safe "$_sii_lp_codec"; then
        ideal=0; reason="lossless audio codec $_sii_lp_codec not muxable into .$OUTPUT_EXT (would be silently dropped on skip)"
      fi
    fi
  fi

  # ---- Stereo fallback check (skip-if-ideal only) ----
  # If ADD_STEREO_IF_MULTICH is set and the primary audio track is surround,
  # the source is not ideal because a stereo downmix track would need to be added.
  if (( ideal )) && (( ADD_STEREO_IF_MULTICH )); then
    local _sii_ch
    _sii_ch="$(_audio_channels 0)"
    if [[ -n "$_sii_ch" ]] && (( _sii_ch > 2 )); then
      ideal=0; reason="stereo fallback needed (${_sii_ch}ch audio, ADD_STEREO_IF_MULTICH=1)"
    fi
  fi

  # ---- Subtitle compliance (skip-if-ideal only) ----
  if (( ideal )) && (( SUB_MULTI_TRACK )); then
    # Multi-track: source is ideal only if every subtitle track survives the filter.
    # If any track would be dropped (wrong language, excluded type, cap), we need to remux.
    _check_filter_ideality "subtitle" "_build_subtitle_keep_list" "_sub_count" ideal reason
  fi

  # ---- External subtitle check ----
  # If sidecar subtitle files were discovered, they must be muxed in — the source
  # cannot be considered ideal because a straight copy would silently omit them.
  if (( ideal )) && (( ${#EXT_SUB_PATHS[@]} > 0 )); then
    ideal=0; reason="${#EXT_SUB_PATHS[@]} external subtitle(s) need to be muxed in"
  fi

  # ---- CLI quality override checks ----
  # If the user explicitly requested a different CRF or preset on the CLI, the source
  # cannot be considered ideal — skip-if-ideal must not suppress a quality override.
  if (( ideal )) && (( _CLI_CRF_EXPLICIT )); then
    ideal=0; reason="CRF explicitly set on CLI (--crf ${CRF_VALUE})"
  fi
  if (( ideal )) && (( _CLI_PRESET_EXPLICIT )); then
    ideal=0; reason="preset explicitly set on CLI (--preset ${PRESET_VALUE})"
  fi

  if (( ideal )); then
    # ---- Build validated stream keep-lists for the remux ----
    # Multi-track profiles reuse their existing filter functions (which already
    # validated all streams above — ideal=1 means nothing was dropped).
    # Single-track profiles keep all streams that are container-compatible:
    # a safety gate that prevents incompatible codecs from reaching the mux
    # without changing track-selection behavior.
    SII_AUDIO_INDICES=()
    SII_SUB_INDICES=()

    if (( AUDIO_MULTI_TRACK )); then
      local _sii_alist
      _sii_alist="$(_build_audio_keep_list)"
      # shellcheck disable=SC2206  # intentional word-splitting of index list
      SII_AUDIO_INDICES=( $_sii_alist )
    else
      local _sii_a_n _sii_a_i _sii_a_codec
      _sii_a_n="$(_audio_stream_count)"
      for (( _sii_a_i=0; _sii_a_i<_sii_a_n; _sii_a_i++ )); do
        _sii_a_codec="$(_audio_codec "$_sii_a_i")"
        if _sii_audio_is_container_safe "$_sii_a_codec"; then
          SII_AUDIO_INDICES+=("$_sii_a_i")
        else
          log "  [skip-if-ideal] Excluding audio #$_sii_a_i ($_sii_a_codec) — incompatible with $OUTPUT_EXT container"
        fi
      done
    fi

    if (( SUB_MULTI_TRACK )); then
      local _sii_slist
      _sii_slist="$(_build_subtitle_keep_list)"
      # shellcheck disable=SC2206  # intentional word-splitting of index list
      SII_SUB_INDICES=( $_sii_slist )
    else
      local _sii_s_n _sii_s_i _sii_s_codec _sii_s_info
      _sii_s_n="$(_sub_count)"
      for (( _sii_s_i=0; _sii_s_i<_sii_s_n; _sii_s_i++ )); do
        _sii_s_info="$(_sub_stream_info "$_sii_s_i")"
        _sii_s_codec="${_sii_s_info%%$'\t'*}"  # C2: codec is the first field — non-collapsing by construction
        _sii_s_codec="${_sii_s_codec,,}"
        if [[ "$MUX_FORMAT" == "matroska" ]] || _is_text_sub_codec "$_sii_s_codec"; then
          SII_SUB_INDICES+=("$_sii_s_i")
        else
          log "  [skip-if-ideal] Excluding subtitle #$_sii_s_i ($_sii_s_codec) — incompatible with $OUTPUT_EXT container"
        fi
      done
    fi

    note "✅ Source already matches profile '${PROFILE_NAME:-}' requirements — skipping processing."
    report_add "skip_if_ideal" "true"
    report_add "skip_reason" "source already compliant"
    return 0  # 0 = skip
  else
    note "Source does not match ideal: $reason"
    report_add "skip_if_ideal" "false"
    report_add "skip_reason" "$reason"
    return 1  # 1 = don't skip
  fi
}

# Query a field from the first video stream in the metadata cache.
# Falls back to ffprobe if cache is empty (called before cache_stream_metadata).
# Args: $1 — field name (e.g., codec_name, pix_fmt, color_primaries)
#        $2 — (optional) source file path, only used in pre-cache fallback
# Globals: METADATA_CACHE (read), FFPROBE_FLAGS (read)
_probe_field(){
  local field="$1"
  if [[ -n "${METADATA_CACHE:-}" ]]; then
    _jq_cache -r \
      "[.streams[] | select(.codec_type==\"video\")] | .[0].$field // empty" | head -n1 || true
  else
    # Pre-cache fallback (should only occur if called before cache_stream_metadata)
    ffprobe "${FFPROBE_FLAGS[@]}" -show_entries "stream=$field" \
            -of default=nk=1:nw=1 "${2:-}" 2>/dev/null | head -n1 || true
  fi
}

# Check if METADATA_CACHE contains at least one stream of the given type.
# Args: $1 — stream type (e.g., "audio", "video", "subtitle")
# Globals: METADATA_CACHE (read)
_has_stream(){
  _jq_cache -e "[.streams[] | select(.codec_type==\"$1\")] | length > 0" >/dev/null
}

# Convert a frame rate (exact rational "num/den" or a plain decimal) to a decimal
# string. Echoes nothing on invalid/zero input. Used for fps comparison/logging.
# Args: $1 — rate string (e.g. "24000/1001", "25", "23.976")
_fps_to_decimal(){
  local r="${1:-}"
  case "$r" in
    */*)
      local num="${r%%/*}" den="${r##*/}"
      [[ "$num" =~ ^[0-9]+$ && "$den" =~ ^[0-9]+$ ]] || return 0
      (( den == 0 || num == 0 )) && return 0
      LC_NUMERIC=C awk -v n="$num" -v d="$den" 'BEGIN{ printf "%.4f", n/d }'
      ;;
    *)
      [[ "$r" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
      LC_NUMERIC=C awk -v n="$r" 'BEGIN{ if (n+0 == 0) exit; printf "%.4f", n }'
      ;;
  esac
}

# Populate the SRC_FPS global from the cached source metadata (r_frame_rate).
# Keeps the exact rational so downstream wrap steps (mp4box -fps, ffmpeg -r) can
# stamp the precise rate with zero rounding drift. Leaves SRC_FPS empty when the
# source advertises no usable rate (e.g. "0/0"), so callers skip fps enforcement.
# Globals: SRC_FPS (write). Must run AFTER cache_stream_metadata().
init_src_fps(){
  local raw dec
  raw="$(_probe_field r_frame_rate)"
  dec="$(_fps_to_decimal "$raw")"
  if [[ -n "$dec" ]]; then
    SRC_FPS="$raw"
    log "[init_src_fps] source frame rate: $SRC_FPS (${dec} fps)"
  else
    SRC_FPS=""
    warn "Could not determine source frame rate (r_frame_rate='${raw:-unset}'); fps will not be enforced on the DV wrap. Output fps should be verified manually."
  fi
}

# ===== Section 22: Color space & pixel format decision ========================================
declare -i IS_DV=0
PROFILE_DESC="SDR"
TARGET_PIXFMT="yuv420p"
COLOR_ARGS=()

# decide_color_and_pixfmt — Analyze source color metadata and set output targets.
#
# Reads color_primaries, color_transfer, color_space, and pix_fmt from the
# source video stream and determines the output color profile and pixel format.
#
# Decision tree:
#   TONEMAP_HDR_TO_SDR + HDR source → SDR-TONEMAP (force bt709, yuv420p)
#   arib-std-b67/HLG transfer        → HLG (bt2020, HDR_TARGET_PIXFMT)
#   bt2020/smpte2084                  → HDR10 (bt2020, HDR_TARGET_PIXFMT)
#   everything else                   → SDR (bt709, 10-bit if source is 10-bit)
#
# Sets globals: PROFILE_DESC, TARGET_PIXFMT, COLOR_ARGS[]
# Reads globals: METADATA_CACHE, TONEMAP_HDR_TO_SDR, HDR_TARGET_PIXFMT,
#                FORCE_CHROMA_420, SDR_USE_10BIT_IF_SRC_10BIT, SDR_FORCE_10BIT
decide_color_and_pixfmt() {
  local pix prim trc cspace
  pix="$(_probe_field pix_fmt)"
  prim="$(_probe_field color_primaries)"
  trc="$(_probe_field color_transfer)"
  cspace="$(_probe_field color_space)"

  prim="$(_lower "$prim")"
  trc="$(_lower "$trc")"
  cspace="$(_lower "$cspace")"
  pix="$(_lower "$pix")"

  local is_10bit=0 chroma="420"
  [[ "$pix" =~ (p010le|p10|p12) ]] && is_10bit=1
  [[ "$pix" =~ 422 ]] && chroma="422"
  [[ "$pix" =~ 444 ]] && chroma="444"

  if (( FORCE_CHROMA_420 )) && [[ "$chroma" != "420" ]]; then
    warn "Source chroma is 4:${chroma}; downsampling to 4:2:0 for Apple TV Direct Play."
    chroma="420"
  fi

  # Color Space Decision Tree:
  # ┌─ TONEMAP_HDR_TO_SDR=1 + HDR source → SDR-TONEMAP (force bt709)
  # ├─ HLG (arib-std-b67)                → HLG profile, bt2020
  # ├─ HDR10 (bt2020/smpte2084)          → HDR10 profile, bt2020
  # └─ SDR (everything else)             → SDR, 10-bit if source is 10-bit
  
  local tgt_pix="yuv420p" profile="SDR"

  if (( TONEMAP_HDR_TO_SDR )) && [[ "$prim" == "bt2020" || "$cspace" == "bt2020nc" || "$trc" == "smpte2084" || "$trc" == "arib-std-b67" || "$trc" == "hlg" ]]; then
    # Source is HDR but we want SDR output (tone-mapping)
    profile="SDR-TONEMAP"
    tgt_pix="yuv420p"
    COLOR_ARGS=(-color_primaries bt709 -color_trc bt709 -colorspace bt709)
    note "HDR source detected — will tone-map to SDR (profile: universal)"
  elif [[ "$trc" == "arib-std-b67" || "$trc" == "hlg" ]]; then
    profile="HLG"
    tgt_pix="$HDR_TARGET_PIXFMT"
    COLOR_ARGS=(-color_primaries bt2020 -color_trc arib-std-b67 -colorspace bt2020nc)
    (( ! FORCE_CHROMA_420 )) && [[ "$chroma" != "420" ]] && \
      note "4:2:0 chroma is enforced for HLG (Direct Play compatibility) regardless of the chroma-preservation setting."
  elif [[ "$prim" == "bt2020" || "$cspace" == "bt2020nc" || "$trc" == "smpte2084" ]]; then
    profile="HDR10"
    tgt_pix="$HDR_TARGET_PIXFMT"
    COLOR_ARGS=(-color_primaries bt2020 -color_trc smpte2084 -colorspace bt2020nc)
    (( ! FORCE_CHROMA_420 )) && [[ "$chroma" != "420" ]] && \
      note "4:2:0 chroma is enforced for HDR (Direct Play compatibility) regardless of the chroma-preservation setting."
  else
    profile="SDR"
    if (( SDR_FORCE_10BIT )); then
      tgt_pix="yuv420p10le"
    elif (( SDR_USE_10BIT_IF_SRC_10BIT )) && (( is_10bit )); then
      tgt_pix="yuv420p10le"
    else
      tgt_pix="yuv420p"
    fi
    # Honor FORCE_CHROMA_420=0 by preserving source chroma on the SDR path (H8).
    if (( ! FORCE_CHROMA_420 )) && [[ "$chroma" != "420" ]]; then
      local _cbit="p"
      (( is_10bit )) && _cbit="p10le"
      case "$chroma" in
        444) tgt_pix="yuv444${_cbit}" ;;
        422) tgt_pix="yuv422${_cbit}" ;;
      esac
      note "Preserving source 4:${chroma} chroma (4:2:0 not forced)."
    fi
    [[ -z "$prim" ]] && prim="bt709"
    [[ -z "$trc" ]] && trc="bt709"
    [[ -z "$cspace" ]] && cspace="bt709"
    COLOR_ARGS=(-color_primaries "$prim" -color_trc "$trc" -colorspace "$cspace")
  fi
  PROFILE_DESC="$profile"
  TARGET_PIXFMT="$tgt_pix"
  
  note "Color profile: $PROFILE_DESC, Target pixel format: $TARGET_PIXFMT"
}

# ===== Section 23: x265 params & Level/VBV guardrails ========================================
# Build the final X265_PARAMS string from X265_PARAMS_BASE.
# Adds or strips HDR-specific x265 parameters based on the detected color profile:
#   - Non-HDR10: removes :hdr-opt=1
#   - HDR10: appends hdr10=1, colorprim, transfer, colormatrix, range
# Sets: X265_PARAMS (global)
# Reads: X265_PARAMS_BASE, PROFILE_DESC
build_x265_params() {
  X265_PARAMS="$X265_PARAMS_BASE"

  # Strip all baked HDR10/PQ color keys from X265_PARAMS_BASE up front (H9, L7): some profiles bake
  # hdr10=1/transfer=smpte2084/colorprim=bt2020/etc. in, which must NOT signal PQ on non-PQ (HLG/SDR)
  # content and must be de-duplicated before the HDR10 path re-appends them. Both color paths start
  # from this clean slate, so the strip — previously duplicated verbatim in both branches — is hoisted
  # here and each branch only appends what it needs.
  X265_PARAMS="$(printf '%s' "$X265_PARAMS" | sed \
    's/:hdr10=[^:]*//g; s/^hdr10=[^:]*://
     s/:hdr10-opt=[^:]*//g; s/^hdr10-opt=[^:]*://
     s/:hdr-opt=[^:]*//g; s/^hdr-opt=[^:]*://
     s/:colorprim=[^:]*//g; s/^colorprim=[^:]*://
     s/:transfer=[^:]*//g; s/^transfer=[^:]*://
     s/:colormatrix=[^:]*//g; s/^colormatrix=[^:]*://
     s/:range=[^:]*//g; s/^range=[^:]*://')"

  if [[ "$PROFILE_DESC" == "HDR10" ]]; then
    X265_PARAMS="${X265_PARAMS}:hdr10=1:hdr10-opt=1:colorprim=bt2020:transfer=smpte2084:colormatrix=bt2020nc:range=limited"
  elif [[ "$PROFILE_DESC" == "HLG" ]]; then
    # HLG: inject the correct HLG color signaling (H9).
    X265_PARAMS="${X265_PARAMS}:colorprim=bt2020:transfer=arib-std-b67:colormatrix=bt2020nc"
  fi
  # (SDR / SDR-TONEMAP and anything else: stripped, nothing appended.)

  # --threads N → genuinely cap core usage by sizing x265's worker thread pool.
  # ffmpeg's -threads does NOT size that pool (it defaults to all logical cores),
  # so -threads alone leaves CPU pinned near 100%×ncores regardless of value;
  # `pools=N` is the real cap. Gated on the concrete encoder (libx265 only — NOT
  # the hevc_videotoolbox HW arm, which also routes through this builder) and
  # skipped when the user already set pools= via --x265-params (explicit wins).
  if [[ "$VIDEO_ENCODER_FFMPEG" == "libx265" && "${THREADS:-}" =~ ^[1-9][0-9]*$ ]] \
     && [[ ":${X265_PARAMS}" != *":pools="* ]]; then
    X265_PARAMS="${X265_PARAMS:+${X265_PARAMS}:}pools=${THREADS}"
  fi
}

build_av1_params() {
  SVT_AV1_PARAMS="$SVT_AV1_PARAMS_BASE"

  # --threads N → cap SVT-AV1 parallelism. ffmpeg's -threads is ignored by
  # libsvtav1; `lp=N` (logical processors) plus `pin=1` is the real cap. lp/pin
  # are SVT-AV1-only params, so this is gated to the concrete libsvtav1 encoder —
  # NOT libaom-av1, whose shared param string feeds -aom-params (which would
  # reject lp=). Skipped when the user already set lp= via --av1-params.
  if [[ "$VIDEO_ENCODER_FFMPEG" == "libsvtav1" && "${THREADS:-}" =~ ^[1-9][0-9]*$ ]] \
     && [[ ":${SVT_AV1_PARAMS}" != *":lp="* ]]; then
    SVT_AV1_PARAMS="${SVT_AV1_PARAMS:+${SVT_AV1_PARAMS}:}lp=${THREADS}:pin=1"
  fi
}

# build_videotoolbox_params — assemble VIDEOTOOLBOX_ARGS[] for hevc_videotoolbox
# or h264_videotoolbox invocations. Dispatches on VIDEO_ENCODER_FFMPEG so the
# HEVC and H.264 arms share common knobs (quality, allow_sw) while differing
# on profile selection and Apple-compatibility tag.
#
# Quality resolution order:
#   1. HW_ACCEL_QUALITY (explicit override via --hw-accel-quality or rc file)
#   2. VT_QUALITY_MAP[PROFILE_NAME] (calibrated per-profile value)
#   3. VT_QUALITY_DEFAULT (fallback when no profile is active)
#
# HDR10 and color metadata flow through via COLOR_ARGS[] (appended by the
# pipeline dispatch). The VideoToolbox encoder itself does not take explicit
# master_display / max_cll flags — ffmpeg 6.0+ carries input side data
# forward to the muxer, which writes the correct MP4 atoms (colr/mdcv/clli)
# or MKV Colour/MasteringMetadata elements automatically (verified in the
# Phase 2 HDR10 and DV spikes).
#
# Reads:  VIDEO_ENCODER_FFMPEG, VIDEO_CODEC, HW_ACCEL_QUALITY, VT_QUALITY_MAP,
#         VT_QUALITY_DEFAULT, PROFILE_NAME, HW_ACCEL_ALLOW_SW, OUTPUT_EXT,
#         PROFILE_DESC, X264_PARAMS_BASE
# Writes: VIDEOTOOLBOX_ARGS[]
build_videotoolbox_params() {
  VIDEOTOOLBOX_ARGS=()

  # Resolve the quality knob.
  local vt_q=""
  if [[ -n "$HW_ACCEL_QUALITY" ]]; then
    vt_q="$HW_ACCEL_QUALITY"
  elif [[ -n "${PROFILE_NAME:-}" ]] && [[ -n "${VT_QUALITY_MAP[$PROFILE_NAME]:-}" ]]; then
    vt_q="${VT_QUALITY_MAP[$PROFILE_NAME]}"
  else
    vt_q="$VT_QUALITY_DEFAULT"
  fi

  # Common flags across HEVC and H.264 VideoToolbox encoders.
  VIDEOTOOLBOX_ARGS=(
    -q:v "$vt_q"
    -allow_sw "$HW_ACCEL_ALLOW_SW"
    -realtime 0
  )

  # Encoder-specific profile + container tag.
  case "$VIDEO_ENCODER_FFMPEG" in
    hevc_videotoolbox)
      # RF12: hevc_videotoolbox encodes only 4:2:0 (8-bit Main / 10-bit Main10). Reject a 4:2:2/4:4:4
      # target up front with a clean error instead of forwarding an unsupported pix_fmt into a VT
      # encode that would fail cryptically mid-run. (Software libx265 honors 4:2:2/4:4:4; VT does not.)
      if [[ "$TARGET_PIXFMT" == *422* || "$TARGET_PIXFMT" == *444* ]]; then
        die 11 "hevc_videotoolbox does not support a 4:2:2/4:4:4 pixel format (TARGET_PIXFMT=$TARGET_PIXFMT). Use software encoding (--no-hw-accel) or a 4:2:0 target."
      fi
      # 10-bit HDR/SDR → Main10, 8-bit SDR → Main.
      if [[ "$TARGET_PIXFMT" == *"10le"* ]]; then   # matches yuv420p10le AND p010le (both contain "10le")
        VIDEOTOOLBOX_ARGS+=( -profile:v main10 )
      else
        VIDEOTOOLBOX_ARGS+=( -profile:v main )
      fi
      # Apple Direct Play and MP4 playback require the hvc1 tag; MKV is agnostic.
      case "${OUTPUT_EXT,,}" in
        mp4|m4v|mov) VIDEOTOOLBOX_ARGS+=( -tag:v hvc1 ) ;;
      esac
      ;;
    h264_videotoolbox)
      # Mirror the existing libx264 profile choice: youtube-upload uses High,
      # everything else stays on the encoder default (which selects High
      # automatically for 8-bit 4:2:0 yuv420p inputs).
      if [[ "$X264_PARAMS_BASE" == *"profile=high"* ]]; then
        VIDEOTOOLBOX_ARGS+=( -profile:v high )
      fi
      ;;
  esac
}

# build_video_encoder_params — dispatch parameter assembly based on the
# resolved encoder backend. Software encoders populate their *_PARAMS globals
# (consumed via -x265-params / -svtav1-params / -x264-params in the video
# pipeline); hardware backends populate their own arg arrays.
#
# Phase 2: the VideoToolbox arm populates VIDEOTOOLBOX_ARGS[]. The software
# HEVC param builder (build_x265_params) is still invoked even when VT is in
# effect, because --print-effective-config and downstream DV conversion code
# may reference X265_PARAMS — harmless for VT encodes, and preserves behavior
# when VT falls back to software for a particular encode.
#
# Reads:  VIDEO_CODEC, VIDEO_ENCODER_FFMPEG
# Writes: X265_PARAMS, SVT_AV1_PARAMS, VIDEOTOOLBOX_ARGS
build_video_encoder_params() {
  case "$VIDEO_CODEC" in
    libsvt-av1|libaom-av1) build_av1_params ;;
    *)                     build_x265_params ;;
  esac

  # Hardware-encoder param builders layer on top: the software builder above
  # leaves X265_PARAMS populated for display/reference; the hardware builder
  # populates its own ARGS array used by the dispatch.
  case "$VIDEO_ENCODER_FFMPEG" in
    hevc_videotoolbox|h264_videotoolbox) build_videotoolbox_params ;;
  esac
}

# resolve_video_encoder — map (VIDEO_CODEC, HW_ACCEL_RESOLVED) to the concrete
# ffmpeg `-c:v` argument, applying compatibility gates along the way.
#
# Phase 2 wires the VideoToolbox arm. Dolby Vision is NOT a gate: the DV
# pipeline (Section 26) extracts the RPU from the source and injects it into
# the encoded bitstream post-hoc via dovi_tool, which is encoder-agnostic.
# Frame-count parity is already verified at the end of run_video_pipeline, so
# the existing safety net covers VT+DV too.
#
# Gates (any one forces software fallback with a recorded reason):
#   - libaom-av1 codec           — no hardware counterpart
#   - videotoolbox + AV1 codec   — Apple Silicon has no AV1 hardware encoder
#   - nvenc + av1_nvenc missing  — pre-Ada GPUs (Phase 3)
#
# Writes:
#   VIDEO_ENCODER_FFMPEG       — concrete -c:v value
#   HW_ACCEL_FALLBACK_REASON   — human-readable reason when gated to SW
# Reads:
#   VIDEO_CODEC, HW_ACCEL_RESOLVED
resolve_video_encoder() {
  VIDEO_ENCODER_FFMPEG="$VIDEO_CODEC"
  HW_ACCEL_FALLBACK_REASON=""

  # ffmpeg's SVT-AV1 encoder is spelled "libsvtav1" (no dash); muxm's
  # user-facing alias is "libsvt-av1". Normalise when emitting -c:v.
  [[ "$VIDEO_ENCODER_FFMPEG" == "libsvt-av1" ]] && VIDEO_ENCODER_FFMPEG="libsvtav1"

  # Software path: nothing to resolve.
  [[ -z "$HW_ACCEL_RESOLVED" || "$HW_ACCEL_RESOLVED" == "none" ]] && return 0

  # Gate 1: libaom-av1 has no hardware counterpart — always software.
  if [[ "$VIDEO_CODEC" == "libaom-av1" ]]; then
    HW_ACCEL_FALLBACK_REASON="libaom-av1 has no hardware counterpart"
    note "Hardware acceleration disabled for this encode: $HW_ACCEL_FALLBACK_REASON."
    return 0
  fi

  # Gate 2: VideoToolbox does not offer AV1 encode on any current Apple Silicon.
  if [[ "$HW_ACCEL_RESOLVED" == "videotoolbox" && "$VIDEO_CODEC" == "libsvt-av1" ]]; then
    HW_ACCEL_FALLBACK_REASON="VideoToolbox has no AV1 encoder on Apple Silicon"
    note "Hardware acceleration disabled for this encode: $HW_ACCEL_FALLBACK_REASON."
    return 0
  fi

  # Gate 3: NVENC AV1 requires Ada Lovelace (RTX 40+) — probe for av1_nvenc.
  if [[ "$HW_ACCEL_RESOLVED" == "nvenc" && "$VIDEO_CODEC" == "libsvt-av1" ]] && ! ffmpeg_has_encoder av1_nvenc; then
    HW_ACCEL_FALLBACK_REASON="NVENC AV1 needs an RTX 40-series (Ada) GPU or newer"
    note "Hardware acceleration disabled for this encode: $HW_ACCEL_FALLBACK_REASON."
    return 0
  fi

  # OS guard: hardware acceleration is supported on macOS (Apple VideoToolbox) only.
  # On Linux, fall back to software and warn exactly once here (H11).
  if [[ "$(uname -s)" != "Darwin" ]]; then
    warn "Hardware acceleration is currently supported on macOS (VideoToolbox) only. Falling back to software encoding."
    HW_ACCEL_FALLBACK_REASON="Linux hardware acceleration is not supported in this release (software fallback)."
    # VIDEO_ENCODER_FFMPEG is already the normalized software codec name from the top of this function.
    return 0
  fi

  # Backend-specific encoder selection.
  case "$HW_ACCEL_RESOLVED" in
    videotoolbox)
      case "$VIDEO_CODEC" in
        libx265) VIDEO_ENCODER_FFMPEG="hevc_videotoolbox" ;;
        libx264) VIDEO_ENCODER_FFMPEG="h264_videotoolbox" ;;
      esac
      ;;
    nvenc)
      # NVENC dispatch is not wired up in this build; fall back to software.
      HW_ACCEL_FALLBACK_REASON="NVENC is not supported in this build; using software encoding"
      warn "Hardware acceleration disabled for this encode: $HW_ACCEL_FALLBACK_REASON."
      # VIDEO_ENCODER_FFMPEG is already set to the normalized software codec name.
      ;;
  esac
}

# Apply level-based VBV constraints
# VBV (Video Buffering Verifier) ensures bitrate stays within device capabilities
apply_level_vbv() {
  # AV1 encoders use different level/VBV mechanisms — skip x265-specific params.
  case "$VIDEO_CODEC" in
    libsvt-av1|libaom-av1) return 0 ;;
  esac
  # VideoToolbox picks its own level; it does not accept x265-params and has
  # no corresponding vbv-maxrate knob. Skip for HW backends.
  case "$VIDEO_ENCODER_FFMPEG" in
    hevc_videotoolbox|h264_videotoolbox)
      if [[ -n "${LEVEL_VALUE:-}" ]] || (( ${CONSERVATIVE_VBV:-0} )); then
        warn "VideoToolbox does not enforce H.265 level / bitrate-cap constraints — Apple TV Direct Play compliance is not guaranteed for this encode."
        log  "VT level/VBV not enforced: LEVEL_VALUE=${LEVEL_VALUE:-unset}, CONSERVATIVE_VBV=${CONSERVATIVE_VBV:-0}"
      fi
      return 0 ;;
  esac
  local lvl="$1" maxrate="" bufsize=""
  if (( CONSERVATIVE_VBV )); then
    case "$lvl" in
      4.1) maxrate="$LEVEL_VBV_4_1_MAXRATE"; bufsize="$LEVEL_VBV_4_1_BUFSIZE" ;;
      5.0) maxrate="$LEVEL_VBV_5_0_MAXRATE"; bufsize="$LEVEL_VBV_5_0_BUFSIZE" ;;
      5.1) maxrate="$LEVEL_VBV_5_1_MAXRATE"; bufsize="$LEVEL_VBV_5_1_BUFSIZE" ;;
      5.2) maxrate="$LEVEL_VBV_5_2_MAXRATE"; bufsize="$LEVEL_VBV_5_2_BUFSIZE" ;;
    esac
  fi
  if [[ -n "$maxrate" ]]; then
    X265_PARAMS="${X265_PARAMS}:level-idc=${lvl}:vbv-maxrate=${maxrate}:vbv-bufsize=${bufsize}"
    note "Applying VBV guardrails for level ${lvl} → maxrate=${maxrate}, bufsize=${bufsize}"
  else
    (( CONSERVATIVE_VBV )) && [[ -n "$lvl" ]] && \
      warn "No VBV guardrail table for level ${lvl}; buffer compliance NOT enforced."
    [[ -n "$lvl" ]] && X265_PARAMS="${X265_PARAMS}:level-idc=${lvl}"
  fi
}

# ===== Section 24: Dolby Vision detection =====================================================
# detect_dv — Check if source contains Dolby Vision metadata.
#
# Two-pass detection:
#   1. Stream-level probe: checks codec tags, side data, and FourCC codes
#      (dvhe, dvh1, com.dolby.vision) in the first video stream.
#   2. Frame-level probe: reads the first 5 frames looking for DOVI/dolby
#      metadata in frame side data (catches cases where container metadata
#      is missing but RPU NAL units are present).
#
# Returns: 0 if DV detected, 1 if not detected, 2 if detection was skipped (DISABLE_DV=1).
# Globals: DISABLE_DV (read), FFPROBE_FLAGS (read), SRC_ABS (read)
detect_dv() {
  (( DISABLE_DV )) && return 2
  
  local probe_output
  probe_output="$(ffprobe "${FFPROBE_FLAGS[@]}" -show_streams -select_streams v:0 "$SRC_ABS" 2>&1)" || {
    warn "ffprobe failed during DV detection - assuming no DV present"
    return 1
  }
  
  if printf '%s\n' "$probe_output" | grep -qiE 'dolby_vision|dv_profile|dovi|dvhe|dvh1|com\.dolby\.vision'; then
    return 0
  fi
  
  # Check first few frames for DV metadata
  probe_output="$(ffprobe "${FFPROBE_FLAGS[@]}" -show_frames -read_intervals %+#5 -select_streams v:0 "$SRC_ABS" 2>&1)" || {
    warn "Frame analysis failed during DV detection - assuming no DV"
    return 1
  }
  
  printf '%s\n' "$probe_output" | grep -qiE 'DOVI|dolby' && return 0
  return 1
}

# _source_has_dv_metadata — Lightweight check for DV presence using the metadata cache.
#
# Unlike detect_dv, this does NOT honour DISABLE_DV and never probes frames.
# It only checks the already-populated METADATA_CACHE for a DOVI configuration
# record. Intended for informational messages when DV detection was skipped.
#
# Returns: 0 if DOVI configuration record found in cache, 1 otherwise.
# Globals: METADATA_CACHE (read)
_source_has_dv_metadata() {
  [[ -n "${METADATA_CACHE:-}" ]] || return 1
  _jq_cache -e '
    [.streams[] | select(.codec_type=="video")] | .[0].side_data_list[]? |
    select(.side_data_type == "DOVI configuration record")' >/dev/null 2>&1
}

# _source_dv_profile — Echo the source's Dolby Vision profile number (e.g. "7",
# "8") read directly from the DOVI configuration record in the metadata cache, or
# nothing if the source carries no DV side data. Read-only: writes no globals and
# emits no notes/report, so it is safe to call from the skip-if-ideal copy gate,
# where IS_DV/DV_SRC_PROFILE are not yet populated (C1). Mirrors the JSON arm of
# detect_dv_info().
# Globals: METADATA_CACHE (read)
_source_dv_profile() {
  [[ -n "${METADATA_CACHE:-}" ]] || return 0
  _jq_cache -r '
    [.streams[] | select(.codec_type=="video")] | .[0].side_data_list[]? |
    select(.side_data_type == "DOVI configuration record") | .dv_profile // empty' \
    2>/dev/null | head -n1 || true
}

# Populate DV source metadata from ffprobe side data and container records.
# Sets: DV_SRC_PROFILE, DV_SRC_COMPAT_ID, DV_SRC_BL_PRESENT, DV_SRC_EL_PRESENT
# Must be called after detect_dv returns true and METADATA_CACHE is populated.
# Globals: METADATA_CACHE (read), DV_SRC_* (write), FFPROBE_FLAGS (read), SRC_ABS (read)
detect_dv_info() {
  # Try JSON metadata cache first (structured side_data_list)
  if [[ -n "${METADATA_CACHE:-}" ]]; then
    local side_data
    side_data="$(_jq_cache -r '
      [.streams[] | select(.codec_type=="video")] | .[0].side_data_list[]? |
      select(.side_data_type == "DOVI configuration record")')" || true

    if [[ -n "$side_data" ]]; then
      { read -r DV_SRC_PROFILE
        read -r DV_SRC_COMPAT_ID
        read -r DV_SRC_BL_PRESENT
        read -r DV_SRC_EL_PRESENT
      } < <(printf '%s\n' "$side_data" | jq -r '
          .dv_profile // "",
          .dv_bl_signal_compatibility_id // "",
          .bl_present_flag // "",
          .el_present_flag // ""
        ' 2>/dev/null) || true
    fi
  fi

  # Fallback: parse text ffprobe output if JSON didn't produce results
  if [[ -z "${DV_SRC_PROFILE:-}" ]]; then
    local probe_out
    probe_out="$(ffprobe "${FFPROBE_FLAGS[@]}" -show_streams -select_streams v:0 "$SRC_ABS" 2>&1)" || return 1

    DV_SRC_PROFILE="$(printf '%s\n' "$probe_out" | grep -oiE 'profile: [0-9]+' | grep -oE '[0-9]+' | head -1)" || true
    DV_SRC_COMPAT_ID="$(printf '%s\n' "$probe_out" | grep -oiE 'compatibility id: [0-9]+' | grep -oE '[0-9]+' | head -1)" || true
    DV_SRC_BL_PRESENT="$(printf '%s\n' "$probe_out" | grep -oiE 'bl.flag: [0-9]+' | grep -oE '[0-9]+' | head -1)" || true
    DV_SRC_EL_PRESENT="$(printf '%s\n' "$probe_out" | grep -oiE 'el.flag: [0-9]+' | grep -oE '[0-9]+' | head -1)" || true
  fi

  # Seed the output-profile vars to the source values. This is correct for the
  # genuine P8 passthrough path (output stays 8.<source-compat>); the P7/P5→P8.1
  # convert-success branch in run_video_pipeline overrides these to 8/1 (CR-1).
  DV_OUT_PROFILE="$DV_SRC_PROFILE"
  DV_OUT_COMPAT_ID="$DV_SRC_COMPAT_ID"

  note "DV source info: profile=${DV_SRC_PROFILE:-?}, compat_id=${DV_SRC_COMPAT_ID:-?}, bl=${DV_SRC_BL_PRESENT:-?}, el=${DV_SRC_EL_PRESENT:-?}"
  report_add "dv_src_profile" "${DV_SRC_PROFILE:-unknown}"
  report_add "dv_src_compat_id" "${DV_SRC_COMPAT_ID:-unknown}"
  report_add "dv_src_el_present" "${DV_SRC_EL_PRESENT:-unknown}"
}

# Validate RPU integrity via dovi_tool info.
# Args: $1 — path to RPU file
# Returns: 0 if valid, 1 if invalid or dovi_tool unavailable.
# Side effect: logs RPU frame count and detected profile.
# Globals: WORKDIR (read)
_validate_dv_rpu() {
  local rpu_path="$1" rpu_info=""
  [[ -s "$rpu_path" ]] || { warn "RPU file is empty: $rpu_path"; return 1; }

  if ! (( _HAS_DOVI_TOOL )); then
    warn "dovi_tool not available — cannot validate RPU integrity."
    return 0  # Non-fatal; proceed optimistically
  fi

  rpu_info="$(dovi_tool info -i "$rpu_path" --summary 2>"$WORKDIR/rpu_validate.err")" || {
    warn "dovi_tool info failed on RPU — RPU may be corrupt. See: $WORKDIR/rpu_validate.err"
    return 1
  }

  # Extract profile from RPU info
  local rpu_profile
  rpu_profile="$(printf '%s\n' "$rpu_info" | grep -oiE 'profile [0-9]+' | grep -oE '[0-9]+' | head -1)" || true
  if [[ -n "$rpu_profile" ]]; then
    note "RPU validated: DV Profile $rpu_profile"
    report_add "dv_rpu_profile" "$rpu_profile"
  fi

  return 0
}

# Count video frames in an HEVC elementary stream or container.
# Args: $1 — file path
# Returns: frame count on stdout (0 if counting fails)
# Globals: FFPROBE_FLAGS (read)
_count_video_frames() {
  local file="$1" count
  count="$(ffprobe "${FFPROBE_FLAGS[@]}" -count_packets -select_streams v:0 \
           -show_entries stream=nb_read_packets -of csv=p=0 "$file" 2>/dev/null)" || true
  [[ "$count" =~ ^[0-9]+$ ]] && echo "$count" || echo "0"
}

# _dv_probe_has_config_record FILE — true (rc 0) iff FILE's video stream carries a container-level
# DOVI configuration record (dvcC/dvvC box). M-DRY: the ffprobe-side-data + grep idiom was
# copy-pasted across the DV fallback / pre-wrap paths. ffprobe failure is treated as "no record"
# (those callers act only on a positive detection). verify_dv_container_record deliberately does
# NOT use this helper — it distinguishes an ffprobe failure ("unknown") from a genuine absence.
# Globals: FFPROBE_FLAGS, DV_CONTAINER_PATTERN (read).
_dv_probe_has_config_record() {
  local _probe
  _probe="$(ffprobe "${FFPROBE_FLAGS[@]}" -show_streams -show_entries \
            stream_side_data -select_streams v:0 "$1" 2>&1)" || true
  printf '%s\n' "$_probe" | grep -qiE "$DV_CONTAINER_PATTERN"
}

# Verify DOVI configuration record (dvcC/dvvC box) is present in muxed output.
# For MP4/MOV containers, the dvcC box is required for players to activate DV rendering.
# If missing, attempts a fallback remux. If still missing, warns clearly.
# Args: none (operates on TMP_OUT)
# Globals: OUTPUT_HAS_DV, DRY_RUN, MUX_FORMAT, TMP_OUT, FFPROBE_FLAGS, WORKDIR,
#          V_MIXED, VIDEO_COPY_FROM_SOURCE
verify_dv_container_record() {
  (( OUTPUT_HAS_DV )) || return 0
  (( DRY_RUN )) && return 0

  # MKV uses different DV signaling (codec private data, not MP4 boxes)
  [[ "$MUX_FORMAT" == "matroska" ]] && {
    note "MKV container — DV signaling uses codec private data (no dvcC box needed)."
    report_add "dv_container_record" "n/a (matroska)"
    return 0
  }

  local out_probe
  if ! out_probe="$(ffprobe "${FFPROBE_FLAGS[@]}" -show_streams -show_entries \
               stream_side_data -select_streams v:0 "$TMP_OUT" 2>&1)"; then
    warn "ffprobe could not probe output container — cannot verify DV configuration record."
    warn "  Output may still be valid. Re-check with: ffprobe -show_streams \"$TMP_OUT\""
    report_add "dv_container_record" "unknown (ffprobe failed to probe output)"
    return 0
  fi

  if printf '%s\n' "$out_probe" | grep -qiE "$DV_CONTAINER_PATTERN"; then
    # CR-1: a DOVI record being *present* is not enough on the converted path — MP4Box's
    # `:dvp=` overrides the written dv_profile regardless of the RPU NALs, so a stale source
    # value here ships a container that mis-signals the (now single-layer P8.1) stream. When
    # this run converted P7/P5 → P8.1 (DV_OUT_PROFILE=8), assert the *value*, not just presence.
    if [[ "${DV_OUT_PROFILE:-}" == "8" ]]; then
      local out_dv_profile
      out_dv_profile="$(printf '%s\n' "$out_probe" | grep -oiE 'dv_profile=[0-9]+' | grep -oE '[0-9]+' | head -1)" || true
      if [[ -n "$out_dv_profile" && "$out_dv_profile" != "8" ]]; then
        warn "Output container signals dv_profile=${out_dv_profile} but the stream was converted to P8.1."
        warn "  Strict DV players (Apple TV, iOS) may reject the DV layer and fall back to HDR10."
        report_add "dv_container_record" "present but mis-signaled (dv_profile=${out_dv_profile}, expected 8)"
        OUTPUT_HAS_DV=0
        return 0
      fi
      note "✅ DOVI configuration record confirmed in output container (dv_profile=${out_dv_profile:-8})."
      report_add "dv_container_record" "present (dv_profile=${out_dv_profile:-8})"
      return 0
    fi
    note "✅ DOVI configuration record confirmed in output container."
    report_add "dv_container_record" "present"
    return 0
  fi

  warn "DOVI configuration record (dvcC/dvvC box) NOT found in output container."
  warn "  RPU NAL units are present in the bitstream but the container lacks DV signaling."
  warn "  Impact: Some players (Apple TV, iPhone, iPad) may not activate DV rendering"
  warn "  and will fall back to HDR10/HLG base layer instead."

  # Attempt fallback: mux the raw HEVC ES into a DV-signaled MP4 with mp4box,
  # then merge that video with audio/subs from the original mux.
  if (( ! VIDEO_COPY_FROM_SOURCE )); then
    note "→ Attempting DV container signaling fallback…"
    local dv_video_mp4="$WORKDIR/dv_video_only.mp4"
    local fallback_ok=0

    # mp4box fallback: natively parses RPU NALs and writes dvcC box.
    if (( ! fallback_ok )) && [[ -n "${MP4BOX_CMD:-}" && -n "${V_MIXED:-}" && -s "$V_MIXED" ]]; then
      local dvp_hint=""
      # Defense-in-depth: require BOTH values to be plain integers before feeding them into the
      # mp4box `:dvp=PROFILE.COMPAT_ID` hint. Safe in practice (DOVI-box integers can't carry : or =),
      # but a numeric guard keeps a malformed probe value from ever reaching the mp4box arg string.
      # CR-1: consume the OUTPUT profile (8.1 after a P7/P5 convert; otherwise the
      # source value) so the dvcC box never mis-signals a converted single-layer stream.
      if [[ "${DV_OUT_PROFILE:-}" =~ ^[0-9]+$ && "${DV_OUT_COMPAT_ID:-}" =~ ^[0-9]+$ ]]; then
        dvp_hint=":dvp=${DV_OUT_PROFILE}.${DV_OUT_COMPAT_ID}"
      fi

      # Force source frame rate (mp4box defaults headerless ES to 25fps). See the
      # pre-wrap path for the full rationale.
      local -a fps_arg=()
      [[ -n "$SRC_FPS" ]] && fps_arg=(-fps "$SRC_FPS")
      "$MP4BOX_CMD" ${fps_arg[@]+"${fps_arg[@]}"} -add "${V_MIXED}${dvp_hint}" \
           -new "$dv_video_mp4" >"$WORKDIR/dovi_mux_mp4box.log" 2>&1 &
      local mp4box_fb_pid=$!
      local _mp4box_fb_rc=0; _await_tracked_pid "$mp4box_fb_pid" "DV fallback: muxing with mp4box" || _mp4box_fb_rc=$?
      if (( _mp4box_fb_rc == 0 )) && [[ -s "$dv_video_mp4" ]]; then
        if _dv_probe_has_config_record "$dv_video_mp4"; then  # M-DRY-a
          fallback_ok=1
        else
          warn "mp4box fallback muxed OK but dvcC not detected. See: $WORKDIR/dovi_mux_mp4box.log"
        fi
      else
        warn "mp4box fallback mux failed. See: $WORKDIR/dovi_mux_mp4box.log"
      fi
    fi

    # If mp4box produced a dvcC-bearing video MP4, remux it with audio/subs from original output.
    if (( fallback_ok )); then
      # L6 (known, accepted): dv_final lives in WORKDIR, so the `mv -f "$dv_final" "$TMP_OUT"` below
      # is cross-filesystem when --workdir puts WORKDIR on a different volume than OUT_DIR — there it
      # degrades to a full copy+unlink of the multi-GB DV file (and is not atomic). Kept in WORKDIR
      # deliberately: a failed fallback remux is then auto-cleaned with WORKDIR instead of orphaning
      # a partial file next to the output. Only the rare mp4box DV-container fallback path hits this.
      local dv_final="$WORKDIR/dv_final_remux.${OUTPUT_EXT}"
      local -a remux_cmd=("${FFMPEG_FLAGS[@]}")
      remux_cmd+=(-i "$dv_video_mp4")  # Video with dvcC from mp4box
      remux_cmd+=(-i "$TMP_OUT")       # Audio/subs from original mux
      remux_cmd+=(-map 0:v:0)          # Video from mp4box mux
      remux_cmd+=(-map 1:a? -map 1:s?) # Audio + subs from original mux
      remux_cmd+=(-c copy)
      # D9 (verified non-issue): no -map_metadata/-map_chapters override is needed here even
      # under --strip-metadata / --no-keep-chapters. Input 0 ($dv_video_mp4) is a *raw HEVC ES*
      # wrapped by mp4box, so it carries no source-origin global metadata and no chapters (only
      # mp4box's own major_brand/encoder/creation_time tags, the GPAC analogue of ffmpeg's
      # muxer tags on the normal path). Input 1 ($TMP_OUT) was already produced by mux_final in
      # the post-strip state, so ffmpeg's default chapter copy reflects the flag too. The earlier
      # audit (D9) suspected an input-0 leak; ffprobe of a real wrapped ES confirmed none.
      remux_cmd+=(-strict unofficial -tag:v dvh1)
      remux_cmd+=(-movflags +faststart)
      remux_cmd+=(-f "$MUX_FORMAT" "$dv_final")

      ffmpeg "${remux_cmd[@]}" 2>"$WORKDIR/dv_remux.err" &
      local remux_fb_pid=$!
      local _remux_fb_rc=0; _await_tracked_pid "$remux_fb_pid" "DV fallback: remuxing with dvcC" || _remux_fb_rc=$?
      if (( _remux_fb_rc == 0 )) && [[ -s "$dv_final" ]]; then
        if _dv_probe_has_config_record "$dv_final"; then  # M-DRY-a
          mv -f "$dv_final" "$TMP_OUT"
          note "✅ DV container fallback succeeded (mp4box) — DOVI configuration record added."
          report_add "dv_container_record" "added via mp4box fallback"
          return 0
        fi
      fi
      warn "DV container fallback remux failed. See: $WORKDIR/dv_remux.err"
    fi
  fi

  report_add "dv_container_record" "missing — players may fall back to HDR10/HLG"
  return 0  # Non-fatal; output is still usable, just without DV activation on some players
}

# Check if source has valid HDR10 static metadata (MaxCLL, mastering display).
# Warns if metadata is absent, which causes dim/washed-out playback when DV is stripped.
# Globals: METADATA_CACHE (read), FFPROBE_FLAGS (read), SRC_ABS (read)
_check_hdr10_static_metadata() {
  local has_mastering=0 has_cll=0 side_data

  # Check JSON metadata cache for mastering display and content light level
  if [[ -n "${METADATA_CACHE:-}" ]]; then
    side_data="$(_jq_cache -r '
      [.streams[] | select(.codec_type=="video")] | .[0].side_data_list[]?.side_data_type // empty')" || true

    printf '%s\n' "$side_data" | grep -qiE 'mastering.display' && has_mastering=1
    printf '%s\n' "$side_data" | grep -qiE 'content.light.level' && has_cll=1
  fi

  # Fallback: text probe
  if (( ! has_mastering && ! has_cll )); then
    local probe_out
    probe_out="$(ffprobe "${FFPROBE_FLAGS[@]}" -show_frames -read_intervals %+#1 \
                 -select_streams v:0 "$SRC_ABS" 2>&1)" || true
    printf '%s\n' "$probe_out" | grep -qiE 'mastering.display|mastering_display' && has_mastering=1
    printf '%s\n' "$probe_out" | grep -qiE 'max_content|max_average|content.light' && has_cll=1
  fi

  if (( ! has_mastering && ! has_cll )); then
    warn "Source has DV but NO HDR10 static metadata (mastering display, MaxCLL/MaxFALL)."
    warn "  Stripping DV will produce an HDR10 stream with missing brightness metadata."
    warn "  Impact: Playback may appear dim or washed-out on HDR10-only displays."
    warn "  Consider using archive profile to preserve DV, or adding HDR10 metadata manually."
    report_add "hdr10_static_metadata" "missing (mastering=$has_mastering, cll=$has_cll)"
  elif (( ! has_mastering )); then
    warn "Source has MaxCLL/MaxFALL but no mastering display metadata. HDR10 output may have suboptimal tone-mapping on some displays."
    report_add "hdr10_static_metadata" "partial (mastering=0, cll=1)"
  elif (( ! has_cll )); then
    note "Source has mastering display metadata but no MaxCLL/MaxFALL. Most players handle this gracefully."
    report_add "hdr10_static_metadata" "partial (mastering=1, cll=0)"
  else
    report_add "hdr10_static_metadata" "present"
  fi
}

# ===== Section 25: Temp paths =================================================================
V_SRC_ES="$WORKDIR/video_src.es"
RPU_P7="$WORKDIR/rpu_p7.bin"
RPU_FINAL="$WORKDIR/rpu_final.bin"

# Initial values — run_video_pipeline() reassigns V_BASE and V_MIXED at runtime
# based on whether DV injection is needed:
#   DV path:     .hevc raw ES (dovi_tool requires raw elementary streams)
#   Non-DV path: .mkv container (preserves timestamps for matroska final mux)
#
# NOTE: On non-DV paths and DV fallback paths, V_MIXED is reassigned to alias
# V_BASE (or V_INJECTED) rather than copying the file.  This avoids multi-GB
# file copies for no functional gain.  Downstream consumers (mux_final, DV
# container verification, pre-wrap) only read V_MIXED — they never write to it.
# Consequence for --keep-temp-always: the workdir will contain only video_base
# (not a separate video_mixed) on non-DV runs.
V_BASE="$WORKDIR/video_base.hevc"
V_MIXED="$WORKDIR/video_mixed.hevc"

# Intermediate file for P7/P5→P8 conversion: inject raw RPU here first, then
# dovi_tool convert produces the final V_MIXED from this file.
V_INJECTED="$WORKDIR/video_injected.hevc"

# Pre-wrapped DV MP4: V_MIXED wrapped into MP4 with proper dvcC/dvvC box via dovi_tool.
# When available, mux_final uses this instead of the raw V_MIXED ES so that ffmpeg
