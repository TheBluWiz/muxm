# ── Unified subtitle track list (Subs_Fix Phase 2) ──────────────────────────
# One data model shared by both selectors (single-track build_subtitle_plan and
# multi-track run_subtitle_pipeline_multi) and consumed by the one emitter
# (_emit_sub_tracks in mux_final). Each index is one output subtitle track.
# Parallel arrays, appended via _sub_track_add and read via _sub_track_field.
#
# Fields:
#   KIND        — source kind: "embedded" (map from source) or "file" (-i input).
#   VALUE       — for "embedded": the 0-based subtitle-relative stream index in the
#                 source (mapped as $src:s:VALUE — this is the desync fix: embedded
#                 subs are mapped from the source, never round-tripped through a
#                 standalone .sup). For "file": the path to a workdir/OCR/converted
#                 file or an external sidecar (added as a deduplicated -i input).
#   LANG        — language tag (e.g. "eng"); empty if unset.
#   TITLE       — title tag; empty means "derive from TYPE" at emit time.
#   TYPE        — "forced" | "full" | "sdh" (drives disposition + title fallback).
#   CODEC       — desired -c:s codec ("copy" | "srt" | "mov_text") or the source
#                 codec name for the emitter to decide from.
#   DISPOSITION — "forced" | "hearing_impaired" | "0".
#   ROUTING     — "embed" (default) | "burn" | "export". Phases 4–5 populate this;
#                 the emitter only emits ROUTING=embed tracks (burn/export are
#                 handled by the video-burn / external-export paths respectively).
#
# Additive in Phase 2: declared and unit-tested, but nothing populates or reads
# these yet — the selectors and emitter are wired up in Phases 3–5.
declare -a SUB_TRACKS_KIND=()
declare -a SUB_TRACKS_VALUE=()
declare -a SUB_TRACKS_LANG=()
declare -a SUB_TRACKS_TITLE=()
declare -a SUB_TRACKS_TYPE=()
declare -a SUB_TRACKS_CODEC=()
declare -a SUB_TRACKS_DISPOSITION=()
declare -a SUB_TRACKS_ROUTING=()

# _sub_tracks_reset — clear the unified track list (idempotent; also (re)creates
# the arrays, so callers extracted in isolation get a clean, defined state).
_sub_tracks_reset() {
  SUB_TRACKS_KIND=()
  SUB_TRACKS_VALUE=()
  SUB_TRACKS_LANG=()
  SUB_TRACKS_TITLE=()
  SUB_TRACKS_TYPE=()
  SUB_TRACKS_CODEC=()
  SUB_TRACKS_DISPOSITION=()
  SUB_TRACKS_ROUTING=()
}

# _sub_track_add KIND VALUE LANG TITLE TYPE CODEC DISPOSITION [ROUTING]
# Append one subtitle track to the unified list. ROUTING defaults to "embed".
_sub_track_add() {
  SUB_TRACKS_KIND+=( "$1" )
  SUB_TRACKS_VALUE+=( "$2" )
  SUB_TRACKS_LANG+=( "$3" )
  SUB_TRACKS_TITLE+=( "$4" )
  SUB_TRACKS_TYPE+=( "$5" )
  SUB_TRACKS_CODEC+=( "$6" )
  SUB_TRACKS_DISPOSITION+=( "$7" )
  SUB_TRACKS_ROUTING+=( "${8:-embed}" )
}

# _sub_track_count — number of tracks in the unified list (stdout).
# Body kept multi-line (closing brace on its own line) so the unit harness's awk
# extraction anchor (/^fn\(\)/,/^\}/) captures exactly this function.
_sub_track_count() {
  printf '%s\n' "${#SUB_TRACKS_KIND[@]}"
}

# _sub_track_field IDX FIELD — echo one field of track IDX (mirrors _sp_sub_field's
# (index, field) accessor convention). FIELD is one of: kind value lang title type
# codec disposition routing. Returns 2 (and emits nothing) on an unknown field.
_sub_track_field() {
  local idx="$1" field="$2"
  case "$field" in
    kind)        printf '%s\n' "${SUB_TRACKS_KIND[$idx]}" ;;
    value)       printf '%s\n' "${SUB_TRACKS_VALUE[$idx]}" ;;
    lang)        printf '%s\n' "${SUB_TRACKS_LANG[$idx]}" ;;
    title)       printf '%s\n' "${SUB_TRACKS_TITLE[$idx]}" ;;
    type)        printf '%s\n' "${SUB_TRACKS_TYPE[$idx]}" ;;
    codec)       printf '%s\n' "${SUB_TRACKS_CODEC[$idx]}" ;;
    disposition) printf '%s\n' "${SUB_TRACKS_DISPOSITION[$idx]}" ;;
    routing)     printf '%s\n' "${SUB_TRACKS_ROUTING[$idx]}" ;;
    *)           return 2 ;;
  esac
}

# ── Shared subtitle emitter (Subs_Fix Phase 3) ──────────────────────────────
# The one place that turns chosen subtitle tracks into ffmpeg input/-map/-c:s/
# metadata/disposition arguments, for BOTH single- and multi-track modes. Built
# and unit-tested here; mux_final is wired to call _emit_sub_tracks in Phases 4–5
# (multi first, then single). These functions mutate the mux_final-scoped arrays
# and counters: ff_in, ff_map, ff_codec, next_idx, _src_input_idx, _ext_sub_paths,
# _ext_sub_idxs (bash dynamic scope — they are mux_final locals at call time).

# _add_sub_stream KIND VALUE — register one subtitle track's ffmpeg input and
# append its -map to ff_map. The desync fix lives here: an "embedded" track is
# mapped straight from the source input ("$_src_input_idx:s:VALUE"), never written
# to a standalone .sup elementary stream and re-imported (which, without -copyts,
# rebased its first cue to t=0).
#
#   KIND=embedded — VALUE is the 0-based subtitle-relative stream index in the
#     source. Registers SRC_ABS as a shared input ONCE (idempotent via
#     _src_input_idx, shared with video-copy / audio-copy) and maps
#     "$_src_input_idx:s:VALUE".
#   KIND=file — VALUE is a path (workdir OCR/converted file or external sidecar).
#     Added as a DEDUPLICATED -i input (same path reused, not re-added) and mapped
#     as "$idx:s:0".
#
# Out-of-scope (Subs_Fix.md §8): embedded subs are mapped without -copyts, so a
# source whose container start_time != 0 leaves the same small residual offset the
# multi-track path already has today — deliberately not compensated here.
_add_sub_stream() {
  local kind="$1" value="$2"
  case "$kind" in
    embedded)
      if [[ -z "$_src_input_idx" ]]; then
        ff_in+=( -i "$SRC_ABS" )
        _src_input_idx=$next_idx
        next_idx=$(( next_idx + 1 ))
      fi
      ff_map+=( -map "${_src_input_idx}:s:${value}" )
      ;;
    file)
      local idx="" k
      for (( k=0; k<${#_ext_sub_paths[@]}; k++ )); do
        [[ "${_ext_sub_paths[$k]}" == "$value" ]] && { idx="${_ext_sub_idxs[$k]}"; break; }
      done
      if [[ -z "$idx" ]]; then
        ff_in+=( -i "$value" )
        idx=$next_idx
        _ext_sub_paths+=( "$value" )
        _ext_sub_idxs+=( "$idx" )
        next_idx=$(( next_idx + 1 ))
      fi
      ff_map+=( -map "${idx}:s:0" )
      ;;
    *)
      die 41 "Internal error: _add_sub_stream: unknown subtitle source kind '$kind' (expected 'embedded' or 'file'). Please report this."
      ;;
  esac
}

# _emit_sub_tracks — the single subtitle emitter. Iterates the unified SUB_TRACKS_*
# list and, for every ROUTING=embed track, appends its input + -map (via
# _add_sub_stream) and its -c:s / language / title / disposition to ff_codec using
# ONE rule set for both modes. ROUTING=burn / =export tracks are skipped (handled by
# the video-burn and external-export paths). The output subtitle stream index is
# function-local, so audio tagging downstream is untouched.
#
# Codec rule — ONE decision for both modes, keyed on the track's EFFECTIVE codec
# (SUB_TRACKS_CODEC = the codec of the data actually muxed: the source stream codec
# for embedded tracks, the prepared-file codec for file tracks; both selectors set
# it). This is the pre-unification multi-track codec case verbatim, so multi-track
# output is identical by construction (Phase 4 populates SUB_TRACKS_CODEC from
# SUB_MT_CODECS):
#   MKV     : ass/ssa → copy if SUB_PRESERVE_TEXT_FORMAT else srt; everything else
#             (other text or bitmap) → copy (stream-copied).
#   MP4/MOV : text → mov_text; bitmap (PGS/VobSub) → die 12 (can't live in MP4).
# (The old single-track _sub_codec_for_file emitted `srt` for a prepared text file;
# the unified rule emits `copy` instead — identical subrip output in MKV, just a
# different command token. Single-track folds onto this in Phase 5.)
# Title + disposition derive from TYPE (forced→Forced/forced, sdh→SDH/
# hearing_impaired, *→<Type>/0), a near-verbatim lift of the pre-unification
# mux_final logic; SUB_TRACKS_DISPOSITION carries the same resolved value for a
# self-describing model but the emitter is the single owner of the type→ rule.
_emit_sub_tracks() {
  local i n kind value lang title type codec oc label c
  local -i out=0
  n=${#SUB_TRACKS_KIND[@]}
  for (( i=0; i<n; i++ )); do
    [[ "${SUB_TRACKS_ROUTING[$i]}" == "embed" ]] || continue
    kind="${SUB_TRACKS_KIND[$i]}"
    value="${SUB_TRACKS_VALUE[$i]}"
    lang="${SUB_TRACKS_LANG[$i]}"
    title="${SUB_TRACKS_TITLE[$i]}"
    type="${SUB_TRACKS_TYPE[$i]}"
    codec="${SUB_TRACKS_CODEC[$i]}"

    # 1) input + -map
    _add_sub_stream "$kind" "$value"

    # 2) output codec — ONE rule set, keyed on the track's effective codec
    c="${codec,,}"
    if [[ "$MUX_FORMAT" == "matroska" ]]; then
      case "$c" in
        ass|ssa) if (( SUB_PRESERVE_TEXT_FORMAT )); then oc="copy"; else oc="srt"; fi ;;
        *)       oc="copy" ;;
      esac
    else
      if _is_text_sub_codec "$c"; then
        oc="mov_text"
      else
        die 12 "PGS/VobSub subtitles cannot be muxed into MP4/MOV; use MKV output or enable OCR."
      fi
    fi
    ff_codec+=( "-c:s:${out}" "$oc" )

    # 3) language
    [[ -n "$lang" ]] && ff_codec+=( "-metadata:s:s:${out}" "language=$lang" )

    # 4) title — source title if present, else capitalized type label
    if [[ -n "$title" ]]; then
      ff_codec+=( "-metadata:s:s:${out}" "title=$title" )
    else
      case "$type" in
        sdh) label="SDH" ;;
        *)   label="${type^}" ;;
      esac
      ff_codec+=( "-metadata:s:s:${out}" "title=$label" )
    fi

    # 5) disposition — derived from type
    case "$type" in
      forced) ff_codec+=( "-disposition:s:${out}" forced ) ;;
      sdh)    ff_codec+=( "-disposition:s:${out}" hearing_impaired ) ;;
      *)      ff_codec+=( "-disposition:s:${out}" 0 ) ;;
    esac

    out=$(( out + 1 ))
  done
}

