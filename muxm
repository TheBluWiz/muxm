# L7: single source of truth for the numeric-value validation patterns. These were inlined ~3×
# each across the CLI-parse validators and the post-config re-validation block; hoisting them keeps
# the two sites from drifting. Used unquoted in [[ $x =~ $_RE_… ]] tests (quoting forces a literal
# match). _RE_BITRATE: a bitrate like 20000k / 5M / a plain integer. _RE_LEVEL: a numeric H.26x level
# like 5.1. (Deliberately NOT applied to the unrelated duration/framerate `^[0-9]+(\.[0-9]+)?$`
# checks, which only coincide in shape.)
readonly _RE_BITRATE='^[0-9]+(\.[0-9]+)?[kKmMgG]?$'
readonly _RE_LEVEL='^[0-9]+(\.[0-9]+)?$'

# CR-15: single source of truth for the binary size units. Both filesize_pretty and _gb open-coded
# 1 GiB / 1 MiB as the bare literal (1073741824 / 1048576) AND the factored expression
# (1024*1024*1024 / 1024*1024). Name them once so the two spellings can't drift.
readonly BYTES_PER_GIB=1073741824   # 1024^3
readonly BYTES_PER_MIB=1048576      # 1024^2

# L8: canonical membership test for "is $1 one of the software AV1 encoders". Replaces the
# `[[ $VIDEO_CODEC == libsvt-av1 || $VIDEO_CODEC == libaom-av1 ]]` idiom that was repeated across
# many sites, so adding/renaming an AV1 encoder is a one-line change. NOTE: `case` pattern arms
# (e.g. `libsvt-av1|libaom-av1)`) cannot call a function and are intentionally left inline.
_is_av1_codec(){ [[ "$1" == "libsvt-av1" || "$1" == "libaom-av1" ]]; }

