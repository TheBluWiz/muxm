# ===== Section 26: Video pipeline =============================================================

# Check if source video can be stream-copied (no re-encode) for the target profile.
# Tests: codec match (hevc/h264), pixel format (10-bit for HDR), tone-map requirement,
#        DV profile compatibility (atv-directplay-hq requires P8 for copy),
#        bitrate ceiling (MAX_COPY_BITRATE).
# Returns: 0 if copy-compliant, 1 if re-encode required.
# Sets: _COPY_REJECT_REASON (diagnostic string when returning 1)
# Globals: VIDEO_CODEC, TARGET_PIXFMT, TONEMAP_HDR_TO_SDR, PROFILE_DESC,
#          IS_DV, DISABLE_DV, PROFILE_NAME, DV_SRC_PROFILE,
#          MAX_COPY_BITRATE (read)
# _output_pixfmt_is_10bit — Would the encoded output be 10-bit for the active
# profile, given the source's color metadata? Self-sufficient: probes the source
# directly (color_primaries/transfer/space + pix_fmt) and reads only config that is
# already set at skip time, so it is correct on BOTH the normal pipeline path AND
# the skip-if-ideal path — where TARGET_PIXFMT is not yet computed and still holds
# its "yuv420p" default (the C1 bug). This mirrors the 4:2:0 bit-depth arm of
# decide_color_and_pixfmt() (its source of truth — keep the two in sync if that
# logic changes). It does NOT replicate decide's SDR 4:4:4/4:2:2 chroma-preservation
# branch, which downgrades a forced-10-bit target back to 8-bit for an 8-bit source;
# that path is unreachable here (the only VIDEO_COPY_IF_COMPLIANT profile setting
# SDR_FORCE_10BIT also sets FORCE_CHROMA_420), and even if reached it would only cost
# an unnecessary re-encode at the same 8-bit depth — never a wrong-depth output.
# Reads: HDR_TARGET_PIXFMT, TONEMAP_HDR_TO_SDR, SDR_FORCE_10BIT, SDR_USE_10BIT_IF_SRC_10BIT
# Returns: 0 (true) if the output would be 10-bit, 1 (false) otherwise.
_output_pixfmt_is_10bit() {
  local prim trc cspace pix src_is_hdr=0 src_is_10bit=0
  prim="$(_lower "$(_probe_field color_primaries)")"
  trc="$(_lower "$(_probe_field color_transfer)")"
  cspace="$(_lower "$(_probe_field color_space)")"
  pix="$(_lower "$(_probe_field pix_fmt)")"

  # Classify the source exactly as decide_color_and_pixfmt does (same predicates).
  [[ "$prim" == "bt2020" || "$cspace" == "bt2020nc" || "$trc" == "smpte2084" \
     || "$trc" == "arib-std-b67" || "$trc" == "hlg" ]] && src_is_hdr=1
  [[ "$pix" =~ (p010le|p10|p12) ]] && src_is_10bit=1

  if (( src_is_hdr )); then
    # HDR source: tone-mapped to SDR → 8-bit yuv420p; otherwise the output bit depth
    # follows HDR_TARGET_PIXFMT (HLG and HDR10 both take this branch in decide).
    (( TONEMAP_HDR_TO_SDR )) && return 1
    [[ "$HDR_TARGET_PIXFMT" =~ (p010le|p10|p12) ]] && return 0
    return 1
  fi

  # SDR source: 10-bit iff forced, or preserved from a 10-bit source.
  (( SDR_FORCE_10BIT )) && return 0
  (( SDR_USE_10BIT_IF_SRC_10BIT )) && (( src_is_10bit )) && return 0
  return 1
}

_video_is_copy_compliant() {
  _COPY_REJECT_REASON=""
  local src_codec src_pix
  src_codec="$(_lower "$(_probe_field codec_name)")"
  src_pix="$(_lower "$(_probe_field pix_fmt)")"

  # CLI overrides: explicit --crf or --preset forces a re-encode regardless of compliance
  if (( _CLI_CRF_EXPLICIT )); then
    _COPY_REJECT_REASON="CRF explicitly set on CLI (--crf ${CRF_VALUE})"
    return 1
  fi
  if (( _CLI_PRESET_EXPLICIT )); then
    _COPY_REJECT_REASON="preset explicitly set on CLI (--preset ${PRESET_VALUE})"
    return 1
  fi

  # Check codec match
  if [[ "$VIDEO_CODEC" == "libx265" && "$src_codec" != "hevc" ]]; then
    _COPY_REJECT_REASON="video codec is $src_codec (need hevc)"
    return 1
  fi
  if [[ "$VIDEO_CODEC" == "libx264" && "$src_codec" != "h264" ]]; then
    _COPY_REJECT_REASON="video codec is $src_codec (need h264)"
    return 1
  fi
  if _is_av1_codec "$VIDEO_CODEC"; then
    if [[ "$src_codec" != "av1" ]]; then
      _COPY_REJECT_REASON="video codec is $src_codec (need av1)"
      return 1
    fi
  fi

  # Pixel-format (bit-depth) gate. Self-sufficient so it is correct on BOTH the
  # normal pipeline path AND the skip-if-ideal path, where TARGET_PIXFMT is not yet
  # computed and still holds its "yuv420p" default (C1). Decide the INTENDED output
  # bit depth from the profile/SDR config + freshly-probed source color metadata
  # (_output_pixfmt_is_10bit) instead of reading the stale TARGET_PIXFMT, and detect
  # the source's depth with decide_color_and_pixfmt's own 10-bit predicate.
  if _output_pixfmt_is_10bit && [[ ! "$src_pix" =~ (p010le|p10|p12) ]]; then
    _COPY_REJECT_REASON="pixel format is $src_pix (need 10-bit output for this profile)"
    return 1
  fi

  # If tone-mapping is requested, can't copy — check actual source color metadata
  # (PROFILE_DESC is not yet set when check_skip_if_ideal runs, so probe directly)
  if (( TONEMAP_HDR_TO_SDR )); then
    local _sii_prim _sii_trc
    _sii_prim="$(_lower "$(_probe_field color_primaries)")"
    _sii_trc="$(_lower "$(_probe_field color_transfer)")"
    if [[ "$_sii_prim" == "bt2020" || "$_sii_trc" == "smpte2084" || "$_sii_trc" == "arib-std-b67" ]]; then
      _COPY_REJECT_REASON="tone-mapping required (HDR source cannot be copied)"
      return 1
    fi
  fi

  # RF2 (HIGH-2): forced-subtitle burn-in requires a re-encode — a stream-copy cannot
  # burn the forced track into the video. Gate on the config flag SUB_BURN_FORCED (set at
  # both call sites, unlike the runtime SRT_FORCED_BURN_PATH which is not yet populated when
  # check_skip_if_ideal calls us). Without this, the copy branch returned 0 before the burn
  # filter, the plan had routed the forced track to the (unread) burn path, the direct-map
  # fallback was suppressed, and the plan was not rebuilt — so the forced subtitle reached
  # neither the video nor a soft track, with no warning. Also fixes the milder skip-if-ideal
  # variant (forced sub silently un-burned), since check_skip_if_ideal delegates here.
  if (( SUB_BURN_FORCED )); then
    _COPY_REJECT_REASON="forced-subtitle burn-in requires a re-encode"
    return 1
  fi

  # RF2b (HIGH-2, secondary): reject copy when chroma downsampling is required — a 4:2:2/4:4:4
  # source under a Direct-Play profile (FORCE_CHROMA_420=1) must be re-encoded to 4:2:0, not
  # shipped verbatim. Chroma is read from the source pix_fmt exactly as decide_color_and_pixfmt
  # derives it.
  if (( FORCE_CHROMA_420 )) && [[ "$src_pix" =~ (422|444) ]]; then
    _COPY_REJECT_REASON="chroma downsampling required (4:2:0 enforced; source pix_fmt is $src_pix)"
    return 1
  fi

  # DV-profile gate. For the Apple TV Direct-Play profiles, only Profile 8 may be
  # stream-copied; P7/P5 etc. need RPU conversion to P8.1 and cannot be copied verbatim.
  #
  # Must be correct on BOTH call paths. On the normal pipeline path detect_dv/
  # detect_dv_info have run, so IS_DV/DV_SRC_PROFILE are authoritative (and stay so
  # for frame-probe-only or text-fallback DV, where the cache JSON has no DOVI
  # record). On the skip-if-ideal path they are still their defaults (IS_DV=0,
  # DV_SRC_PROFILE="") — the C1 bug — so fall back to a read-only probe of the
  # source's DV profile from the metadata cache.
  if (( ! DISABLE_DV )) && _is_atv_directplay_profile "${PROFILE_NAME:-}"; then
    local _cc_is_dv="$IS_DV" _cc_dv_profile="${DV_SRC_PROFILE:-}"
    if (( ! _cc_is_dv )) && [[ -z "$_cc_dv_profile" ]]; then
      if _source_has_dv_metadata; then
        _cc_is_dv=1
        _cc_dv_profile="$(_source_dv_profile)"
      fi
    fi
    if (( _cc_is_dv )) && [[ "$_cc_dv_profile" != "8" ]]; then
      _COPY_REJECT_REASON="DV profile ${_cc_dv_profile:-?} requires conversion (need P8 for copy)"
      return 1
    fi
  fi

  # Bitrate ceiling: reject copy if source exceeds MAX_COPY_BITRATE.
  # Prevents copying high-bitrate remuxes that would stutter on constrained
  # hardware (e.g., Apple TV 4K with 80+ Mbps Blu-ray remuxes).
  if [[ -n "${MAX_COPY_BITRATE:-}" ]]; then
    local src_br_bps max_br_kbps max_br_bps
    src_br_bps="$(_probe_field bit_rate)"

    # Fallback: compute average bitrate from file size / duration
    if [[ -z "$src_br_bps" || "$src_br_bps" == "N/A" || "$src_br_bps" == "0" ]]; then
      local _dur _fsz
      _dur="$(_get_source_duration_secs)"
      _dur="${_dur%.*}"  # truncate to integer
      if [[ -n "$_dur" ]] && (( _dur > 0 )); then
        # Cross-platform stat: macOS uses -f%z, Linux uses -c%s
        _fsz="$(stat -f%z "$SRC_ABS" 2>/dev/null || stat -c%s "$SRC_ABS" 2>/dev/null || echo 0)"
        if (( _fsz > 0 )); then
          src_br_bps=$(( _fsz * 8 / _dur ))
        fi
      fi
    fi

    if [[ -n "$src_br_bps" && "$src_br_bps" =~ ^[0-9]+$ ]] && (( src_br_bps > 0 )); then
      # MAX_COPY_BITRATE is specified as e.g. "80000k" — strip the trailing 'k'
      # suffix to get a plain integer, then convert kbps → bps for comparison.
      max_br_kbps="${MAX_COPY_BITRATE%k}"
      # Guard: validate numeric before arithmetic to prevent bash error on bad config
      if [[ ! "$max_br_kbps" =~ ^[0-9]+$ ]]; then
        warn "--max-copy-bitrate '${MAX_COPY_BITRATE}' is not a valid rate (expected e.g. '80000k') — skipping the bitrate ceiling check."
      else
        max_br_bps=$(( max_br_kbps * 1000 ))
        if (( src_br_bps > max_br_bps )); then
          _COPY_REJECT_REASON="bitrate ~$(( src_br_bps / 1000 ))kbps exceeds MAX_COPY_BITRATE=${MAX_COPY_BITRATE}"
          return 1
        fi
      fi
    fi
  fi

  return 0
}

# run_video_pipeline — Encode or copy the video stream, with DV handling.
#
# High-level flow:
#   1. Check copy-if-compliant → skip encode if source matches target profile
#   2. Determine intermediate format (raw ES for DV injection, MKV otherwise)
#   3. Demux raw HEVC ES from source (for DV RPU extraction, if applicable)
#   4. Encode video with filters (tone-map, forced sub burn-in)
#   5. Extract DV RPU from source (piped method → file fallback)
#   6. Convert RPU profile if needed (P7/P5 → P8.1)
#   7. Inject RPU into encoded video via dovi_tool
#   8. Pre-wrap DV video into MP4 with dvcC box (mp4box → ffmpeg fallback)
#
# Sets: V_BASE, V_MIXED, V_DV_MP4, VIDEO_COPY_FROM_SOURCE, OUTPUT_HAS_DV
# Dies on: encode failure, DV failure with fallback disabled

# Give the fallback base video the packet timestamps the Matroska muxer requires.
# When DV processing gives up and aliases V_MIXED to the raw HEVC Annex B base ES
# (V_BASE is `*.hevc` whenever v_needs_raw_es=1 — i.e. an HEVC re-encode of a DV
# source), MKV output would abort the final mux with "Can't write packet with unknown
# timestamp": a raw ES carries no container timing and the Matroska muxer — unlike the
# mp4 muxer, which reconstructs pts/dts from HEVC VUI/SPS — rejects timestamp-less
# packets. This wraps the raw ES into a timestamped MP4 (HEVC stream-copied losslessly,
# NO Dolby Vision signalling — OUTPUT_HAS_DV is already 0 on every give-up path) and
# repoints V_MIXED at it. The MP4 carries an `hvc1` tag, which the Matroska muxer accepts
# (the rejected `dvh1` tag is only used on the live-DV path). No-op when not needed:
# MP4/MOV output (mux_final stamps -r SRC_FPS on the raw ES and muxes it directly),
# non-raw-ES V_MIXED (already a timestamped .mkv intermediate), and dry runs. Fail-soft:
# on any wrap error, leave V_MIXED as the raw ES so mux_final can still try (and surface
# the existing error) rather than aborting the give-up path.
_dv_fallback_timestamp_wrap() {
  [[ "$MUX_FORMAT" == "matroska" ]] || return 0
  [[ "$V_MIXED" == *.hevc ]] || return 0
  (( DRY_RUN )) && return 0
  [[ -s "$V_MIXED" ]] || return 0

  # The raw base ES we're about to wrap is dead once V_MIXED points at the MP4 — capture
  # it now so we can reclaim it mid-run (mirrors the success-path pre-wrap at the
  # `_reclaim "$V_MIXED" "wrapped into V_DV_MP4 for mux"` site). On the give-up path this
  # is V_BASE, which the success-path `_reclaim` calls intentionally skip while
  # V_MIXED==V_BASE; once we repoint V_MIXED below it is genuinely dead.
  local _superseded_es="$V_MIXED"
  local _ts_wrap="$WORKDIR/video_base_timestamped.mp4"
  local -a _ts_fps=()
  # Raw-hevc demuxer defaults headerless ES to 25fps; stamp the real source fps.
  [[ -n "$SRC_FPS" ]] && _ts_fps=(-r "$SRC_FPS")
  ffmpeg "${FFMPEG_FLAGS[@]}" ${_ts_fps[@]+"${_ts_fps[@]}"} -i "$V_MIXED" \
       -c:v copy -tag:v hvc1 -movflags +faststart \
       -f mp4 "$_ts_wrap" >"$WORKDIR/base_timestamp_wrap.log" 2>&1 &
  local _ts_pid=$!
  local _ts_rc=0; _await_tracked_pid "$_ts_pid" "Wrapping base video for MKV mux (timestamps)" || _ts_rc=$?
  if (( _ts_rc == 0 )) && [[ -s "$_ts_wrap" ]]; then
    note "✅ Base video wrapped into timestamped MP4 for the MKV mux (no Dolby Vision)."
    report_add "dv_fallback_wrap" "timestamped wrap (mkv, no dv)"
    V_MIXED="$_ts_wrap"
    # The raw base ES is now superseded by the timestamped MP4 mux input — reclaim it
    # (no-op in dry-run / outside WORKDIR; runs even under -k/-K, like every _reclaim).
    _reclaim "$_superseded_es" "wrapped into timestamped MP4 for MKV mux"
  else
    warn "Could not wrap base video into a timestamped container — the MKV final mux may fail."
    report_add "dv_fallback_wrap" "failed (mkv timestamp wrap)"
  fi
}

run_video_pipeline() {
  # Check copy-if-compliant first
  if (( VIDEO_COPY_IF_COMPLIANT )); then
    if ! _video_is_copy_compliant; then
      note "Source video not compliant for copy — will re-encode."
      report_add "video_action" "re-encode (not compliant)"
    else
      note "→ Source video is compliant for target profile — will copy directly from source during mux."
      report_add "video_action" "copy (compliant)"

      # --threads only governs the software video *encoder*; a stream copy runs no
      # encoder, so the flag has no effect on this path. Advise once when typed.
      (( _CLI_THREADS_EXPLICIT )) && \
        warn "--threads has no effect here — the source video is being copied, not re-encoded."

      # Flag for mux_final to map video directly from source file.
      # This preserves container-level metadata (DOVI configuration record,
      # displaymatrix, etc.) that would be lost by extracting to raw HEVC ES.
      VIDEO_COPY_FROM_SOURCE=1

      if (( IS_DV && ! DISABLE_DV )); then
        # Validate DV integrity in source before committing to copy path.
        # A corrupt RPU would pass through silently without this check.
        if (( _HAS_DOVI_TOOL )); then
          note "→ Validating DV RPU integrity in source (copy path)…"
          # Quick RPU extraction to validate (piped, no temp file needed)
          local rpu_check="$WORKDIR/rpu_copy_check.bin"
          (
            set +eE  # Prevent ERR trap in subshell
            ffmpeg "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:v:0 -c copy \
                 -bsf:v hevc_mp4toannexb -f hevc - 2>/dev/null \
               | dovi_tool extract-rpu - -o "$rpu_check" >/dev/null 2>&1
          ) &
          local rpu_val_pid=$!
          local _rpu_val_rc=0; _await_tracked_pid "$rpu_val_pid" "Validating DV RPU integrity" || _rpu_val_rc=$?
          if (( _rpu_val_rc == 0 )) && [[ -s "$rpu_check" ]]; then
            if _validate_dv_rpu "$rpu_check"; then
              note "DV RPU integrity verified for copy path."
              report_add "dv_copy_rpu_check" "passed"
            else
              warn "DV RPU validation failed on source — RPU may be corrupt."
              warn "  Copy will proceed (source data is unchanged), but DV playback may be affected."
              report_add "dv_copy_rpu_check" "failed (proceeding with copy)"
            fi
            rm -f "$rpu_check" 2>/dev/null || true
          else
            note "Could not extract RPU for validation (non-fatal). Proceeding with copy."
            report_add "dv_copy_rpu_check" "extraction failed (proceeding)"
          fi
        fi

        OUTPUT_HAS_DV=1
        note "DV metadata will be preserved via direct source copy."
        mark_done "DV preserved (direct source copy)"
      fi

      mark_done "Video stream copy (compliant — direct source)"
      return 0
    fi
  fi

  # Determine intermediate format: raw ES is needed only when DV RPU injection
  # is possible (HEVC encoder + DV source + DV enabled). Otherwise, use a container
  # (matroska) to preserve timestamps that the Matroska final muxer requires.
  # Raw ES files lack packet pts/dts, which the mp4 muxer can reconstruct from
  # HEVC VUI/SPS parameters but the matroska muxer cannot — causing mux failures
  # for any MKV output path.
  #
  # Both libx265 and hevc_videotoolbox produce raw Annex B HEVC suitable for
  # dovi_tool inject-rpu (verified in the Phase 2 DV spike — RPU round-trips
  # bit-perfect through VT). VIDEO_ENCODER_FFMPEG captures both cases.
  local -i v_needs_raw_es=0
  if { [[ "$VIDEO_ENCODER_FFMPEG" == "libx265" ]] || [[ "$VIDEO_ENCODER_FFMPEG" == "hevc_videotoolbox" ]]; } \
     && (( IS_DV && ! DISABLE_DV )); then
    v_needs_raw_es=1
  fi

  if (( v_needs_raw_es )); then
    V_BASE="$WORKDIR/video_base.hevc"
    V_MIXED="$WORKDIR/video_mixed.hevc"
  else
    V_BASE="$WORKDIR/video_base.mkv"
    V_MIXED="$WORKDIR/video_mixed.mkv"
  fi

  # Demux raw HEVC ES for DV RPU extraction (only when DV injection is possible).
  # Skipped for non-HEVC sources and when DV is disabled — the ES is only consumed
  # by dovi_tool extract-rpu later in the pipeline.
  if (( v_needs_raw_es )); then
    # Lazy ES demux: the raw HEVC elementary stream is now produced on demand
    # (via _ensure_src_es) ONLY if the piped DV RPU extraction later fails and the
    # file-based fallback is needed. Eager demux here wrote a full source-sized
    # copy (often tens of GB) that the piped extraction made redundant — it was
    # usually created and never read. See run_dv_inject's RPU extraction path.
    if (( DRY_RUN )); then
      : > "$V_SRC_ES" 2>/dev/null || true
      mark_done "Demux raw ES → video_src.es (dry-run)"
    else
      log "Raw ES demux deferred — produced on demand only if piped DV RPU extraction fails."
    fi
  else
    log "Skipping ES demux (DV injection not applicable for this encode)."
  fi

  # Build encode command based on VIDEO_CODEC and PROFILE_DESC
  local -a vf_filters=()
  local -a encode_args=()
  local _enc_cwd=""    # if set, run the encode ffmpeg from this dir (forced-sub burn-in)
  local thread_args=()   # RF9: expanded array-safe below (empty when THREADS unset — bash-4.3 set -u)
  [[ -n "${THREADS:-}" ]] && thread_args=(-threads "$THREADS")

  # Tone-mapping filter (universal profile: HDR→SDR)
  if [[ "$PROFILE_DESC" == "SDR-TONEMAP" ]]; then
    vf_filters+=("$TONEMAP_FILTER")
    note "→ Tone-mapping HDR→SDR via: ${TONEMAP_FILTER}"
    report_add "tonemap" "enabled (hable)"
  fi

  # Forced subtitle burn-in filter (added here if SUB_BURN_FORCED and we have a forced SRT)
  # Note: SRT_FORCED_BURN_PATH is set by subtitle plan if burn is requested.
  if (( SUB_BURN_FORCED )) && [[ -n "${SRT_FORCED_BURN_PATH:-}" && -s "${SRT_FORCED_BURN_PATH:-}" ]]; then
    # Stage the forced SRT at a clean temp path for the ffmpeg subtitles filter.
    # The subtitles filter requires the explicit 'filename=' key — positional
    # argument form (subtitles=/path) fails on many ffmpeg builds with
    # "No option name near '/path'".
    # Path safety: reference the staged file by its bare RELATIVE name (burn.srt) and
    # run the encode ffmpeg from inside WORKDIR (see _enc_cwd below). burn.srt contains
    # no filtergraph metacharacters, so NO escaping is needed for any user path — quoting
    # the absolute WORKDIR path here would still break on an apostrophe in the output
    # directory (e.g. "It's A Test/"), since the filtergraph parser unquotes it. Every
    # other path in the encode invocation is absolute (SRC_ABS, V_BASE, the .err redirect,
    # the progress pipe), so the cwd change is harmless.
    # Security: WORKDIR is mktemp -d (unpredictable name, 0700 on Linux), so the staged
    # file is not guessable by a local attacker — eliminates the TOCTOU race that a
    # predictable /tmp/muxm-burn-$$.srt name would expose.
    _BURN_SRT_FILTER="$WORKDIR/burn.srt"
    cp -f "$SRT_FORCED_BURN_PATH" "$_BURN_SRT_FILTER"
    vf_filters+=("subtitles=filename=burn.srt")
    _enc_cwd="$WORKDIR"
    note "→ Burning forced subtitles into video stream"
    report_add "sub_burn_forced" "true"
  elif (( SUB_BURN_FORCED )); then
    warn "[Subs] Forced-subtitle burn-in was requested but no forced subtitle was prepared — encoding without burn-in."
    report_add "sub_burn_forced" "skipped (no forced subtitle available)"
  fi

  # Build -vf string
  local vf_str=""
  if [[ ${#vf_filters[@]} -gt 0 ]]; then
    # shellcheck disable=SC2030  # Subshell-scoped IFS change is intentional
    vf_str="$(IFS=','; echo "${vf_filters[*]}")"
  fi

  # Dispatch on VIDEO_ENCODER_FFMPEG (set by resolve_video_encoder). This is
  # the concrete ffmpeg `-c:v` value and captures both software and hardware
  # backends for each logical codec. AV1 (libsvtav1/libaom-av1) remains
  # software-only in Phase 2; HEVC/H.264 may route to VideoToolbox when
  # HW_ACCEL_RESOLVED=videotoolbox.
  case "$VIDEO_ENCODER_FFMPEG" in
    libsvtav1|libaom-av1)
      # AV1 encode (SVT-AV1 or libaom-av1)
      local av1_preset="${PRESET_VALUE:-6}"
      log "→ Encoding video (AV1, ${TARGET_PIXFMT}, preset ${av1_preset}, CRF ${CRF_VALUE}) → $V_BASE"
      encode_args=(
        -c:v "$VIDEO_ENCODER_FFMPEG"
        -crf "$CRF_VALUE"
        -pix_fmt "$TARGET_PIXFMT"
        "${COLOR_ARGS[@]}"
      )
      if [[ "$VIDEO_ENCODER_FFMPEG" == "libsvtav1" ]]; then
        encode_args+=( -preset "$av1_preset" )
      else
        encode_args+=( -cpu-used "$av1_preset" )
      fi
      # SVT_AV1_PARAMS_BASE is shared between libsvt-av1 and libaom-av1; flag name differs per encoder
      if [[ -n "${SVT_AV1_PARAMS:-}" ]]; then
        if [[ "$VIDEO_ENCODER_FFMPEG" == "libsvtav1" ]]; then
          encode_args+=( -svtav1-params "$SVT_AV1_PARAMS" )
        else
          encode_args+=( -aom-params "$SVT_AV1_PARAMS" )
        fi
      fi
      [[ -n "$AV1_MAXRATE" ]] && encode_args+=( -maxrate "$AV1_MAXRATE" )
      [[ -n "$AV1_BUFSIZE" ]] && encode_args+=( -bufsize "$AV1_BUFSIZE" )
      report_add "video_codec" "av1"
      ;;

    libx264)
      # H.264 software encode (universal / youtube-upload profile)
      # F9: H.264 output is always 8-bit 4:2:0 (yuv420p) for universal device compatibility —
      # the only chroma/depth H.264 decoders are guaranteed to play. TARGET_PIXFMT/FORCE_CHROMA_420
      # are intentionally NOT honored here (4:2:2/4:4:4 or 10-bit H.264 has poor device support and
      # no profile selects libx264 for HDR). The hevc_videotoolbox/libx265 arms do honor TARGET_PIXFMT.
      log "→ Encoding video (H.264/SDR, preset ${PRESET_VALUE}, CRF ${CRF_VALUE}) → $V_BASE"
      encode_args=(
        -c:v libx264
        -preset "$PRESET_VALUE"
        -crf "$CRF_VALUE"
        -pix_fmt yuv420p
        "${COLOR_ARGS[@]}"
      )
      [[ -n "$X264_PARAMS_BASE" ]] && encode_args+=( -x264-params "$X264_PARAMS_BASE" )
      report_add "video_codec" "h264"
      ;;

    h264_videotoolbox)
      # H.264 via Apple Silicon VideoToolbox.
      # VideoToolbox uses `-q:v` (assembled by build_videotoolbox_params into
      # VIDEOTOOLBOX_ARGS) instead of -crf, and does not accept -preset.
      if [[ "$TARGET_PIXFMT" == *"10"* ]]; then
        warn "h264_videotoolbox does not support 10-bit output — the target pixel format (${TARGET_PIXFMT}) is overridden to yuv420p."
      fi
      log "→ Encoding video (H.264/SDR via VideoToolbox, q:v ${VIDEOTOOLBOX_ARGS[1]:-?}) → $V_BASE"
      encode_args=(
        -c:v h264_videotoolbox
        -pix_fmt yuv420p
        "${COLOR_ARGS[@]}"
        "${VIDEOTOOLBOX_ARGS[@]}"
      )
      report_add "video_codec" "h264 (hw: videotoolbox)"
      ;;

    libx265)
      # HEVC software encode (default, hdr10-hq, atv-directplay-*, animation, streaming-hevc)
      log "→ Encoding video (${PROFILE_DESC}, ${TARGET_PIXFMT}, preset ${PRESET_VALUE}, CRF ${CRF_VALUE}) → $V_BASE"
      encode_args=(
        -c:v libx265
        -preset "$PRESET_VALUE"
        -crf "$CRF_VALUE"
        -pix_fmt "$TARGET_PIXFMT"
        "${COLOR_ARGS[@]}"
        -x265-params "$X265_PARAMS"
      )
      report_add "video_codec" "hevc"
      ;;

    hevc_videotoolbox)
      # HEVC via Apple Silicon VideoToolbox.
      # Pixel format: VT accepts p010le natively for 10-bit and yuv420p for 8-bit.
      # ffmpeg converts yuv420p10le → p010le internally when needed; we set p010le
      # explicitly on 10-bit paths to match VT's native format and avoid an
      # extra swscale pass. COLOR_ARGS carries HDR10/HLG metadata; ffmpeg
      # forwards input side data (mastering display, content light level) to
      # the muxer, which writes the correct MP4 atoms / MKV elements.
      local _vt_pixfmt="$TARGET_PIXFMT"
      [[ "$_vt_pixfmt" == "yuv420p10le" ]] && _vt_pixfmt="p010le"
      log "→ Encoding video (${PROFILE_DESC} via VideoToolbox, ${_vt_pixfmt}, q:v ${VIDEOTOOLBOX_ARGS[1]:-?}) → $V_BASE"
      encode_args=(
        -c:v hevc_videotoolbox
        -pix_fmt "$_vt_pixfmt"
        "${COLOR_ARGS[@]}"
        "${VIDEOTOOLBOX_ARGS[@]}"
      )
      report_add "video_codec" "hevc (hw: videotoolbox)"
      ;;

    *)
      die 11 "Internal error: unhandled VIDEO_ENCODER_FFMPEG=\"$VIDEO_ENCODER_FFMPEG\". This is a bug in muxm's encoder dispatch."
      ;;
  esac

  if (( DRY_RUN )); then
    : > "$V_BASE" 2>/dev/null || true
    mark_done "Encode base video (dry-run)"
  else
    local -a ff_cmd=("${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:v:0)
    [[ -n "$vf_str" ]] && ff_cmd+=(-vf "$vf_str")
    if (( v_needs_raw_es )); then
      ff_cmd+=("${encode_args[@]}" ${thread_args[@]+"${thread_args[@]}"} -an -sn -dn -f hevc "$V_BASE")
    else
      ff_cmd+=("${encode_args[@]}" ${thread_args[@]+"${thread_args[@]}"} -an -sn -dn -f matroska "$V_BASE")
    fi

    local total_secs
    total_secs="$(_get_source_duration_secs)"
    log "ffmpeg encode command: ffmpeg ${ff_cmd[*]}"
    if ! _ffmpeg_run_with_ui ff_cmd "Encoding video" "$WORKDIR/encode.err" "$total_secs" "$_enc_cwd"; then
      _check_disk_full "$WORKDIR/encode.err"
      die 40 "Base video encode failed. See: $WORKDIR/encode.err"
    fi

    # Validate encoded output
    _validate_media_file "$V_BASE" "Base video encode"

    mark_done "Encode base video"
  fi

  log "→ Finalizing video stream (DV inject if available) → $V_MIXED"

  if (( DRY_RUN )); then
    : > "$V_MIXED" 2>/dev/null || true
    mark_done "Use base video (dry-run)"
    return 0
  fi

  # Default: no DV, or DV disabled, or non-HEVC codec (no DV possible) → use base
  if (( IS_DV == 0 || DISABLE_DV == 1 )) || [[ "$VIDEO_CODEC" == "libx264" ]] || _is_av1_codec "$VIDEO_CODEC"; then
    V_MIXED="$V_BASE"
    mark_done "Use base video (non-DV)"
    return 0
  fi

  # Try extracting RPU from the source.
  #
  # Primary method: pipe ffmpeg → dovi_tool via stdin.
  # This matches the dovi_tool README's recommended workflow and avoids
  # subtle issues with file-based extraction (EOS/EOB NAL handling,
  # buffer flushing differences) that cause failures on some sources
  # — particularly iPhone P8.4 HLG MOV files.
  #
  # Fallback: extract from the previously demuxed ES file on disk.

  local rpu_extracted=0

  # Primary: piped extraction (ffmpeg → dovi_tool stdin)
  if (( ! DRY_RUN )); then
    log "→ Extracting DV RPU via piped stdin…"
    (
      set +eE  # Prevent ERR trap from firing inside this subshell
      ffmpeg "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:v:0 -c copy \
           -bsf:v hevc_mp4toannexb -f hevc - 2>"$WORKDIR/rpu_pipe_demux.err" \
         | dovi_tool extract-rpu - -o "$RPU_P7" >"$WORKDIR/rpu_pipe.log" 2>&1
    ) &
    # NOTE: $! is the SUBSHELL pid, not the grandchild ffmpeg/dovi_tool pid. This is intentional and
    # harmless: on Ctrl-C the INT handler signals the whole process group, so the grandchildren die
    # with the subshell; _ACTIVE_FFMPEG_PID only needs to name a process whose death releases the
    # tee pipe, and killing the subshell does that. Not a bug — don't "fix" it to a grandchild pid.
    local rpu_pipe_pid=$!
    local _rpu_pipe_rc=0; _await_tracked_pid "$rpu_pipe_pid" "Extracting DV RPU (piped)" || _rpu_pipe_rc=$?
    if (( _rpu_pipe_rc == 0 )); then
      if [[ -s "$RPU_P7" ]]; then
        rpu_extracted=1
        log "DV RPU extracted successfully (piped method)."
      else
        warn "Piped RPU extraction produced empty file — trying file-based fallback."
      fi
    else
      warn "Piped RPU extraction failed — trying file-based fallback."
      log "See: $WORKDIR/rpu_pipe_demux.err and $WORKDIR/rpu_pipe.log"
    fi
  fi

  # Fallback: file-based extraction from a demuxed ES (produced on demand here).
  if (( ! rpu_extracted && ! DRY_RUN )); then
    log "→ Piped RPU extraction unavailable — falling back to on-demand ES demux…"
    if _ensure_src_es; then
      log "→ Extracting DV RPU from demuxed ES file (fallback)…"
      dovi_tool extract-rpu -i "$V_SRC_ES" -o "$RPU_P7" >"$WORKDIR/rpu_file.log" 2>&1 &
      local rpu_file_pid=$!
      local _rpu_file_rc=0; _await_tracked_pid "$rpu_file_pid" "Extracting DV RPU (file fallback)" || _rpu_file_rc=$?
      if (( _rpu_file_rc == 0 )); then
        if [[ -s "$RPU_P7" ]]; then
          rpu_extracted=1
          log "DV RPU extracted successfully (file-based fallback)."
        fi
      else
        warn "File-based RPU extraction also failed."
        log "See: $WORKDIR/rpu_file.log"
      fi
    else
      warn "Could not produce a demuxed ES for fallback RPU extraction."
    fi
  fi

  # RPU is now in hand (RPU_P7) — the source ES, if it was demuxed for the
  # fallback, is dead. Reclaim it immediately (it can be ~source-sized).
  (( rpu_extracted )) && _reclaim "$V_SRC_ES" "RPU extracted"

  if (( ! rpu_extracted && ! DRY_RUN )); then
    warn "All DV RPU extraction methods failed; using base video."
    if (( ALLOW_DV_FALLBACK )); then
      V_MIXED="$V_BASE"
      _dv_fallback_timestamp_wrap   # MKV needs timestamps the raw base ES lacks
      mark_done "Use base video (DV extract failed)"
      return 0
    fi
    die 40 "Dolby Vision RPU extraction failed and fallback is disabled"
  fi

  # ---- DV RPU profile analysis (conversion deferred until after injection) ----
  # Decision tree for RPU handling based on source DV profile:
  #
  # ┌─ Source is P8 (any compat_id) → RPU passes through unchanged
  # │   P8.1 (compat_id=1, PQ), P8.2 (compat_id=2, SDR), P8.4 (compat_id=4, HLG)
  # │   are all single-layer and compatible with re-encoded base layer.
  # ├─ Source is P7 (dual-layer) → inject raw RPU, then convert HEVC to P8
  # │   ├─ EL present → warn about enhancement layer data loss (irreversible)
  # │   ├─ HLG source (compat_id=4) → warn about PQ compat_id mismatch
  # │   └─ After injection: dovi_tool convert -d → P8.1 (best-effort)
  # ├─ Source is P5 (IPT) → inject raw RPU, then convert HEVC to P8.1
  # └─ Unknown profile → attempt passthrough with warning

  # Start with extracted RPU; used directly for injection in all cases
  cp -f "$RPU_P7" "$RPU_FINAL" 2>/dev/null \
    || warn "Failed to copy extracted RPU to staging path — DV injection will likely fail."

  # Flag: set to 1 when the injected HEVC needs P7/P5→P8 conversion via
  # dovi_tool convert after RPU injection.
  local -i dv_needs_convert=0

  if [[ "${DV_SRC_PROFILE:-}" == "8" ]]; then
    # Source is already Profile 8 — RPU is single-layer compatible, no conversion needed.
    # Preserves original compat_id (1=PQ, 2=SDR, 4=HLG) and all RPU metadata.
    note "Source DV is Profile 8 (compat_id=${DV_SRC_COMPAT_ID:-?}) — RPU passes through unchanged."
    report_add "dv_rpu_action" "passthrough (already P8, compat_id=${DV_SRC_COMPAT_ID:-?})"

  elif [[ "${DV_SRC_PROFILE:-}" == "7" || "${DV_SRC_PROFILE:-}" == "5" ]]; then
    # Source is dual-layer (P7) or IPT (P5) — needs conversion to single-layer P8.
    # Conversion happens AFTER RPU injection: dovi_tool convert now operates on
    # HEVC elementary streams (not standalone RPU files).
    if (( DV_CONVERT_TO_P81_IF_FAIL )); then
      note "Source DV is Profile ${DV_SRC_PROFILE} — will convert to Profile 8 after injection…"
      dv_needs_convert=1

      # F8: Profile 5 carries an IPT-PQ-c2 ("ICtCp") base layer, not a standard BT.2020 image.
      # muxm decodes and re-encodes that base layer as-is, and `dovi_tool convert -d` rewrites
      # ONLY the RPU — the base-layer pixels are never color-converted out of IPT. So a P5→P8.1
      # conversion is best-effort: on non-DV players (which ignore the RPU) the base layer may
      # render with incorrect colors. P7 is unaffected — its base layer is already BT.2020.
      if [[ "${DV_SRC_PROFILE:-}" == "5" ]]; then
        warn "Source DV is Profile 5 (IPT base layer). muxm re-encodes the base layer as-is and"
        warn "  converts only the RPU to P8.1 — the IPT base layer is NOT color-converted, so this"
        warn "  is best-effort: colors may be incorrect on non-DV players. Verify the output, or"
        warn "  keep the original if exact P5 color fidelity matters."
        report_add "dv_p5_base_best_effort" "true (P5 IPT base layer not color-converted)"
      fi

      # Warn about enhancement layer data loss for P7
      if [[ "${DV_SRC_EL_PRESENT:-}" == "1" ]]; then
        warn "DV Profile ${DV_SRC_PROFILE} has an enhancement layer (EL) that carries additional"
        warn "  highlight/shadow detail. The EL will be discarded during P7→P8 conversion."
        warn "  This is a lossy operation — DV image quality may be slightly reduced."
        report_add "dv_el_loss" "true (P${DV_SRC_PROFILE} EL discarded)"
      fi

      # Warn about HLG compat_id mismatch: dovi_tool convert produces P8.1 (PQ, compat_id=1)
      # but HLG sources use compat_id=4. Players may misinterpret the fallback layer.
      if [[ "${DV_SRC_COMPAT_ID:-}" == "4" ]]; then
        warn "Source is HLG Dolby Vision (compat_id=4) but dovi_tool convert targets P8.1 (PQ, compat_id=1)."
        warn "  The DV RPU will be converted, but the compatibility ID will change from HLG to PQ."
        warn "  Impact: Non-DV players may interpret the base layer as PQ instead of HLG."
        report_add "dv_compat_id_mismatch" "source=4(HLG) → output=1(PQ)"
      fi
    else
      warn "Source DV is Profile ${DV_SRC_PROFILE} (dual-layer) but conversion is disabled"
      warn "  (profile-8.1 conversion is disabled via --no-dv-convert-p81). Using the raw RPU — DV playback will likely fail."
      report_add "dv_rpu_action" "passthrough (P${DV_SRC_PROFILE}, conversion disabled)"
    fi

  else
    # Unknown or unrecognized DV profile — attempt passthrough
    if [[ -n "${DV_SRC_PROFILE:-}" ]]; then
      warn "Unrecognized DV profile: ${DV_SRC_PROFILE}. Attempting RPU passthrough."
      warn "  DV playback behavior is unpredictable for this profile."
    else
      warn "Could not determine source DV profile. Attempting RPU passthrough."
    fi
    report_add "dv_rpu_action" "passthrough (unknown profile ${DV_SRC_PROFILE:-?})"
  fi

  # Validate RPU integrity before injection
  if ! _validate_dv_rpu "$RPU_FINAL"; then
    warn "RPU validation failed — RPU may be corrupt or incompatible."
    if (( ALLOW_DV_FALLBACK )); then
      warn "Falling back to base video without DV."
      V_MIXED="$V_BASE"
      _dv_fallback_timestamp_wrap   # MKV needs timestamps the raw base ES lacks
      mark_done "Use base video (RPU validation failed)"
      return 0
    fi
    die 40 "DV RPU validation failed and fallback is disabled"
  fi

  # Inject RPU into encoded video.
  # When P7/P5→P8 conversion is needed, inject into an intermediate file first;
  # dovi_tool convert will then produce the final V_MIXED from that file.
  local inject_target="$V_MIXED"
  if (( dv_needs_convert )); then
    inject_target="$V_INJECTED"
  fi

  dovi_tool inject-rpu -i "$V_BASE" --rpu-in "$RPU_FINAL" -o "$inject_target" >"$WORKDIR/rpu_inject.log" 2>&1 &
  local inject_pid=$!
  local _inject_rc=0; _await_tracked_pid "$inject_pid" "Injecting DV RPU into video" || _inject_rc=$?
  if (( _inject_rc != 0 )); then
    warn "DV RPU injection failed. See: $WORKDIR/rpu_inject.log"
    if (( ALLOW_DV_FALLBACK )); then
      warn "Falling back to base video without DV."
      V_MIXED="$V_BASE"
      _dv_fallback_timestamp_wrap   # MKV needs timestamps the raw base ES lacks
      mark_done "Use base video (DV inject failed)"
      return 0
    fi
    die 41 "Dolby Vision RPU injection failed and fallback is disabled"
  fi

  # Validate DV-injected output exists and is non-empty
  if [[ ! -s "$inject_target" ]]; then
    warn "DV injection produced empty file."
    if (( ALLOW_DV_FALLBACK )); then
      warn "Falling back to base video without DV."
      V_MIXED="$V_BASE"
      _dv_fallback_timestamp_wrap   # MKV needs timestamps the raw base ES lacks
      mark_done "Use base video (DV inject empty)"
      return 0
    fi
    die 41 "DV injection produced empty output and fallback is disabled"
  fi

  # ---- Post-injection DV profile conversion (P7/P5 → P8) ----
  # dovi_tool convert now operates on HEVC elementary streams (not standalone
  # RPU files). The -d flag discards the enhancement layer, producing a valid
  # single-layer Profile 8 output from the dual-layer P7/P5 input.
  if (( dv_needs_convert )); then
    dovi_tool convert -i "$V_INJECTED" -o "$V_MIXED" -d >"$WORKDIR/rpu_convert.log" 2>&1 &
    local conv_pid=$!
    local _conv_rc=0; _await_tracked_pid "$conv_pid" "Converting DV RPU (P${DV_SRC_PROFILE} → P8.1)" || _conv_rc=$?
    if (( _conv_rc == 0 )) && [[ -s "$V_MIXED" ]]; then
      note "DV profile converted (P${DV_SRC_PROFILE} → P8.1)"
      report_add "dv_rpu_action" "converted P${DV_SRC_PROFILE} → P8.1"
      # CR-1: the muxed stream is now single-layer P8.1 — the container dvcC/dvvC
      # box must signal 8.1, NOT the stale source profile. Override the output vars.
      DV_OUT_PROFILE=8; DV_OUT_COMPAT_ID=1
      # video_injected is now superseded by the converted V_MIXED — reclaim it.
      _reclaim "$V_INJECTED" "P${DV_SRC_PROFILE}→P8 convert done"
    else
      warn "dovi_tool convert failed (P${DV_SRC_PROFILE} → P8.1). See: $WORKDIR/rpu_convert.log"
      report_add "dv_rpu_action" "convert failed — P${DV_SRC_PROFILE} RPU cannot be used for single-layer output"
      if (( ALLOW_DV_FALLBACK )); then
        warn "  Falling back to base video without Dolby Vision (DV fallback is allowed)."
        V_MIXED="$V_BASE"
        OUTPUT_HAS_DV=0
        _reclaim "$V_INJECTED" "convert failed — using base"
        _dv_fallback_timestamp_wrap   # MKV needs timestamps the raw base ES lacks
        mark_done "Use base video (DV convert failed)"
        return 0
      fi
      die 44 "dovi_tool convert failed (P${DV_SRC_PROFILE} → P8.1) and ALLOW_DV_FALLBACK=0 — refusing to ship invalid Dolby Vision"
    fi
  fi

  # Verify RPU frame count matches encoded video frame count.
  # Mismatched counts cause DV flicker, color shifts, or player crashes
  # on frames where the RPU and video desync.
  local v_frames rpu_frames
  v_frames="$(_count_video_frames "$V_MIXED")"
  # RPU frame count from dovi_tool info (if available)
  if (( _HAS_DOVI_TOOL )); then
    rpu_frames="$(dovi_tool info -i "$RPU_FINAL" --summary 2>/dev/null \
                  | grep -oiE '[0-9]+ RPU' | grep -oE '[0-9]+' | head -1)" || true
    # Fallback: try parsing "Parsed X RPU" format
    if [[ -z "$rpu_frames" ]]; then
      rpu_frames="$(dovi_tool info -i "$RPU_FINAL" --summary 2>/dev/null \
                    | grep -oiE 'parsed [0-9]+' | grep -oE '[0-9]+' | head -1)" || true
    fi
  fi

  if [[ -n "$rpu_frames" && "$rpu_frames" =~ ^[0-9]+$ && -n "$v_frames" && "$v_frames" =~ ^[0-9]+$ ]]; then
    if (( v_frames > 0 && rpu_frames > 0 )); then
      local frame_diff=$(( v_frames - rpu_frames ))
      # Allow ±2 frame tolerance (encoder may add/drop frames at boundaries)
      if (( frame_diff > 2 || frame_diff < -2 )); then
        warn "RPU frame count mismatch: video has $v_frames frames but RPU has $rpu_frames frames."
        warn "  Difference: ${frame_diff} frames. DV may flicker or desync on mismatched frames."
        warn "  This can occur when the re-encode changes frame count (e.g., framerate conversion)."
        report_add "dv_frame_count_match" "MISMATCH (video=$v_frames, rpu=$rpu_frames, diff=$frame_diff)"
        if (( ! ALLOW_DV_FALLBACK )); then
          die 44 "DV RPU/frame mismatch — refusing to ship desynced Dolby Vision (ALLOW_DV_FALLBACK=0)"
        fi
        warn "  Falling back to base video without Dolby Vision (DV fallback is allowed)."
        # The fully injected/converted DV video (the current V_MIXED, e.g.
        # video_mixed.hevc — full-size on a real title) is dead now that we're reverting
        # to the base encode. Reclaim it BEFORE aliasing V_MIXED to V_BASE, so we don't
        # carry an orphaned multi-GB intermediate to end-of-run (same _reclaim convention;
        # only this give-up branch holds a *completed* injected video — the earlier
        # branches fail during/before injection, leaving at most a partial/empty file).
        _reclaim "$V_MIXED" "DV abandoned on frame mismatch — injected video superseded by base"
        V_MIXED="$V_BASE"
        OUTPUT_HAS_DV=0
        _dv_fallback_timestamp_wrap   # MKV needs timestamps the raw base ES lacks
        mark_done "Use base video (DV frame mismatch)"
        # Give up like the three sibling fallback branches above (RPU validation,
        # inject failure, convert failure): return now so we do NOT pre-wrap the
        # base video with dvcC/dvh1 signaling and re-set OUTPUT_HAS_DV=1 below.
        return 0
      else
        note "RPU frame count verified: video=$v_frames, rpu=$rpu_frames (within tolerance)."
        report_add "dv_frame_count_match" "ok (video=$v_frames, rpu=$rpu_frames)"
      fi
    fi
  else
    note "Could not verify RPU/video frame count alignment (counting unavailable)."
    report_add "dv_frame_count_match" "unverified"
  fi

  # The base encode is no longer needed once the DV video (V_MIXED) is finalized
  # and every DV-fallback decision point (which aliases V_MIXED→V_BASE) is past.
  # The guard skips reclaim on the fallback path where V_MIXED *is* V_BASE.
  [[ "$V_MIXED" != "$V_BASE" ]] && _reclaim "$V_BASE" "DV video finalized"

  # Pre-wrap the DV-injected HEVC ES into an MP4 with proper dvcC/dvvC signaling.
  #
  # Why: When mux_final feeds a raw HEVC ES to ffmpeg, ffmpeg cannot synthesize
  # a dvcC configuration record from RPU NAL units in a raw elementary stream.
  # The raw HEVC demuxer does not parse RPU NALs (type 62) to construct DOVI
  # side data — so even with -strict unofficial -tag:v dvh1, no dvcC box is
  # written. The dvcC box must already exist in an input container for ffmpeg
  # to copy it through to the output.
  #
  # Strategy: Use mp4box (GPAC) to mux the raw ES into a video-only MP4.
  # mp4box natively parses RPU NAL units and writes the correct dvcC/dvvC box.
  # The dvp= hint tells mp4box the exact DV profile and cross-compatibility ID.
  # ffmpeg-based approaches are kept as fallbacks for environments without mp4box.
  #
  # The pre-wrap is required for TWO distinct reasons:
  #   (a) MP4/MOV output needs the dvcC/dvvC box (ffmpeg cannot synthesise it
  #       from a raw HEVC ES), and
  #   (b) MKV output fed a raw HEVC Annex B ES needs PACKET TIMESTAMPS — a raw ES
  #       has none, and the Matroska final muxer rejects timestamp-less packets
  #       with "Can't write packet with unknown timestamp", aborting the whole
  #       encode (this is why DV+MKV runs failed before this guard existed).
  # The DV RPU NALs live in-band in the HEVC bitstream, so wrapping into any
  # timestamped container preserves DV regardless of the container's own DV box.
  local _need_prewrap=0
  if [[ "$MUX_FORMAT" != "matroska" ]]; then
    _need_prewrap=1                       # (a) MP4/MOV: dvcC box required
  elif [[ "$V_MIXED" == *.hevc ]]; then
    _need_prewrap=1                       # (b) MKV + raw ES: timestamps required
  fi
  if (( _need_prewrap )); then
    local dv_prewrap="$WORKDIR/video_dv_prewrap.mp4"
    note "→ Pre-wrapping DV video into MP4 with dvcC signaling…"

    local prewrap_ok=0

    # Method 1: mp4box (GPAC) — natively understands DV RPU NALs.
    # Constructs the dvcC box from RPU data; dvp=PROFILE.COMPAT_ID ensures
    # correct signaling even if auto-detection is ambiguous.
    if (( ! prewrap_ok )) && [[ -n "${MP4BOX_CMD:-}" ]]; then
      local dvp_hint=""
      # Defense-in-depth: require BOTH values to be plain integers before feeding them into the
      # mp4box `:dvp=PROFILE.COMPAT_ID` hint. Safe in practice (DOVI-box integers can't carry : or =),
      # but a numeric guard keeps a malformed probe value from ever reaching the mp4box arg string.
      # CR-1: consume the OUTPUT profile (8.1 after a P7/P5 convert; otherwise the
      # source value) so the dvcC box never mis-signals a converted single-layer stream.
      if [[ "${DV_OUT_PROFILE:-}" =~ ^[0-9]+$ && "${DV_OUT_COMPAT_ID:-}" =~ ^[0-9]+$ ]]; then
        dvp_hint=":dvp=${DV_OUT_PROFILE}.${DV_OUT_COMPAT_ID}"
      fi

      # Force the source frame rate: raw HEVC ES carries no container timing, and
      # mp4box defaults headerless ES (e.g. from hevc_videotoolbox, which omits VUI
      # timing) to 25fps — corrupting timing on 23.976/24/30 content. Skipped only
      # when SRC_FPS is undeterminable.
      # RF9: expand with the array-safe ${fps_arg[@]+"${fps_arg[@]}"} form below — a bare
      # "${fps_arg[@]}" raises `unbound variable` under `set -u` on bash < 4.4 (the documented
      # floor is 4.3) when the array is empty. The alternate-value form yields the elements when
      # present and NOTHING when empty (no spurious empty argument, unlike "${fps_arg[@]:-}").
      local -a fps_arg=()
      [[ -n "$SRC_FPS" ]] && fps_arg=(-fps "$SRC_FPS")
      "$MP4BOX_CMD" ${fps_arg[@]+"${fps_arg[@]}"} -add "${V_MIXED}${dvp_hint}" \
           -new "$dv_prewrap" >"$WORKDIR/dv_prewrap_mp4box.log" 2>&1 &
      local pw_mp4box_pid=$!
      local _pw_mp4box_rc=0; _await_tracked_pid "$pw_mp4box_pid" "Pre-wrapping DV video (mp4box)" || _pw_mp4box_rc=$?
      if (( _pw_mp4box_rc == 0 )) && [[ -s "$dv_prewrap" ]]; then
        if _dv_probe_has_config_record "$dv_prewrap"; then  # M-DRY-a
          V_DV_MP4="$dv_prewrap"
          prewrap_ok=1
          note "✅ DV pre-wrap succeeded (mp4box) — dvcC box present."
          report_add "dv_prewrap" "success (mp4box)"
        else
          warn "mp4box muxed OK but dvcC not detected by ffprobe. See: $WORKDIR/dv_prewrap_mp4box.log"
        fi
      else
        warn "mp4box pre-wrap failed. See: $WORKDIR/dv_prewrap_mp4box.log"
      fi
    fi

    # Method 2 (ffmpeg fallback): Direct mux with -strict unofficial.
    # Some ffmpeg builds may gain raw-ES DV detection in the future.
    # NOTE: Do NOT use -bsf:v hevc_mp4toannexb here — V_MIXED is already
    # Annex B format. That BSF converts FROM MP4 length-prefixed NALUs and
    # would corrupt the stream.
    if (( ! prewrap_ok )); then
      rm -f "$dv_prewrap" 2>/dev/null || true
      # Stamp source fps as an INPUT option — ffmpeg's raw-hevc demuxer also
      # defaults headerless ES to 25fps (and can field-double to 50fps).
      local -a fps_in=()
      [[ -n "$SRC_FPS" ]] && fps_in=(-r "$SRC_FPS")
      ffmpeg "${FFMPEG_FLAGS[@]}" \
           ${fps_in[@]+"${fps_in[@]}"} \
           -i "$V_MIXED" \
           -c:v copy \
           -strict unofficial \
           -tag:v dvh1 \
           -movflags +faststart \
           -f mp4 "$dv_prewrap" >"$WORKDIR/dv_prewrap.log" 2>&1 &
      local pw_ff_pid=$!
      local _pw_ff_rc=0; _await_tracked_pid "$pw_ff_pid" "Pre-wrapping DV video (ffmpeg fallback)" || _pw_ff_rc=$?
      if (( _pw_ff_rc == 0 )) && [[ -s "$dv_prewrap" ]]; then
        if _dv_probe_has_config_record "$dv_prewrap"; then  # M-DRY-a
          V_DV_MP4="$dv_prewrap"
          prewrap_ok=1
          note "✅ DV pre-wrap succeeded (ffmpeg direct) — dvcC box present."
          report_add "dv_prewrap" "success (ffmpeg direct)"
        fi
      fi
    fi

    if (( ! prewrap_ok )); then
      if [[ "$MUX_FORMAT" != "matroska" ]]; then
        warn "DV pre-wrap could not produce dvcC box."
        [[ -n "${MP4BOX_CMD:-}" ]] || warn "  mp4box (GPAC) is not installed — this is the recommended tool for DV container signaling."
        warn "  Final mux will use raw HEVC ES — dvcC box may be missing in output."
        warn "  Impact: Players may not activate DV rendering and fall back to HDR10/HLG."
        report_add "dv_prewrap" "failed"
      else
        # MKV output does not need the dvcC box (DV is signalled natively in
        # Matroska and the RPU is in-band), but the final mux DOES need packet
        # timestamps that the raw HEVC ES lacks. Wrap the ES into a timestamped
        # MP4 and accept it regardless of dvcC detection — without this the
        # Matroska mux fails with "Can't write packet with unknown timestamp".
        warn "DV pre-wrap did not yield a dvcC box; wrapping raw ES into a timestamped MP4 for the MKV mux."
        rm -f "$dv_prewrap" 2>/dev/null || true
        # Stamp source fps as an INPUT option (raw-hevc demuxer defaults to 25/50fps).
        local -a fps_in2=()
        [[ -n "$SRC_FPS" ]] && fps_in2=(-r "$SRC_FPS")
        # CR-5/RF9: array-safe expansion — a bare "${fps_in2[@]}" raises `unbound variable`
        # under set -u on bash < 4.4 (documented floor 4.3) when SRC_FPS is empty (0-element
        # array). Matches the four sibling fps expansions; see the RF9 note above (~fps_arg).
        ffmpeg "${FFMPEG_FLAGS[@]}" \
             ${fps_in2[@]+"${fps_in2[@]}"} \
             -i "$V_MIXED" \
             -c:v copy \
             -strict unofficial \
             -tag:v dvh1 \
             -movflags +faststart \
             -f mp4 "$dv_prewrap" >"$WORKDIR/dv_prewrap.log" 2>&1 &
        local pw_ts_pid=$!
        local _pw_ts_rc=0; _await_tracked_pid "$pw_ts_pid" "Wrapping DV video for MKV mux (timestamps)" || _pw_ts_rc=$?
        if (( _pw_ts_rc == 0 )) && [[ -s "$dv_prewrap" ]]; then
          V_DV_MP4="$dv_prewrap"
          note "✅ DV video wrapped into timestamped MP4 for MKV mux (RPU preserved in-band)."
          report_add "dv_prewrap" "timestamped wrap (mkv)"
        else
          warn "Could not wrap DV video into a timestamped container — the MKV final mux may fail."
          report_add "dv_prewrap" "failed (mkv timestamp wrap)"
        fi
      fi
    fi
  fi

  # If the video was wrapped into a timestamped container (V_DV_MP4), the raw
  # V_MIXED ES is now dead — mux_final reads V_DV_MP4 instead. Reclaim it, but
  # only for Matroska output: MP4/MOV keep V_MIXED as input for the post-mux
  # dvcC container fallback (verify_dv_container_record). Guards also skip the
  # DV-fallback alias (V_MIXED==V_BASE) and the wrap-is-mixed degenerate case.
  if [[ -n "${V_DV_MP4:-}" && "$MUX_FORMAT" == "matroska" \
        && "$V_MIXED" != "$V_BASE" && "$V_MIXED" != "$V_DV_MP4" ]]; then
    _reclaim "$V_MIXED" "wrapped into V_DV_MP4 for mux"
  fi

  OUTPUT_HAS_DV=1
  mark_done "DV inject (profile-aware)"
}

# ===== Section 27: Audio selection & pipeline =================================================
# Note on variable scope: the audio-result variables below are intentionally GLOBAL — they are
# assigned without `local` in run_audio_pipeline / run_audio_pipeline_multi precisely because
# mux_final and other downstream functions consume them after the pipeline returns (a `local`
# would not survive the return). Key variables consumed downstream: A_PRIMARY_LANG, A_PRIMARY_TITLE,
# A_PRIMARY_CHANNELS, A_STEREO_LANG, A_PRIMARY, AAC_STEREO, HAS_AUDIO.
# Count audio streams in source file
# Returns: Integer count (0 if none)
# Globals: METADATA_CACHE
_audio_stream_count(){
  _jq_cache '[.streams[] | select(.codec_type=="audio")] | length' || echo 0
}

# _probe_stream_field TYPE IDX FIELD — echo FIELD of the IDX-th stream of codec_type TYPE from the
# metadata cache (single jq call). FIELD is a jq path under the stream object, so a container tag
# is reached by passing "tags.<name>". The _audio_*/_sp_sub_* field+tag accessors are one-line
# wrappers over this (L7 — they were four byte-identical bodies differing only in the type string).
# Globals: METADATA_CACHE (read)
_probe_stream_field(){
  local type="$1" idx="$2" field="$3"
  # RF12 (E4): no head -n1 — `.[$idx].$field // empty` selects ONE stream's scalar field, so jq emits
  # at most a single line already; the head was redundant.
  _jq_cache -r \
    "[.streams[] | select(.codec_type==\"$type\")] | .[$idx].$field // empty" || true
}

# Get audio field from cached metadata.  Args: $1 — audio stream index, $2 — field (e.g. codec_name).
_audio_field(){ _probe_stream_field audio "$1" "$2"; }
# Get audio tag from cached metadata.    Args: $1 — audio stream index, $2 — tag (e.g. language, title).
_audio_tag(){ _probe_stream_field audio "$1" "tags.$2"; }

# Return channel count for audio stream (0 if unavailable).
# Args: $1 — audio stream index
_audio_channels(){
  local ch
  ch="$(_audio_field "$1" channels)"
  [[ -z "$ch" ]] && ch=0
  echo "$ch"
}

# Return codec_name for audio stream (lowercased, "unknown" if unavailable).
# Args: $1 — audio stream index
_audio_codec(){
  local c
  c="$(_audio_field "$1" codec_name)"; c="${c,,}"
  [[ -z "$c" ]] && c="unknown"
  echo "$c"
}

# Map channel count to a human-readable label.
# Args: $1 — channel count, $2 — style: "long" (capitalized + Surround) or "short" (compact, default)
# Output: e.g., long: "5.1 Surround", short: "5.1"
_channel_label(){
  local ch="${1:-0}" style="${2:-short}"
  if [[ "$style" == "long" ]]; then
    case "$ch" in
      1) echo "Mono" ;;         2) echo "Stereo" ;;
      6) echo "5.1 Surround" ;; 8) echo "7.1 Surround" ;;
      *) echo "${ch}ch" ;;
    esac
  else
    case "$ch" in
      1) echo "mono" ;;   2) echo "stereo" ;;
      6) echo "5.1" ;;    8) echo "7.1" ;;
      *) echo "${ch}ch" ;;
    esac
  fi
}

# Build a human-readable audio stream title from codec and channel count.
# Args: $1 — codec name, $2 — channel count
# Output: e.g., "5.1 Surround (E-AC-3)" or "Stereo (AAC)"
_audio_descriptive_title() {
  local codec="$1" ch="${2:-0}"

  local ch_label
  ch_label="$(_channel_label "$ch" long)"

  local codec_display codec_lc="${codec,,}"
  case "$codec_lc" in
    eac3)      codec_display="E-AC-3" ;;
    ac3)       codec_display="AC-3" ;;
    aac)       codec_display="AAC" ;;
    truehd)    codec_display="TrueHD" ;;
    dts|dca)   codec_display="DTS" ;;
    flac)      codec_display="FLAC" ;;
    alac)      codec_display="ALAC" ;;
    opus)      codec_display="Opus" ;;
    pcm_*)     codec_display="PCM" ;;
    *)         codec_display="$codec_lc" ;;
  esac

  echo "${ch_label} (${codec_display})"
}

# Return ordinal position of codec in AUDIO_CODEC_PREFERENCE list (0 = best).
# Returns 10 for unlisted codecs — low preference but not a hard penalty.
# This avoids crushing valid but uncommon codecs (e.g., Opus, FLAC) with
# the ~97-point cliff that rank 99 would create.
# Cache: rebuilds associative array only when AUDIO_CODEC_PREFERENCE changes.
# Args: $1 — codec name (lowercased)
# Globals: AUDIO_CODEC_PREFERENCE (read), _AUDIO_CODEC_RANK_CACHE/_AUDIO_CODEC_RANK_PREF (r/w)
_audio_codec_rank(){
  # Cache is per-subshell — each $(...) invocation starts fresh (L1).
  declare -gA _AUDIO_CODEC_RANK_CACHE 2>/dev/null || true
  local codec="$1"
  if [[ "$AUDIO_CODEC_PREFERENCE" != "$_AUDIO_CODEC_RANK_PREF" ]]; then
    _AUDIO_CODEC_RANK_CACHE=()
    local item i=0
    local -a _arr
    IFS=',' read -r -a _arr <<<"$AUDIO_CODEC_PREFERENCE"
    for item in "${_arr[@]}"; do
      item="${item,,}"; item="${item// /}"
      [[ -z "$item" ]] && continue
      _AUDIO_CODEC_RANK_CACHE["$item"]=$i
      (( ++i ))
    done
    _AUDIO_CODEC_RANK_PREF="$AUDIO_CODEC_PREFERENCE"
  fi
  echo "${_AUDIO_CODEC_RANK_CACHE[$codec]:-10}"
}

# Check if a language tag matches any entry in AUDIO_LANG_PREF.
# Both the stream tag and each pref entry are run through _norm_lang_code, so 2-letter
# and 3-letter codes (and 639-2/B vs /T variants) match symmetrically: `en`↔`eng`,
# `ja`↔`jpn`, `fre`↔`fra` (H2). Returns 0 (true) if the tag matches, 1 otherwise.
# Args: $1 — language tag (e.g., "en", "eng", "spa", "und")
# Globals: AUDIO_LANG_PREF (read)
_audio_lang_matches(){
  local lang pref
  local -a prefs   # Phase 5: declare local (sibling _sub_lang_matches does) — don't leak to global scope
  # CR-6: empty AUDIO_LANG_PREF (the documented keep-all `--audio-lang-pref ""`) yields a
  # 0-element prefs array; `for pref in "${prefs[@]}"` aborts under set -u on bash < 4.4.
  # Guard at entry (empty pref matches nothing — callers treat empty as keep-all upstream),
  # mirroring the `-n` gating the other call sites already apply and the _sub_lang_matches note.
  [[ -n "$AUDIO_LANG_PREF" ]] || return 1
  lang="$(_norm_lang_code "$1")"
  IFS=',' read -r -a prefs <<< "$AUDIO_LANG_PREF"
  for pref in "${prefs[@]}"; do
    pref="${pref// /}"
    [[ -z "$pref" ]] && continue
    [[ "$lang" == "$(_norm_lang_code "$pref")" ]] && return 0
  done
  return 1
}

# Subtitle analogue of _audio_lang_matches: does a subtitle language tag match any
# entry in SUB_LANG_PREF, normalizing BOTH sides via _norm_lang_code (H2)? This closes
# the embedded-vs-external asymmetry — an embedded `en` sub now survives an `eng` filter,
# matching how external `movie.en.srt` (parsed to `eng`) is already treated.
# An empty/whitespace-only SUB_LANG_PREF matches nothing here; callers gate on
# `-n SUB_LANG_PREF` first (empty = keep-all), preserving the existing semantics.
# Args: $1 — language tag. Globals: SUB_LANG_PREF (read).
_sub_lang_matches(){
  local lang pref
  local -a prefs
  # CR-6 (symmetry/defense-in-depth): same empty-array footgun as _audio_lang_matches.
  [[ -n "$SUB_LANG_PREF" ]] || return 1
  lang="$(_norm_lang_code "$1")"
  IFS=',' read -r -a prefs <<< "$SUB_LANG_PREF"
  for pref in "${prefs[@]}"; do
    pref="${pref// /}"
    [[ -z "$pref" ]] && continue
    [[ "$lang" == "$(_norm_lang_code "$pref")" ]] && return 0
  done
  return 1
}

# Check if an audio stream's title tag suggests commentary or descriptive audio.
# Matches common English and international keywords in the title.
# Returns 0 (true) if commentary/descriptive, 1 otherwise.
# Args: $1 — title string (will be lowercased internally)
_audio_is_commentary(){
  local title="${1,,}"
  [[ -z "$title" ]] && return 1
  # shellcheck disable=SC2254
  [[ "$title" =~ (commentary|comentario|kommentar|descriptive|audio.description|visually.impaired) ]] && return 0
  return 1
}

# _audio_stream_info — Fetch all scoring-relevant fields for one audio stream
# in a single jq call (replaces separate jq forks per stream).
# Returns: codec\tchannels\tlanguage\tbit_rate\ttitle\tdisposition.comment\t
#          disposition.visual_impaired\tdisposition.hearing_impaired  (tab-delimited)
# RF3: the three trailing disposition flags (0/1) let _score_audio_stream demote a
# flagged-but-untitled commentary/description track and let the stereo paths drop one
# without separate disposition jq probes. They are APPENDED after title (which has the full
# control range stripped, so it is one field) — every _split_tab consumer of this record reads
# the extra fields (real vars or `_` sinks) so the flags never fold into `title`.
# RF8 (security): title AND language are sanitized at extraction — the full C0 control range plus
# DEL (jq gsub on U+0000..U+001F and U+007F) is replaced with a space, so a hostile track title
# can't inject terminal escape sequences into output or the persistent log. (This subsumes the
# earlier \t\n\r-only strip on title.)
# Args: $1 — audio stream index (0-based, relative to audio streams)
# Globals: METADATA_CACHE (read)
_audio_stream_info(){
  local idx="$1"
  _jq_cache -r "[.streams[] | select(.codec_type==\"audio\")] | .[$idx] |
    \"\(.codec_name // \"unknown\")\t\(.channels // 0)\t\(.tags.language // \"\" | gsub(\"[\\u0000-\\u001f\\u007f]\";\" \"))\t\(.bit_rate // \"0\")\t\(.tags.title // \"\" | gsub(\"[\\u0000-\\u001f\\u007f]\";\" \"))\t\(.disposition.comment // 0)\t\(.disposition.visual_impaired // 0)\t\(.disposition.hearing_impaired // 0)\"" | head -n1 || printf 'unknown\t0\t\t0\t\t0\t0\t0\n'
}

# Audio stream scoring algorithm for automatic track selection.
#
# Factors (highest weight first):
#   1. Language preference   — +AUDIO_SCORE_LANG_BONUS (150) if language matches AUDIO_LANG_PREF
#      Ensures preferred language wins over higher-channel foreign tracks.
#   2. Channel count         — ch × AUDIO_SCORE_CHANNEL_MULTIPLIER (20)
#      More channels = higher fidelity; 7.1 scores higher than 5.1.
#   3. Surround bonus        — +AUDIO_SCORE_SURROUND_BONUS (30) if ≥ 6ch
#      Discrete jump to prefer surround over stereo.
#   4. Codec preference      — (10 − rank) × 10 from AUDIO_CODEC_PREFERENCE list
#      10 points per rank position. Ensures codec ordering dominates bitrate.
#      eac3 > ac3 > aac > alac > other by default.
#   5. Bitrate (tie-break)   — br / 50000  (capped at 8)
#      Small bonus for higher-bitrate tracks when all else is equal.
#      Lossless codecs with unreported bitrate get a synthetic floor so they
#      are not penalised for VBR / missing bit_rate metadata.
#   6. Commentary penalty    — −AUDIO_SCORE_COMMENTARY_PENALTY (200) if title matches
#      Demotes commentary/descriptive tracks so the main feature wins.
#
# Returns: score|idx|codec|channels|lang|title
_score_audio_stream(){
  local idx="$1"

  # Single jq call fetches all fields at once
  local info codec lang ch br title rank score comment vi hi
  info="$(_audio_stream_info "$idx")"
  # RF3: also read the three disposition flags (comment / visual_impaired / hearing_impaired).
  _split_tab "$info" codec ch lang br title comment vi hi  # C2: non-collapsing — preserve empty lang/title

  _normalize_codec_lang codec lang
  [[ -z "$ch" || ! "$ch" =~ ^[0-9]+$ ]] && ch=0
  [[ -z "$br" || ! "$br" =~ ^[0-9]+$ ]] && br=0

  rank="$(_audio_codec_rank "$codec")"

  score=0
  # Language bonus for preferred language(s) — strongest signal
  if _audio_lang_matches "$lang"; then
    score=$(( score + AUDIO_SCORE_LANG_BONUS ))
  fi
  # Channel count
  score=$(( score + ch * AUDIO_SCORE_CHANNEL_MULTIPLIER ))
  # Surround bonus (>=6ch)
  (( ch >= 6 )) && score=$(( score + AUDIO_SCORE_SURROUND_BONUS ))
  # Codec preference: better rank -> higher score
  # 10 points per rank position ensures codec ordering dominates the bitrate
  # tie-breaker (max ~8 pts) while staying below language/channel signals.
  local inv=$(( (10 - rank) * 10 ))
  (( inv < 0 )) && inv=0
  score=$(( score + inv ))

  # Save raw bitrate before synthetic lossless floor (L2b: passed through to caller).
  local raw_br="$br"

  # Lossless codecs (TrueHD, DTS-HD MA, FLAC, etc.) often report bit_rate=0
  # because they are VBR. Give them a synthetic floor so they are not penalised
  # relative to lossy codecs that do report bitrate.
  if (( br == 0 )) && audio_is_lossless "$codec"; then
    br=1536000   # ~1.5 Mbps — conservative TrueHD 5.1 average
  fi

  # Bitrate small tie-breaker (scaled, capped so it cannot overpower codec rank)
  if (( br > 0 )); then
    local br_bonus=$(( br / 50000 ))
    (( br_bonus > 8 )) && br_bonus=8
    score=$(( score + br_bonus ))
  fi

  # Commentary/descriptive track penalty — RF3: demote on the DISPOSITION flags
  # (comment / visual_impaired / hearing_impaired), not just a title keyword. A track
  # flagged disposition.comment with an empty/non-English title would otherwise escape
  # the penalty and, under the default codec preference (lossless mains rank last), could
  # outscore the main feature and be stream-copied as the primary audio.
  if _audio_is_commentary "$title" || (( comment )) || (( vi )) || (( hi )); then
    score=$(( score - AUDIO_SCORE_COMMENTARY_PENALTY ))
  fi

  # Format: score\tidx\tcodec\tch\tlang\ttitle\traw_br (L2b: raw_br enables caller to
  # destructure the full winning record without additional jq forks).
  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$score" "$idx" "$codec" "$ch" "$lang" "${title:-}" "$raw_br"
}

# select_best_audio — Pick the best audio track using the scoring algorithm.
#
# Respects AUDIO_TRACK_OVERRIDE if set (with bounds validation).
# Otherwise, scores all audio streams via _score_audio_stream and returns
# the full winning record so the caller can destructure without extra jq forks (L2b).
#
# Returns: "idx\tcodec\tch\tlang\ttitle\traw_br" on stdout ("" if no audio streams exist).
# Globals: AUDIO_TRACK_OVERRIDE (read), METADATA_CACHE (read)
select_best_audio(){
  local n i best_line best_score=-999999
  n="$(_audio_stream_count)"
  (( n > 0 )) || { echo ""; return 0; }

  # Handle user override with validation
  if [[ -n "${AUDIO_TRACK_OVERRIDE:-}" ]]; then
    if [[ "$AUDIO_TRACK_OVERRIDE" =~ ^[0-9]+$ ]] && (( AUDIO_TRACK_OVERRIDE >= 0 && AUDIO_TRACK_OVERRIDE < n )); then
      # Fetch full record for the overridden track so caller can destructure (L2b).
      local _ov_info _ov_codec _ov_ch _ov_lang _ov_br _ov_title
      _ov_info="$(_audio_stream_info "$AUDIO_TRACK_OVERRIDE")"
      _split_tab "$_ov_info" _ov_codec _ov_ch _ov_lang _ov_br _ov_title _ _ _  # C2: non-collapsing (RF3: sink trailing disposition fields)
      _normalize_codec_lang _ov_codec _ov_lang
      [[ -z "$_ov_ch"  || ! "$_ov_ch"  =~ ^[0-9]+$ ]] && _ov_ch=0
      [[ -z "$_ov_br"  || ! "$_ov_br"  =~ ^[0-9]+$ ]] && _ov_br=0
      printf "%s\t%s\t%s\t%s\t%s\t%s\n" \
        "$AUDIO_TRACK_OVERRIDE" "$_ov_codec" "$_ov_ch" "$_ov_lang" "${_ov_title:-}" "$_ov_br"
      return 0
    fi
    warn "Requested --audio-track $AUDIO_TRACK_OVERRIDE is invalid (must be 0-$((n-1))). Using auto-selection."
  fi

  # When AUDIO_PREFER_STEREO is set, prefer a native exactly-2ch track ranked by the
  # existing scorer. Falls through to the score-all pass if no qualifying track found.
  if (( AUDIO_PREFER_STEREO )); then
    local ps_best_line="" ps_best_score=-999999
    for (( i=0; i<n; i++ )); do
      # RF3: read channels/title/disposition from the single _audio_stream_info record
      # (collapses the two separate disposition jq probes this loop used to fork per stream).
      local ps_info ps_ch ps_lang ps_title ps_comment ps_vi ps_hi ps_line ps_score
      ps_info="$(_audio_stream_info "$i")"
      _split_tab "$ps_info" _ ps_ch ps_lang _ ps_title ps_comment ps_vi ps_hi  # C2: non-collapsing (codec/br unused here)
      [[ -z "$ps_ch" || ! "$ps_ch" =~ ^[0-9]+$ ]] && ps_ch=0
      (( ps_ch != 2 )) && continue
      _audio_is_commentary "$ps_title" && continue
      (( ps_comment )) && continue
      (( ps_vi )) && continue
      (( ps_hi )) && continue
      # RF4: honor AUDIO_LANG_PREF — skip a wrong-language stereo so an English-preferring
      # encode of an English-5.1 + foreign-2.0 source does not pick the foreign stereo. Only
      # gates when a preference is set; an empty AUDIO_LANG_PREF keeps the old language-agnostic
      # behavior. When no preferred-language stereo exists, the loop finds nothing and falls
      # through to the score-all / downmix path (mirroring the native-stereo fallback's gate).
      # Lowercase + und-default mirrors _normalize_codec_lang's lang handling (used by the
      # sibling _build_audio_keep_list before its own _audio_lang_matches gate).
      if [[ -n "${AUDIO_LANG_PREF:-}" ]]; then
        local ps_match_lang="${ps_lang,,}"
        [[ -z "$ps_match_lang" ]] && ps_match_lang="$TAG_LANGUAGE_DEFAULT"
        _audio_lang_matches "$ps_match_lang" || continue
      fi
      ps_line="$(_score_audio_stream "$i")"
      ps_score="${ps_line%%$'\t'*}"
      if [[ "$ps_score" =~ ^-?[0-9]+$ ]] && (( ps_score > ps_best_score )); then
        ps_best_score="$ps_score"
        ps_best_line="$ps_line"
      fi
    done
    if [[ -n "$ps_best_line" ]]; then
      local ps_idx
      ps_idx="${ps_best_line#*$'\t'}"; ps_idx="${ps_idx%%$'\t'*}"
      note "[Audio] Prefer-stereo: native stereo track found at stream #${ps_idx} — selecting it over the scored best."
      # Output full record (score prefix stripped): idx\tcodec\tch\tlang\ttitle\traw_br (L2b).
      printf '%s\n' "${ps_best_line#*$'\t'}"
      return 0
    fi
    note "[Audio] Prefer-stereo: no suitable native stereo track found — selecting the best track by score instead."
  fi

  # Score all tracks, select best, and collect summary in one pass
  local -a score_lines=()
  local s_score s_idx s_codec s_ch s_lang
  for (( i=0; i<n; i++ )); do
    local line score
    line="$(_score_audio_stream "$i")"
    score_lines+=("$line")
    score="${line%%$'\t'*}"
    if [[ "$score" =~ ^-?[0-9]+$ ]] && (( score > best_score )); then
      best_score="$score"
      best_line="$line"
    fi
  done

  # Log score breakdown when multiple tracks exist (aids debugging)
  if (( n >= 2 )); then
    local best_idx score_summary=""
    best_idx="${best_line#*$'\t'}"; best_idx="${best_idx%%$'\t'*}"
    for (( i=0; i<n; i++ )); do
      local marker=""
      # The record's trailing title/raw_br fields are irrelevant to this score-summary line, but
      # _split_tab must still consume all 7 fields (else s_lang would absorb the remainder) — sink
      # them into `_`. (C2: non-collapsing split.)
      _split_tab "${score_lines[$i]}" s_score s_idx s_codec s_ch s_lang _ _
      [[ "$s_idx" == "$best_idx" ]] && marker=" ★"
      score_summary+="#${s_idx}: ${s_codec} ${s_ch}ch [${s_lang}] = ${s_score}${marker}  "
    done
    log "• Score: ${score_summary% }"
  fi

  # Guard: if scoring produced no winner (all tracks failed), default to track 0 (M5).
  if [[ -z "$best_line" ]]; then
    warn "Audio scoring failed for all tracks; defaulting to track 0."
    local _g_info _g_codec _g_ch _g_lang _g_br _g_title
    _g_info="$(_audio_stream_info "0")"
    _split_tab "$_g_info" _g_codec _g_ch _g_lang _g_br _g_title _ _ _  # C2: non-collapsing (RF3: sink trailing disposition fields)
    _normalize_codec_lang _g_codec _g_lang
    [[ -z "$_g_ch" || ! "$_g_ch" =~ ^[0-9]+$ ]] && _g_ch=0
    [[ -z "$_g_br" || ! "$_g_br" =~ ^[0-9]+$ ]] && _g_br=0
    printf "%s\t%s\t%s\t%s\t%s\t%s\n" "0" "$_g_codec" "$_g_ch" "$_g_lang" "${_g_title:-}" "$_g_br"
    return 0
  fi

  # Output full record (score prefix stripped): idx\tcodec\tch\tlang\ttitle\traw_br (L2b).
  printf '%s\n' "${best_line#*$'\t'}"
}

# _split_tab RECORD VAR1 [VAR2 …] — split RECORD on LITERAL tabs into the named variables,
# PRESERVING empty middle fields (C2). A plain `IFS=$'\t' read` collapses empty/leading fields
# because tab is IFS-whitespace, so an untagged-language or untitled audio track (empty MIDDLE
# field in codec⇥ch⇥lang⇥br⇥title) shifted its bitrate into the next variable and silently wrote
# garbage like `language=640000` into the output metadata. Manual %%/#-parameter-expansion splits
# on each literal tab and never collapses. Semantics match `read` for the field/variable mismatch
# cases: the LAST variable absorbs the entire remainder (any internal tabs included); with more
# variables than fields the trailing ones are set empty. Free-text fields have \t\n\r stripped by
# their producers, so the split is unambiguous. Assignment is by name via `printf -v` (bash dynamic
# scope reaches the caller's locals); the locals are `_st_`-prefixed so they cannot collide with a
# caller's field-variable names.
_split_tab(){
  local _st_rec="$1"; shift
  while (( $# > 1 )); do
    if [[ "$_st_rec" == *$'\t'* ]]; then
      printf -v "$1" '%s' "${_st_rec%%$'\t'*}"
      _st_rec="${_st_rec#*$'\t'}"
    else
      printf -v "$1" '%s' "$_st_rec"
      _st_rec=""
    fi
    shift
  done
  printf -v "$1" '%s' "$_st_rec"
}

# _parse_audio_record — split a select_best_audio record (idx\tcodec\tch\tlang\ttitle\traw_br) into
# six globals, PRESERVING empty fields. Thin wrapper over _split_tab (C2): a plain `IFS=$'\t' read`
# collapses an empty MIDDLE field (tab is IFS-whitespace), so an untitled track shifted its bitrate
# into `title` and left the bitrate empty. _split_tab never collapses, so an empty title stays
# empty and raw_br lands in _AREC_BR.
# Sets: _AREC_IDX _AREC_CODEC _AREC_CH _AREC_LANG _AREC_TITLE _AREC_BR
_parse_audio_record(){
  _split_tab "$1" _AREC_IDX _AREC_CODEC _AREC_CH _AREC_LANG _AREC_TITLE _AREC_BR
}

# Check whether a TARGET DEVICE can Direct Play this audio codec — independent of MUX_FORMAT.
# This answers the device-capability question ("will Apple TV / Plex Direct Play stream-copy this
# track untouched?"), NOT the container question ("can this container physically hold the codec?").
# The two were conflated (F1): aliasing _sii_audio_is_container_safe() made EVERY codec "copyable"
# on a matroska target, so atv-directplay-* / streaming-* (MKV) would stream-copy TrueHD/DTS-HD MA
# the device cannot Direct Play, instead of transcoding to E-AC-3 as documented. The whitelist
# below is the real device set; container fitness stays in _sii_audio_is_container_safe() /
# audio_lossless_muxable() (used by the lossless-passthrough and native-stereo copy paths).
# SYNC: Codecs listed here can reach do_copy=1 via Step 3 of run_audio_pipeline. Each MUST have a
#   valid ffmpeg muxer extension in _audio_copy_ext() (aac/ac3/eac3 pass through; alac→m4a).
#   See also: audio_is_lossless() (lossless-passthrough path), _sii_audio_is_container_safe().
audio_is_direct_play_copyable(){
  case "$1" in aac|ac3|eac3|alac) return 0 ;; *) return 1 ;; esac
}

# Check if audio codec is lossless (for AUDIO_LOSSLESS_PASSTHROUGH)
# SYNC: Codecs listed here can reach do_copy=1 via the lossless passthrough
#   path in run_audio_pipeline.  Any codec added here MUST have a valid ffmpeg
#   muxer extension — if not, add a mapping in _audio_copy_ext().
#   See also: audio_is_direct_play_copyable(), audio_lossless_muxable().
audio_is_lossless(){
  local codec="$1"
  case "$codec" in
    truehd|dts|dca|flac|alac|pcm_s16le|pcm_s24le|pcm_s32le) return 0 ;;
    *) return 1 ;;
  esac
}

# Check if lossless codec can be muxed into the target container
audio_lossless_muxable(){
  _sii_audio_is_container_safe "$1"
}

# Check if an audio codec can be muxed into the current target container.
# Used by the skip-if-ideal remux to gate streams that would fail the mux.
# Conservative: rejects known-incompatible codecs, allows everything else
# (ffmpeg will catch any edge cases during remux as a safe failure mode).
# Args: $1 — codec name (lowercase)
# Globals: MUX_FORMAT (read)
_sii_audio_is_container_safe() {
  local codec="$1"
  [[ "$MUX_FORMAT" == "matroska" ]] && return 0
  # MP4/MOV/M4V: whitelist — only these codecs are safe to mux (M2)
  case "$MUX_FORMAT" in
    mp4|mov|m4v)
      case "$codec" in
        aac|ac3|eac3|alac) return 0 ;;
        *) return 1 ;;
      esac
      ;;
  esac
  return 1
}

# Map ffprobe codec name to a file extension ffmpeg can mux when stream-copying.
# ffmpeg auto-detects the muxer from the output filename extension. Some codecs
# (notably TrueHD and ALAC) use an ffprobe name that doesn't match any registered
# muxer extension, causing "Unable to choose an output format" errors during copy.
# This function returns a safe extension for the intermediate copy file.
# SYNC: Every codec that can reach do_copy=1 in run_audio_pipeline must produce
#   a valid extension here.  When adding codecs to audio_is_lossless() or
#   audio_is_direct_play_copyable(), verify the ffprobe name has a matching
#   ffmpeg muxer — if not, add an explicit mapping below.
# Args: $1 — codec name (lowercased, from ffprobe)
# Stdout: file extension (without dot) suitable for ffmpeg -c copy output
_audio_copy_ext(){
  local codec="$1"
  case "$codec" in
    truehd)                       echo "thd" ;;   # ffmpeg truehd muxer recognizes .thd
    alac)                         echo "m4a" ;;   # ffmpeg has no .alac muxer; .m4a (ipod) works
    pcm_s16le|pcm_s24le|pcm_s32le) echo "wav" ;;  # raw PCM needs a container
    dca)                          echo "dts" ;;    # ffprobe reports dca, muxer expects .dts
    *)                            echo "$codec" ;; # aac, ac3, eac3, flac, dts, etc. work as-is
  esac
}

# Map ffmpeg encoder name to file extension
_audio_codec_ext() {
  case "$1" in
    libopus)            echo "opus" ;;
    libmp3lame)         echo "mp3" ;;
    libvorbis)          echo "ogg" ;;
    aac)                echo "aac" ;;
    # L4: the AAC encoder variants (libfdk_aac, AudioToolbox aac_at) produce raw AAC that has no
    # bare-`.libfdk_aac`/`.aac_at` muxer — wrap in .m4a (mirrors _audio_copy_ext's alac→m4a). Without
    # this, a --audio-force-codec libfdk_aac/aac_at transcode named the intermediate after the raw
    # encoder, ffmpeg could not choose a muxer, and the run die 43'd late (the crash this map prevents).
    libfdk_aac|aac_at)  echo "m4a" ;;
    ac3)                echo "ac3" ;;
    eac3)               echo "eac3" ;;
    flac)               echo "flac" ;;
    *)                  echo "$1" ;;  # fallback: use codec name as-is
  esac
}

# Normalize an ffmpeg ENCODER name to the ffprobe CODEC name it produces, so
# "source already matches target" comparisons (source codec from ffprobe vs the target
# encoder) and the descriptive title work for encoders whose name differs from the codec.
# e.g. an Opus source (ffprobe: "opus") vs AUDIO_FORCE_CODEC=libopus must be seen as a
# match (→ stream-copy, not a pointless re-encode). Unknown/already-codec names pass through.
_encoder_to_codec() {
  case "$1" in
    libopus)                 echo "opus" ;;
    libfdk_aac|aac_at)       echo "aac" ;;
    libmp3lame)              echo "mp3" ;;
    libvorbis)               echo "vorbis" ;;
    *)                       echo "$1" ;;  # aac/ac3/eac3/flac/alac/dts/truehd already match
  esac
}

# Determine target codec and bitrate for audio transcode based on channel count.
# Outputs: "codec bitrate" (space-separated, suitable for `read`)
# Channel thresholds are centralized here to avoid divergence.
# NOTE: This function selects codec based on *source* channel count, not encoder
#   limits.  Callers must apply _codec_max_channels() to clamp effective_ch before
#   passing it to ffmpeg — e.g. eac3 supports at most 6ch despite being selected
#   for 8ch sources.
# Args: $1 — channel count
audio_transcode_target(){
  local ch="$1"
  if (( ch >= 8 )); then
    echo "eac3 $EAC3_BITRATE_7_1"
  elif (( ch >= 6 )); then
    echo "eac3 $EAC3_BITRATE_5_1"
  else
    # D7: the ≤2ch (stereo/mono) aac transcode honors --stereo-bitrate (STEREO_BITRATE),
    # not a hard-coded 192k. Default STEREO_BITRATE is "192k", so the default is unchanged.
    echo "aac ${STEREO_BITRATE:-192k}"
  fi
}

# Return the maximum channel count supported by ffmpeg's native encoder for a
# given codec.  Used by run_audio_pipeline to clamp effective_ch *after*
# audio_transcode_target selects the codec — prevents fatal ffmpeg errors like
# "Specified channel layout '7.1' is not supported" from the eac3 encoder.
# Args: $1 — codec name (lowercased)
_codec_max_channels(){
  local codec="$1"
  case "$codec" in
    eac3) echo 6 ;;   # ffmpeg native eac3 encoder: 5.1 max
    ac3)  echo 6 ;;   # ffmpeg native ac3 encoder: 5.1 max
    aac)  echo 48 ;;  # ffmpeg native aac: effectively unlimited
    *)    echo 64 ;;  # conservative fallback — no known encoder needs >64
  esac
}

# _build_audio_keep_list — Subtractive filter for multi-track audio mode.
#
# Enumerates all audio streams and applies keep-filters:
#   1. AUDIO_LANG_PREF (if non-empty) — only keep tracks whose language matches
#   2. AUDIO_KEEP_COMMENTARY — drop commentary/descriptive tracks when 0
#
# Unlike select_best_audio (which scores and picks ONE), this keeps ALL tracks
# that pass the filters. No scoring, no ranking — just pass/fail.
#
# Output: space-separated list of 0-based audio-relative indices on stdout.
#         Empty string if no tracks survive the filter.
# Globals: AUDIO_LANG_PREF (read), AUDIO_KEEP_COMMENTARY (read),
#          METADATA_CACHE (read), TAG_LANGUAGE_DEFAULT (read)
_build_audio_keep_list(){
  local n i
  n="$(_audio_stream_count)"
  (( n > 0 )) || { echo ""; return 0; }

  local -a kept=()
  local -a dropped_reasons=()

  for (( i=0; i<n; i++ )); do
    local info codec lang ch br title comment vi hi
    info="$(_audio_stream_info "$i")"
    # CR-3: capture the three trailing disposition flags (comment / visual_impaired /
    # hearing_impaired) instead of sinking them — the commentary filter below ORs them in,
    # mirroring _score_audio_stream so a disposition-flagged but untitled/foreign-titled
    # commentary/AD track is dropped, not just one matched by the title keyword regex.
    _split_tab "$info" codec ch lang br title comment vi hi  # C2: non-collapsing — preserve empty lang/title
    _normalize_codec_lang codec lang

    # Filter 1: language
    if [[ -n "${AUDIO_LANG_PREF:-}" ]]; then
      if ! _audio_lang_matches "$lang"; then
        dropped_reasons+=("#$i: ${codec} ${ch}ch [$lang] — language not in AUDIO_LANG_PREF")
        continue
      fi
    fi

    # Filter 2: commentary — RF3/CR-3: drop on the DISPOSITION flags too, not just a title keyword.
    if (( ! AUDIO_KEEP_COMMENTARY )) && { _audio_is_commentary "$title" || (( comment )) || (( vi )) || (( hi )); }; then
      dropped_reasons+=("#$i: ${codec} ${ch}ch [$lang] — commentary/descriptive")
      continue
    fi

    kept+=("$i")
  done

  _log_dropped_tracks "multi-track" dropped_reasons

  echo "${kept[*]}"
}

# run_audio_pipeline_multi — Multi-track audio: filter and defer to mux_final.
#
# Called instead of the single-track pipeline when AUDIO_MULTI_TRACK=1.
# No ffmpeg calls, no intermediate files. Populates metadata arrays that
# mux_final uses to map audio streams directly from source with -c:a copy.
#
# Sets: AUDIO_COPY_FROM_SOURCE, AUDIO_MT_INDICES, AUDIO_MT_CODECS,
#       AUDIO_MT_CHANNELS, AUDIO_MT_LANGS, AUDIO_MT_TITLES,
#       HAS_AUDIO, A_PRIMARY (cleared), AAC_STEREO (cleared)
# Globals: AUDIO_MULTI_TRACK (read), METADATA_CACHE (read)
run_audio_pipeline_multi(){
  local keep_list
  keep_list="$(_build_audio_keep_list)"

  if [[ -z "$keep_list" ]]; then
    local _n_audio; _n_audio="$(_audio_stream_count)"
    if (( _n_audio > 0 )); then
      # H3: the language/commentary filter dropped EVERY audio track, but the source HAS
      # audio. Never silently ship a video-only file — fall back to the best-scored track and
      # warn loudly (mirrors select_best_audio's single-track "default to track 0" guard).
      local _fallback_idx
      _fallback_idx="$(select_best_audio | cut -f1)"
      [[ "$_fallback_idx" =~ ^[0-9]+$ ]] || _fallback_idx=0
      warn "[Audio] No audio track matched the language/commentary filter (AUDIO_LANG_PREF='${AUDIO_LANG_PREF:-}'); keeping the best-scored track #${_fallback_idx} so the output is not left without audio."
      report_add "audio_keep_fallback" "no filter match; kept best track #${_fallback_idx}"
      keep_list="$_fallback_idx"
    else
      note "[Audio] Multi-track filter: no audio tracks survived filtering."
      HAS_AUDIO=0
      return 0
    fi
  fi

  # Reset single-track vars (not used in multi-track mode)
  A_PRIMARY=""
  AAC_STEREO=""

  # Populate parallel metadata arrays
  AUDIO_MT_INDICES=()
  AUDIO_MT_CODECS=()
  AUDIO_MT_CHANNELS=()
  AUDIO_MT_LANGS=()
  AUDIO_MT_TITLES=()

  local idx
  for idx in $keep_list; do
    local info codec ch lang br title
    info="$(_audio_stream_info "$idx")"
    _split_tab "$info" codec ch lang br title _ _ _  # C2: non-collapsing — untagged lang/title into MT output metadata (RF3: sink disposition fields)
    _normalize_codec_lang codec lang

    AUDIO_MT_INDICES+=("$idx")
    AUDIO_MT_CODECS+=("$codec")
    AUDIO_MT_CHANNELS+=("$ch")
    AUDIO_MT_LANGS+=("$lang")
    AUDIO_MT_TITLES+=("${title:-}")
  done

  AUDIO_COPY_FROM_SOURCE=1
  HAS_AUDIO=1

  # Log summary
  local n_total n_kept n_dropped
  n_total="$(_audio_stream_count)"
  n_kept="${#AUDIO_MT_INDICES[@]}"
  n_dropped=$(( n_total - n_kept ))

  # SYNC: only the per-stream `pretty=` line construction must stay in sync with the display loop in
  # run_audio_pipeline (the surrounding filter/keep logic differs by design). (RF12: narrowed.)
  say "→ Scanning audio streams (multi-track mode):"
  local i
  for (( i=0; i<n_total; i++ )); do
    local _ainfo _c _ch_i _l _br_i _t pretty marker=""
    _ainfo="$(_audio_stream_info "$i")"
    _split_tab "$_ainfo" _c _ch_i _l _br_i _t _ _ _  # C2: non-collapsing (RF3: sink trailing disposition fields)
    _normalize_codec_lang _c _l
    [[ -z "$_br_i" || ! "$_br_i" =~ ^[0-9]+$ ]] && _br_i=0

    # Check if this index is in the keep list
    local _is_kept=0
    for idx in "${AUDIO_MT_INDICES[@]}"; do
      (( idx == i )) && { _is_kept=1; break; }
    done

    pretty="#$i: $_c ${_ch_i}ch [$_l]"
    [[ -n "$_t" ]] && pretty="$pretty — $_t"
    _audio_is_commentary "$_t" && pretty="$pretty [commentary]"
    (( _br_i > 0 )) && pretty="$pretty, $((_br_i/1000))kbps"

    if (( _is_kept )); then
      marker=" ✓"
    else
      marker=" ✗"
    fi
    say "  $pretty$marker"
  done

  note "[Audio] Multi-track: keeping ${n_kept} of ${n_total} tracks (${n_dropped} filtered out)"
  report_add "audio_mode" "multi-track"
  report_add "audio_multi_track_kept" "$n_kept"
  report_add "audio_multi_track_dropped" "$n_dropped"

  # Report kept tracks
  local track_summary=""
  for (( i=0; i<n_kept; i++ )); do
    local _idx="${AUDIO_MT_INDICES[$i]}"
    local _codec="${AUDIO_MT_CODECS[$i]}"
    local _ch="${AUDIO_MT_CHANNELS[$i]}"
    local _lang="${AUDIO_MT_LANGS[$i]}"
    track_summary+="#${_idx}: ${_codec} ${_ch}ch [${_lang}]"
    (( i < n_kept - 1 )) && track_summary+=", "
  done
  report_add "audio_kept_tracks" "$track_summary"

  mark_done "Audio filter plan (multi-track, ${n_kept} tracks)"
}

# run_audio_pipeline — Select, copy or transcode the best audio track.
#
# Decision tree:
#   1. AUDIO_FORCE_CODEC set   → transcode to that codec (or copy if already matching)
#   2. AUDIO_LOSSLESS_PASSTHROUGH + lossless codec + container supports it → copy
#   3. Direct-play-copyable codec (aac, alac, ac3, eac3) → copy
#   4. Otherwise → transcode to eac3 (surround) or aac (stereo)
#
# Optionally creates a stereo AAC fallback track (ADD_STEREO_IF_MULTICH).
#
# Sets: A_PRIMARY, AAC_STEREO, HAS_AUDIO, A_PRIMARY_LANG, A_PRIMARY_TITLE,
#       A_STEREO_LANG
# Dies on: audio copy/transcode failure (exit 43)
run_audio_pipeline(){
  # shellcheck disable=SC2034
  local n best idx codec ch lang br title
  n="$(_audio_stream_count)"
  
  if (( n == 0 )); then
    note "No audio streams detected."
    HAS_AUDIO=0
    return 0
  fi

  # ---- Multi-track mode: filter and defer to mux_final ----
  # When AUDIO_MULTI_TRACK=1, skip single-track scoring entirely.
  # Demote to single-track if the user set overrides that are incompatible.
  if (( AUDIO_MULTI_TRACK )); then
    if [[ -n "${AUDIO_TRACK_OVERRIDE:-}" ]]; then
      note "[Audio] Keeping a single audio track: --audio-track override is set (multi-track mode off)."
    elif [[ -n "${AUDIO_FORCE_CODEC:-}" ]]; then
      note "[Audio] Keeping a single audio track: --audio-force-codec is set (multi-track mode off)."
    else
      # D5: --prefer-stereo / --stereo-fallback are single-track intents; multi-track mode
      # copies all source audio tracks as-is and cannot honor them. Announce rather than
      # silently ignore (says == does). Gated on _CLI_*_EXPLICIT so the warning fires ONLY when
      # the user actually typed the flag — never for a value carried by a profile/config or the
      # ADD_STEREO_IF_MULTICH=1 default (which would name a flag the user didn't pass). The
      # archive profile also surfaces --stereo-fallback as a config-time conflict advisory.
      (( _CLI_AUDIO_PREFER_STEREO_EXPLICIT && AUDIO_PREFER_STEREO )) && \
        warn "[Audio] --prefer-stereo does not apply in multi-track audio mode (AUDIO_MULTI_TRACK=1); all source audio tracks are kept as-is."
      (( _CLI_ADD_STEREO_IF_MULTICH_EXPLICIT && ADD_STEREO_IF_MULTICH )) && \
        warn "[Audio] --stereo-fallback does not apply in multi-track audio mode (AUDIO_MULTI_TRACK=1); all source audio tracks are kept as-is (no stereo downmix added)."
      run_audio_pipeline_multi
      return $?
    fi
  fi

  # ---- Single-track mode (score, select, copy/transcode) ----
  # Destructure the full winning record in one shot — avoids 5 extra jq forks (L2b).
  local _best_record
  _best_record="$(select_best_audio)"
  [[ -n "$_best_record" ]] || { HAS_AUDIO=0; return 0; }
  # Tab-safe split that preserves an empty title field (a plain `IFS=$'\t' read` collapses it —
  # tab is IFS-whitespace — shifting an untitled track's bitrate into title and blanking br).
  _parse_audio_record "$_best_record"
  idx="$_AREC_IDX"; codec="$_AREC_CODEC"; ch="$_AREC_CH"; lang="$_AREC_LANG"; title="$_AREC_TITLE"; br="$_AREC_BR"

  # SYNC: only the per-stream `pretty=` line construction must stay in sync with the display loop in
  # run_audio_pipeline_multi (the surrounding select/keep logic differs by design). (RF12: narrowed.)
  log "• Detected audio streams:"
  local i
  for (( i=0; i<n; i++ )); do
    local _ainfo _c _ch_i _l _br_i _t pretty
    _ainfo="$(_audio_stream_info "$i")"
    _split_tab "$_ainfo" _c _ch_i _l _br_i _t _ _ _  # C2: non-collapsing (RF3: sink trailing disposition fields)
    _normalize_codec_lang _c _l
    [[ -z "$_br_i" || ! "$_br_i" =~ ^[0-9]+$ ]] && _br_i=0

    pretty="#$i: $_c ${_ch_i}ch [$_l]"
    [[ -n "$_t" ]] && pretty="$pretty — $_t"
    _audio_is_commentary "$_t" && pretty="$pretty [commentary]"
    (( _br_i > 0 )) && pretty="$pretty, $((_br_i/1000))kbps"
    log "  $pretty"
  done

  # F9: guard the bitrate suffix with (( br > 0 )) — a 0/absent bitrate must not render ", 0kbps"
  # (mirrors the per-stream display loop above). br is numeric here (normalized by select_best_audio).
  local _sel_br_suffix=""
  (( br > 0 )) && _sel_br_suffix=", $((br/1000))kbps"
  note "[Audio] Selected track #$idx: $codec ${ch}ch [$lang]${title:+ — $title}${_sel_br_suffix}"
  report_add "audio_source" "track #$idx: $codec ${ch}ch [$lang]"

  A_PRIMARY="$WORKDIR/audio_primary.$(_audio_copy_ext "$codec")"
  AAC_STEREO="$WORKDIR/audio_stereo.aac"
  HAS_AUDIO=1

  # Persist audio metadata for mux_final tagging
  A_PRIMARY_LANG="$lang"
  A_PRIMARY_TITLE="${title:-}"
  A_PRIMARY_CHANNELS="$ch"
  # Stereo-fallback defaults (F7): a downmix is AAC in the primary's language. A native stereo
  # track (copy or transcode) overrides these with its own codec/language in the block below.
  A_STEREO_LANG="$lang"
  A_STEREO_CODEC="aac"

  # Enforce MAX_AUDIO_CHANNELS
  local effective_ch="$ch"
  if (( ch > MAX_AUDIO_CHANNELS )); then
    note "[Audio] Capping audio channels from $ch to $MAX_AUDIO_CHANNELS (the configured maximum)."
    effective_ch="$MAX_AUDIO_CHANNELS"
  fi

  log "→ Preparing primary audio → $A_PRIMARY"

  if (( DRY_RUN )); then
    : > "$A_PRIMARY" 2>/dev/null || true
    mark_done "Primary audio prepared (dry-run)"
    if (( ADD_STEREO_IF_MULTICH )) && (( effective_ch > 2 )); then
      : > "$AAC_STEREO" 2>/dev/null || true
      mark_done "Stereo fallback prepared (dry-run)"
    fi
    return 0
  fi

  # Decision tree for audio handling:
  # 1. AUDIO_FORCE_CODEC set → always transcode to that codec
  # 2. AUDIO_LOSSLESS_PASSTHROUGH=1 and codec is lossless and container supports it → copy
  # 3. Direct-play-copyable codec → copy
  # 4. Otherwise → transcode

  local do_copy=0 tgt_codec="" tgt_br=""

  # Step 1: Forced codec override via AUDIO_FORCE_CODEC (--audio-force-codec)
  if [[ -n "${AUDIO_FORCE_CODEC:-}" ]]; then
    # Force codec: always transcode to target
    tgt_codec="$AUDIO_FORCE_CODEC"
    # Compare the codec the target ENCODER produces (libopus→opus) against the source
    # codec (ffprobe name) — a naive "$tgt_codec" == "$codec" never matches an Opus source
    # vs AUDIO_FORCE_CODEC=libopus and would re-encode it pointlessly.
    local _tgt_native; _tgt_native="$(_encoder_to_codec "$tgt_codec")"
    if [[ "$_tgt_native" == "$codec" ]] && (( effective_ch == ch )); then
      do_copy=1
      note "Audio already matches forced codec ($_tgt_native). Copying."
      report_add "audio_action" "copy (already $_tgt_native)"
    else
      read -r _ tgt_br <<< "$(audio_transcode_target "$effective_ch")"
      if [[ "$tgt_codec" == "aac" ]]; then
        # L (Phase 5): honor STEREO_BITRATE instead of a hardcoded 256k. Masked today because
        # `universal` (the only profile forcing AAC) sets STEREO_BITRATE=256k, but --stereo-bitrate
        # / a .muxmrc override was silently ignored on the force-AAC path.
        tgt_br="$STEREO_BITRATE"
      fi
      [[ -n "${AUDIO_FORCE_BITRATE:-}" ]] && tgt_br="$AUDIO_FORCE_BITRATE"
      note "Force transcoding audio: $codec → $tgt_codec"
      report_add "audio_action" "transcode to $tgt_codec"
    fi
  # Step 2: Lossless passthrough (if enabled and codec is lossless)
  elif (( AUDIO_LOSSLESS_PASSTHROUGH )) && audio_is_lossless "$codec"; then
    # F4: only stream-copy untouched when the container can hold the codec AND the channel count
    # is uncapped. A MAX_AUDIO_CHANNELS cap (effective_ch < ch) cannot be applied to a lossless
    # copy, so a capped source must fall through to transcode (which applies -ac) — the same
    # `(( effective_ch == ch ))` guard Steps 1 and 3 already carry.
    if audio_lossless_muxable "$codec" && (( effective_ch == ch )); then
      do_copy=1
      note "Lossless audio passthrough ($codec). Copying without conversion."
      report_add "audio_action" "lossless passthrough ($codec)"
    else
      # Lossless but either can't mux into the target container OR the channel cap applies —
      # transcode to the best compatible codec (effective_ch is enforced via -ac downstream).
      read -r tgt_codec tgt_br <<< "$(audio_transcode_target "$effective_ch")"
      # D3: --audio-force-bitrate overrides the auto bitrate for any transcoded non-lossless
      # output, not just the --audio-force-codec path (Step 1, above). No double-apply: this is
      # a separate elif branch from Step 1.
      [[ -n "${AUDIO_FORCE_BITRATE:-}" ]] && tgt_br="$AUDIO_FORCE_BITRATE"
      if (( effective_ch != ch )); then
        note "Lossless $codec capped from ${ch}ch to ${effective_ch}ch (MAX_AUDIO_CHANNELS) — transcoding to $tgt_codec."
        report_add "audio_action" "transcode (lossless $codec capped ${ch}ch→${effective_ch}ch)"
      else
        note "Lossless $codec can't mux into $MUX_FORMAT — transcoding to $tgt_codec."
        report_add "audio_action" "transcode (lossless $codec incompatible with $MUX_FORMAT)"
      fi
    fi
  # Step 3: Direct-play-copyable codec (aac, alac, ac3, eac3) → copy
  elif audio_is_direct_play_copyable "$codec" && (( effective_ch == ch )); then
    do_copy=1
    note "Direct Play audio codec detected ($codec). Copying without conversion."
    report_add "audio_action" "copy ($codec direct-play compatible)"
  # Step 4: Fallback → transcode to eac3 (surround) or aac (stereo)
  else
    read -r tgt_codec tgt_br <<< "$(audio_transcode_target "$effective_ch")"
    # D3: --audio-force-bitrate overrides the auto bitrate here too (standalone, no forced
    # codec). Separate elif from Step 1, so no double-apply. (The bitrate is logged once after
    # the channel cap below, so it reflects the final post-cap value.)
    [[ -n "${AUDIO_FORCE_BITRATE:-}" ]] && tgt_br="$AUDIO_FORCE_BITRATE"
    note "Transcoding audio: $codec → $tgt_codec"
    report_add "audio_action" "transcode $codec → $tgt_codec"
  fi

  # Update metadata to reflect the final output codec and channel count.
  # On transcode, store the ffprobe CODEC name the encoder produces (libopus→opus), not the
  # raw encoder name — so the descriptive audio title reads "… (Opus)", not "… (libopus)".
  if (( do_copy )); then
    A_PRIMARY_CODEC="$codec"
  else
    A_PRIMARY_CODEC="$(_encoder_to_codec "$tgt_codec")"
  fi

  # Enforce encoder channel ceiling (e.g., eac3/ac3 max = 6ch).
  # audio_transcode_target selects codec based on *source* channel count, but
  # ffmpeg's native encoders may support fewer channels than the source has.
  # Without this clamp, -ac 8 + eac3 causes a fatal ffmpeg error.
  if (( ! do_copy )); then
    local codec_max
    codec_max="$(_codec_max_channels "$tgt_codec")"
    if (( effective_ch > codec_max )); then
      note "Capping channels from $effective_ch to $codec_max ($tgt_codec encoder limit)"
      effective_ch="$codec_max"
      # Re-derive the AUTO bitrate for the capped layout (e.g., 768k 7.1 → 640k 5.1) — but a
      # user-forced bitrate (--audio-force-bitrate) must SURVIVE the cap, so don't re-derive
      # over it (item 1). Mirrors the force-bitrate override applied in Steps 1/2/4 above.
      [[ -n "${AUDIO_FORCE_BITRATE:-}" ]] || read -r _ tgt_br <<< "$(audio_transcode_target "$effective_ch")"
    fi
    # Single bitrate log for every transcode path (Steps 1/2/4), emitted AFTER the cap so it
    # reflects the final channel count + bitrate (item 1: accuracy; item 2b: Step 2 now logs its
    # bitrate too, consistent with the other transcode branches). log-only — kept off the terminal.
    log "audio transcode: channels=${effective_ch}ch, bitrate=$tgt_br"
  fi

  A_PRIMARY_CHANNELS="$effective_ch"

  if (( do_copy )); then
    ffmpeg "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:a:"$idx" -c copy "$A_PRIMARY" 2>"$WORKDIR/audio_primary.err" &
    local acopy_pid=$!
    local _acopy_rc=0; _await_tracked_pid "$acopy_pid" "Copying audio stream" || _acopy_rc=$?
    if (( _acopy_rc != 0 )); then
      _check_disk_full "$WORKDIR/audio_primary.err"   # L5: surface ENOSPC, like the die 40/41 paths
      die 43 "Audio copy failed. See: $WORKDIR/audio_primary.err"
    fi
  else
    A_PRIMARY="$WORKDIR/audio_primary.$(_audio_codec_ext "$tgt_codec")"
    local -a transcode_args=("${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map "0:a:$idx")

    if [[ "$tgt_codec" == "eac3" ]]; then
      transcode_args+=(-c:a eac3 -b:a "$tgt_br")
    elif [[ "$tgt_codec" == "aac" ]]; then
      transcode_args+=(-c:a aac -b:a "$tgt_br")
    elif [[ "$tgt_codec" == "ac3" ]]; then
      transcode_args+=(-c:a ac3 -b:a "$tgt_br")
    else
      transcode_args+=(-c:a "$tgt_codec" -b:a "$tgt_br")
    fi

    # Apply channel limit
    transcode_args+=(-ac "$effective_ch")
    transcode_args+=("$A_PRIMARY")

    local total_secs
    total_secs="$(_get_source_duration_secs)"
    if ! _ffmpeg_run_with_ui transcode_args "Transcoding audio" "$WORKDIR/audio_primary.err" "$total_secs"; then
      _check_disk_full "$WORKDIR/audio_primary.err"   # L5: surface ENOSPC, like the die 40/41 paths
      die 43 "Audio transcode to $tgt_codec failed. See: $WORKDIR/audio_primary.err"
    fi
  fi

  # Validate primary audio
  if [[ ! -s "$A_PRIMARY" ]]; then
    die 43 "Primary audio preparation produced empty file"
  fi

  mark_done "Primary audio prepared"

  # Add stereo fallback if needed
  if (( ADD_STEREO_IF_MULTICH )) && (( effective_ch > 2 )); then
    # Scan for a native stereo track before falling back to a synthetic downmix.
    local _native_si="" _native_sc="" _native_sl=""
    local _ns_total _ns_i _ns_info _ns_c _ns_ch _ns_l _ns_br _ns_t _ns_comment _ns_vi _ns_hi
    _ns_total="$(_audio_stream_count)"
    for (( _ns_i = 0; _ns_i < _ns_total; _ns_i++ )); do
      (( _ns_i == idx )) && continue
      # RF3: disposition flags now come from the single _audio_stream_info record (no extra
      # per-stream disposition jq probes).
      _ns_info="$(_audio_stream_info "$_ns_i")"
      _split_tab "$_ns_info" _ns_c _ns_ch _ns_l _ns_br _ns_t _ns_comment _ns_vi _ns_hi  # C2: non-collapsing
      _ns_c="${_ns_c,,}"; _ns_l="${_ns_l,,}"
      [[ -z "$_ns_l" ]] && _ns_l="$TAG_LANGUAGE_DEFAULT"
      [[ -z "$_ns_ch" || ! "$_ns_ch" =~ ^[0-9]+$ ]] && _ns_ch=0
      # Must be exactly 2 channels
      (( _ns_ch != 2 )) && continue
      # Language must match primary track (und matches anything). CR-7: normalize BOTH sides via
      # _norm_lang_code so an `en`-tagged native stereo matches an `eng` primary (and 639-2/B vs /T),
      # mirroring _audio_lang_matches — otherwise a code mismatch needlessly synthesizes an AAC
      # downmix instead of stream-copying the existing native stereo. `und` normalizes to `und`,
      # preserving the wildcard. The raw tag (_ns_l) is still kept below for honest muxing.
      local _ns_l_norm _lang_norm
      _ns_l_norm="$(_norm_lang_code "$_ns_l")"
      _lang_norm="$(_norm_lang_code "$lang")"
      if [[ "$_ns_l_norm" != "und" && "$_lang_norm" != "und" && "$_ns_l_norm" != "$_lang_norm" ]]; then continue; fi
      # Not commentary or descriptive audio (title keyword OR disposition flags)
      _audio_is_commentary "$_ns_t" && continue
      (( _ns_comment )) && continue
      (( _ns_vi )) && continue
      (( _ns_hi )) && continue
      _native_si="$_ns_i"
      _native_sc="$_ns_c"
      _native_sl="$_ns_l"
      break
    done

    local stereo_total_secs
    stereo_total_secs="$(_get_source_duration_secs)"

    if [[ -z "$_native_si" ]]; then
      note "[Audio] No native stereo track available. Creating downmix from surround."
      log "→ Preparing stereo fallback → $AAC_STEREO"
      # shellcheck disable=SC2034  # used by name-reference in _ffmpeg_run_with_ui
      local -a stereo_cmd=("${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:a:"$idx" \
        -c:a aac -b:a "$STEREO_BITRATE" -ac 2 "$AAC_STEREO")
      if ! _ffmpeg_run_with_ui stereo_cmd "Creating stereo fallback" "$WORKDIR/audio_stereo.err" "$stereo_total_secs"; then
        warn "Stereo fallback creation failed - continuing without it. See: $WORKDIR/audio_stereo.err"
        AAC_STEREO=""
      else
        mark_done "Stereo fallback prepared"
      fi
    else
      note "[Audio] Native stereo track found (stream #${_native_si}, ${_native_sc} 2ch); using it instead of creating a stereo downmix."
      # F7: the fallback now carries the chosen native track's language (not the primary's) so
      # mux_final tags it honestly. The codec stays "aac" for the transcode path; the copy path
      # below overrides it with the real native codec.
      A_STEREO_LANG="$_native_sl"
      # Copy if codec is compatible with the output container; otherwise transcode to AAC (M2).
      local _ns_do_copy=0
      _sii_audio_is_container_safe "$_native_sc" && _ns_do_copy=1
      if (( ! _ns_do_copy )); then
        # shellcheck disable=SC2034  # used by name-reference in _ffmpeg_run_with_ui
        local -a stereo_cmd=("${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map "0:a:${_native_si}" \
          -c:a aac -b:a "$STEREO_BITRATE" "$AAC_STEREO")
        if ! _ffmpeg_run_with_ui stereo_cmd "Transcoding native stereo" "$WORKDIR/audio_stereo.err" "$stereo_total_secs"; then
          warn "Native stereo transcode failed - continuing without it. See: $WORKDIR/audio_stereo.err"
          AAC_STEREO=""
        else
          mark_done "Stereo fallback prepared (native)"
        fi
      else
        # F7: stream-copy keeps the native codec — record it so the output track is labeled with
        # its real codec (e.g. "(AC-3)"), not a hardcoded "aac".
        A_STEREO_CODEC="$_native_sc"
        # Stream-copy: the intermediate must use an extension matching the
        # native codec, not the default .aac. ffmpeg picks the muxer from the
        # extension, and the .aac (ADTS) muxer only accepts AAC — copying any
        # other codec (FLAC/AC3/EAC3) into it fails ("adts muxer supports only
        # codec aac"), silently dropping the stereo track.
        AAC_STEREO="$WORKDIR/audio_stereo.$(_audio_copy_ext "$_native_sc")"
        ffmpeg "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map "0:a:${_native_si}" -c copy "$AAC_STEREO" \
          2>"$WORKDIR/audio_stereo.err" &
        local _ns_pid=$!
        local _ns_rc=0; _await_tracked_pid "$_ns_pid" "Copying native stereo track" || _ns_rc=$?
        if (( _ns_rc != 0 )); then
          warn "Native stereo copy failed - continuing without it. See: $WORKDIR/audio_stereo.err"
          AAC_STEREO=""
        else
          mark_done "Stereo fallback prepared (native)"
        fi
      fi
    fi
  else
    note "Primary audio is stereo (or fallback disabled); no extra stereo needed."
  fi
}

# ===== Section 28: Subtitle helpers (planner + OCR) ==========================================
# Count subtitle streams in source file
_sub_count() {
  _jq_cache '[.streams[] | select(.codec_type=="subtitle")] | length' || echo 0
}

# Emit integers 0..N-1 (one per line) for iterating all subtitle stream indices.
# Provides a standard loop target: for i in $(list_sub_indices); do ...
list_sub_indices(){
  local n i
  n="$(_sub_count)"
  for (( i=0; i<n; i++ )); do echo "$i"; done
}

# Get subtitle field from cached metadata.  Args: $1 — subtitle stream index, $2 — field (e.g. codec_name).
_sp_sub_field() { _probe_stream_field subtitle "$1" "$2"; }
# Get subtitle tag from cached metadata.    Args: $1 — subtitle stream index, $2 — tag (e.g. language, title).
_sp_sub_tag() { _probe_stream_field subtitle "$1" "tags.$2"; }

# Return language tag for subtitle stream (lowercased), defaulting to TAG_LANGUAGE_DEFAULT.
# Args: $1 — subtitle stream index
_sp_sub_lang(){
  local lang
  lang="$(_sp_sub_tag "$1" language)"; lang="${lang,,}"
  [[ -z "$lang" ]] && lang="$TAG_LANGUAGE_DEFAULT"
  echo "$lang"
}

# Heuristic: check if a subtitle title string indicates forced/signs content.
# Matches "forced", "signs", "foreign" as whole words (word-anchored, M2) so titles like
# "Designs"/"Foreigner"/"Cosigns" don't false-match — important because a "forced" track is
# burned into the video under SUB_BURN_FORCED.
# Args: $1 — title string to test
# Returns: 0 if match, 1 otherwise
_is_forced_title(){
  local t="${1,,}"
  [[ "$t" =~ (^|[^a-z])(forced|signs|foreign)([^a-z]|$) ]]
}

# Heuristic: check if a subtitle title string indicates SDH/HI content.
# Matches "sdh", "hi", "cc", "caption", "hearing", "impaired" as whole words (every
# alternative word-anchored, M2) so "Soccer"/"vaccine"/"Account" (containing "cc") and
# "history" (containing "hi") don't false-match.
# Args: $1 — title string to test
# Returns: 0 if match, 1 otherwise
_is_sdh_title(){
  local t="${1,,}"
  [[ "$t" =~ (^|[^a-z])(sdh|hi|cc|caption|hearing|impaired)([^a-z]|$) ]]
}

# _sub_stream_info — Fetch all scan-relevant fields for one subtitle stream
# in a single jq call (replaces 3–4 separate jq forks per stream).
# Returns: codec\tlanguage\ttitle\tforced\thearing_impaired  (tab-delimited)
# F3: hearing_impaired disposition is emitted so SDH can be classified by disposition, not just
#     title. ALL consumers `read -r codec lang title forced hi` — a 4-field read would fold the
#     hi field into `forced`, corrupting the `(( forced ))` checks (see the fallback below too).
# RF8 (security): attacker-controlled title/language tags are sanitized at extraction — the full C0
#     control range plus DEL (jq gsub on U+0000..U+001F and U+007F) is replaced with a space, so
#     a hostile track title can't inject terminal escape sequences into the scan output or log.
# Args: $1 — subtitle stream index (0-based, relative to subtitle streams)
# Globals: METADATA_CACHE (read)
_sub_stream_info(){
  local idx="$1"
  _jq_cache -r "[.streams[] | select(.codec_type==\"subtitle\")] | .[$idx] |
    \"\(.codec_name // \"?\")\t\(.tags.language // \"\" | gsub(\"[\\u0000-\\u001f\\u007f]\";\" \"))\t\(.tags.title // \"\" | gsub(\"[\\u0000-\\u001f\\u007f]\";\" \"))\t\(.disposition.forced // 0)\t\(.disposition.hearing_impaired // 0)\"" | head -n1 || printf '?\t\t\t0\t0\n'
}

# Check if codec is text-based (can be stream-copied to MP4 as mov_text or MKV as srt).
# Text: subrip, srt, ass, ssa, webvtt, vtt, mov_text
# Bitmap (not text): hdmv_pgs_subtitle, dvd_subtitle, dvb_subtitle
# Args: $1 — codec name
_is_text_sub_codec(){
  local c="$1"
  case "$c" in
    subrip|srt|ass|ssa|webvtt|vtt|mov_text) return 0 ;;
    *) return 1 ;;
  esac
}

_container_supports_bitmap_subs(){ [[ "$MUX_FORMAT" == "matroska" ]]; }

# RF6: a single-track subtitle CANDIDATE that cannot be turned into a track for the current output
# container — a bitmap codec (PGS/VobSub/DVD) when the container can't carry it (non-MKV) AND OCR is
# disabled, so it can neither be stream-copied nor OCR'd to text. Used to (a) keep a usable text
# sidecar that would otherwise be deduped against such an embedded bitmap, and (b) skip the bitmap in
# single-track selection so a same-type text candidate (e.g. a `.srt` sidecar) is chosen instead —
# mirroring the multi-track keep-list's Filter 3 "never silently lose a track" intent.
# Args: $1 — codec name.  Reads: MUX_FORMAT, SUB_ENABLE_OCR.
_sub_candidate_undeliverable(){
  local c="$1"
  _is_text_sub_codec "$c" && return 1            # text is always deliverable
  _container_supports_bitmap_subs && return 1     # MKV stream-copies the bitmap as-is
  (( SUB_ENABLE_OCR )) && return 1                # OCR converts the bitmap → text
  return 0                                        # bitmap, non-MKV, OCR off → undeliverable
}

# Find the first text-based subtitle in a preferred language for direct stream copy.
# Returns: relative subtitle index on stdout (empty string if none found).
# Used as a fast path when no OCR or conversion is needed.
_pick_direct_text_sub_relidx(){
  local i lang codec
  # shellcheck disable=SC2046  # Intentional word-splitting of integer list
  for i in $(list_sub_indices); do
    lang="$(_sp_sub_lang "$i")"
    _sub_lang_matches "$lang" || continue
    codec="$(_sp_sub_field "$i" codec_name)"; codec="${codec,,}"
    if _is_text_sub_codec "$codec"; then
      echo "$i"
      return 0
    fi
  done
  echo ""
}

# Prepare subtitle for output (extract, convert, or OCR as needed).
# When SUB_PRESERVE_TEXT_FORMAT=1 and the output container is MKV,
# ASS/SSA subtitles are extracted in native format instead of converting to SRT.
# Args: subtitle_stream_index
# Returns: path to prepared subtitle file or empty string if failed
_prepare_subtitle(){
  local idx="$1" codec srt sup vob_base

  if [[ ! -d "$WORKDIR" ]]; then
    # L (Phase 5): echo ""+rc0, not rc1. Callers capture via `sub_path="$(...)"` (a plain, non-local
    # assignment), where a non-zero command substitution would trip set -e and abort the whole run.
    # An exotic mid-run workdir loss should warn-and-skip the subtitle, not kill the encode.
    warn "[Subs] Workdir disappeared — cannot extract subtitle #$idx"
    echo ""
    return 0
  fi

  codec="$(_sp_sub_field "$idx" codec_name)"; codec="${codec,,}"
  srt="$WORKDIR/sub.${idx}.srt"

  # Check if we should preserve native text format (ASS/SSA) for this run.
  # Conditions: SUB_PRESERVE_TEXT_FORMAT=1, output container is MKV, and codec is ASS/SSA.
  local _preserve_native=0
  if (( SUB_PRESERVE_TEXT_FORMAT )) && [[ "$MUX_FORMAT" == "matroska" ]]; then
    case "$codec" in
      ass|ssa) _preserve_native=1 ;;
    esac
  fi

  # Compute PGS-preserve decision before the dry-run check so the dry-run branch
  # can advertise the .sup path, matching the real run (H13).
  local _preserve_pgs=0
  if [[ "$codec" == "hdmv_pgs_subtitle" || "$codec" == "pgs" ]]; then
    sup="$WORKDIR/sub.${idx}.sup"
    if (( SUB_PRESERVE_BITMAP )) && _container_supports_bitmap_subs && (( ! SUB_BURN_FORCED )); then
      _preserve_pgs=1
    fi
  fi

  if (( DRY_RUN )); then
    if (( _preserve_native )); then
      local dry_out="$WORKDIR/sub.${idx}.${codec}"
      printf "[Script Info]\n; dry-run\n" >"$dry_out" 2>/dev/null || true
      note "[Subs] DRY-RUN: would extract subtitle #${idx} as native ${codec} (preserving styling)"
      echo "$dry_out"
    elif (( _preserve_pgs )); then
      printf "" >"$sup" 2>/dev/null || true
      note "[Subs] DRY-RUN: would stream-copy PGS subtitle #${idx} as .sup (bitmap preserved)"
      echo "$sup"
    else
      printf "1\n00:00:00,000 --> 00:00:00,500\n(dry-run)\n" >"$srt" 2>/dev/null || true
      echo "$srt"
    fi
    return 0
  fi

  case "$codec" in
    subrip|srt)
      ffmpeg "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:s:"$idx" -c copy "$srt" 2>"$WORKDIR/sub_${idx}.err" &
      local sub_pid=$!
      local _sub_ok=0; _await_tracked_pid "$sub_pid" "Extracting subtitle #${idx} (SRT copy)" || _sub_ok=$?
      if (( _sub_ok == 0 )); then
        echo "$srt"
        return 0
      fi
      warn "[Subs] Failed to extract SRT subtitle #$idx. See: $WORKDIR/sub_${idx}.err"
      ;;

    ass|ssa|webvtt|vtt)
      if (( _preserve_native )); then
        # Extract in native format (copy, no conversion)
        local native_out="$WORKDIR/sub.${idx}.${codec}"
        ffmpeg "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:s:"$idx" -c:s copy "$native_out" 2>"$WORKDIR/sub_${idx}.err" &
        local sub_pid=$!
        local _sub_ok=0; _await_tracked_pid "$sub_pid" "Extracting subtitle #${idx} (${codec} native copy)" || _sub_ok=$?
        if (( _sub_ok == 0 )); then
          echo "$native_out"
          return 0
        fi
        warn "[Subs] Failed to extract native ${codec} subtitle #$idx. See: $WORKDIR/sub_${idx}.err"
      else
        # Convert to SRT (legacy behavior)
        ffmpeg "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:s:"$idx" "$srt" 2>"$WORKDIR/sub_${idx}.err" &
        local sub_pid=$!
        local _sub_ok=0; _await_tracked_pid "$sub_pid" "Converting subtitle #${idx} (${codec} → SRT)" || _sub_ok=$?
        if (( _sub_ok == 0 )); then
          echo "$srt"
          return 0
        fi
        warn "[Subs] Failed to convert subtitle #$idx to SRT. See: $WORKDIR/sub_${idx}.err"
      fi
      ;;

    hdmv_pgs_subtitle|pgs)
      # _preserve_pgs and sup already computed before the top-level DRY_RUN check (H13).
      # sup is set to "$WORKDIR/sub.${idx}.sup" when codec is PGS.

      ffmpeg "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" -map 0:s:"$idx" -c:s copy "$sup" 2>"$WORKDIR/sub_${idx}_extract.err" &
      local sup_pid=$!
      local _sup_ok=0; _await_tracked_pid "$sup_pid" "Extracting PGS subtitle #${idx} to SUP" || _sup_ok=$?
      if (( _sup_ok != 0 )); then
        warn "[Subs] Failed extracting PGS #$idx to .sup — skipping. See: $WORKDIR/sub_${idx}_extract.err"
        echo ""
        return 0
      fi

      if (( _preserve_pgs )); then
        note "[Subs] Preserving PGS subtitle #${idx} as bitmap (.sup stream-copy)"
        echo "$sup"
        return 0
      fi

      if (( ! SUB_ENABLE_OCR )); then
        warn "[Subs] PGS subtitle #$idx requires OCR but OCR is disabled — skipping."
        echo ""
        return 0
      fi

      local _ocr_ok=0

      # Select language flag based on OCR tool (M14)
      local -a _ocr_lang=()
      case "$SUB_OCR_TOOL" in
        pgsrip)  [[ -n "$SUB_OCR_LANG" ]] && _ocr_lang=(--language "$SUB_OCR_LANG") ;;
        sub2srt) ;;  # sub2srt does not support a language flag
        *)       [[ -n "$SUB_OCR_LANG" ]] && _ocr_lang=(-l "$SUB_OCR_LANG") ;;
      esac

      # Try vobsub conversion if muxer is available
      if ffmpeg_has_muxer vobsub; then
        vob_base="$WORKDIR/sub.${idx}.vob"
        ffmpeg "${FFMPEG_FLAGS[@]}" -i "$sup" -map 0:s:0 -c:s dvdsub -f vobsub "$vob_base" 2>"$WORKDIR/sub_${idx}_vobsub.err" &
        local vob_pid=$!
        local _vob_ok=0; _await_tracked_pid "$vob_pid" "Converting PGS #${idx} to VobSub" || _vob_ok=$?
        if (( _vob_ok != 0 )); then
          warn "[Subs] PGS→VobSub conversion failed for #$idx. See: $WORKDIR/sub_${idx}_vobsub.err"
          echo ""
          return 0
        fi

        # Run OCR tool on VobSub .idx
        (
          "$SUB_OCR_TOOL" ${_ocr_lang[@]+"${_ocr_lang[@]}"} "${vob_base}.idx" >"$WORKDIR/sub_${idx}_ocr.log" 2>&1 || true
        ) &
        local ocr_pid=$!
        _ACTIVE_FFMPEG_PID=$ocr_pid
        spinner "$ocr_pid" "Running OCR on subtitle #${idx}"
        wait "$ocr_pid" 2>/dev/null || true
        _ACTIVE_FFMPEG_PID=""
        if [[ -s "${vob_base}.srt" ]]; then
          mv -f "${vob_base}.srt" "$srt" || true
        fi
        if [[ -s "$srt" ]] && grep -q ' --> ' "$srt"; then
          echo "$srt"
          return 0
        fi
        warn "[Subs] OCR tool ('$SUB_OCR_TOOL') ran on VobSub but produced no SRT for subtitle #$idx. See: $WORKDIR/sub_${idx}_ocr.log"
        echo ""
        return 0
      fi

      # Fallback: try OCR tool directly on .sup
      (
        "$SUB_OCR_TOOL" ${_ocr_lang[@]+"${_ocr_lang[@]}"} "$sup" >"$WORKDIR/sub_${idx}_ocr_sup.log" 2>&1 || true
      ) &
      local ocr_sup_pid=$!
      _ACTIVE_FFMPEG_PID=$ocr_sup_pid
      spinner "$ocr_sup_pid" "Running OCR on subtitle #${idx} (SUP)"
      wait "$ocr_sup_pid" 2>/dev/null || true; _ACTIVE_FFMPEG_PID=""  # M3: clear AFTER wait (a SIGINT before wait would otherwise orphan the OCR child and could hang the tee drain)
      # Check common output locations for the SRT
      if [[ -s "${sup%.sup}.srt" ]]; then
        mv -f "${sup%.sup}.srt" "$srt" || true
        _ocr_ok=1
      elif [[ -s "${sup}.srt" ]]; then
        mv -f "${sup}.srt" "$srt" || true
        _ocr_ok=1
      fi
      if (( _ocr_ok )) && [[ -s "$srt" ]] && grep -q ' --> ' "$srt"; then
        echo "$srt"
        return 0
      fi

      # Provide specific diagnostic based on what failed
      if ! ffmpeg_has_muxer vobsub; then
        warn "[Subs] PGS subtitle #$idx: ffmpeg lacks the 'vobsub' muxer (common on macOS Homebrew builds)."
        warn "  '$SUB_OCR_TOOL' also could not process .sup directly. See: $WORKDIR/sub_${idx}_ocr_sup.log"
        warn "  Fix: install a PGS-capable OCR tool (e.g., pgsrip) or rebuild ffmpeg with vobsub."
      else
        warn "[Subs] PGS OCR failed for subtitle #$idx — '$SUB_OCR_TOOL' produced no output."
        warn "  See: $WORKDIR/sub_${idx}_ocr_sup.log"
      fi
      echo ""
      return 0
      ;;
      
    *)
      warn "[Subs] Unsupported subtitle codec '$codec' for #$idx — skipping."
      ;;
  esac

  echo ""
  return 0
}

# _prepare_ext_subtitle — Prepare an external subtitle file for muxing.
#
# For text formats (srt/ass/ssa/vtt): returns the absolute path as-is.
#   ffmpeg can read these directly as -i inputs with no intermediate extraction.
# For PGS (.sup): OCR pipeline → SRT (requires SUB_ENABLE_OCR=1).
# For VobSub (.idx): OCR pipeline → SRT (requires SUB_ENABLE_OCR=1, partner .sub must exist).
#
# Args: $1 — absolute path to external subtitle file
# Returns: path to a usable subtitle file (possibly in WORKDIR), or "" on failure
# Globals: WORKDIR, SUB_ENABLE_OCR, SUB_OCR_TOOL, SUB_OCR_LANG, DRY_RUN
_prepare_ext_subtitle(){
  local ext_path="$1"
  local fext="${ext_path##*.}"; fext="${fext,,}"
  local basename_label
  basename_label="$(basename -- "$ext_path")"

  if [[ ! -f "$ext_path" ]]; then
    warn "[Subs] External subtitle not found: $ext_path"
    echo ""
    return 0
  fi

  case "$fext" in
    srt|ass|ssa|vtt)
      # Text formats: pass through directly — ffmpeg reads them as subtitle inputs
      if (( DRY_RUN )); then
        note "[Subs] DRY-RUN: would use external subtitle $basename_label"
      fi
      echo "$ext_path"
      return 0
      ;;

    sup)
      # PGS bitmap: preserve via stream-copy if container supports it, else OCR to SRT
      if (( SUB_PRESERVE_BITMAP )) && _container_supports_bitmap_subs && (( ! SUB_BURN_FORCED )); then
        if (( DRY_RUN )); then
          note "[Subs] DRY-RUN: would use external PGS $basename_label as bitmap (.sup stream-copy)"
        fi
        echo "$ext_path"
        return 0
      fi

      if (( ! SUB_ENABLE_OCR )); then
        warn "[Subs] External PGS $basename_label requires OCR but OCR is disabled — skipping."
        echo ""
        return 0
      fi

      local srt_out="$WORKDIR/ext_${basename_label%.sup}.srt"

      if (( DRY_RUN )); then
        printf "1\n00:00:00,000 --> 00:00:00,500\n(dry-run external PGS)\n" >"$srt_out" 2>/dev/null || true
        note "[Subs] DRY-RUN: would OCR external PGS $basename_label"
        echo "$srt_out"
        return 0
      fi

      local -a _ocr_lang=()
      case "$SUB_OCR_TOOL" in
        pgsrip)  [[ -n "$SUB_OCR_LANG" ]] && _ocr_lang=(--language "$SUB_OCR_LANG") ;;
        sub2srt) ;;
        *)       [[ -n "$SUB_OCR_LANG" ]] && _ocr_lang=(-l "$SUB_OCR_LANG") ;;
      esac
      (
        "$SUB_OCR_TOOL" ${_ocr_lang[@]+"${_ocr_lang[@]}"} "$ext_path" >"$WORKDIR/ext_ocr_sup.log" 2>&1 || true
      ) &
      local ocr_pid=$!
      _ACTIVE_FFMPEG_PID=$ocr_pid
      spinner "$ocr_pid" "OCR external PGS: $basename_label"
      wait "$ocr_pid" 2>/dev/null || true; _ACTIVE_FFMPEG_PID=""  # M3: clear AFTER wait (avoid orphaning the OCR child on SIGINT)

      # Some OCR tools write .srt next to source file; relocate to workdir
      local sup_srt="${ext_path%.sup}.srt"
      if [[ -s "$sup_srt" ]]; then
        mv -f "$sup_srt" "$srt_out" || true
      fi

      if [[ -s "$srt_out" ]] && grep -q ' --> ' "$srt_out"; then
        echo "$srt_out"
        return 0
      fi
      warn "[Subs] OCR failed for external PGS $basename_label. See: $WORKDIR/ext_ocr_sup.log"
      echo ""
      return 0
      ;;

    idx)
      # VobSub: OCR to SRT (partner .sub must exist — checked in discover_external_subtitles)
      if (( ! SUB_ENABLE_OCR )); then
        warn "[Subs] External VobSub $basename_label requires OCR but OCR is disabled — skipping."
        echo ""
        return 0
      fi

      local srt_out="$WORKDIR/ext_${basename_label%.idx}.srt"

      if (( DRY_RUN )); then
        printf "1\n00:00:00,000 --> 00:00:00,500\n(dry-run external VobSub)\n" >"$srt_out" 2>/dev/null || true
        note "[Subs] DRY-RUN: would OCR external VobSub $basename_label"
        echo "$srt_out"
        return 0
      fi

      local -a _ocr_lang=()
      case "$SUB_OCR_TOOL" in
        pgsrip)  [[ -n "$SUB_OCR_LANG" ]] && _ocr_lang=(--language "$SUB_OCR_LANG") ;;
        sub2srt) ;;
        *)       [[ -n "$SUB_OCR_LANG" ]] && _ocr_lang=(-l "$SUB_OCR_LANG") ;;
      esac
      (
        "$SUB_OCR_TOOL" ${_ocr_lang[@]+"${_ocr_lang[@]}"} "$ext_path" >"$WORKDIR/ext_ocr_vobsub.log" 2>&1 || true
      ) &
      local ocr_pid=$!
      _ACTIVE_FFMPEG_PID=$ocr_pid
      spinner "$ocr_pid" "OCR external VobSub: $basename_label"
      wait "$ocr_pid" 2>/dev/null || true; _ACTIVE_FFMPEG_PID=""  # M3: clear AFTER wait (avoid orphaning the OCR child on SIGINT)

      # RF7: some OCR tools write the .srt next to the source .idx, not into the workdir. Relocate
      # it before the existence check (mirrors the .sup branch above) — otherwise a SUCCESSFUL
      # VobSub OCR left $srt_out empty and was misreported as "OCR failed" and dropped.
      local vob_srt="${ext_path%.idx}.srt"
      if [[ -s "$vob_srt" ]]; then
        mv -f "$vob_srt" "$srt_out" || true
      fi

      if [[ -s "$srt_out" ]] && grep -q ' --> ' "$srt_out"; then
        echo "$srt_out"
        return 0
      fi
      warn "[Subs] OCR failed for external VobSub $basename_label. See: $WORKDIR/ext_ocr_vobsub.log"
      echo ""
      return 0
      ;;

    *)
      warn "[Subs] Unsupported external subtitle format: .$fext ($basename_label)"
      echo ""
      return 0
      ;;
  esac
}

# _prepare_sub_from_source — Dispatch subtitle preparation based on source descriptor.
# Routes "embedded:N" to _prepare_subtitle (extract from source file) and
# "ext:/path" to _prepare_ext_subtitle (use external file directly or OCR).
# Args: $1 — source descriptor ("embedded:N" or "ext:/abs/path")
# Returns: path to prepared subtitle file or empty string on failure
_prepare_sub_from_source(){
  local src="$1"
  if [[ "$src" == embedded:* ]]; then
    _prepare_subtitle "${src#embedded:}"
  else
    _prepare_ext_subtitle "${src#ext:}"
  fi
}

# May hold .srt, .ass, .ssa, or .sup path; name is historical
SRT_FORCED=""
SRT_FULL=""
SRT_SDH=""
SRT_FORCED_BURN_PATH=""           # Set when SUB_BURN_FORCED=1; used by video pipeline
declare -a EXTERNAL_SRT_PATHS=()  # Paths of external SRT files exported alongside output
declare -i SRT_DIRECT_MAP=0
DIRECT_SUB_RELIDX=""

# Subtitle metadata for mux tagging (populated by build_subtitle_plan)
SRT_FORCED_LANG=""
SRT_FULL_LANG=""
SRT_SDH_LANG=""
SRT_FORCED_TITLE=""
SRT_FULL_TITLE=""
SRT_SDH_TITLE=""

# Audio metadata for mux tagging (populated by run_audio_pipeline)
A_PRIMARY_LANG=""
A_PRIMARY_TITLE=""
A_PRIMARY_CHANNELS=""
A_PRIMARY_CODEC=""
A_STEREO_LANG=""
A_STEREO_CODEC=""

# Process a prepared subtitle: either export as external file or embed.
# Sets _SUB_EMBED_PATH to the subtitle path if embedded, empty if exported externally.
# Args: $1 — subtitle file path (may be .srt, .ass, .ssa), $2 — label (full|sdh)
# Globals: SUB_EXPORT_EXTERNAL, OUT, OUTPUT_EXT, DRY_RUN, EXTERNAL_SRT_PATHS (modified)
_SUB_EMBED_PATH=""
_export_or_embed_sub(){
  local sub_path="$1" label="$2"
  _SUB_EMBED_PATH=""
  # Derive extension from the prepared subtitle file
  local sub_ext="${sub_path##*.}"
  if (( SUB_EXPORT_EXTERNAL )); then
    local ext_sub="${OUT%."${OUTPUT_EXT}"}.${label}.${sub_ext}"
    if (( ! DRY_RUN )); then
      if ! cp -f "$sub_path" "$ext_sub" 2>/dev/null; then
        warn "[Subs] Failed to export $label subtitle to $ext_sub — skipping."
        return 0
      fi
    fi
    EXTERNAL_SRT_PATHS+=("$ext_sub")
    note "[Subs] Exported $label → external $ext_sub"
    report_add "sub_${label}" "external ${sub_ext}"
  else
    _SUB_EMBED_PATH="$sub_path"
    note "[Subs] Prepared $label → $sub_path"
    report_add "sub_${label}" "embedded (${sub_ext})"
  fi
}

# _ext_sub_codec_from_ext — Map a subtitle file extension to an ffmpeg codec name.
# Args: $1 — file extension WITHOUT leading dot (case-insensitive)
# Stdout: codec name suitable for codec comparisons (e.g. "subrip", "ass", "webvtt")
_ext_sub_codec_from_ext(){
  case "${1,,}" in
    srt) echo "subrip"             ;;
    ass) echo "ass"                ;;
    ssa) echo "ssa"                ;;
    vtt) echo "webvtt"             ;;
    sup) echo "hdmv_pgs_subtitle"  ;;
    idx) echo "dvd_subtitle"       ;;
    *)   echo "unknown"            ;;
  esac
}

# _norm_lang_code — Normalize a 2-letter ISO 639-1 language code to its ISO 639-2/T equivalent.
# If the code is already 3 letters or not recognized, it is returned unchanged.
# Only covers the most common subtitle languages.
_norm_lang_code(){
  case "${1,,}" in
    en) echo "eng" ;; es) echo "spa" ;; fr) echo "fra" ;; de) echo "deu" ;;
    ja) echo "jpn" ;; ko) echo "kor" ;; zh) echo "zho" ;; it) echo "ita" ;;
    pt) echo "por" ;; ru) echo "rus" ;; ar) echo "ara" ;; nl) echo "nld" ;;
    pl) echo "pol" ;; sv) echo "swe" ;; da) echo "dan" ;; fi) echo "fin" ;;
    no) echo "nor" ;; tr) echo "tur" ;; cs) echo "ces" ;; hu) echo "hun" ;;
    ro) echo "ron" ;; el) echo "ell" ;; he) echo "heb" ;; vi) echo "vie" ;;
    th) echo "tha" ;; id) echo "ind" ;; uk) echo "ukr" ;; sk) echo "slk" ;;
    # ISO 639-2/B (bibliographic) → 639-2/T (terminological), so a `fre`-tagged stream
    # matches an `fra` preference. Only the /B variants of languages already mapped above.
    fre) echo "fra" ;; ger) echo "deu" ;; dut) echo "nld" ;; gre) echo "ell" ;;
    chi) echo "zho" ;; cze) echo "ces" ;; slo) echo "slk" ;; rum) echo "ron" ;;
    *) echo "${1,,}" ;;
  esac
}

# _parse_ext_sub_filename — Extract language code and type from a subtitle sidecar filename.
#
# Filename convention: {stem}[.qualifier...].ext
# Qualifiers are the dot-separated segments between the source stem and the extension.
# Segment classification (case-insensitive):
#   forced|signs|foreign  → type = forced
#   sdh|hearing|cc        → type = sdh
#   2-3 letter alpha      → language code (first match wins)
#   hi                    → language (Hindi) when it fills the empty language slot, else type=sdh (CR-13)
#   anything else         → ignored
#
# Examples:
#   movie.srt             → lang=TAG_LANGUAGE_DEFAULT, type=full
#   movie.en.srt          → lang=en,  type=full
#   movie.forced.en.srt   → lang=en,  type=forced
#   movie.en.sdh.srt      → lang=en,  type=sdh
#   movie.hi.srt          → lang=hi,  type=full   (Hindi, not SDH — CR-13)
#   movie.eng.hi.srt      → lang=eng, type=sdh    (language already set → hi = SDH marker)
#
# Args:    $1 — source file stem (basename without extension, may contain dots)
#          $2 — subtitle filename (basename with extension)
# Stdout:  lang TAB type
_parse_ext_sub_filename(){
  local stem="$1" fname="$2"
  # Strip the last extension to get the bare name (e.g. "movie.forced.en.srt" → "movie.forced.en")
  local bare="${fname%.*}"
  # Remove the source stem prefix, then strip any leading dot
  local suffix="${bare#"$stem"}"
  suffix="${suffix#.}"

  if [[ -z "$suffix" ]]; then
    # No qualifiers: base match only (e.g. "movie.srt")
    printf '%s\t%s\n' "$TAG_LANGUAGE_DEFAULT" "full"
    return 0
  fi

  local lang="" stype="full"
  local seg
  # Iterate dot-delimited segments; append trailing dot so the last segment is read
  while IFS= read -r -d '.' seg; do
    [[ -z "$seg" ]] && continue
    seg="${seg,,}"
    case "$seg" in
      forced|signs|foreign) stype="forced" ;;
      sdh|hearing|cc)       stype="sdh"    ;;
      *)
        # Accept the first 2-3 letter purely alphabetic segment as language code.
        # Normalize 2-letter ISO 639-1 codes to 3-letter ISO 639-2/T codes.
        # CR-13: `hi` is ambiguous — both the SDH (hearing-impaired) keyword AND ISO-639-1 for
        # Hindi. Classify as LANGUAGE first when it fills the still-empty language slot
        # (`movie.hi.srt` → lang=hi/full); only treat it as the SDH marker once a language is
        # already set (`movie.eng.hi.srt` → sdh). Explicit `sdh`/`hearing`/`cc` is unaffected (above).
        if [[ -z "$lang" ]] && [[ "$seg" =~ ^[a-z]{2,3}$ ]]; then
          lang="$(_norm_lang_code "$seg")"
        elif [[ "$seg" == "hi" ]]; then
          stype="sdh"
        fi
        ;;
    esac
  done < <(printf '%s.' "$suffix")

  [[ -z "$lang" ]] && lang="$TAG_LANGUAGE_DEFAULT"
  printf '%s\t%s\n' "$lang" "$stype"
}

# discover_external_subtitles — Scan for sidecar subtitle files alongside the source.
#
# Searches EXT_SUB_DIR (default: directory of SRC_ABS) for files whose basename
# starts with the source stem followed by a dot and ends with a subtitle extension.
# Supported extensions: .srt .ass .ssa .vtt .sup .idx (.idx requires partner .sub)
#
# Skipped when SKIP_SUBS=1 or EXT_SUB_ENABLED=0.
#
# Sets: EXT_SUB_PATHS[], EXT_SUB_LANGS[], EXT_SUB_TYPES[], EXT_SUB_CODECS[]
# Globals: SRC_ABS (read), EXT_SUB_ENABLED (read), EXT_SUB_DIR (read),
#          TAG_LANGUAGE_DEFAULT (read), SKIP_SUBS (read)
discover_external_subtitles(){
  EXT_SUB_PATHS=()
  EXT_SUB_LANGS=()
  EXT_SUB_TYPES=()
  EXT_SUB_CODECS=()

  if (( SKIP_SUBS )) || (( ! EXT_SUB_ENABLED )); then
    return 0
  fi

  local search_dir
  if [[ -n "${EXT_SUB_DIR:-}" ]]; then
    search_dir="$EXT_SUB_DIR"
  else
    search_dir="$(dirname -- "$SRC_ABS")"
  fi

  if [[ ! -d "$search_dir" ]]; then
    warn "[Subs] External subtitle search directory not found: $search_dir"
    return 0
  fi

  local src_stem
  src_stem="$(basename -- "${SRC_ABS%.*}")"

  # CR-4: src_stem is interpolated into a `find -name` glob below, so any glob metacharacter in the
  # source name (`* ? [`) is matched as a wildcard, not literally — extremely common in anime naming
  # like `[Group] Show - 01 [1080p].mkv` (the very files the animation profiles target). `[1080p]`
  # then becomes a one-char class, so the real sidecar is MISSED and an unrelated `… 1.srt` decoy can
  # over-match. Backslash-escape the fnmatch specials (backslash FIRST, so it can't double-escape the
  # others) to match the stem literally; the structural `.*.` wildcard built below stays intact.
  local src_stem_glob="$src_stem"
  src_stem_glob="${src_stem_glob//\\/\\\\}"   # \ → \\  (must be first)
  src_stem_glob="${src_stem_glob//\*/\\*}"    # * → \*
  src_stem_glob="${src_stem_glob//\?/\\?}"    # ? → \?
  src_stem_glob="${src_stem_glob//\[/\\[}"    # [ → \[  (neutralizes the whole class; ] needs no escape)

  # Process each supported extension in priority order
  local -a sub_exts=( srt ass ssa vtt sup idx )
  local ext fpath fname parsed lang stype codec

  # H3: sort the null-delimited find output portably. `sort -z` is GNU-only; stock-macOS BSD
  # `sort` (older Darwin) has no -z, where the old unconditional `sort -z` failed inside the
  # process substitution and — masked by `set -e` not crossing the `<( )` boundary — yielded
  # EMPTY output, silently dropping every sidecar. Probe once (mirrors _sed_inplace's GNU/BSD
  # detection) and fall back to `cat` (find's single-dir order is adequate for sidecar matching).
  # Both branches keep nulls intact, so the control-char guard / `read -d ''` stay newline-safe.
  local -a _sub_sort
  if printf '' | sort -z >/dev/null 2>&1; then
    _sub_sort=( sort -z )
  else
    _sub_sort=( cat )
  fi

  for ext in "${sub_exts[@]}"; do
    while IFS= read -r -d '' fpath; do
      [[ -z "$fpath" || ! -f "$fpath" ]] && continue

      # Reject sidecar paths containing control characters, mirroring the SRC_ABS/OUT guards (L2):
      # a newline/tab/etc. in the name could corrupt a log or report line downstream. Warn (with the
      # control bytes rendered as '?' so the warning itself stays clean) and skip — never mux it.
      if [[ "$fpath" =~ [[:cntrl:]] ]]; then
        warn "[Subs] Skipping external subtitle with control characters in its path: ${fpath//[[:cntrl:]]/?}"
        continue
      fi

      # .idx requires a partner .sub file to form a valid VobSub pair
      if [[ "$ext" == "idx" ]]; then
        [[ -f "${fpath%.idx}.sub" ]] || continue
      fi

      fname="$(basename -- "$fpath")"
      parsed="$(_parse_ext_sub_filename "$src_stem" "$fname")"
      _split_tab "$parsed" lang stype  # C2: non-collapsing (producer always emits both fields, but keep the pattern uniform)
      codec="$(_ext_sub_codec_from_ext "$ext")"

      EXT_SUB_PATHS+=("$fpath")
      EXT_SUB_LANGS+=("$lang")
      EXT_SUB_TYPES+=("$stype")
      EXT_SUB_CODECS+=("$codec")

      note "[Subs] External subtitle found: $fname [$lang] ($stype)"
    done < <(find "$search_dir" -maxdepth 1 -type f \
      \( -name "${src_stem_glob}.${ext}" -o -name "${src_stem_glob}.*.${ext}" \) \
      -print0 2>/dev/null | LC_ALL=C "${_sub_sort[@]}")
  done

  local n="${#EXT_SUB_PATHS[@]}"
  if (( n > 0 )); then
    note "[Subs] ${n} external subtitle file(s) discovered alongside source"
    report_add "ext_subs_found" "$n"
  fi
}

# merge_subtitle_sources — Build unified subtitle stream list from embedded + external.
#
# Combines all embedded subtitle streams (from cached ffprobe metadata) with all
# discovered external subtitle files into ALL_SUB_SOURCES[], ALL_SUB_LANGS[],
# ALL_SUB_TYPES[], ALL_SUB_CODECS[], and ALL_SUB_TITLES[].
#
# Source format: "embedded:N" for embedded stream index N, "ext:/abs/path" for files.
# All subtitle filtering and planning functions iterate this unified list.
#
# Sets: ALL_SUB_SOURCES[], ALL_SUB_LANGS[], ALL_SUB_TYPES[], ALL_SUB_CODECS[], ALL_SUB_TITLES[]
# Globals: METADATA_CACHE (read), EXT_SUB_PATHS[] (read), TAG_LANGUAGE_DEFAULT (read)
merge_subtitle_sources(){
  ALL_SUB_SOURCES=()
  ALL_SUB_LANGS=()
  ALL_SUB_TYPES=()
  ALL_SUB_CODECS=()
  ALL_SUB_TITLES=()

  # Add embedded subtitle streams first
  local n
  n="$(_sub_count)"
  local i
  for (( i=0; i<n; i++ )); do
    local info codec lang title forced hi stype
    info="$(_sub_stream_info "$i")"
    _split_tab "$info" codec lang title forced hi  # C2: non-collapsing — empty lang/title must not shift forced/hi (sub classification)
    _normalize_codec_lang codec lang

    # F3: classify SDH by the hearing_impaired disposition OR an SDH/HI title — a track tagged
    # hearing_impaired but titled plainly ("English") was previously mis-classified "full".
    if (( forced )) || _is_forced_title "$title"; then
      stype="forced"
    elif (( hi )) || _is_sdh_title "$title"; then
      stype="sdh"
    else
      stype="full"
    fi

    ALL_SUB_SOURCES+=("embedded:$i")
    ALL_SUB_LANGS+=("$lang")
    ALL_SUB_TYPES+=("$stype")
    ALL_SUB_CODECS+=("$codec")
    ALL_SUB_TITLES+=("${title:-}")
  done

  # Append external subtitle files, de-duplicating by normalized language + type against BOTH:
  #   - embedded streams (M3): a `movie.en.srt` next to an embedded `eng` track is skipped; and
  #   - externals already kept this pass (L3): two sidecars that normalize to the same (lang, type)
  #     — e.g. `movie.en.srt` + `movie.eng.srt` — must not both survive into a multi-track output
  #     (single-track mode already takes first-match-wins, but multi-track keeps every passing
  #     track, so without this the duplicate ships, capped only by SUB_MAX_TRACKS).
  # `n` is the embedded count; the externals are appended after those first `n` entries.
  local j _ext_kept=0 _ext_deduped=0
  local _ext_seen=" "   # L3: space-padded set of already-kept external "lang_n:type" pairs
  for (( j=0; j<${#EXT_SUB_PATHS[@]}; j++ )); do
    local _xlang="${EXT_SUB_LANGS[$j]}" _xtype="${EXT_SUB_TYPES[$j]}"
    local _xlang_n; _xlang_n="$(_norm_lang_code "$_xlang")"
    local _dup=0 _dup_src="" k
    for (( k=0; k<n; k++ )); do
      if [[ "$(_norm_lang_code "${ALL_SUB_LANGS[$k]}")" == "$_xlang_n" \
            && "${ALL_SUB_TYPES[$k]}" == "$_xtype" ]]; then
        # RF6: an embedded match only suppresses an external sidecar if the embedded track is
        # actually DELIVERABLE in the target container. An undeliverable embedded bitmap (non-MKV
        # output, OCR off) can't produce a track, so it must NOT dedup away a usable text sidecar —
        # otherwise the bitmap is dropped at mux and the sidecar is already gone (silent loss).
        _sub_candidate_undeliverable "${ALL_SUB_CODECS[$k]}" && continue
        _dup=1; _dup_src="embedded"; break
      fi
    done
    local _xkey="${_xlang_n}:${_xtype}"
    if (( ! _dup )) && [[ "$_ext_seen" == *" ${_xkey} "* ]]; then
      _dup=1; _dup_src="external"   # L3: collides with an earlier sidecar, not an embedded track
    fi
    if (( _dup )); then
      note "[Subs] Skipping external $(basename -- "${EXT_SUB_PATHS[$j]}") — a matching ${_xlang_n} ${_xtype} subtitle (${_dup_src}) is already present."
      _ext_deduped=$(( _ext_deduped + 1 ))
      continue
    fi
    _ext_seen+="${_xkey} "
    ALL_SUB_SOURCES+=("ext:${EXT_SUB_PATHS[$j]}")
    ALL_SUB_LANGS+=("$_xlang")
    ALL_SUB_TYPES+=("$_xtype")
    ALL_SUB_CODECS+=("${EXT_SUB_CODECS[$j]}")
    ALL_SUB_TITLES+=("")
    _ext_kept=$(( _ext_kept + 1 ))
  done

  local total="${#ALL_SUB_SOURCES[@]}"
  if (( ${#EXT_SUB_PATHS[@]} > 0 )); then
    if (( _ext_deduped > 0 )); then
      note "[Subs] Unified subtitle list: $n embedded + ${_ext_kept} external (${_ext_deduped} duplicate sidecar(s) skipped) = $total source(s)"
    else
      note "[Subs] Unified subtitle list: $n embedded + ${_ext_kept} external = $total source(s)"
    fi
  fi
}

# _build_subtitle_keep_list — Subtractive filter for multi-track subtitle mode.
#
# Iterates ALL_SUB_SOURCES[] (unified embedded + external list) and applies filters:
#   1. SUB_LANG_PREF (if non-empty) — only keep tracks whose language matches
#   2. Type classification (forced/SDH/full) against SUB_INCLUDE_* flags
#   3. Container compatibility — bitmap subs in non-MKV containers are skipped
#
# Unlike build_subtitle_plan (which picks ONE of each type), this keeps ALL
# tracks that pass the filters. No scoring, no ranking — just pass/fail.
# The result is capped by SUB_MAX_TRACKS.
#
# Output: space-separated list of 0-based ALL_SUB_SOURCES[] indices on stdout.
#         Empty string if no tracks survive the filter.
# Globals: ALL_SUB_SOURCES[] (read), ALL_SUB_LANGS[] (read), ALL_SUB_TYPES[] (read),
#          ALL_SUB_CODECS[] (read), SUB_LANG_PREF (read), SUB_INCLUDE_FORCED (read),
#          SUB_INCLUDE_FULL (read), SUB_INCLUDE_SDH (read), SUB_MAX_TRACKS (read),
#          MUX_FORMAT (read), OUTPUT_EXT (read)
_build_subtitle_keep_list(){
  local n="${#ALL_SUB_SOURCES[@]}"
  (( n > 0 )) || { echo ""; return 0; }

  local -a kept=()
  local -a dropped_reasons=()

  local i
  for (( i=0; i<n; i++ )); do
    local src="${ALL_SUB_SOURCES[$i]}"
    local codec="${ALL_SUB_CODECS[$i]}"
    local lang="${ALL_SUB_LANGS[$i]}"
    local stype="${ALL_SUB_TYPES[$i]}"

    # Human-readable source label for diagnostic messages
    local src_label
    src_label="$(_source_label "$src")"

    # Filter 1: language (normalized both sides — H2)
    if [[ -n "${SUB_LANG_PREF:-}" ]]; then
      if ! _sub_lang_matches "$lang"; then
        dropped_reasons+=("$src_label: ${codec} [$lang] — language not in SUB_LANG_PREF")
        continue
      fi
    fi

    # Filter 2: type inclusion flags
    case "$stype" in
      forced) if (( ! SUB_INCLUDE_FORCED )); then
                dropped_reasons+=("$src_label: ${codec} [$lang] — forced tracks excluded (SUB_INCLUDE_FORCED=0)")
                continue
              fi ;;
      sdh)    if (( ! SUB_INCLUDE_SDH )); then
                dropped_reasons+=("$src_label: ${codec} [$lang] — SDH tracks excluded (SUB_INCLUDE_SDH=0)")
                continue
              fi ;;
      full)   if (( ! SUB_INCLUDE_FULL )); then
                dropped_reasons+=("$src_label: ${codec} [$lang] — full tracks excluded (SUB_INCLUDE_FULL=0)")
                continue
              fi ;;
    esac

    # Filter 3: container compatibility — bitmap subs can't go into MP4/MOV
    if [[ "$MUX_FORMAT" != "matroska" ]] && ! _is_text_sub_codec "$codec"; then
      if (( SUB_ENABLE_OCR )); then
        dropped_reasons+=("$src_label: ${codec} [$lang] — bitmap subtitle dropped — OCR is not performed in multi-track mode; use single-track (default) to OCR into MP4.")
      else
        dropped_reasons+=("$src_label: ${codec} [$lang] — bitmap subtitle incompatible with ${OUTPUT_EXT} container")
      fi
      continue
    fi

    kept+=("$i")
  done

  _log_dropped_tracks "multi-track subs" dropped_reasons

  # Apply SUB_MAX_TRACKS cap
  if (( ${#kept[@]} > SUB_MAX_TRACKS )); then
    log "  [multi-track subs] Capping from ${#kept[@]} to $SUB_MAX_TRACKS tracks (SUB_MAX_TRACKS)"
    kept=("${kept[@]:0:$SUB_MAX_TRACKS}")
  fi

  echo "${kept[*]}"
}

# run_subtitle_pipeline_multi — Multi-track subtitles: filter and defer to mux_final.
#
# Called instead of the single-track pipeline when SUB_MULTI_TRACK=1.
# Iterates ALL_SUB_SOURCES[] (unified embedded + external list), applies
# _build_subtitle_keep_list() filters, and populates SUB_MT_SOURCES[] and
# related arrays that mux_final uses to map subtitle streams from source or
# external files.
#
# Embedded streams are copied directly from source (-c:s copy).
# External text subs are added as separate ffmpeg inputs in mux_final.
#
# Sets: SUB_COPY_FROM_SOURCE, SUB_MT_SOURCES[], SUB_MT_INDICES[],
#       SUB_MT_CODECS[], SUB_MT_LANGS[], SUB_MT_TITLES[], SUB_MT_TYPES[],
#       SRT_FORCED (cleared), SRT_FULL (cleared), SRT_SDH (cleared),
#       SRT_DIRECT_MAP (cleared), DIRECT_SUB_RELIDX (cleared)
# Globals: ALL_SUB_SOURCES[] (read), METADATA_CACHE (read)
run_subtitle_pipeline_multi(){
  local keep_list
  keep_list="$(_build_subtitle_keep_list)"

  if [[ -z "$keep_list" ]]; then
    note "[Subs] Multi-track filter: no subtitle tracks survived filtering."
    SUB_COPY_FROM_SOURCE=0
    return 0
  fi

  # D6: --no-sub-preserve-bitmap requests OCR of bitmap (PGS/VobSub) subs to text, but
  # multi-track subtitle mode stream-copies every kept track and never OCRs (documented).
  # Announce that the OCR request is inert here rather than silently ignoring it (says ==
  # does). Container is MKV-gated (bitmap subs only survive into Matroska) and only fires on
  # an explicit --no-sub-preserve-bitmap (no profile sets SUB_PRESERVE_BITMAP=0). Known limit:
  # the skip-if-ideal copy path (_build_subtitle_keep_list at the skip check) does not warn.
  if (( ! SUB_PRESERVE_BITMAP )) && [[ "$MUX_FORMAT" == "matroska" ]]; then
    warn "[Subs] --no-sub-preserve-bitmap requests OCR, but multi-track subtitle mode does not OCR — any PGS/VobSub tracks are stream-copied as-is. Use single-track mode (the default) to OCR bitmap subs to text."
  fi

  # Reset single-track vars (not used in multi-track mode)
  SRT_FORCED=""
  SRT_FULL=""
  SRT_SDH=""
  SRT_FORCED_BURN_PATH=""
  SRT_DIRECT_MAP=0
  DIRECT_SUB_RELIDX=""

  # Populate parallel metadata arrays from the unified ALL_SUB_SOURCES[] list
  SUB_MT_INDICES=()
  SUB_MT_SOURCES=()
  SUB_MT_CODECS=()
  SUB_MT_LANGS=()
  SUB_MT_TITLES=()
  SUB_MT_TYPES=()

  # Subs_Fix Phase 4: also populate the unified SUB_TRACKS_* model so mux_final can
  # render every kept track through the shared _emit_sub_tracks emitter. The legacy
  # SUB_MT_* arrays are retained for the multi-track log/report summaries below.
  _sub_tracks_reset

  local uidx
  for uidx in $keep_list; do
    local src="${ALL_SUB_SOURCES[$uidx]}"
    local codec="${ALL_SUB_CODECS[$uidx]}"
    local lang="${ALL_SUB_LANGS[$uidx]}"
    local stype="${ALL_SUB_TYPES[$uidx]}"
    local title="${ALL_SUB_TITLES[$uidx]}"

    SUB_MT_SOURCES+=("$src")
    # SUB_MT_INDICES: embedded stream index for mux_final mapping; -1 for external files
    if [[ "$src" == embedded:* ]]; then
      SUB_MT_INDICES+=("${src#embedded:}")
    else
      SUB_MT_INDICES+=(-1)
    fi
    SUB_MT_CODECS+=("$codec")
    SUB_MT_LANGS+=("$lang")
    SUB_MT_TITLES+=("$title")
    SUB_MT_TYPES+=("$stype")

    # Mirror into the unified model. KIND/VALUE: embedded:N → map from source;
    # ext:/path → file input. CODEC is the source-stream codec (the effective codec,
    # since multi-track stream-copies). DISPOSITION derives from type. Multi-track
    # never burns or exports, so ROUTING is always embed.
    local _kind _value _disp
    if [[ "$src" == embedded:* ]]; then
      _kind=embedded; _value="${src#embedded:}"
    else
      _kind=file;     _value="${src#ext:}"
    fi
    case "$stype" in
      forced) _disp=forced ;;
      sdh)    _disp=hearing_impaired ;;
      *)      _disp=0 ;;
    esac
    _sub_track_add "$_kind" "$_value" "$lang" "$title" "$stype" "$codec" "$_disp" embed
  done

  SUB_COPY_FROM_SOURCE=1

  # Log summary: show all unified sources with ✓/✗ markers
  local n_total n_kept n_dropped
  n_total="${#ALL_SUB_SOURCES[@]}"
  n_kept="${#SUB_MT_SOURCES[@]}"
  n_dropped=$(( n_total - n_kept ))

  say "→ Scanning subtitle streams (multi-track mode):"
  local i
  for (( i=0; i<n_total; i++ )); do
    local _src="${ALL_SUB_SOURCES[$i]}"
    local _c="${ALL_SUB_CODECS[$i]}"
    local _l="${ALL_SUB_LANGS[$i]}"
    local _t="${ALL_SUB_TITLES[$i]}"
    local _stype="${ALL_SUB_TYPES[$i]}"
    local pretty

    if [[ "$_src" == embedded:* ]]; then
      pretty="#${_src#embedded:}: ${_c} [${_l}]"
    else
      pretty="$(basename -- "${_src#ext:}"): ${_c} [${_l}]"
    fi
    [[ -n "$_t" ]]              && pretty="$pretty — $_t"
    [[ "$_stype" == "forced" ]] && pretty="$pretty (forced)"
    [[ "$_stype" == "sdh"    ]] && pretty="$pretty [SDH]"

    # Check if this unified index survived the filter
    local _is_kept=0
    local _k
    for _k in $keep_list; do
      (( _k == i )) && { _is_kept=1; break; }
    done

    if (( _is_kept )); then
      say "  $pretty ✓"
    else
      say "  $pretty ✗"
    fi
  done

  note "[Subs] Multi-track: keeping ${n_kept} of ${n_total} tracks (${n_dropped} filtered out)"
  report_add "sub_mode" "multi-track"
  report_add "sub_multi_track_kept" "$n_kept"
  report_add "sub_multi_track_dropped" "$n_dropped"

  # Report kept tracks
  local track_summary=""
  for (( i=0; i<n_kept; i++ )); do
    local _src="${SUB_MT_SOURCES[$i]}"
    local _codec="${SUB_MT_CODECS[$i]}"
    local _lang="${SUB_MT_LANGS[$i]}"
    local _stype="${SUB_MT_TYPES[$i]}"
    local _label
    if [[ "$_src" == embedded:* ]]; then
      _label="#${_src#embedded:}"
    else
      _label="$(basename -- "${_src#ext:}")"
    fi
    track_summary+="${_label}: ${_codec} [${_lang}] (${_stype})"
    (( i < n_kept - 1 )) && track_summary+=", "
  done
  report_add "sub_kept_tracks" "$track_summary"

  # Note when ASS/SSA tracks will be converted (SUB_PRESERVE_TEXT_FORMAT=0)
  if (( ! SUB_PRESERVE_TEXT_FORMAT )); then
    local _ass_convert_count=0
    for (( i=0; i<n_kept; i++ )); do
      case "${SUB_MT_CODECS[$i]}" in
        ass|ssa) _ass_convert_count=$(( _ass_convert_count + 1 )) ;;
      esac
    done
    if (( _ass_convert_count > 0 )); then
      note "[Subs] Multi-track: ${_ass_convert_count} ASS/SSA track(s) will be converted to SRT (native-format preservation is off)."
      report_add "sub_ass_convert" "$_ass_convert_count"
    fi
  fi

  mark_done "Subtitle filter plan (multi-track, ${n_kept} tracks)"
}

# build_subtitle_plan — Scan, categorize, and prepare subtitle tracks.
#
# Iterates ALL_SUB_SOURCES[] (unified embedded + external list), selects the
# best candidates (up to SUB_MAX_TRACKS), and prepares them via extraction,
# conversion, OCR, or pass-through. Embedded streams use _prepare_subtitle();
# external files use _prepare_ext_subtitle() via _prepare_sub_from_source().
#
# Routes forced subtitles to either the burn-in path (SRT_FORCED_BURN_PATH) or
# embed path (SRT_FORCED) based on SUB_BURN_FORCED. Non-forced subtitles are
# either embedded or exported as external files based on SUB_EXPORT_EXTERNAL.
#
# Falls back to direct-mapping a TEXT subtitle from the embedded stream list
# if no prepared subtitles were produced and at least one SUB_INCLUDE_* flag
# is enabled (embedded-only fallback — external files are handled in main loop).
#
# Sets: SRT_FORCED, SRT_FULL, SRT_SDH, SRT_FORCED_BURN_PATH, SRT_DIRECT_MAP,
#       DIRECT_SUB_RELIDX, EXTERNAL_SRT_PATHS[], and associated *_LANG/*_TITLE vars
# Globals: ALL_SUB_SOURCES[] (read), SUB_* config vars (read)
# _sub_plan_add_embed SRC SUB_PATH LANG TITLE TYPE SRCCODEC — record one
# single-track-selected subtitle (embed routing) into the unified SUB_TRACKS_*
# model. THE DESYNC FIX lives in the embedded branch: a preserved PGS bitmap (a
# .sup produced from an embedded source) is recorded as embedded:N so the emitter
# maps it straight from the source (-map $src:s:N) instead of re-importing the
# standalone .sup elementary stream (which ffmpeg rebases to t=0 without -copyts).
# Everything else — OCR'd / format-converted / native-extracted workdir files and
# external sidecars — is a file: input. CODEC carries the EFFECTIVE codec the
# emitter keys its one codec rule on: the source stream codec for the embedded
# (PGS) branch, the prepared file's extension for the file branch.
#
# NOTE: for a preserved PGS the .sup is still extracted by _prepare_subtitle and
# left orphaned in the workdir (cleaned up on exit). Only the ffmpeg COMMAND
# changes (no -i .sup), so this stays a pure command-shape cutover with no new
# logic in the extraction path. It can later be optimized to skip the extraction
# entirely via a shared _sub_is_preserved_pgs predicate.
_sub_plan_add_embed(){
  local src="$1" sub_path="$2" lang="$3" title="$4" stype="$5" srccodec="$6"
  local disp
  case "$stype" in
    forced) disp=forced ;;
    sdh)    disp=hearing_impaired ;;
    *)      disp=0 ;;
  esac
  if [[ "$src" == embedded:* && "$sub_path" == *.sup ]]; then
    _sub_track_add embedded "${src#embedded:}" "$lang" "$title" "$stype" "${srccodec,,}" "$disp" embed
  else
    local ext="${sub_path##*.}"; ext="${ext,,}"
    _sub_track_add file "$sub_path" "$lang" "$title" "$stype" "$ext" "$disp" embed
  fi
}

build_subtitle_plan(){
  # Subs_Fix Phase 5: reset the unified model up front so it covers the single-track
  # path, the multi-track delegate (harmless double-reset), AND the early returns
  # below — otherwise a prior file's tracks could leak into a SKIP_SUBS/no-subs file.
  _sub_tracks_reset

  if (( SKIP_SUBS )); then
    SRT_FORCED=""; SRT_FULL=""; SRT_SDH=""
    SRT_DIRECT_MAP=0; DIRECT_SUB_RELIDX=""
    return 0
  fi

  # No subtitle sources at all (neither embedded nor external)
  if (( ${#ALL_SUB_SOURCES[@]} == 0 )); then
    note "[Subs] No subtitle streams detected."
    SRT_DIRECT_MAP=0
    return 0
  fi

  # ---- Multi-track mode: filter and defer to mux_final ----
  # When SUB_MULTI_TRACK=1, skip single-track selection entirely.
  # Demote to single-track if the user set overrides that are incompatible.
  if (( SUB_MULTI_TRACK )); then
    if (( SUB_BURN_FORCED )); then
      # Phase 5: warn (not note) — the user's multi-track request is being silently overridden by
      # --sub-burn-forced. NOTE: no `return` here on purpose — this case INTENTIONALLY falls through
      # to the single-track selection below (that IS the demotion). A return would skip it entirely.
      warn "[Subs] --sub-burn-forced overrides multi-track: keeping a single subtitle track (multi-track mode off)."
    elif (( SUB_EXPORT_EXTERNAL )); then
      note "[Subs] Multi-track mode: --sub-export-external ignored (all subs embedded via stream-copy)."
      run_subtitle_pipeline_multi
      return $?
    else
      run_subtitle_pipeline_multi
      return $?
    fi
  fi

  # ---- Single-track mode: scan unified list, select one per type, prepare ----

  say "→ Scanning subtitle streams:"
  local i
  for (( i=0; i<${#ALL_SUB_SOURCES[@]}; i++ )); do
    local _src="${ALL_SUB_SOURCES[$i]}"
    local _c="${ALL_SUB_CODECS[$i]}"
    local _l="${ALL_SUB_LANGS[$i]}"
    local _t="${ALL_SUB_TITLES[$i]}"
    local _stype="${ALL_SUB_TYPES[$i]}"
    if [[ "$_src" == embedded:* ]]; then
      say "  #${_src#embedded:}: ${_c} [${_l}]${_t:+ — $_t} (${_stype})"
    else
      say "  $(basename -- "${_src#ext:}"): ${_c} [${_l}] (${_stype})"
    fi
  done

  local forced_uidx="" full_uidx="" sdh_uidx=""

  # Find best candidates from unified list (first match per type wins)
  for (( i=0; i<${#ALL_SUB_SOURCES[@]}; i++ )); do
    local lang="${ALL_SUB_LANGS[$i]}"
    local stype="${ALL_SUB_TYPES[$i]}"

    # Language filter (normalized both sides — H2)
    if [[ -n "${SUB_LANG_PREF:-}" ]]; then
      _sub_lang_matches "$lang" || continue
    fi

    # RF6: skip a candidate that can't be delivered as a single track in this container — a bitmap
    # subtitle with a non-MKV output and OCR disabled. Skipping it lets selection fall through to a
    # container-usable same-type candidate (e.g. a text `.srt` sidecar, kept by the codec-aware
    # dedup above) instead of choosing a bitmap that fails to prepare and silently drops the track.
    # (Mirrors _build_subtitle_keep_list's Filter 3 on the multi-track path.)
    if _sub_candidate_undeliverable "${ALL_SUB_CODECS[$i]}"; then
      continue
    fi

    case "$stype" in
      forced)
        if (( SUB_INCLUDE_FORCED )) && [[ -z "$forced_uidx" ]]; then
          forced_uidx="$i"
        fi
        ;;
      sdh)
        if (( SUB_INCLUDE_SDH )) && [[ -z "$sdh_uidx" ]]; then
          sdh_uidx="$i"
        fi
        ;;
      full)
        if (( SUB_INCLUDE_FULL )) && [[ -z "$full_uidx" ]]; then
          full_uidx="$i"
        fi
        ;;
    esac
  done

  # Sole-external-sub fallback: if the language filter produced no candidates but there is
  # exactly one external sidecar subtitle and zero embedded subtitle streams, include that
  # subtitle regardless of its language tag. This handles the common case of a sidecar file
  # with no language qualifier in its filename (tagged 'und' by default) that would otherwise
  # be silently dropped by SUB_LANG_PREF. Disable with --no-sub-sole-ext-fallback.
  if [[ -z "$forced_uidx" && -z "$full_uidx" && -z "$sdh_uidx" ]] \
     && (( SUB_SOLE_EXT_FALLBACK )) \
     && (( SUB_INCLUDE_FORCED || SUB_INCLUDE_FULL || SUB_INCLUDE_SDH )); then
    local _emb_count=0 _ext_count=0 _sole_ext_uidx=""
    local _j
    for (( _j=0; _j<${#ALL_SUB_SOURCES[@]}; _j++ )); do
      if [[ "${ALL_SUB_SOURCES[$_j]}" == embedded:* ]]; then
        _emb_count=$(( _emb_count + 1 ))
      else
        _ext_count=$(( _ext_count + 1 ))
        _sole_ext_uidx="$_j"
      fi
    done
    if (( _emb_count == 0 && _ext_count == 1 )); then
      local _sole_stype="${ALL_SUB_TYPES[$_sole_ext_uidx]}"
      local _sole_lang="${ALL_SUB_LANGS[$_sole_ext_uidx]}"
      local _sole_name; _sole_name="$(basename -- "${ALL_SUB_SOURCES[$_sole_ext_uidx]#ext:}")"
      note "[Subs] Sole-external fallback: 1 sidecar, 0 embedded — including $_sole_name [$_sole_lang] (language filter bypassed)."
      case "$_sole_stype" in
        forced) (( SUB_INCLUDE_FORCED )) && forced_uidx="$_sole_ext_uidx" ;;
        sdh)    (( SUB_INCLUDE_SDH    )) && sdh_uidx="$_sole_ext_uidx"    ;;
        full)   (( SUB_INCLUDE_FULL   )) && full_uidx="$_sole_ext_uidx"   ;;
      esac
    fi
  fi

  # Prepare selected subtitles (up to SUB_MAX_TRACKS)
  local sub_path pick_count=0
  if [[ -n "$forced_uidx" ]]; then
    sub_path="$(_prepare_sub_from_source "${ALL_SUB_SOURCES[$forced_uidx]}")"
    if [[ -z "$sub_path" ]]; then
      : # preparation failed; skip silently
    elif (( SUB_BURN_FORCED )); then
      # Route forced sub to burn path (video pipeline will handle it)
      SRT_FORCED_LANG="${ALL_SUB_LANGS[$forced_uidx]}"
      SRT_FORCED_TITLE="Forced"
      SRT_FORCED_BURN_PATH="$sub_path"
      note "[Subs] Prepared Forced for burn-in → $SRT_FORCED_BURN_PATH"
      report_add "sub_forced" "burn-in"
    else
      SRT_FORCED_LANG="${ALL_SUB_LANGS[$forced_uidx]}"
      SRT_FORCED_TITLE="Forced"
      SRT_FORCED="$sub_path"
      _sub_plan_add_embed "${ALL_SUB_SOURCES[$forced_uidx]}" "$sub_path" "$SRT_FORCED_LANG" "$SRT_FORCED_TITLE" forced "${ALL_SUB_CODECS[$forced_uidx]}"
      pick_count=$(( pick_count + 1 ))
      note "[Subs] Prepared Forced → $SRT_FORCED"
      report_add "sub_forced" "embedded"
    fi
  fi
  if [[ -n "$full_uidx" && $pick_count -lt $SUB_MAX_TRACKS ]]; then
    sub_path="$(_prepare_sub_from_source "${ALL_SUB_SOURCES[$full_uidx]}")"
    if [[ -n "$sub_path" ]]; then
      SRT_FULL_LANG="${ALL_SUB_LANGS[$full_uidx]}"
      SRT_FULL_TITLE="${ALL_SUB_TITLES[$full_uidx]:-Full}"
      _export_or_embed_sub "$sub_path" "full"
      if [[ -n "$_SUB_EMBED_PATH" ]]; then
        SRT_FULL="$_SUB_EMBED_PATH"
        _sub_plan_add_embed "${ALL_SUB_SOURCES[$full_uidx]}" "$_SUB_EMBED_PATH" "$SRT_FULL_LANG" "$SRT_FULL_TITLE" full "${ALL_SUB_CODECS[$full_uidx]}"
        pick_count=$(( pick_count + 1 ))
      fi
    fi
  fi
  if [[ -n "$sdh_uidx" && $pick_count -lt $SUB_MAX_TRACKS ]]; then
    sub_path="$(_prepare_sub_from_source "${ALL_SUB_SOURCES[$sdh_uidx]}")"
    if [[ -n "$sub_path" ]]; then
      SRT_SDH_LANG="${ALL_SUB_LANGS[$sdh_uidx]}"
      SRT_SDH_TITLE="SDH"
      _export_or_embed_sub "$sub_path" "sdh"
      if [[ -n "$_SUB_EMBED_PATH" ]]; then
        SRT_SDH="$_SUB_EMBED_PATH"
        _sub_plan_add_embed "${ALL_SUB_SOURCES[$sdh_uidx]}" "$_SUB_EMBED_PATH" "$SRT_SDH_LANG" "$SRT_SDH_TITLE" sdh "${ALL_SUB_CODECS[$sdh_uidx]}"
        pick_count=$(( pick_count + 1 ))
      fi
    fi
  fi

  # Fallback: try direct-mapping a TEXT subtitle from embedded streams if NOTHING was prepared.
  # Only attempt when at least one SUB_INCLUDE_* flag is enabled and all preparation failed.
  # External files are always handled via the main selection loop above (not the fallback).
  # H2: gate on "nothing PREPARED", not just "nothing EMBEDDED". On burn+export profiles
  # (universal: SUB_BURN_FORCED=1, SUB_EXPORT_EXTERNAL=1) a forced sub routes to
  # SRT_FORCED_BURN_PATH and a full sub to EXTERNAL_SRT_PATHS, leaving SRT_FORCED/FULL/SDH empty
  # even though subtitles WERE prepared — without these two extra clauses the fallback would
  # wrongly re-embed a contradictory soft mov_text track on top of the burn + external export.
  if [[ -z "$SRT_FORCED" && -z "$SRT_FULL" && -z "$SRT_SDH" ]] \
     && [[ -z "$SRT_FORCED_BURN_PATH" ]] && (( ${#EXTERNAL_SRT_PATHS[@]} == 0 )) \
     && (( SUB_INCLUDE_FORCED || SUB_INCLUDE_FULL || SUB_INCLUDE_SDH )); then
    DIRECT_SUB_RELIDX="$(_pick_direct_text_sub_relidx)"
    if [[ -n "$DIRECT_SUB_RELIDX" ]]; then
      SRT_DIRECT_MAP=1
      # Unified: the direct-map text fallback folds into an embedded:N track — mapped
      # straight from the source by the emitter (the same mechanism PGS now uses).
      local _dm_lang _dm_codec
      _dm_lang="$(_sp_sub_lang "$DIRECT_SUB_RELIDX")"
      _dm_codec="$(_sp_sub_field "$DIRECT_SUB_RELIDX" codec_name)"; _dm_codec="${_dm_codec,,}"
      _sub_track_add embedded "$DIRECT_SUB_RELIDX" "$_dm_lang" "" full "$_dm_codec" 0 embed
      note "[Subs] No external SRTs prepared — enabling direct-map of TEXT subtitle stream #$DIRECT_SUB_RELIDX."
    else
      SRT_DIRECT_MAP=0
      note "[Subs] No usable subtitles prepared. Proceeding without subtitles."
    fi
  else
    SRT_DIRECT_MAP=0
  fi
}

# ===== Section 29: Final mux ==================================================================
# mux_final — Assemble all prepared streams into the final output container.
#
# Combines video (from source copy, DV pre-wrap MP4, or encoded ES/MKV),
# primary audio, optional stereo fallback, and subtitle tracks into a single
# MP4/MOV/MKV file. Handles:
#   - Stream mapping with correct input indices
#   - Codec assignment (copy for A/V, mov_text/srt for subs)
#   - Language/title/disposition metadata tagging per stream
#   - DV container signaling (-strict unofficial, -tag:v dvh1)
#   - Chapter and metadata stripping policies
#   - MP4 faststart optimization
#   - Post-mux validation via ffprobe
#
# Dies on: missing video stream, ffmpeg mux failure, corrupt output.
# Globals: numerous — see individual stream sections below.
mux_final() {
  log "→ Muxing final ${OUTPUT_EXT^^} with ffmpeg → $TMP_OUT"

  if (( DRY_RUN )); then
    : > "$TMP_OUT" 2>/dev/null || true
    mark_done "Mux final (dry-run)"
    return 0
  fi

  # Sanity check: workdir must still exist for stream files to be valid
  if [[ ! -d "$WORKDIR" ]]; then
    die 42 "Workdir disappeared before mux — cannot assemble output. Temp files lost."
  fi

  local -a ff_in=()
  local -a ff_map=()
  local -a ff_codec=()

  ff_in+=( "${FFMPEG_FLAGS[@]}" )

  local next_idx=0
  local vid_idx="" a_primary_idx="" a_stereo_idx=""
  local s_forced_idx="" s_full_idx="" s_sdh_idx=""
  local forced_present=0 full_present=0 sdh_present=0
  local src_sub_idx=""
  local _src_input_idx=""   # shared index when source is used as ffmpeg input
  # Parallel arrays for deduplicating external subtitle file inputs in multi-track mode
  local -a _ext_sub_paths=()   # unique external subtitle file paths (insertion order)
  local -a _ext_sub_idxs=()    # ffmpeg -i index for each unique external subtitle path

  # Validate and add video stream
  if (( VIDEO_COPY_FROM_SOURCE )); then
    # Map video directly from source to preserve container-level metadata
    # (DOVI configuration record, displaymatrix, etc.)
    ff_in+=( -i "$SRC_ABS" )
    _src_input_idx=$next_idx
    vid_idx=$next_idx
    next_idx=$(( next_idx + 1 ))
  elif [[ -n "${V_DV_MP4:-}" && -s "$V_DV_MP4" ]]; then
    # Prefer DV pre-wrapped MP4 over raw ES — it carries the dvcC/dvvC box
    # that ffmpeg will copy through to the final output container.
    note "Using DV pre-wrapped MP4 as video input (dvcC box present)."
    ff_in+=( -i "$V_DV_MP4" )
    vid_idx=$next_idx
    next_idx=$(( next_idx + 1 ))
  elif [[ -n "${V_MIXED:-}" && -s "$V_MIXED" ]]; then
    # Validate video before muxing
    if ! ffprobe -v error "$V_MIXED" >/dev/null 2>&1; then
      die 42 "Encoded video exists but is invalid/corrupt"
    fi
    # Raw HEVC ES carries no container timing; stamp source fps as an input option
    # so the mux doesn't inherit ffmpeg's 25fps raw-demuxer default. (.mkv/.mp4
    # intermediates already carry timing — only raw .hevc needs this.)
    if [[ "$V_MIXED" == *.hevc && -n "$SRC_FPS" ]]; then
      ff_in+=( -r "$SRC_FPS" )
    fi
    ff_in+=( -i "$V_MIXED" )
    vid_idx=$next_idx
    next_idx=$(( next_idx + 1 ))
  else
    die 42 "No encoded video stream found."
  fi

  # Add audio streams — multi-track or single-track
  if (( ! SKIP_AUDIO )) && (( HAS_AUDIO )) && (( AUDIO_COPY_FROM_SOURCE )); then
    # Multi-track: map audio streams directly from source.
    # Reuse the source input if VIDEO_COPY_FROM_SOURCE already added it.
    if [[ -z "$_src_input_idx" ]]; then
      ff_in+=( -i "$SRC_ABS" )
      _src_input_idx=$next_idx
      next_idx=$(( next_idx + 1 ))
    fi
    # Mapping and tagging handled below in the multi-track section.
  else
    # Single-track: use extracted/transcoded intermediate files
    if (( ! SKIP_AUDIO )) && (( HAS_AUDIO )) && [[ -n "${A_PRIMARY:-}" && -s "$A_PRIMARY" ]]; then
      ff_in+=( -i "$A_PRIMARY" )
      a_primary_idx=$next_idx
      next_idx=$(( next_idx + 1 ))
    fi
    
    if (( ! SKIP_AUDIO )) && [[ -n "${AAC_STEREO:-}" && -s "$AAC_STEREO" ]]; then
      ff_in+=( -i "$AAC_STEREO" )
      a_stereo_idx=$next_idx
      next_idx=$(( next_idx + 1 ))
    fi
  fi

  # Subtitle inputs (both modes) are registered by _emit_sub_tracks below, via
  # _add_sub_stream: embedded tracks reuse the shared source input ($_src_input_idx),
  # file tracks add deduped -i inputs (Subs_Fix Phase 5).

  # Build stream mapping
  # When VIDEO_COPY_FROM_SOURCE, source is the first input; -map N:v:0
  # selects only the video stream, excluding audio/subs/data tracks.
  ff_map+=( -map "$vid_idx":v:0 )

  # Audio mapping: multi-track from source or single-track from files
  if (( AUDIO_COPY_FROM_SOURCE )) && [[ -n "$_src_input_idx" ]]; then
    local _mt_i
    for _mt_i in "${AUDIO_MT_INDICES[@]}"; do
      ff_map+=( -map "${_src_input_idx}:a:${_mt_i}" )
    done
  else
    [[ -n "$a_primary_idx" ]] && ff_map+=( -map "$a_primary_idx":a:0 )
    [[ -n "$a_stereo_idx"  ]] && ff_map+=( -map "$a_stereo_idx":a:0 )
  fi

  # Subtitle -map entries (both modes) are emitted by _emit_sub_tracks below,
  # alongside the inputs and per-stream tagging (Subs_Fix Phase 5).

  # Codec settings: copy everything; subtitle codecs are assigned per-stream below
  ff_codec+=( -c copy )

  # Subtitle inputs, -map entries, and per-stream tagging — emitted in ONE pass by
  # the unified emitter for BOTH single- and multi-track modes (Subs_Fix Phase 5).
  # SUB_TRACKS_* is populated by build_subtitle_plan (single) or
  # run_subtitle_pipeline_multi (multi); empty (e.g. --no-subtitles) is a no-op.
  (( ! SKIP_SUBS )) && _emit_sub_tracks

  # Audio metadata: language, title, and disposition tagging.
  # Output audio index tracks which output stream we're tagging.
  local -i out_a_idx=0
  if (( AUDIO_COPY_FROM_SOURCE )) && (( ${#AUDIO_MT_INDICES[@]} > 0 )); then
    # Multi-track: tag each kept audio stream copied from source
    local _mt_i
    for (( _mt_i=0; _mt_i<${#AUDIO_MT_INDICES[@]}; _mt_i++ )); do
      local _mt_lang="${AUDIO_MT_LANGS[$_mt_i]}"
      local _mt_codec="${AUDIO_MT_CODECS[$_mt_i]}"
      local _mt_ch="${AUDIO_MT_CHANNELS[$_mt_i]}"
      local _mt_title="${AUDIO_MT_TITLES[$_mt_i]}"

      [[ -n "$_mt_lang" ]] && ff_codec+=( "-metadata:s:a:${out_a_idx}" "language=$_mt_lang" )

      if (( INCLUDE_AUDIO_TITLES )); then
        local _mt_desc
        _mt_desc="$(_audio_descriptive_title "$_mt_codec" "$_mt_ch")"
        ff_codec+=( "-metadata:s:a:${out_a_idx}" "title=$_mt_desc" )
      elif [[ -n "$_mt_title" ]]; then
        ff_codec+=( "-metadata:s:a:${out_a_idx}" "title=$_mt_title" )
      fi

      # First track gets default disposition; rest get none
      if (( out_a_idx == 0 )); then
        ff_codec+=( "-disposition:a:${out_a_idx}" default )
      else
        ff_codec+=( "-disposition:a:${out_a_idx}" 0 )
      fi

      out_a_idx=$(( out_a_idx + 1 ))
    done
  else
    # Single-track: primary + optional stereo fallback
    if [[ -n "$a_primary_idx" ]]; then
      [[ -n "${A_PRIMARY_LANG:-}" ]]  && ff_codec+=( "-metadata:s:a:${out_a_idx}" "language=$A_PRIMARY_LANG" )
      if (( INCLUDE_AUDIO_TITLES )) && [[ -n "${A_PRIMARY_CODEC:-}" ]]; then
        local _desc_title
        _desc_title="$(_audio_descriptive_title "$A_PRIMARY_CODEC" "${A_PRIMARY_CHANNELS:-0}")"
        ff_codec+=( "-metadata:s:a:${out_a_idx}" "title=$_desc_title" )
      elif [[ -n "${A_PRIMARY_TITLE:-}" ]]; then
        ff_codec+=( "-metadata:s:a:${out_a_idx}" "title=$A_PRIMARY_TITLE" )
      fi
      ff_codec+=( "-disposition:a:${out_a_idx}" default )
      out_a_idx=$(( out_a_idx + 1 ))
    fi
    if [[ -n "$a_stereo_idx" ]]; then
      [[ -n "${A_STEREO_LANG:-}" ]] && ff_codec+=( "-metadata:s:a:${out_a_idx}" "language=$A_STEREO_LANG" )
      if (( INCLUDE_AUDIO_TITLES )); then
        ff_codec+=( "-metadata:s:a:${out_a_idx}" "title=$(_audio_descriptive_title "${A_STEREO_CODEC:-aac}" 2)" )
      else
        ff_codec+=( "-metadata:s:a:${out_a_idx}" "title=Stereo" )
      fi
      ff_codec+=( "-disposition:a:${out_a_idx}" 0 )
      out_a_idx=$(( out_a_idx + 1 ))
    fi
  fi

  # MP4/MOV optimization
  if [[ "$MUX_FORMAT" != "matroska" ]]; then
    ff_codec+=( -movflags +faststart )
  fi

  # Dolby Vision container signalling for MP4/MOV.
  # ffmpeg refuses to write the DOVI configuration record (dvcC/dvvC MP4 box)
  # without -strict unofficial. Without this box, players cannot identify the
  # stream as Dolby Vision even when RPU NAL units are present in the bitstream.
  # -tag:v dvh1 sets the codec tag required by Apple devices (Apple TV, iPhone,
  # iPad) — Apple's player ignores dvhe/hev1 tagged DV streams.
  if (( OUTPUT_HAS_DV )) && [[ "$MUX_FORMAT" != "matroska" ]]; then
    ff_codec+=( -strict unofficial -tag:v dvh1 )
    note "Adding Dolby Vision container signalling (so Apple devices recognise the DV stream)."
    log  "DV container signalling flags: -strict unofficial -tag:v dvh1"
    report_add "dv_mux_flags" "strict unofficial + dvh1 tag"
  elif (( OUTPUT_HAS_DV )) && [[ "$MUX_FORMAT" == "matroska" ]] && [[ -n "${V_DV_MP4:-}" ]]; then
    # The DV video is sourced from a pre-wrapped MP4 (needed to give the raw HEVC
    # ES the packet timestamps the Matroska muxer requires). That MP4 carries an
    # 'dvh1'/'dvhe' fourcc tag which the Matroska muxer rejects outright:
    #   "Tag dvh1 incompatible with output codec id".
    # Override with 'hvc1' so the mux succeeds. DV fidelity then depends on how the
    # pre-wrap was produced: the DV RPU is ALWAYS preserved in-band (carried in the
    # HEVC bitstream by -c copy); container-level DV signalling (dvcC → Matroska
    # BlockAdditionMapping) is additionally carried only when the pre-wrap wrote a
    # dvcC box — i.e. via mp4box (Method 1). The ffmpeg-only fallback yields
    # in-band RPU without the dvcC box. -strict unofficial allows ffmpeg to emit
    # the DV side data when present.
    ff_codec+=( -strict unofficial -tag:v hvc1 )
    note "Matroska DV mux: overriding video tag for MKV compatibility (the MP4 DV tag is rejected by Matroska)."
    log  "Matroska DV mux: video tag dvh1 → hvc1 (Matroska rejects the dvh1 fourcc); -strict unofficial"
    report_add "dv_mux_flags" "matroska: strict unofficial + hvc1 tag"
  fi

  # Chapter handling
  if (( ! KEEP_CHAPTERS )); then
    ff_codec+=( -map_chapters -1 )
    note "Stripping chapter markers from output."
    report_add "chapters" "stripped"
  else
    report_add "chapters" "preserved"
  fi

  # Metadata stripping
  if (( STRIP_METADATA )); then
    ff_codec+=( -map_metadata -1 )
    note "Stripping non-essential metadata from output."
    report_add "metadata" "stripped"
  else
    report_add "metadata" "preserved"
  fi

  # Profile comment metadata (tagline identifying the encode profile).
  # Applied after -map_metadata so it survives STRIP_METADATA — this is our
  # metadata, not inherited source junk.
  if (( PROFILE_COMMENT )) && [[ -n "${PROFILE_NAME:-}" ]]; then
    local _pcomment
    _pcomment="$(_profile_comment)"
    if [[ -n "$_pcomment" ]]; then
      ff_codec+=( -metadata "comment=$_pcomment" )
      report_add "comment" "$_pcomment"
    fi
  fi

  # Execute final mux
  log "ffmpeg mux command: ffmpeg ${ff_in[*]} ${ff_map[*]} ${ff_codec[*]} -f $MUX_FORMAT $TMP_OUT"
  ffmpeg "${ff_in[@]}" "${ff_map[@]}" "${ff_codec[@]}" -f "$MUX_FORMAT" "$TMP_OUT" 2>"$WORKDIR/mux.err" &
  local mux_pid=$!
  local _mux_ok=0; _await_tracked_pid "$mux_pid" "Muxing final ${OUTPUT_EXT^^}" || _mux_ok=$?
  if (( _mux_ok != 0 )); then
    _check_disk_full "$WORKDIR/mux.err"
    die 41 "ffmpeg final mux failed. See: $WORKDIR/mux.err"
  fi

  # Validate muxed output
  _validate_media_file "$TMP_OUT" "Final mux"

  mark_done "Mux final ${OUTPUT_EXT}"
}

# _check_multitrack_container_safety — M1: hard-stop BEFORE the encode when multi-track
# COPY mode would have to drop or degrade a kept stream to fit the target container.
# Multi-track mode stream-copies every kept audio/subtitle track verbatim; MKV carries
# everything losslessly, but MP4/MOV cannot hold lossless HD audio (TrueHD/DTS-HD MA),
# bitmap subtitles (PGS/VobSub), or styled ASS/SSA (which would flatten to plain
# mov_text). Failing here — in seconds, before run_video_pipeline — avoids a long encode
# that would only die at mux_final, and turns the old "bitmap subs silently skipped in
# MP4" behaviour into an explicit "use MKV" choice (never silently lose a track).
# Only KEPT tracks are considered: this mirrors the language/type/commentary keep filters
# of _build_audio_keep_list / _build_subtitle_keep_list (SYNC: keep these in step).
# Globals (read): MUX_FORMAT, OUTPUT_EXT, AUDIO_MULTI_TRACK, SUB_MULTI_TRACK, SKIP_AUDIO,
#   SKIP_SUBS, AUDIO_LANG_PREF, AUDIO_KEEP_COMMENTARY, SUB_LANG_PREF, SUB_INCLUDE_FORCED,
#   SUB_INCLUDE_SDH, SUB_INCLUDE_FULL, SUB_PRESERVE_TEXT_FORMAT, ALL_SUB_CODECS/LANGS/TYPES.
_check_multitrack_container_safety() {
  # MKV holds every codec/format losslessly — nothing can be lost, so skip the check.
  [[ "$MUX_FORMAT" == "matroska" ]] && return 0
  (( AUDIO_MULTI_TRACK || SUB_MULTI_TRACK )) || return 0

  local -a _blk=()
  local _ext="${OUTPUT_EXT,,}"

  # ---- Audio: every kept track is stream-copied (-c copy); MP4/MOV can't carry the
  # lossless HD codecs.  Keep-filter mirrors _build_audio_keep_list (language + commentary).
  if (( AUDIO_MULTI_TRACK )) && (( ! SKIP_AUDIO )); then
    local _an _ai _info _codec _ch _lang _br _title _comment _vi _hi _profile
    _an="$(_audio_stream_count)"
    for (( _ai=0; _ai<_an; _ai++ )); do
      _info="$(_audio_stream_info "$_ai")"
      # CR-3: capture the disposition flags and OR them into the commentary drop, matching
      # the keep-filter in _build_audio_keep_list (this must stay in sync with it).
      _split_tab "$_info" _codec _ch _lang _br _title _comment _vi _hi  # C2: non-collapsing — keep-filter mirrors _build_audio_keep_list
      _normalize_codec_lang _codec _lang
      [[ -n "${AUDIO_LANG_PREF:-}" ]] && ! _audio_lang_matches "$_lang" && continue
      (( ! AUDIO_KEEP_COMMENTARY )) && { _audio_is_commentary "$_title" || (( _comment )) || (( _vi )) || (( _hi )); } && continue
      case "$_codec" in
        truehd|mlp) _blk+=("audio #${_ai}: ${_codec} (lossless)") ;;
        dts|dca)
          _profile="$(_audio_field "$_ai" profile)"
          [[ "${_profile,,}" == *"hd ma"* ]] && _blk+=("audio #${_ai}: DTS-HD MA (lossless)") ;;
      esac
    done
  fi

  # ---- Subtitles: every kept track is stream-copied; MP4/MOV can't carry bitmap subs and
  # flattens styled ASS/SSA.  Keep-filter mirrors Filters 1-2 of _build_subtitle_keep_list
  # (language + type); the container drop (Filter 3) becomes this hard-stop instead.
  if (( SUB_MULTI_TRACK )) && (( ! SKIP_SUBS )); then
    local _si _scodec _slang _stype
    for (( _si=0; _si<${#ALL_SUB_CODECS[@]}; _si++ )); do
      _scodec="${ALL_SUB_CODECS[$_si],,}"
      _slang="${ALL_SUB_LANGS[$_si]}"
      _stype="${ALL_SUB_TYPES[$_si]}"
      [[ -n "${SUB_LANG_PREF:-}" ]] && ! _sub_lang_matches "$_slang" && continue
      case "$_stype" in
        forced) (( SUB_INCLUDE_FORCED )) || continue ;;
        sdh)    (( SUB_INCLUDE_SDH ))    || continue ;;
        full)   (( SUB_INCLUDE_FULL ))   || continue ;;
      esac
      if ! _is_text_sub_codec "$_scodec"; then
        _blk+=("subtitle #${_si}: ${_scodec} (bitmap — cannot be carried)")
      elif [[ "$_scodec" == "ass" || "$_scodec" == "ssa" ]] && (( SUB_PRESERVE_TEXT_FORMAT )); then
        _blk+=("subtitle #${_si}: ${_scodec} (styled — would flatten to plain mov_text)")
      fi
    done
  fi

  (( ${#_blk[@]} > 0 )) || return 0

  local _list="" _b
  for _b in "${_blk[@]}"; do _list+=$'\n'"     • ${_b}"; done
  die 11 "Multi-track output to .${_ext} can't preserve these stream(s) without quality loss:${_list}
   Use --output-ext mkv — MKV carries all of them losslessly (or drop the affected track(s))."
}

# _video_codec_label — short human label for a logical or ffmpeg video codec id (banner/Plan).
_video_codec_label() {
  case "$1" in
    libx265|hevc_videotoolbox|hevc_nvenc) echo "HEVC" ;;
    libx264|h264_videotoolbox|h264_nvenc) echo "H.264" ;;
    libsvt-av1|libsvtav1|libaom-av1|av1_nvenc) echo "AV1" ;;
    *) echo "$1" ;;
  esac
}

# ===== Section 30: Main =======================================================================
main() {
  # ---- Startup banner: confirm the impactful decisions up front (Phase 3). ----
  # Two parts: this banner echoes the resolved POLICY (config + profile + CLI — all known now),
  # and a single "▶ Plan:" line printed later (post-probe, before the video pipeline) reports the
  # CONCRETE facts that aren't known yet here — actual encoder, target pixfmt, color class, DV
  # status. Keep "=== Workdir    : <path>" verbatim: the test harness sed-extracts the workdir
  # from it. Mid-pipeline narration stays stage/progress focused; parameter detail lives in the log.
  say "=== ${APP_NAME} v${VERSION} — CLI: ${CLI_NAME}"
  say "=== Input      : $SRC_ABS"
  say "=== Output     : $OUT"
  say "=== Workdir    : $WORKDIR"
  [[ -n "${PROFILE_NAME:-}" ]] && say "=== Profile    : $PROFILE_NAME"

  local _b_hw=""; [[ "$HW_ACCEL" != "none" ]] && _b_hw=" · HW: $HW_ACCEL"
  say "=== Video      : $(_video_codec_label "$VIDEO_CODEC") ($VIDEO_CODEC)$_b_hw · CRF $CRF_VALUE · preset $PRESET_VALUE"
  say "=== Container  : ${OUTPUT_EXT^^}"

  local _b_codecs _b_stereo=""
  if [[ -n "${AUDIO_FORCE_CODEC:-}" ]]; then _b_codecs="force $AUDIO_FORCE_CODEC"
  else _b_codecs="codecs $AUDIO_CODEC_PREFERENCE"; fi
  if   (( AUDIO_PREFER_STEREO ));  then _b_stereo=" · stereo-only"
  elif (( ADD_STEREO_IF_MULTICH )); then _b_stereo=" · +stereo downmix @ $STEREO_BITRATE"; fi
  say "=== Audio      : prefer lang $AUDIO_LANG_PREF · $_b_codecs$_b_stereo"

  local _b_sub
  if   (( SKIP_SUBS )); then _b_sub="disabled (--skip-subs)"
  elif (( ! SUB_INCLUDE_FORCED && ! SUB_INCLUDE_FULL && ! SUB_INCLUDE_SDH )); then _b_sub="none (--no-subtitles)"
  else
    _b_sub="prefer lang $SUB_LANG_PREF"
    (( SUB_ENABLE_OCR ))      && _b_sub+=" · OCR"
    (( SUB_BURN_FORCED ))     && _b_sub+=" · burn-forced"
    (( SUB_EXPORT_EXTERNAL )) && _b_sub+=" · export-external"
  fi
  say "=== Subtitles  : $_b_sub"

  local _b_tm _b_dv
  (( TONEMAP_HDR_TO_SDR )) && _b_tm="HDR→SDR" || _b_tm="off"
  if   (( DISABLE_DV ));        then _b_dv="disabled (--no-dv)"
  elif (( ALLOW_DV_FALLBACK )); then _b_dv="keep (P8.1 fallback ok)"
  else _b_dv="keep (strict)"; fi
  say "=== Color/DV   : tonemap $_b_tm · DV $_b_dv"

  (( DRY_RUN )) && note "DRY-RUN is ON"
  [[ ${#MUXM_CONFIG_LOADED[@]} -gt 0 ]] && note "Loaded config: ${MUXM_CONFIG_LOADED[*]}"
  (( SKIP_AUDIO )) && note "[Quick Test] Audio processing disabled (--skip-audio)"
  (( SKIP_SUBS  )) && note "[Quick Test] Subtitle processing disabled (--skip-subs)"

  # Cache metadata once for all operations
  cache_stream_metadata

  # Capture the source frame rate so the DV raw-ES wrap steps (mp4box / ffmpeg)
  # stamp the correct rate instead of mp4box's 25fps default for headerless ES.
  init_src_fps

  # Smart disk space preflight — runs here so METADATA_CACHE is available for estimation
  disk_free_warn

  # Validate source contains at least one video stream
  _has_stream video || die 12 "Source file contains no video streams"

  # Discover external subtitle files and build unified stream list
  discover_external_subtitles
  merge_subtitle_sources

  # Skip-if-ideal: check early and exit if source is already compliant
  if (( SKIP_IF_IDEAL )); then
    if check_skip_if_ideal; then
      # Source is ideal — write report and exit clean.
      # Record the metadata/chapters disposition for --report-json, mirroring mux_final's
      # report_add on the normal path (same "stripped"/"preserved" values and order). The
      # skip-if-ideal remux below honors --strip-metadata / --no-keep-chapters (D2), and the
      # raw-hardlink branch only runs when neither flag demands a change, so these flag-driven
      # values always match the actual output. Must precede write_json_report, which serializes
      # REPORT_ENTRIES immediately below (the skip-if-ideal path returns before mux_final runs).
      if (( ! KEEP_CHAPTERS )); then report_add "chapters" "stripped"; else report_add "chapters" "preserved"; fi
      if (( STRIP_METADATA )); then report_add "metadata" "stripped"; else report_add "metadata" "preserved"; fi
      write_json_report
      if (( ! DRY_RUN )); then
        # Determine if a remux is needed (metadata stamping or stream filtering)
        local _sii_needs_remux=0
        (( INCLUDE_AUDIO_TITLES && ${#SII_AUDIO_INDICES[@]} > 0 )) && _sii_needs_remux=1
        (( PROFILE_COMMENT )) && [[ -n "${PROFILE_NAME:-}" ]] && _sii_needs_remux=1
        # Stream filtering: if keep-lists exclude any streams, we must remux
        local _sii_total_a _sii_total_s
        _sii_total_a="$(_audio_stream_count)"
        _sii_total_s="$(_sub_count)"
        (( ${#SII_AUDIO_INDICES[@]} < _sii_total_a )) && _sii_needs_remux=1
        (( ${#SII_SUB_INDICES[@]} < _sii_total_s )) && _sii_needs_remux=1
        # D2: --strip-metadata / --no-keep-chapters must reach the output even on the
        # skip-the-encode path. Force the copy-remux branch (never the raw hardlink, which
        # would ship the source verbatim) whenever either flag demands a change.
        (( STRIP_METADATA )) && _sii_needs_remux=1
        (( ! KEEP_CHAPTERS )) && _sii_needs_remux=1

        if (( _sii_needs_remux )); then
          # Build explicit per-stream maps from validated keep-lists
          local -a _sii_meta=( "${FFMPEG_FLAGS[@]}" -i "$SRC_ABS" )

          # Video: always map
          _sii_meta+=( -map 0:v:0 )

          # Audio: map only validated streams
          local _sii_a_idx
          for _sii_a_idx in "${SII_AUDIO_INDICES[@]}"; do
            _sii_meta+=( -map "0:a:${_sii_a_idx}" )
          done

          # Subtitles: map only validated streams
          local _sii_s_idx
          for _sii_s_idx in "${SII_SUB_INDICES[@]}"; do
            _sii_meta+=( -map "0:s:${_sii_s_idx}" )
          done

          _sii_meta+=( -c copy )

          # D2: honor --no-keep-chapters / --strip-metadata on the skip-if-ideal remux,
          # reusing mux_final's exact tokens AND order (chapters, then metadata, then the
          # profile comment below) so our own comment metadata survives the strip.
          if (( ! KEEP_CHAPTERS )); then
            _sii_meta+=( -map_chapters -1 )
            note "Stripping chapter markers from output."
          fi
          if (( STRIP_METADATA )); then
            _sii_meta+=( -map_metadata -1 )
            note "Stripping non-essential metadata from output."
          fi

          # Audio titles: use output indices (sequential) not source indices
          if (( INCLUDE_AUDIO_TITLES )) && (( ${#SII_AUDIO_INDICES[@]} > 0 )); then
            local _sii_out_a=0 _sii_src_a _sii_codec _sii_ch _sii_title
            for _sii_src_a in "${SII_AUDIO_INDICES[@]}"; do
              _sii_codec="$(_audio_codec "$_sii_src_a")"
              _sii_ch="$(_audio_channels "$_sii_src_a")"
              _sii_title="$(_audio_descriptive_title "$_sii_codec" "$_sii_ch")"
              _sii_meta+=( "-metadata:s:a:${_sii_out_a}" "title=$_sii_title" )
              _sii_out_a=$(( _sii_out_a + 1 ))
            done
          fi

          # Profile comment
          if (( PROFILE_COMMENT )) && [[ -n "${PROFILE_NAME:-}" ]]; then
            local _sii_comment
            _sii_comment="$(_profile_comment)"
            [[ -n "$_sii_comment" ]] && _sii_meta+=( -metadata "comment=$_sii_comment" )
          fi
          [[ "$MUX_FORMAT" != "matroska" ]] && _sii_meta+=( -movflags +faststart )
          _sii_meta+=( -f "$MUX_FORMAT" "$TMP_OUT" )
          ffmpeg "${_sii_meta[@]}" 2>"$WORKDIR/skip_ideal_remux.err" &
          local _sii_pid=$!
          local _sii_ok=0; _await_tracked_pid "$_sii_pid" "Applying metadata (copy-remux)" || _sii_ok=$?
          if (( _sii_ok != 0 )); then
            _check_disk_full "$WORKDIR/skip_ideal_remux.err"
            die 41 "Skip-if-ideal metadata remux failed. See: $WORKDIR/skip_ideal_remux.err"
          fi
          _validate_media_file "$TMP_OUT" "Skip-if-ideal remux"

          # Log stream counts if filtering occurred
          if (( ${#SII_AUDIO_INDICES[@]} < _sii_total_a )) || (( ${#SII_SUB_INDICES[@]} < _sii_total_s )); then
            note "Streams: ${#SII_AUDIO_INDICES[@]}/${_sii_total_a} audio, ${#SII_SUB_INDICES[@]}/${_sii_total_s} subtitle (container-filtered)."
          fi
          note "Applied metadata via copy-remux (already ideal)."
        else
          # No titles, no comment, no filtering — hardlink (instant on same FS); fall back to copy
          if ! ln -f "$SRC_ABS" "$TMP_OUT" 2>/dev/null; then
            cp -f "$SRC_ABS" "$TMP_OUT" &
            local _sii_cp_pid=$!
            local _sii_cp_rc=0; _await_tracked_pid "$_sii_cp_pid" "Copying source to output" || _sii_cp_rc=$?
            (( _sii_cp_rc == 0 )) || die 41 "Failed to copy source to output (skip-if-ideal)"
          fi
          _validate_media_file "$TMP_OUT" "Skip-if-ideal copy"
          note "Linked/copied source to output (already ideal)."
        fi
      fi
      mark_done "Skip-if-ideal (source compliant)"
      FAILED=0
      return 0
    fi
  fi
  
  # Detect Dolby Vision
  # detect_dv returns: 0=detected, 1=not found, 2=skipped (DISABLE_DV).
  # Use || to capture non-zero returns without triggering errexit.
  local _dv_rc=0
  detect_dv || _dv_rc=$?

  if (( _dv_rc == 0 )); then
    IS_DV=1
    note "Dolby Vision detected — extraction/injection will be attempted in the video pipeline."
    report_add "dv_detected" "true"

    # Extract detailed DV source info (profile, compat_id, layer flags)
    detect_dv_info

    # Validate output container supports DV muxing before starting any encode.
    # ffmpeg can read DV from MOV but cannot reliably write DV signalling back
    # into MOV. Only MP4 and MKV are supported.
    case "${OUTPUT_EXT,,}" in
      mp4|m4v|mkv) ;;
      *)
        die 11 "Dolby Vision detected but output container .${OUTPUT_EXT} is not supported for DV muxing by ffmpeg.
   Either switch to a supported container (--output-ext mkv or --output-ext mp4)
   or disable DV handling (--no-dv) to proceed without DV metadata."
        ;;
    esac
  elif (( _dv_rc == 2 )); then
    # Detection was skipped because DISABLE_DV=1. Check the metadata cache
    # so we can tell the user if the source actually contains DV.
    IS_DV=0
    local _dv_skip_source="--no-dv"
    [[ -n "${PROFILE_NAME:-}" ]] && _dv_skip_source="profile '${PROFILE_NAME}'"
    if _source_has_dv_metadata; then
      warn "Source contains Dolby Vision but DV handling is disabled (${_dv_skip_source}). Use --dv to override."
      report_add "dv_detected" "skipped (present in source)"
      # F2: these profiles strip DV and emit a 10-bit HDR10 stream (DISABLE_DV=1, HDR10 target).
      # If the source carries DV but no HDR10 static metadata (mastering display / MaxCLL), the
      # stripped output has missing brightness data → dim/washed-out on HDR10-only displays — so
      # warn and point at archive (preserve DV). Skipped when tone-mapping to SDR (then the output
      # isn't HDR10 and the metadata is irrelevant). Pre-fix this lived in the dead _dv_rc==0 arm,
      # where DISABLE_DV is always 0 (detect_dv returns 2 when DISABLE_DV=1), so it never fired.
      if (( ! TONEMAP_HDR_TO_SDR )); then
        case "${PROFILE_NAME:-}" in
          hdr10-hq|streaming-hevc|streaming-av1|av1-hq) _check_hdr10_static_metadata ;;
        esac
      fi
    else
      note "DV detection skipped (disabled by ${_dv_skip_source})."
      report_add "dv_detected" "skipped"
    fi
  else
    IS_DV=0
    note "No Dolby Vision detected."
    report_add "dv_detected" "false"
  fi

  # M1: in multi-track copy mode, hard-stop NOW (before the encode) if the target
  # container can't carry a kept stream losslessly — recommend MKV. Runs before the
  # single-track advisory warnings below so it pre-empts a redundant warn-then-die.
  _check_multitrack_container_safety

  # Warn: ASS/SSA subtitles + MP4 container + SUB_PRESERVE_TEXT_FORMAT=1
  # ASS/SSA native format cannot be carried by MP4; subtitles will be flattened to mov_text.
  if (( SUB_PRESERVE_TEXT_FORMAT )) && [[ "${OUTPUT_EXT,,}" == "mp4" || "${OUTPUT_EXT,,}" == "m4v" ]]; then
    local _has_ass_sub=0
    local _acs_i
    for _acs_i in "${!ALL_SUB_CODECS[@]}"; do
      case "${ALL_SUB_CODECS[$_acs_i]}" in
        ass|ssa) _has_ass_sub=1; break ;;
      esac
    done
    if (( _has_ass_sub )); then
      warn "[Subs] ASS/SSA subtitle preservation was requested, but the .${OUTPUT_EXT,,} output container cannot carry native ASS. Subtitles will be converted to mov_text (plain text — formatting, positioning, and styling will be lost)."
    fi
  fi

  # Warn: lossless audio passthrough + MP4 container with codecs that have limited MP4 support
  # TrueHD/DTS-HD MA cannot be muxed into MP4; FLAC can be muxed but has limited device playback support.
  if (( AUDIO_LOSSLESS_PASSTHROUGH )) && [[ "${OUTPUT_EXT,,}" == "mp4" || "${OUTPUT_EXT,,}" == "m4v" ]]; then
    local _has_problematic_lossless=0
    local _alp_n _alp_i _alp_codec _alp_profile
    _alp_n="$(_audio_stream_count)"
    for (( _alp_i=0; _alp_i<_alp_n; _alp_i++ )); do
      _alp_codec="$(_audio_field "$_alp_i" codec_name)"
      _alp_codec="${_alp_codec,,}"
      case "$_alp_codec" in
        truehd|mlp|flac)
          _has_problematic_lossless=1; break ;;
        dts|dca)
          _alp_profile="$(_audio_field "$_alp_i" profile)"
          if [[ "${_alp_profile,,}" == *"hd ma"* ]]; then
            _has_problematic_lossless=1; break
          fi
          ;;
      esac
    done
    if (( _has_problematic_lossless )); then
      warn "Lossless audio passthrough enabled but output container .${OUTPUT_EXT,,} has limited lossless playback support. TrueHD/FLAC tracks may not play on most devices. Consider --output-ext mkv for full lossless compatibility."
    fi
  fi

  # Decide color space, then resolve concrete encoder (logical codec +
  # hardware backend → VIDEO_ENCODER_FFMPEG) before assembling encoder
  # parameters — the VideoToolbox param builder reads VIDEO_ENCODER_FFMPEG
  # and TARGET_PIXFMT, so both must be set first.
  decide_color_and_pixfmt
  resolve_video_encoder
  build_video_encoder_params

  # A1: resolution/HDR-aware CRF for the AV1 profiles (streaming-av1 and av1-hq). Runs here
  # so PROFILE_DESC (the HDR check) is set; an explicit --crf always wins via _CLI_CRF_EXPLICIT.
  _apply_av1_resolution_crf

  # Deferred warning: H.264 + HDR source + no tone-mapping.
  # Both libx264 and h264_videotoolbox produce 8-bit yuv420p only; the output
  # will carry smpte2084/bt2020 container metadata but the video data is 8-bit,
  # which cannot represent the full PQ luminance range. Output will appear
  # washed out on displays that interpret the HDR metadata. Pass --tonemap to
  # convert to SDR instead. (youtube-upload accepts this as a known limitation —
  # see docs/VIDEOTOOLBOX_CALIBRATION.md §5.)
  if (( _H264_HDR_WARN_PENDING )) && [[ "$PROFILE_DESC" == "HDR10" || "$PROFILE_DESC" == "HLG" ]]; then
    warn "H.264 + HDR source ($PROFILE_DESC) without tone-mapping: the encoder ($VIDEO_ENCODER_FFMPEG) produces 8-bit yuv420p — output will carry HDR metadata but the video data is 8-bit and will appear washed out. Use --tonemap for correct SDR output."
  fi

  # Deferred warning (C6): H.264 cannot carry Dolby Vision. Post-probe, so IS_DV is known.
  _warn_h264_drops_dv

  [[ -n "$LEVEL_VALUE" ]] && apply_level_vbv "$LEVEL_VALUE"

  # ▶ Plan line (Phase 3): the CONCRETE facts now known post-probe/resolution — actual ffmpeg
  # encoder, target pixfmt (+ bit depth), color class, and DV in/out intent. Complements the
  # policy banner above (which echoed config-resolved intent before any of this was known).
  # Audio/subtitle concretes are decided in their pipelines below and narrated there.
  local _p_bits _p_dv
  case "$TARGET_PIXFMT" in *10le|*10be|*10) _p_bits=" 10-bit" ;; *) _p_bits=" 8-bit" ;; esac
  if (( IS_DV )); then (( DISABLE_DV )) && _p_dv="drop" || _p_dv="keep"; else _p_dv="none"; fi
  say "▶ Plan: $(_video_codec_label "$VIDEO_ENCODER_FFMPEG")${_p_bits} (${VIDEO_ENCODER_FFMPEG}, ${TARGET_PIXFMT}) · ${OUTPUT_EXT^^} · ${PROFILE_DESC} · DV: ${_p_dv}"

  # When burning forced subs, we need the subtitle plan BEFORE video encode
  if (( SUB_BURN_FORCED && ! SKIP_SUBS )); then
    build_subtitle_plan
    mark_done "Subtitle plan (pre-video for burn-in)"
  fi

  # Run pipelines
  run_video_pipeline

  if (( SKIP_AUDIO )); then
    note "[Quick Test] --skip-audio: skipping audio selection/transcode"
    HAS_AUDIO=0
    A_PRIMARY=""
    AAC_STEREO=""
  else
    run_audio_pipeline
  fi

  # Build subtitle plan if not already done (non-burn case)
  if (( ! SUB_BURN_FORCED || SKIP_SUBS )); then
    build_subtitle_plan
  fi

  mux_final

  # Verify DV container signaling is present in output (dvcC/dvvC box for MP4/MOV)
  verify_dv_container_record

  if (( DRY_RUN )); then
    note "DRY-RUN: DV output status not evaluated (no real encode performed)."
  elif (( OUTPUT_HAS_DV )); then
    note "Dolby Vision present in output."
    report_add "dv_output" "preserved"
  elif (( IS_DV == 1 && DISABLE_DV == 0 )); then
    warn "Dolby Vision was detected in source but could not be preserved in output."
    report_add "dv_output" "failed"
  else
    note "Output is non-DV."
  fi

  say "→ Verifying output…"
  if (( DRY_RUN )); then
    say "  DRY-RUN: ffprobe verify $TMP_OUT"
    say "  DRY-RUN: size of $TMP_OUT"
  else
    # One ffprobe of the output, reused for both the full log dump and the compact summary below
    # (was two separate -show_streams spawns of the same file). The JSON is written to the log —
    # it is complete, and no assertion parses this dump (only muxm's own log lines are grepped).
    local verify_json
    verify_json="$(ffprobe -v error -show_streams -of json "$TMP_OUT" 2>/dev/null)" || true
    log "--- ffprobe output streams (full, json) ---"
    printf '%s\n' "${verify_json:-<no ffprobe output>}" >> "$LOGFILE" 2>/dev/null || true
    log "--- end ffprobe output ---"

    # Compact stream summary → terminal + log (via say)
    if [[ -n "${verify_json:-}" ]]; then
      # Batch: fetch all video summary fields in a single jq call
      local v_codec v_res v_fps s_count _v_summary
      _v_summary="$(printf '%s\n' "$verify_json" | jq -r '
        ([.streams[] | select(.codec_type=="video")][0] |
          "\(.codec_name // "?") \(.profile // "")"
          + "\t" + "\(.width)x\(.height)"
          + "\t" + (.r_frame_rate // "?"))
        + "\t" + ([.streams[] | select(.codec_type=="subtitle")] | length | tostring)' 2>/dev/null)"
      _split_tab "$_v_summary" v_codec v_res v_fps s_count  # C2: non-collapsing (keep the pattern uniform; fields here are never empty)
      v_codec="${v_codec% }"
      # Convert fractional fps like 24000/1001 to decimal
      if [[ "$v_fps" == */* ]]; then
        v_fps="$(echo "scale=3; $v_fps" | bc 2>/dev/null | sed 's/0*$//' | sed 's/\.$//')"
      fi

      say "  Video : ${v_codec:-?} ${v_res:-?} @ ${v_fps:-?} fps"

      # Frame-rate integrity guard (hard-fail backstop). The DV raw-ES wrap steps
      # stamp SRC_FPS explicitly, so output fps MUST match the source. A mismatch
      # means a wrap path slipped through unstamped (e.g. a future regression) and
      # the audio would progressively desync — reject the encode rather than ship a
      # broken file. End users should never see this; it guards against the very
      # bug it was written for. Compared with a 1% relative tolerance to absorb
      # rational↔decimal rounding (23.976 vs 23.976023976). Skipped when either
      # side is unknown or the video was stream-copied (fps preserved by the copy).
      if [[ -n "$SRC_FPS" && -n "${v_fps:-}" && "$v_fps" != "?" ]] && (( ! VIDEO_COPY_FROM_SOURCE )); then
        local _src_fps_dec
        _src_fps_dec="$(_fps_to_decimal "$SRC_FPS")"
        if [[ -n "$_src_fps_dec" ]]; then
          local _fps_ok
          _fps_ok="$(LC_NUMERIC=C awk -v s="$_src_fps_dec" -v o="$v_fps" \
            'BEGIN{ d=s-o; if (d<0) d=-d; print (s>0 && d/s <= 0.01) ? 1 : 0 }')"
          if [[ "$_fps_ok" != "1" ]]; then
            die 45 "Frame-rate integrity check failed: source ${_src_fps_dec} fps but output ${v_fps} fps. This would cause progressive audio desync; refusing to ship a desynced encode. See log: $LOGFILE"
          fi
          log "[verify] fps integrity OK: source ${_src_fps_dec} ≈ output ${v_fps} fps"
        fi
      fi

      # Audio: rich per-track metadata (codec, channels, language, bitrate, title)
      # Single jq call over all audio streams; iterate the newline-delimited output (L2c).
      local a_raw_all a_idx=0 a_had_audio=0
      a_raw_all="$(printf '%s\n' "$verify_json" | jq -r '
        [.streams[] | select(.codec_type=="audio")] |
        .[] |
        "\(.codec_name // "?")\t\(.channels // 0)\t\(.tags.language // "und")\t\(.bit_rate // "")\t\(.tags.title // "")\t\(.channel_layout // "")"
      ' 2>/dev/null)"
      local _a_rec a_codec a_ch a_lang a_br a_title a_layout
      while IFS= read -r _a_rec; do
        a_had_audio=1
        # C2: non-collapsing split — an empty bit_rate field must not shift title/layout left.
        _split_tab "$_a_rec" a_codec a_ch a_lang a_br a_title a_layout
        local a_line a_ch_label
        # Descriptive channel label
        a_ch_label="$(_channel_label "${a_ch:-0}")"
        # Prefer channel_layout if available and more descriptive
        [[ -n "$a_layout" && "$a_layout" != "unknown" ]] && a_ch_label="$a_layout"

        a_line="${a_codec} ${a_ch_label} [${a_lang}]"
        [[ -n "$a_br" && "$a_br" =~ ^[0-9]+$ ]] && (( a_br > 0 )) && a_line+=" $(( a_br / 1000 ))kbps"
        [[ -n "$a_title" ]] && a_line+=" — $a_title"

        if (( a_idx == 0 )); then
          say "  Audio : $a_line"
        else
          say "          $a_line"
        fi
        a_idx=$(( a_idx + 1 ))
      done <<< "$a_raw_all"
      (( a_had_audio )) || say "  Audio : none"

      [[ "${s_count:-0}" != "0" ]] && say "  Subs  : ${s_count} track(s)"
      (( OUTPUT_HAS_DV )) && say "  DV    : present"
    fi

    # File size
    say "  Size  : $(filesize_pretty "$TMP_OUT")"
  fi
  mark_done "Verify output"

  # Write JSON report if requested
  write_json_report

  # Note external SRT files
  if [[ ${#EXTERNAL_SRT_PATHS[@]} -gt 0 ]]; then
    note "External subtitle files:"
    for ext_path in "${EXTERNAL_SRT_PATHS[@]}"; do
      note "  → $ext_path"
    done
  fi

  note "✅ Staging complete — will atomically move to: $OUT"
}

main "$@"
